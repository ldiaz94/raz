{
  // Cloudflare: serves site/public/ (made by make site) as static files.
  // The dashboard's deploy command stays "npx wrangler deploy". This
  // hook generates /source/ from main before assets are uploaded.
  "name": "raz",
  "compatibility_date": "2026-10-01",
  "build": { "command": "make site-source" },
  "assets": { "directory": "./site/public" },
  "workers_dev": true,
  "routes": [{ "pattern": "raz.lucela.org", "zone_name": "lucela.org", "custom_domain": true }]
}
