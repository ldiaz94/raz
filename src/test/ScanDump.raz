(* Prints the symbols of a file, one per line: src/Scan.raz's side of a
   test against the seed's, ScanDump.pas, which prints the same. The
   symbols are numbered as the seed numbers them: it has no continue
   (report 2026-10.31), the last reserved word here, so its end of the
   file is one lower. A file with continue in it isn't compared. *)
module ScanDump;
import Out, Fmt, Files, Diag, Scan;

(* s as the seed numbers it *)
proc seedSym(s: Scan.Sym): INT;
begin
    if s = Scan.sEof then return INT(s) - 1; end;
    return INT(s);
end;

proc main*;
var p: Diag.Pos; bits: ^U64; i: INT; str: []U8; r: F64;
begin
    if LEN(Scan.open(Files.arg(1))) # 0 then Diag.fatal("no file"); end;
    repeat
        Scan.next;
        p := Scan.tokPos();
        Fmt.print("{}:{}:{} {}:{} {}", [Fmt.int(Diag.lineOf(p)), Fmt.int(p.a), Fmt.int(p.b),
            Fmt.int(Scan.curLine()), Fmt.int(Scan.curCol()), Fmt.int(seedSym(Scan.tok))]);
        match Scan.tok of
        | sIdent: Fmt.print(" {} {}", [Fmt.str(Scan.nameOf(Scan.id)), Fmt.int(Scan.id)]);
        | sInt: Fmt.print(" {}", [Fmt.int(Scan.ival)]);
        | sChar: Fmt.print(" {}", [Fmt.int(Scan.ival)]);
        | sReal:
            r := Scan.rval;
            bits := ^U64(ADR(r));
            Out.str(" ");
            Out.hex(bits^, 16);
        | sString:
            Out.str(" \"");
            str := Scan.strBytes();
            for i := 0 to LEN(str) - 1 do Fmt.print("{},", [Fmt.int(INT(str[i]))]); end;
            Out.str("\"");
        | else:
        end;
        Out.ln;
    until Scan.tok = Scan.sEof;
end;

end ScanDump.
