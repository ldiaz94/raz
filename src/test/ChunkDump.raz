(* Makes a program of chunks by a fixed pseudo-random script and prints
   all of it: src/Chunk.raz's side of a test against the seed's,
   ChunkDump.pas, which prints the same. *)
module ChunkDump;
import Out, Fmt, Scan, Chunk;

var seed: I64;

proc rnd(n: INT): INT;
begin
    seed := (seed * 1103515245 + 12345) & 7FFFFFFFH;
    return INT((seed shr 8) mod I64(n));
end;

(* a flag, as the number the seed's side prints for it *)
proc bit(f: BOOL): INT;
begin
    if f then return 1; end;
    return 0;
end;

proc main*;
var
    names: [8]INT; b: [64]U8;
    i, k, n, op, c, sum, open, x, y, z: INT;
begin
    seed := 7;
    for i := 0 to 7 do b[0] := U8(97 + i); names[i] := Scan.intern(ADR(b[0]), 1); end;
    open := -1;
    sum := 0;
    for k := 1 to 30000 do
        op := rnd(16);
        match op of
        | 0..3: Chunk.put1(rnd(256));
        | 4: x := rnd(1 shl 30); y := rnd(1 shl 30); Chunk.put4(x - y);
        | 5: x := rnd(1 shl 30); y := rnd(1 shl 30); Chunk.put8(I64(x) * 4096 - I64(y));
        | 6:
            if open >= 0 then Chunk.endChunk(open); end;
            x := rnd(5); y := rnd(9);
            open := Chunk.newChunk(Chunk.secText, x - 1, y - 1);
            Chunk.beginChunk(open);
        | 7:
            x := rnd(8); Chunk.setCurFile(names[x]);
            x := rnd(300); y := rnd(80); Chunk.noteLine(x, y);
        | 8:
            if Chunk.numChunks > 0 then
                x := rnd(Chunk.numChunks); y := rnd(100); Chunk.addFixup(Chunk.pc, x, y - 50);
            end;
        | 9:
            if (open >= 0) and (Chunk.pc - Chunk.chunks[open].start > 8) then
                x := rnd(6); Chunk.takeBack(x);
            end;
        | 10:
            x := rnd(5); y := rnd(9);
            c := Chunk.newChunk(Chunk.secRodata, x - 1, y - 1);
            n := rnd(64);
            for i := 0 to n - 1 do b[i] := U8(rnd(256)); end;
            x := rnd(4);
            Chunk.setData(c, ADR(b[0]), n, 1 shl x);
            n := rnd(4);
            for i := 1 to n do
                x := rnd(8); y := rnd(Chunk.numChunks); z := rnd(10);
                Chunk.addDataFixup(c, x * 8, y, z);
            end;
        | 11:
            x := rnd(5); y := rnd(9);
            c := Chunk.newChunk(Chunk.secBss, x - 1, y - 1);
            x := rnd(100); y := rnd(4);
            Chunk.setBss(c, x, 1 shl y);
        | 12: x := rnd(8); c := Chunk.externChunk(names[x]);
        | 13:
            if Chunk.numChunks > 0 then
                x := rnd(Chunk.numChunks); y := rnd(8); z := rnd(200); n := rnd(5);
                Chunk.noteVar(x, names[y], z - 100, n);
            end;
        | 14:
            if Chunk.pc >= 8 then
                x := rnd(1 shl 30); y := rnd(1 shl 30);
                Chunk.put4At(Chunk.pc - 8, x - y);
                sum := (sum + Chunk.get4At(Chunk.pc - 8)) & 0FFFFFFH;
            end;
        | else:
            if Chunk.numChunks > 0 then
                x := rnd(Chunk.numChunks); Chunk.setLive(x);
                x := rnd(Chunk.numChunks); y := rnd(1 shl 30); Chunk.setAdr(x, y);
            end;
        end;
    end;
    if open >= 0 then Chunk.endChunk(open); end;
    Fmt.print("sum {} pc {} rolen {}\n", [Fmt.int(sum), Fmt.int(Chunk.pc), Fmt.int(Chunk.rolen)]);
    for i := 0 to Chunk.numChunks - 1 do
        Fmt.print("C {} {} {} {} {} {} {} {} {} {} {} {} {}\n", [Fmt.int(i), Fmt.int(INT(Chunk.chunks[i].sec)),
            Fmt.int(Chunk.chunks[i].start), Fmt.int(Chunk.chunks[i].size), Fmt.int(Chunk.chunks[i].align),
            Fmt.int(Chunk.chunks[i].firstFix), Fmt.int(Chunk.chunks[i].numFix), Fmt.int(Chunk.chunks[i].home),
            Fmt.int(Chunk.chunks[i].name), Fmt.int(Chunk.chunks[i].adr),
            Fmt.int(bit(Chunk.chunks[i].live)), Fmt.int(bit(Chunk.chunks[i].ext)), Fmt.str(Chunk.chunkName(i))]);
    end;
    for i := 0 to Chunk.numFixups - 1 do
        Fmt.print("F {} {} {}\n", [Fmt.int(Chunk.fixups[i].at), Fmt.int(Chunk.fixups[i].chunk), Fmt.int(Chunk.fixups[i].addend)]);
    end;
    for i := 0 to Chunk.numDataFixups - 1 do
        Fmt.print("D {} {} {}\n", [Fmt.int(Chunk.dataFixups[i].at), Fmt.int(Chunk.dataFixups[i].chunk), Fmt.int(Chunk.dataFixups[i].addend)]);
    end;
    for i := 0 to Chunk.numLines - 1 do
        Fmt.print("L {} {} {} {} {}\n", [Fmt.int(Chunk.lines[i].at), Fmt.int(Chunk.lines[i].chunk),
            Fmt.int(Chunk.lines[i].path), Fmt.int(Chunk.lines[i].line), Fmt.int(Chunk.lines[i].col)]);
    end;
    for i := 0 to Chunk.numVarNotes - 1 do
        Fmt.print("V {} {} {} {}\n", [Fmt.int(Chunk.varNotes[i].chunk), Fmt.int(Chunk.varNotes[i].name),
            Fmt.int(Chunk.varNotes[i].off), Fmt.int(Chunk.varNotes[i].kind)]);
    end;
    for i := 0 to Chunk.pc - 1 do Out.hex(U64(Chunk.text[i]), 2); end;
    Out.ln;
    for i := 0 to Chunk.rolen - 1 do Out.hex(U64(Chunk.rodata[i]), 2); end;
    Out.ln;
end;

end ChunkDump.
