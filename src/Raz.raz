(* Raz: the command line.

     raz [-I dir]... [-o file] [-Werror] [-S] Main.raz
     raz run [-I dir]... Main.raz [arg]...
     raz --version

   Compiles the main module and every module it imports, writes the
   entry point, links what it reaches, and writes the executable: by
   default the main module's file without its .raz; with -S, it lists
   the main module's code instead. raz run writes it to a memfd
   instead, a file that lives only in memory, and executes it in raz's
   place with the arguments after Main.raz, so its status is the
   program's; its argv[0] is Main.raz.

   The program starts by saving argc and argv, runs every module's body
   (those of the modules the program imports, imported modules first),
   then the main module's main, and ends with Rt.exit and main's
   status. A static program does this from its entry point. One that
   uses C starts through the C library, __libc_start_main, which sets
   C up and calls this as C's main; first it gives Rt C's exit, which
   Rt.exit then ends the program with.

   Depends on: everything else, and Version, a module the build makes
   (build/src/Version.raz) from what git describe says, as the seed's
   build/version.inc is.
   Leaves out: the work itself; the other units compile, link and
   write, and this only reads the command line and runs them in order. *)
module Raz;
import Sys, Out, Version, Files, Fmt, Diag, Scan, Sym, Chunk, X64, Gen, Parse, Link, Elf;

const
    Report = "2026-10.26";   (* the version of doc/raz.md it follows *)
    MemfdCreate = 319;       (* the system call *)
    MfdCloexec = 1;          (* an ELF still executes: the kernel opens it first *)
    Execve = 59;

var
    links: [4]Gen.Link;
    numLinks: INT;
    cLinks: [3]Gen.Link;    (* C's symbols the entry point gives the library, in a program that uses C *)
    numCLinks: INT;

proc say1(f, a: []U8): []U8;
begin
    return Diag.say(f, [Fmt.str(a)]);
end;

(* The number of the name s *)
proc internStr(s: []U8): INT;
begin
    return Scan.intern(ADR(s[0]), LEN(s));
end;

(* The modules the program uses: the main module, Rt, and every module
   they import. A module read only for the interface check is not. *)
proc use(m: ^Sym.Module);
var i: ^Sym.Import;
begin
    if m^.used then return; end;
    m^.used := true;
    i := m^.imports;
    while i # nil do
        use(i^.home);
        i := i^.next;
    end;
end;

(* Whether the program uses C: if so, the libraries it needs go to
   Elf, the C library first. *)
proc usesC: BOOL;
var m, st, c: ^Sym.Module; l: ^Sym.Lib;
begin
    st := nil; c := nil;
    Elf.noLibs();
    _ := Elf.needLib(internStr("libc.so.6"));
    m := Parse.firstModule;
    while m # nil do
        if m^.used and m^.linkStatic then st := m; end;
        if m^.used and m^.usesC then c := m; end;
        l := m^.libs;
        while m^.used and (l # nil) do
            if not Elf.needLib(l^.name) then Diag.fatal("more than 32 libraries"); end;
            l := l^.next;
        end;
        m := m^.next;
    end;
    if (st # nil) and (c # nil) then
        Diag.fatal(Diag.say("{} says link static, but {} uses C", [Fmt.str(Scan.nameOf(st^.name)), Fmt.str(Scan.nameOf(c^.name))]));
    end;
    if c = nil then Elf.noLibs(); end;
    return c # nil;
end;

(* What raz -h says *)
proc usage;
begin
    Out.str("usage: raz [option]... Main.raz       compiles Main.raz and the modules it imports\n");
    Out.str("       raz run [option]... Main.raz [arg]...   compiles it and runs it, with the args\n");
    Out.str("options:\n");
    Out.str("  -o file      the program's file, Main without .raz if left out\n");
    Out.str("  -I dir       looks for imported modules in dir too, after Main.raz's own\n");
    Out.str("  -Werror      a warning counts as an error\n");
    Out.str("  -S           lists the main module's code, under each line of source\n");
    Out.str("  -s           strips symbols, line numbers, the places a failure is told\n");
    Out.str("               by and the profiler: a failure says only its address\n");
    Out.str("  -noprofile   leaves out the profiler, which RAZ_PROFILE turns on\n");
    Out.str("  -h, --help   says this\n");
    Out.str("  --version    says the version, and the report it follows\n");
    Out.str("see raz(1), and the report, doc/raz.md\n");
    Out.flush();
end;

(* The module named n, or nil if the program has none *)
proc moduleNamed(n: []U8): ^Sym.Module;
var m: ^Sym.Module;
begin
    m := Parse.firstModule;
    while (m # nil) and (Scan.nameOf(m^.name) # n) do m := m^.next; end;
    return m;
end;

(* What the library module m, found by name, declares as n *)
proc objIn(m: ^Sym.Module; n: []U8): ^Sym.Obj;
var o: ^Sym.Obj;
begin
    o := Sym.find(m^.scope, internStr(n));
    if o = nil then Diag.fatal(Diag.say("{} has no {}", [Fmt.str(Scan.nameOf(m^.name)), Fmt.str(n)])); end;
    return o;
end;

(* Rt is given the address of chunk, in its variable v *)
proc addLink(chunk: INT; v: ^Sym.Obj);
begin
    links[numLinks].chunk := chunk;
    links[numLinks].into := v^.chunk;
    INC(numLinks);
end;

(* The library is given C's symbol sym, in its variable v *)
proc addCLink(sym: []U8; v: ^Sym.Obj);
begin
    cLinks[numCLinks].chunk := Chunk.externChunk(internStr(sym));
    cLinks[numCLinks].into := v^.chunk;
    INC(numCLinks);
end;

(* s as a C string, in memory that is never freed *)
proc cstr(s: []U8): ^U8;
var p: ^U8;
begin
    p := Scan.grab(LEN(s) + 1);
    if LEN(s) > 0 then COPY(p[0..LEN(s)], s); end;
    p[LEN(s)] := 0;
    return p;
end;

proc main*: INT;
var
    path, outPath, s: []U8; dir: []U8;
    i, first, entry, fd, last, errno: INT;
    m, rt, thread: ^Sym.Module; mainObj: ^Sym.Obj;
    run, noProfile, listing, dynamic: BOOL; err: ERROR;
begin
    path := "";
    outPath := "";
    noProfile := false;
    listing := false;
    run := (ARGC() >= 2) and (Files.arg(1) = "run");
    if run then i := 2; else i := 1; end;
    while i < ARGC() do
        s := Files.arg(i);
        if s = "-I" then
            INC(i);
            if Parse.numInc > 15 then Diag.fatal("more than 16 -I directories"); end;
            Parse.addIncDir(Files.arg(i));
        elsif s = "-o" then
            INC(i);
            outPath := Files.arg(i);
        elsif s = "-Werror" then
            Diag.setWerror(true);
        elsif s = "-S" then
            listing := true;
            X64.setListing(true);
        elsif s = "-s" then
            Elf.setStripped(true);
        elsif s = "-noprofile" then
            noProfile := true;
        elsif (s = "-h") or (s = "--help") then
            usage();
            return 0;
        elsif s = "--version" then
            Out.str(Diag.say("raz {}, report {}\n", [Fmt.str(Version.Text), Fmt.str(Report)]));
            Out.flush();
            return 0;
        elsif (LEN(s) > 0) and (s[0] = '-') then
            Diag.fatal(say1("unknown option {}", s));
        else
            path := s;
            first := i;
            if run then break; end;   (* the rest are the program's *)
        end;
        INC(i);
    end;
    if LEN(path) = 0 then
        usage();
        return 1;
    end;
    if run and (LEN(outPath) > 0) then Diag.fatal("raz run takes no -o"); end;
    (* where raz is, as the system says, for the library beside it *)
    dir, errno := Sys.readLink("/proc/self/exe");
    if errno # 0 then dir := Files.arg(0); end;
    i := LEN(dir);
    while (i > 0) and (dir[i - 1] # '/') do DEC(i); end;
    if i = 0 then Parse.setLibDir("lib"); else Parse.setLibDir(say1("{}lib", dir[0..i])); end;
    if LEN(outPath) = 0 then
        outPath := path;
        last := LEN(outPath);
        if (last >= 4) and (outPath[last - 4..last] = ".raz") then
            outPath := outPath[0..last - 4];
        else
            outPath := say1("{}.out", outPath);
        end;
    end;

    m, err := Parse.compileMain(path);
    if err # nil then
        Diag.finish();
        return 1;
    end;
    if Diag.errors > 0 then Diag.finish(); end;

    use(m);
    rt := moduleNamed("Rt");
    if rt # nil then use(rt); end;

    mainObj := Sym.find(m^.scope, internStr("main"));
    if mainObj # nil then
        if (mainObj^.cls # Sym.oProc) or not mainObj^.exported then
            Diag.error(mainObj^.pos, "main must be an exported procedure");
        elsif (mainObj^.typ^.len # 0) or ((mainObj^.typ^.base # nil) and (mainObj^.typ^.base # Sym.tInt)) then
            Diag.error(mainObj^.pos, "main must be proc main* or proc main*: INT");
        end;
        if Diag.errors > 0 then Diag.finish(); end;
    end;
    Diag.finish();

    if rt = nil then Diag.fatal("can't find module Rt"); end;
    (* what Rt is given: the places, which the linker makes, for Rt to say
       where a failed check or a signal was (place), and the calls under
       way then (calls); and the profiler, which needs them too. raz -s
       gives none, -noprofile no profiler. *)
    numLinks := 0;
    if not Elf.stripped then
        Link.setPlaces(Chunk.newChunk(Chunk.secRodata, -1, -1));
        Chunk.setData(Link.placesChunk, nil, 0, 8);
        addLink(Link.placesChunk, objIn(rt, "places"));
        addLink(objIn(rt, "calls")^.chunk, objIn(rt, "teller"));
        addLink(objIn(rt, "place")^.chunk, objIn(rt, "placer"));
        if not noProfile then addLink(objIn(rt, "startProfile")^.chunk, objIn(rt, "profiler")); end;
    end;
    (* what a program that uses C is given of C: Rt its exit, and
       Thread, if the program has it, the calls that make and join C's
       threads, so that the C library knows of them *)
    dynamic := usesC();
    numCLinks := 0;
    if dynamic then
        addCLink("exit", objIn(rt, "cExit"));
        thread := moduleNamed("Thread");
        if (thread # nil) and thread^.used then
            addCLink("pthread_create", objIn(thread, "cCreate"));
            addCLink("pthread_join", objIn(thread, "cJoin"));
        end;
    end;
    entry := Gen.entryPoint(dynamic, Parse.firstModule, mainObj, cLinks[0..numCLinks], numCLinks,
        objIn(rt, "exit")^.chunk, links[0..numLinks], numLinks);

    Link.markLive(entry);
    if not Parse.HasReals then
        for i := 0 to Chunk.numChunks - 1 do
            if Chunk.chunks[i].live and Chunk.chunks[i].reals then
                Diag.error(Chunk.chunks[i].realsAt, "this target has no reals");
            end;
        end;
    end;
    if Diag.errors > 0 then Diag.finish(); end;
    if listing then
        X64.list(m^.sname);
        return 0;
    end;

    Elf.setMainPath(path);
    if run then
        (* argv from Main.raz on is the program's, ending in nil as it must *)
        fd := SYSCALL(MemfdCreate, cstr("raz"), MfdCloexec);
        if fd < 0 then Diag.fatal("can't create a memfd"); end;
        outPath := Diag.say("/proc/self/fd/{}", [Fmt.int(fd)]);
        Elf.writeElf(outPath, entry);
        _ := SYSCALL(Execve, cstr(outPath), ARGV() + first, ARGV() + (ARGC() + 1));
        Diag.fatal(say1("can't run {}", path));
    end;
    Elf.writeElf(outPath, entry);
    return 0;
end;

end Raz.
