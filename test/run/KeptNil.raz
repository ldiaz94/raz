(* A parameter kept in rdi or rsi is shown when a signal stops the
   procedure that keeps it. *)
module KeptNil;
import Out;

type Rec = record x: INT; end;

proc get(p: ^Rec; k: INT): INT;
begin
    return p^.x + k;
end;

(* called through a procedure value, so that get isn't made in place *)
proc main*;
var r: Rec; f: proc(p: ^Rec; k: INT): INT;
begin
    r.x := 1;
    f := get;
    Out.int(f(ADR(r), 2)); Out.ln;
    Out.int(f(nil, 5)); Out.ln;
end;

end KeptNil.
