(* Vec: pushed, added in place, resized both ways, popped, emptied, given back;
   of integers and of records, which grow past the first block. *)
module VecTest;
import Fmt, Heap, Ints := Vec(INT), Pts := Vec(Point);

type Point = record x, y: INT; name: []U8; end;

proc main*;
var v: Ints.Vec; w: Pts.Vec; i, sum, top: INT; ok: BOOL; p: ^Point; s: []INT;
begin
    Ints.init(ADR(v), Heap.heap);
    Fmt.print("{} {}\n", [Fmt.int(v.len), Fmt.int(LEN(Ints.all(ADR(v))))]);
    for i := 1 to 10000 do Ints.push(ADR(v), i); end;
    s := Ints.all(ADR(v));
    sum := 0;
    for i := 0 to LEN(s) - 1 do sum := sum + s[i]; end;
    Fmt.print("{} {} {} {}\n", [Fmt.int(v.len), Fmt.int(s[0]), Fmt.int(s[9999]), Fmt.int(sum)]);
    Ints.resize(ADR(v), 3);
    Ints.resize(ADR(v), 5);
    s := Ints.all(ADR(v));
    Fmt.print("{} {} {} {}\n", [Fmt.int(LEN(s)), Fmt.int(s[2]), Fmt.int(s[3]), Fmt.int(s[4])]);
    Ints.reset(ADR(v));
    Ints.push(ADR(v), 7);
    Fmt.print("{} {}\n", [Fmt.int(v.len), Fmt.int(Ints.all(ADR(v))[0])]);
    top, ok := Ints.pop(ADR(v));
    Fmt.print("{} {} {}\n", [Fmt.int(top), Fmt.bool(ok), Fmt.int(v.len)]);
    top, ok := Ints.pop(ADR(v));
    Fmt.print("{} {}\n", [Fmt.int(top), Fmt.bool(ok)]);
    Ints.done(ADR(v));
    Fmt.print("{}\n", [Fmt.int(v.len)]);

    Pts.init(ADR(w), Heap.heap);
    for i := 0 to 99 do
        p := Pts.add(ADR(w));
        p^.x := i; p^.y := i * i;
    end;
    Pts.push(ADR(w), {x: -1, y: -2, name: "last"});
    Fmt.print("{} {} {} {}\n", [Fmt.int(w.len), Fmt.int(Pts.all(ADR(w))[99].y),
        Fmt.int(Pts.all(ADR(w))[100].x), Fmt.str(Pts.all(ADR(w))[100].name)]);
    Pts.done(ADR(w));
end;

end VecTest.
