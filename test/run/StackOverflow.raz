module StackOverflow;
(* A recursion with no end runs out of stack: SIGSEGV, said as such.
   The frame is big so that the fault lands in the prologue, which
   zeroes it from the bottom: with a small one, where the stack starts
   could put the guard page under the body's pushes instead. *)

proc down(n: INT): INT;
var pad: [65536]INT;
begin
    pad[n mod 65536] := n;
    return down(n + 1) + pad[0];
end;

proc main*: INT;
begin
    return down(0);
end;

end StackOverflow.
