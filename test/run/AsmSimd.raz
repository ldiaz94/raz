module AsmSimd;
(* The packed, shuffle and SHA instructions of the assembler: each one's bytes,
   read back from the procedure they are made in. Each was checked against
   GNU as (Intel syntax, objdump). *)
import Out;
import SYSTEM;

const
    Count = 31;
    Names: [Count][]const U8 = [
        "paddd xmm1, xmm2",
        "paddd xmm9, xmm14",
        "paddd xmm0, [rdi]",
        "paddd xmm10, [r12 + rcx * 8 + 400]",
        "punpcklqdq xmm1, xmm2",
        "punpcklqdq xmm8, xmm3",
        "punpcklqdq xmm2, [rax + 16]",
        "punpckhqdq xmm1, xmm2",
        "punpckhqdq xmm3, xmm15",
        "punpckhqdq xmm7, [r9]",
        "pshufb xmm1, xmm2",
        "pshufb xmm8, xmm9",
        "pshufb xmm0, [rdi]",
        "pshufb xmm12, [rsp + 32]",
        "pshufb xmm3, [r13 + 8]",
        "palignr xmm1, xmm2, 8",
        "palignr xmm9, xmm0, 0",
        "palignr xmm2, [rdi + 16], 4",
        "palignr xmm11, [r12], 15",
        "sha256rnds2 xmm1, xmm2, xmm0",
        "sha256rnds2 xmm9, xmm3, xmm0",
        "sha256rnds2 xmm1, [rdi], xmm0",
        "sha256rnds2 xmm2, [r9 + rbx * 4 + 64], xmm0",
        "sha256rnds2 xmm1, xmm2",
        "sha256rnds2 xmm1, [rdi]",
        "sha256msg1 xmm1, xmm2",
        "sha256msg1 xmm8, xmm15",
        "sha256msg1 xmm3, [rsi + 32]",
        "sha256msg2 xmm1, xmm2",
        "sha256msg2 xmm0, xmm9",
        "sha256msg2 xmm4, [r10 + 8]"];
    Sizes: [Count]INT = [
        4,
        5,
        4,
        10,
        4,
        5,
        5,
        4,
        5,
        5,
        5,
        6,
        5,
        8,
        7,
        6,
        7,
        7,
        8,
        4,
        5,
        4,
        7,
        4,
        4,
        4,
        5,
        5,
        4,
        5,
        6];

proc simd;
code
    paddd xmm1, xmm2;
    paddd xmm9, xmm14;
    paddd xmm0, [rdi];
    paddd xmm10, [r12 + rcx * 8 + 400];
    punpcklqdq xmm1, xmm2;
    punpcklqdq xmm8, xmm3;
    punpcklqdq xmm2, [rax + 16];
    punpckhqdq xmm1, xmm2;
    punpckhqdq xmm3, xmm15;
    punpckhqdq xmm7, [r9];
    pshufb xmm1, xmm2;
    pshufb xmm8, xmm9;
    pshufb xmm0, [rdi];
    pshufb xmm12, [rsp + 32];
    pshufb xmm3, [r13 + 8];
    palignr xmm1, xmm2, 8;
    palignr xmm9, xmm0, 0;
    palignr xmm2, [rdi + 16], 4;
    palignr xmm11, [r12], 15;
    sha256rnds2 xmm1, xmm2, xmm0;
    sha256rnds2 xmm9, xmm3, xmm0;
    sha256rnds2 xmm1, [rdi], xmm0;
    sha256rnds2 xmm2, [r9 + rbx * 4 + 64], xmm0;
    sha256rnds2 xmm1, xmm2;
    sha256rnds2 xmm1, [rdi];
    sha256msg1 xmm1, xmm2;
    sha256msg1 xmm8, xmm15;
    sha256msg1 xmm3, [rsi + 32];
    sha256msg2 xmm1, xmm2;
    sha256msg2 xmm0, xmm9;
    sha256msg2 xmm4, [r10 + 8];
    ret;
end simd;

proc main*;
var p: proc; b: ^U8; i, j, at: INT;
begin
    p := simd;
    b := ^U8(p);
    at := 0;
    for i := 0 to Count - 1 do
        Out.str(Names[i]); Out.str(":");
        for j := 0 to Sizes[i] - 1 do
            Out.str(" "); Out.hex(U64(b[at + j]), 2);
        end;
        Out.ln;
        at := at + Sizes[i];
    end;
end;

end AsmSimd.
