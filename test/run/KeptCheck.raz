(* A procedure that calls nothing keeps its first parameters in rdi and
   rsi; a failed check in it still says their values. *)
module KeptCheck;
import Out;

var a: [4]I64;

proc at(i: INT; b: U8): I64;
begin
    return a[i] + I64(b);
end;

proc main*;
begin
    Out.int(at(3, 1)); Out.ln;
    Out.int(at(4, 200)); Out.ln;
end;

end KeptCheck.
