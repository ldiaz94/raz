(* A procedure that calls nothing keeps its first parameters in rdi and
   rsi; a failed check in it still says their values. *)
module KeptCheck;
import Out;

var a: [4]I64;

proc at(i: INT; b: U8): I64;
begin
    return a[i] + I64(b);
end;

(* called through a procedure value, so that at isn't made in place *)
proc main*;
var f: proc(i: INT; b: U8): I64;
begin
    f := at;
    Out.int(f(3, 1)); Out.ln;
    Out.int(f(4, 200)); Out.ln;
end;

end KeptCheck.
