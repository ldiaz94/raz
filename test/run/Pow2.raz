(* div, mod and * by a power of two are shifts; they must agree with
   idiv and imul, which a divisor in a variable still gets. *)
module Pow2;
import Out;

var bad: I64;

proc check(s: []U8; x, got, want: I64);
begin
    if got # want then
        Out.str(s); Out.str(" "); Out.int(x); Out.str(": ");
        Out.int(got); Out.str(" # "); Out.int(want); Out.ln;
        bad := bad + 1;
    end;
end;

proc i64s(x: I64);
var d1, d2, d8, d62: I64;
begin
    d1 := 1; d2 := 2; d8 := 8; d62 := 4000000000000000H;
    check("div 1", x, x div 1, x div d1);
    check("mod 1", x, x mod 1, x mod d1);
    check("div 2", x, x div 2, x div d2);
    check("mod 2", x, x mod 2, x mod d2);
    check("div 8", x, x div 8, x div d8);
    check("mod 8", x, x mod 8, x mod d8);
    check("div 2^62", x, x div 4000000000000000H, x div d62);
    check("mod 2^62", x, x mod 4000000000000000H, x mod d62);
    check("* 8", x, x * 8, x * d8);
    check("div -8", x, x div (0 - 8), x div (0 - d8));
end;

proc u64s(x: U64);
var d2, d8, d62: U64;
begin
    d2 := 2; d8 := 8; d62 := 4000000000000000H;
    check("u div 2", I64(x), I64(x div 2), I64(x div d2));
    check("u mod 2", I64(x), I64(x mod 2), I64(x mod d2));
    check("u div 8", I64(x), I64(x div 8), I64(x div d8));
    check("u mod 8", I64(x), I64(x mod 8), I64(x mod d8));
    check("u div 2^62", I64(x), I64(x div 4000000000000000H), I64(x div d62));
    check("u mod 2^62", I64(x), I64(x mod 4000000000000000H), I64(x mod d62));
end;

proc main*;
var i: I64; b: I8; d: I8; w: U8; dw: U8;
begin
    for i := -300 to 300 do i64s(i); u64s(U64(i)); end;
    i64s(07FFFFFFFFFFFFFFFH); i64s(-07FFFFFFFFFFFFFFFH - 1);
    i64s(4000000000000001H); i64s(-4000000000000001H);
    u64s(0FFFFFFFFFFFFFFFFH); u64s(8000000000000000H);
    d := 8; dw := 8;
    for i := -128 to 127 do
        b := I8(i); w := U8(i + 128);
        check("i8 div 8", i, I64(b div 8), I64(b div d));
        check("i8 mod 8", i, I64(b mod 8), I64(b mod d));
        check("i8 * 8", i, I64(b * 8), I64(b * d));
        check("u8 div 8", i, I64(w div 8), I64(w div dw));
        check("u8 mod 8", i, I64(w mod 8), I64(w mod dw));
        check("u8 * 8", i, I64(w * 8), I64(w * dw));
    end;
    i := -7;
    Out.str("-7 div 2 = "); Out.int(i div 2);
    Out.str(", -7 mod 2 = "); Out.int(i mod 2); Out.ln;
    Out.int(bad); Out.str(" wrong\n");
end;

end Pow2.
