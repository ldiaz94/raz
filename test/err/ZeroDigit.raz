module ZeroDigit;
(* \0 before a digit is a warning; \x00, \0 at the end, \0 before a
   letter, an escaped backslash before 0 and a raw string are quiet. *)
var s*: []const U8; c*: U8;
proc main*;
begin
    s := "a\x0012";
    s := "ab\0";
    s := "\0x\\01";
    s := `\01`;
    c := '\0';
    s := "\0\01234567890-=";
end;
end ZeroDigit.
