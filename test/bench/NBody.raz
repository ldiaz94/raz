(* Bodies under gravity: each step every pair pulls on each other, then
   each body moves. Real variables, a square root and a division in the
   inner loop. *)
module NBody;
import Out, Math;
check off;

const
    N = 64;
    Steps = 8000;
    Dt = 0.001;

var x, y, z, vx, vy, vz, m: [N]F64;

proc step;
var i, j: INT; dx, dy, dz, d2, mag: F64;
begin
    for i := 0 to N - 1 do
        for j := i + 1 to N - 1 do
            dx := x[i] - x[j];
            dy := y[i] - y[j];
            dz := z[i] - z[j];
            d2 := dx * dx + dy * dy + dz * dz + 0.01;
            mag := Dt / (d2 * Math.sqrt(d2));
            vx[i] := vx[i] - dx * m[j] * mag;
            vy[i] := vy[i] - dy * m[j] * mag;
            vz[i] := vz[i] - dz * m[j] * mag;
            vx[j] := vx[j] + dx * m[i] * mag;
            vy[j] := vy[j] + dy * m[i] * mag;
            vz[j] := vz[j] + dz * m[i] * mag;
        end;
    end;
    for i := 0 to N - 1 do
        x[i] := x[i] + Dt * vx[i];
        y[i] := y[i] + Dt * vy[i];
        z[i] := z[i] + Dt * vz[i];
    end;
end;

proc main*;
var i, s: INT; e: F64;
begin
    for i := 0 to N - 1 do
        x[i] := F64(i mod 8);
        y[i] := F64(i div 8);
        z[i] := F64(i mod 5) * 0.5;
        m[i] := 1.0 + F64(i mod 3);
    end;
    for s := 1 to Steps do step; end;
    e := 0.0;
    for i := 0 to N - 1 do
        e := e + 0.5 * m[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);
    end;
    Out.int(INT(e * 1000000.0));
    Out.ln;
end;

end NBody.
