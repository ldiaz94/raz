(* Doc: what a module offers, from its source.

       Doc Module.raz
   prints the module's own comment, the one just before module, then
   each exported declaration as it is written, with the comment just
   before it.

       Doc examples report.md dir
   writes each example of the report that is a whole module, from
   module to end, with no ... left out, to dir/Name.raz, and prints
   the names, one a line. *)
module Doc;
import Out, Rt, Str, Buf, Heap, Scan, Files;

var
    sc: Scan.Scanner;         (* the text being read, at the current symbol *)
    src: []U8;
    docStart, docEnd: I64;    (* the comment just before it, or -1 *)

(* On to the next symbol that isn't a comment, keeping where the last
   comment that starts a line was: one after code on its line belongs
   to that code. *)
proc next;
var newLine: BOOL;
begin
    docStart := -1;
    newLine := false;
    repeat
        Scan.next(ADR(sc));
        newLine := newLine or sc.lineBreak;
        if (sc.kind = Scan.comment) and newLine then
            docStart := sc.start; docEnd := sc.stop;
        end;
    until sc.kind # Scan.comment;
end;

proc text: []U8;
begin
    return Scan.text(ADR(sc));
end;

proc is(s: []U8): BOOL;
begin
    return text() = s;
end;

(* Whether the current word starts a declaration, a section or the end. *)
proc reserved: BOOL;
begin
    return is("const") or is("type") or is("var") or is("proc") or is("extern")
        or is("import") or is("link") or is("begin") or is("end");
end;

(* On to the ; that ends what starts here, past anything bracketed and
   any record or variant; returns where it ends. *)
proc toSemicolon: I64;
var depth: I64;
begin
    depth := 0;
    while sc.kind # Scan.eof do
        if is("(") or is("[") or is("{") or is("record") or is("variant") then INC(depth);
        elsif is(")") or is("]") or is("}") or is("end") then DEC(depth);
        elsif is(";") and (depth <= 0) then return sc.stop;
        end;
        next;
    end;
    return sc.pos;
end;

(* stop, or the end of a comment that follows it on its line. *)
proc trailing(stop: I64): I64;
var t: Scan.Scanner;
begin
    while (stop < LEN(src)) and ((src[stop] = ' ') or (src[stop] = 9)) do INC(stop); end;
    t := sc;
    t.pos := stop;
    Scan.next(ADR(t));
    if (t.kind = Scan.comment) and (t.start = stop) then return t.stop; end;
    return stop;
end;

(* Where the line holding p starts. *)
proc lineStart(p: I64): I64;
begin
    while (p > 0) and (src[p - 1] # 10) do DEC(p); end;
    return p;
end;

(* src[start..stop] as written, each line after the first moved left as
   far as the first one's column. *)
proc block(start, stop: I64);
var col, i, n: I64;
begin
    col := start - lineStart(start);
    i := start;
    while i < stop do
        Out.char(src[i]);
        if src[i] = 10 then
            n := 0;
            while (n < col) and (i + 1 < stop) and (src[i + 1] = ' ') do INC(i); INC(n); end;
        end;
        INC(i);
    end;
    Out.ln;
end;

(* The comment from start to stop, without its brackets, each line
   indented by four. *)
proc comment(start, stop: I64);
var i, j: I64; atLine: BOOL;
begin
    if start < 0 then return; end;
    i := start + 2;
    j := stop - 2;
    while (i < j) and Scan.isSpace(src[i]) do INC(i); end;
    while (j > i) and Scan.isSpace(src[j - 1]) do DEC(j); end;
    atLine := true;
    while i < j do
        if atLine then Out.str("    "); atLine := false; end;
        Out.char(src[i]);
        if src[i] = 10 then
            atLine := true;
            while (i + 1 < j) and (src[i + 1] = ' ') do INC(i); end;
        end;
        INC(i);
    end;
    Out.ln;
end;

(* One declaration, from its first token, the comment before it kept. *)
proc declaration(prefix: []U8; exported: BOOL; start, ds, de, stop: I64);
begin
    if not exported then return; end;
    Out.ln;
    Out.str(prefix);
    block(start, trailing(stop));
    comment(ds, de);
end;

(* name, and whether a * follows it; leaves the token after them. *)
proc name: BOOL;
begin
    next;
    next;
    if is("*") then next; return true; end;
    return false;
end;

(* A procedure's body: to the end that closes its begin, the procedure
   name after it and its ;. *)
proc skipBody;
var depth: I64; sawBegin: BOOL;
begin
    depth := 0;
    sawBegin := false;
    while sc.kind # Scan.eof do
        if is("begin") then
            if depth = 0 then sawBegin := true; end;
            INC(depth);
        elsif is("if") or is("while") or is("for") or is("match") or is("record") or is("variant") then
            INC(depth);
        elsif is("end") then
            DEC(depth);
            if (depth = 0) and sawBegin then
                next;
                if sc.kind = Scan.word then next; end;
                return;
            end;
        end;
        next;
    end;
end;

proc procedure;
var start, ds, de, stop: I64; exp: BOOL;
begin
    start := sc.start; ds := docStart; de := docEnd;
    exp := name();
    stop := toSemicolon();
    next;
    if is("forward") or is("code") then toSemicolon();
    else skipBody;
    end;
    declaration("", exp, start, ds, de, stop);
    next;
end;

proc section;
var word: []U8; start, ds, de, stop: I64; exp: BOOL;
begin
    word := text();
    next;
    while (sc.kind = Scan.word) and not reserved() do
        start := sc.start; ds := docStart; de := docEnd;
        sc.pos := sc.start;      (* name reads the name again *)
        exp := name();
        stop := toSemicolon();
        if exp then
            Out.ln;
            Out.str(word); Out.str(" ");
            block(start, trailing(stop));
            comment(ds, de);
        end;
        next;
    end;
end;

proc external;
var start, ds, de, stop: I64; exp: BOOL;
begin
    start := sc.start; ds := docStart; de := docEnd;
    next;
    exp := name();
    stop := toSemicolon();
    declaration("", exp, start, ds, de, stop);
    next;
end;

proc document(path: []U8);
var b: Buf.Buf; start, ds, de: I64;
begin
    Buf.init(ADR(b), Heap.heap);
    if not Files.read(path, ADR(b)) then Rt.stop("Doc: can't read the file"); end;
    src := Buf.bytes(ADR(b));
    Scan.init(ADR(sc), src);
    next;
    while (sc.kind # Scan.eof) and not is("module") do next; end;
    if sc.kind = Scan.eof then Rt.stop("Doc: no module"); end;
    start := sc.start;
    ds := docStart; de := docEnd;
    block(start, toSemicolon());
    comment(ds, de);
    next;
    while (sc.kind # Scan.eof) and not is("begin") and not is("end") do
        if is("const") or is("type") or is("var") then section;
        elsif is("proc") then procedure;
        elsif is("extern") then external;
        elsif is("import") or is("link") then toSemicolon(); next;
        else next;
        end;
    end;
end;

(* line, without the spaces at its ends *)
proc trim(line: []U8): []U8;
var i, j: I64;
begin
    i := 0;
    j := LEN(line);
    while (i < j) and Scan.isSpace(line[i]) do INC(i); end;
    while (j > i) and Scan.isSpace(line[j - 1]) do DEC(j); end;
    return line[i..j];
end;

(* The report's examples that are whole modules, each to dir. *)
proc examples(path, dir: []U8);
var
    b, out: Buf.Buf; s, line, first, last, name: []U8; i, start, k, n: I64;
    inBlock, whole: BOOL;
begin
    Buf.init(ADR(b), Heap.heap);
    Buf.init(ADR(out), Heap.heap);
    if not Files.read(path, ADR(b)) then Rt.stop("Doc: can't read the report"); end;
    s := Buf.bytes(ADR(b));
    inBlock := false;
    start := 0;
    i := 0;
    while i < LEN(s) do
        k := i;
        while (k < LEN(s)) and (s[k] # 10) do INC(k); end;
        line := s[i..k];
        if trim(line) = "```" then
            if inBlock and whole and Str.hasPrefix(first, "module ") and Str.hasPrefix(last, "end ") then
                name := first[7..LEN(first)];
                n := 0;
                while (n < LEN(name)) and Scan.isWord(name[n]) do INC(n); end;
                name := name[0..n];
                Buf.reset(ADR(out));
                Buf.str(ADR(out), dir); Buf.str(ADR(out), "/"); Buf.str(ADR(out), name);
                Buf.str(ADR(out), ".raz");
                if not Files.write(Buf.bytes(ADR(out)), s[start..i]) then
                    Rt.stop("Doc: can't write an example");
                end;
                Out.str(name); Out.ln;
            end;
            inBlock := not inBlock;
            start := k + 1;
            first := ""; last := "";
            whole := true;
        elsif inBlock then
            if trim(line) = "..." then whole := false; end;
            if LEN(trim(line)) > 0 then
                if LEN(first) = 0 then first := trim(line); end;
                last := trim(line);
            end;
        end;
        i := k + 1;
    end;
end;

proc main*;
begin
    if (ARGC() = 4) and (Files.arg(1) = "examples") then examples(Files.arg(2), Files.arg(3));
    elsif ARGC() = 2 then document(Files.arg(1));
    else Rt.stop("usage: Doc Module.raz, or Doc examples report.md dir");
    end;
end;

end Doc.
