(* Doc: what a module offers, from its source.

       Doc Module.raz
   prints the module's own comment, the one just before module, then
   each exported declaration as it is written, with the comment just
   before it.

       Doc man Module.raz ...
   prints the same of each module, as the manual page raz-lib(3), in
   mdoc: the module's name a heading, each declaration a literal
   display, each comment filled text, indented, but for its lines
   indented further, which are code.

       Doc examples report.md dir
       Doc examples page.7 dir
   writes each example of the report, or of a manual page, that is a
   whole module, from module to end, with no ... left out, to
   dir/Name.raz, and prints the names, one a line. *)
module Doc;
import Out, Rt, Str, Buf, Heap, Scan, Files;

const Date = "October 12, 2026";   (* raz-lib(3)'s, when the library last changed *)

var
    sc: Scan.Scanner;         (* the text being read, at the current symbol *)
    src: []U8;
    docStart, docEnd: INT;    (* the comment just before it, or -1 *)
    man: BOOL;                (* writing mdoc *)
    atStart: BOOL;            (* emit is at the start of a line *)
    shown: BOOL;              (* a literal display of mdoc's is open *)

(* On to the next symbol that isn't a comment, keeping where the last
   comment that starts a line was: one after code on its line belongs
   to that code. *)
proc next;
var newLine: BOOL;
begin
    docStart := -1;
    newLine := false;
    repeat
        Scan.next(ADR(sc));
        newLine := newLine or sc.lineBreak;
        if (sc.kind = Scan.comment) and newLine then
            docStart := sc.start; docEnd := sc.stop;
        end;
    until sc.kind # Scan.comment;
end;

(* c, written out; in mdoc, so that roff takes it as text: a backslash
   is \e, and a line that would start with . or ' is a control line
   unless \& comes first. *)
proc emit(c: U8);
begin
    if man and (c = '\\') then Out.str("\\e");
    else
        if man and atStart and ((c = '.') or (c = '\'')) then Out.str("\\&"); end;
        Out.char(c);
    end;
    atStart := c = 10;
end;

(* a line of mdoc's own, such as .Ed *)
proc control(s: []U8);
begin
    Out.str(s);
    Out.ln;
    atStart := true;
end;

(* the literal display, if open, closed *)
proc close;
begin
    if shown then control(".Ed"); end;
    shown := false;
end;

proc text: []U8;
begin
    return Scan.text(ADR(sc));
end;

proc is(s: []U8): BOOL;
begin
    return text() = s;
end;

(* Whether the current word starts a declaration, a section or the end. *)
proc reserved: BOOL;
begin
    return is("const") or is("type") or is("var") or is("proc") or is("extern")
        or is("import") or is("link") or is("begin") or is("end");
end;

(* On to the ; that ends what starts here, past anything bracketed and
   any record or variant; returns where it ends. *)
proc toSemicolon: INT;
var depth: INT;
begin
    depth := 0;
    while sc.kind # Scan.eof do
        if is("(") or is("[") or is("{") or is("record") or is("variant") then INC(depth);
        elsif is(")") or is("]") or is("}") or is("end") then DEC(depth);
        elsif is(";") and (depth <= 0) then return sc.stop;
        end;
        next;
    end;
    return sc.pos;
end;

(* stop, or the end of a comment that follows it on its line. *)
proc trailing(stop: INT): INT;
var t: Scan.Scanner;
begin
    while (stop < LEN(src)) and ((src[stop] = ' ') or (src[stop] = 9)) do INC(stop); end;
    t := sc;
    t.pos := stop;
    Scan.next(ADR(t));
    if (t.kind = Scan.comment) and (t.start = stop) then return t.stop; end;
    return stop;
end;

(* Where the line holding p starts. *)
proc lineStart(p: INT): INT;
begin
    while (p > 0) and (src[p - 1] # 10) do DEC(p); end;
    return p;
end;

(* src[start..stop] as written, each line after the first moved left as
   far as the first one's column. *)
proc block(start, stop: INT);
var col, i, n: INT;
begin
    col := start - lineStart(start);
    i := start;
    while i < stop do
        emit(src[i]);
        if src[i] = 10 then
            n := 0;
            while (n < col) and (i + 1 < stop) and (src[i + 1] = ' ') do INC(i); INC(n); end;
        end;
        INC(i);
    end;
    emit(10);
end;

(* The comment from start to stop, without its brackets, each line
   indented by four; in mdoc, filled, but for the lines indented past
   its own, which are code, kept as they are. *)
proc comment(start, stop: INT);
var i, j, k, m, n, deep, indent: INT;
begin
    if start < 0 then return; end;
    deep := start - lineStart(start) + 3;
    indent := -1;     (* the indent of the code being written, or -1 *)
    i := start + 2;
    j := stop - 2;
    while (i < j) and Scan.isSpace(src[i]) do INC(i); end;
    while (j > i) and Scan.isSpace(src[j - 1]) do DEC(j); end;
    if man then control(".Bd -filled -offset indent -compact"); end;
    while i < j do
        k := i;
        while (k < j) and (src[k] # 10) do INC(k); end;
        n := 0;
        while (i + n < k) and (src[i + n] = ' ') do INC(n); end;
        if man and (n > deep) and (indent < 0) then
            control(".Bd -literal -offset indent -compact");
            indent := n;
        elsif man and (n <= deep) and (indent >= 0) then
            control(".Ed");
            indent := -1;
        end;
        if man and (n = k - i) and (indent < 0) then control(".Pp");
        else
            if not man then Out.str("    ");
            elsif (indent >= 0) and (n > indent) then n := indent;
            end;
            for m := i + n to k - 1 do emit(src[m]); end;
            emit(10);
        end;
        i := k + 1;
    end;
    if indent >= 0 then control(".Ed"); end;
    if man then control(".Ed"); end;
end;

(* One declaration, from its first token, the comment before it kept.
   In mdoc a module's test, its main, is left out, and declarations
   with no comment share a display. *)
proc declaration(prefix: []U8; exported: BOOL; start, ds, de, stop: INT);
begin
    if not exported then return; end;
    if not man then Out.ln;
    elsif Str.hasPrefix(src[start..stop], "proc main*") then return;
    elsif not shown then control(".Bd -literal"); shown := true;
    end;
    if LEN(prefix) > 0 then Out.str(prefix); Out.str(" "); end;
    block(start, trailing(stop));
    if ds >= 0 then close; end;
    comment(ds, de);
end;

(* name, and whether a * follows it; leaves the token after them. *)
proc name: BOOL;
begin
    next;
    next;
    if is("*") then next; return true; end;
    return false;
end;

(* A procedure's body: to the end that closes its begin or code, the
   procedure name after it and its ;. *)
proc skipBody;
var depth: INT; sawBegin: BOOL;
begin
    depth := 0;
    sawBegin := false;
    while sc.kind # Scan.eof do
        if is("begin") or is("code") then
            if depth = 0 then sawBegin := true; end;
            INC(depth);
        elsif is("if") or is("while") or is("for") or is("match") or is("record") or is("variant") then
            INC(depth);
        elsif is("end") then
            DEC(depth);
            if (depth = 0) and sawBegin then
                next;
                if sc.kind = Scan.word then next; end;
                return;
            end;
        end;
        next;
    end;
end;

proc procedure;
var start, ds, de, stop: INT; exp: BOOL;
begin
    start := sc.start; ds := docStart; de := docEnd;
    exp := name();
    stop := toSemicolon();
    next;
    if is("forward") then _ := toSemicolon();
    else skipBody;
    end;
    declaration("", exp, start, ds, de, stop);
    next;
end;

proc section;
var word: []U8; start, ds, de, stop: INT; exp: BOOL;
begin
    word := text();
    next;
    while (sc.kind = Scan.word) and not reserved() do
        start := sc.start; ds := docStart; de := docEnd;
        sc.pos := sc.start;      (* name reads the name again *)
        exp := name();
        stop := toSemicolon();
        declaration(word, exp, start, ds, de, stop);
        next;
    end;
end;

proc external;
var start, ds, de, stop: INT; exp: BOOL;
begin
    start := sc.start; ds := docStart; de := docEnd;
    next;
    exp := name();
    stop := toSemicolon();
    declaration("", exp, start, ds, de, stop);
    next;
end;

proc document(path: []U8);
var b: Buf.Buf; start, ds, de: INT;
begin
    Buf.init(ADR(b), Heap.heap);
    if not Files.read(path, ADR(b)) then Rt.stop("Doc: can't read the file"); end;
    src := Buf.bytes(ADR(b));
    Scan.init(ADR(sc), src);
    next;
    while (sc.kind # Scan.eof) and not is("module") do next; end;
    if sc.kind = Scan.eof then Rt.stop("Doc: no module"); end;
    start := sc.start;
    ds := docStart; de := docEnd;
    next;
    if man then
        close;
        Out.str(".Ss "); Out.str(text()); emit(10);
        declaration("", true, start, ds, de, toSemicolon());
    else
        block(start, toSemicolon());
        comment(ds, de);
    end;
    next;
    while (sc.kind # Scan.eof) and not is("begin") and not is("end") do
        if is("const") or is("type") or is("var") then section;
        elsif is("proc") then procedure;
        elsif is("extern") then external;
        elsif is("import") or is("link") then _ := toSemicolon(); next;
        else next;
        end;
    end;
end;

(* line, from the report or a manual page's literal block, added to b
   as the program has it: in a page, \e is a backslash, \(ga a
   backquote and \& nothing. *)
proc addLine(b: ^Buf.Buf; line: []U8; page: BOOL);
var i: INT;
begin
    i := 0;
    while i < LEN(line) do
        if page and (line[i] = '\\') and (i + 1 < LEN(line)) and (line[i + 1] = 'e') then
            Buf.add(b, '\\');
            INC(i);
        elsif page and Str.hasPrefix(line[i..LEN(line)], "\\(ga") then
            Buf.add(b, '`');
            INC(i, 3);
        elsif page and (line[i] = '\\') and (i + 1 < LEN(line)) and (line[i + 1] = '&') then
            INC(i);
        else Buf.add(b, line[i]);
        end;
        INC(i);
    end;
    Buf.add(b, 10);
end;

(* text written to the file dir/name and ext, its path made in out *)
proc write(out: ^Buf.Buf; dir, name, ext, text: []U8);
begin
    Buf.reset(out);
    Buf.str(out, dir); Buf.str(out, "/"); Buf.str(out, name); Buf.str(out, ext);
    if not Files.write(Buf.bytes(out), text) then Rt.stop("Doc: can't write an example"); end;
end;

(* The examples that are whole modules, each to dir: those of the
   report, between lines of ```, or of a manual page, between .Bd
   -literal and .Ed. In a page, a block that starts on the line after
   a module's is what that program prints, written to dir/Name.shown,
   so that the page can be checked against the program. *)
proc examples(path, dir: []U8);
var
    b, out, prog: Buf.Buf; s, line, first, last, name, shows: []U8;
    i, k, n, after: INT; inBlock, whole, page, fence: BOOL;
begin
    Buf.init(ADR(b), Heap.heap);
    Buf.init(ADR(out), Heap.heap);
    Buf.init(ADR(prog), Heap.heap);
    if not Files.read(path, ADR(b)) then Rt.stop("Doc: can't read the examples' file"); end;
    s := Buf.bytes(ADR(b));
    page := (LEN(path) < 3) or (path[LEN(path) - 3..LEN(path)] # ".md");
    inBlock := false;
    after := -1;
    i := 0;
    while i < LEN(s) do
        k := i;
        while (k < LEN(s)) and (s[k] # 10) do INC(k); end;
        line := s[i..k];
        fence := not page and (Str.trim(line) = "```");
        if inBlock and (fence or page and (line = ".Ed")) then
            if whole and Str.hasPrefix(first, "module ") and Str.hasPrefix(last, "end ") then
                name := first[7..LEN(first)];
                n := 0;
                while (n < LEN(name)) and Scan.isWord(name[n]) do INC(n); end;
                name := name[0..n];
                write(ADR(out), dir, name, ".raz", Buf.bytes(ADR(prog)));
                Out.str(name); Out.ln;
                after := k + 1;
            elsif LEN(shows) > 0 then
                write(ADR(out), dir, shows, ".shown", Buf.bytes(ADR(prog)));
            end;
            inBlock := false;
        elsif not inBlock and (fence or page and Str.hasPrefix(line, ".Bd -literal")) then
            inBlock := true;
            shows := "";
            if page and (i = after) then shows := name; end;
            Buf.reset(ADR(prog));
            first := ""; last := "";
            whole := true;
        elsif inBlock then
            addLine(ADR(prog), line, page);
            if Str.trim(line) = "..." then whole := false; end;
            if LEN(Str.trim(line)) > 0 then
                if LEN(first) = 0 then first := Str.trim(line); end;
                last := Str.trim(line);
            end;
        end;
        i := k + 1;
    end;
end;

(* raz-lib(3): the modules named from argument 2 on, under a head and
   above a tail of the page's own. *)
proc page;
var i: INT;
begin
    man := true;
    atStart := true;
    control(".\\\" raz-lib(3) - the library; made by tools/Doc.raz from lib/");
    Out.str(".Dd "); Out.str(Date); emit(10);
    control(".Dt RAZ-LIB 3");
    control(".Os");
    control(".Sh NAME");
    control(".Nm raz-lib");
    control(".Nd the library of the raz language");
    control(".Sh DESCRIPTION");
    control("The modules a raz program imports from");
    control(".Pa lib/ ,");
    control("beside the compiler, each as its source gives it: the module's own");
    control("comment, then every declaration it exports, as it is written, with");
    control("the comment just before it.");
    control("A module's");
    control(".Ic main ,");
    control("where it has one, is its test, and is left out.");
    control(".Pp");
    control("The report's second volume says what the library promises, and which");
    control("of its modules every target has.");
    control(".Sh MODULES");
    for i := 2 to ARGC() - 1 do document(Files.arg(i)); end;
    close;
    control(".Sh SEE ALSO");
    control(".Xr raz 1 ,");
    control(".Xr raz 7 ,");
    control(".Xr raz-tutorial 7 ;");
    control("the report,");
    control(".Pa doc/raz.md ,");
    control("and its second volume,");
    control(".Pa doc/raz-lib.md ,");
    control("in raz's sources.");
end;

proc main*;
begin
    if (ARGC() = 4) and (Files.arg(1) = "examples") then examples(Files.arg(2), Files.arg(3));
    elsif (ARGC() >= 3) and (Files.arg(1) = "man") then page;
    elsif ARGC() = 2 then document(Files.arg(1));
    else Rt.stop("usage: Doc Module.raz, Doc man Module.raz ..., or Doc examples file dir");
    end;
end;

end Doc.
