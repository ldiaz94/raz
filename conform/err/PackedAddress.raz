module PackedAddress;
(* A field of a packed record may be misaligned: it has no address,
   and no volatile access *)
type
    Header = packed record kind: U8; len: U32; tag: U8; vals: [2]U16; end;

proc put(var n: U32);
begin
    n := 1;
end;

proc main*;
var h: Header; p: ^U32; q: ^VOLATILE Header; k: ^U8; s: []U16;
begin
    p := ADR(h.len);
    put(h.len);
    s := h.vals[0..1];
    q := ADR(h);
    q^.len := 2;
    k := ADR(h.tag);
    h.len := 3;
end;

end PackedAddress.
