module ConstParam;
import Out;

type
    Big = record a: [100]INT; name: []U8; n: INT; end;
    Shape = variant circle(r: INT); rect(w, h: INT); end;

const Ten: Big = {n: 10, name: "ten"};

var g: Big;

proc sum(const b: Big): INT;
var i, s: INT;
begin
    s := b.n;
    for i := 0 to 99 do s := s + b.a[i]; end;
    return s;
end;

proc first(const s: []U8): U8;
begin
    return s[0];
end;

proc twice(const n: INT): INT;
begin
    return n * 2;
end;

proc seen(const b: Big; var w: Big): INT;   (* sees w's change: same variable *)
begin
    w.n := 77;
    return b.n;
end;

proc area(const s: Shape): INT;
begin
    match s of
    | circle(r): return 3 * r * r;
    | rect(w, h): return w * h;
    end;
end;

proc make(n: INT): Big;
var b: Big;
begin
    b.n := n;
    return b;
end;

proc label(const b: Big): []U8;
begin
    b.name[0] := 'T';     (* allowed: the bytes a slice in it points at *)
    return b.name;
end;

proc main*;
var b: Big; sh: Shape; buf: [3]U8; f: proc(const b: Big): INT;
begin
    b.a[5] := 3; b.n := 1;
    Out.int(sum(b)); Out.ln;
    Out.int(sum(Ten)); Out.ln;
    Out.int(sum(make(5))); Out.ln;
    Out.int(I64(first("hey"))); Out.ln;
    Out.int(twice(21)); Out.ln;
    Out.int(twice(b.n + 1)); Out.ln;
    Out.int(seen(b, b)); Out.ln;
    sh := rect(3, 4);
    Out.int(area(sh)); Out.ln;
    Out.int(area(circle(2))); Out.ln;
    buf := "abc"; b.name := buf[0..3];
    Out.str(label(b)); Out.ln;
    f := sum;
    Out.int(f(b)); Out.ln;
    g.n := 9;
    Out.int(sum(g)); Out.ln;
end;

end ConstParam.
