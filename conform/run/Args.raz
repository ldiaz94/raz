module Args;
import Out;
import SYSTEM;

proc main*: INT;
var i, n: INT; a: ^^U8; s: ^U8;
begin
    a := SYSTEM.ARGV();
    for i := 1 to ARGC() - 1 do
        s := a[i];
        n := 0;
        while s[n] # 0 do n := n + 1; end;
        Out.str(s[0..n]);
        Out.ln;
    end;
    return ARGC();
end;

end Args.
