(* Compiles procedures made by a fixed pseudo-random script of calls to
   Gen, valid by construction (an expression pushes its operands, then
   operates on them; a statement leaves the stack as it found it), then
   prints the bytes, the fixups, the line notes and the listing (raz -S)
   of what it made: self/Gen.raz's side of a test against the seed's,
   GenDump.pas, which makes and prints the same. With the argument dyn,
   the entry point is the dynamic one. *)
module GenDump;
import Out, Fmt, Diag, Scan, Sym, Chunk, X := X64, Gen;

const
    FirstProc = 3;     (* chunks 0 to 2 are Gen's own *)
    NumProcs = 80;
    FirstGlob = FirstProc + NumProcs;
    NumGlobs = 4;
    Arith: [10]Scan.Sym = [Scan.sPlus, Scan.sMinus, Scan.sTimes, Scan.sDiv, Scan.sMod,
        Scan.sAmp, Scan.sBar, Scan.sXor, Scan.sShl, Scan.sShr];
    Cmps: [6]Scan.Sym = [Scan.sEql, Scan.sNeq, Scan.sLss, Scan.sLeq, Scan.sGtr, Scan.sGeq];
    RealOps: [4]Scan.Sym = [Scan.sPlus, Scan.sMinus, Scan.sTimes, Scan.sSlash];

var
    seed: I64;
    slots: [6]I64;           (* frame slots of the procedure *)
    regs: [5]INT;            (* the registers of variables it keeps *)
    numRegs: INT;
    xregs: [4]INT;           (* ... of reals, as numbered from XmmVar *)
    numX: INT;
    tuple2, tuple3, record3, sliceT: ^Sym.Type;
    results: [9]^Sym.Type;
    curRes: INT;             (* the procedure's result: an index of results *)

proc rnd(n: INT): INT;
begin
    seed := (seed * 1103515245 + 12345) & 7FFFFFFFH;
    return INT((seed shr 8) mod I64(n));
end;

proc pos: Diag.Pos;
var p: Diag.Pos;
begin
    p.f := 0; p.a := rnd(400); p.b := p.a + 1;
    return p;
end;

(* a size of 1, 2, 4 or 8 bytes *)
proc size: INT;
begin
    return 1 shl rnd(4);
end;

(* a slot of the procedure's frame *)
proc slot: I64;
begin
    return slots[rnd(6)];
end;

proc bit(f: BOOL): INT;
begin
    if f then return 1; end;
    return 0;
end;

proc flag: BOOL;
begin
    return rnd(2) = 0;
end;

proc constVal: I64;
var x: INT; r: I64;
begin
    x := rnd(1 shl 30);
    match rnd(7) of
    | 0: r := x mod 10;
    | 1: r := -(x mod 100);
    | 2: r := I64(1) shl (x mod 20);
    | 3: r := x;
    | 4: r := I64(x) * 4096 * 4096 * 9 - 7;
    | 5: r := -I64(x) * 8;
    | else: r := x mod 1000 - 500;
    end;
    return r;
end;

proc newObjs(t: ^Sym.Type; n: INT): ^Sym.Obj;
var first, o, last: ^Sym.Obj; i: INT;
begin
    first := nil; last := nil;
    for i := 0 to n - 1 do
        o := Sym.newObj(Sym.oVar, 0, t);
        o^.val := 8 * i;
        if last = nil then first := o; else last^.next := o; end;
        last := o;
    end;
    return first;
end;

proc makeTypes;
begin
    tuple2 := Sym.newType(Sym.fRecord, 16, 8);
    tuple2^.tuple := true; tuple2^.len := 2; tuple2^.fields := newObjs(Sym.tInt, 2);
    tuple3 := Sym.newType(Sym.fRecord, 24, 8);
    tuple3^.tuple := true; tuple3^.len := 3; tuple3^.fields := newObjs(Sym.tInt, 3);
    record3 := Sym.newType(Sym.fRecord, 24, 8);
    record3^.fields := newObjs(Sym.tReal, 3);
    sliceT := Sym.newType(Sym.fSlice, 16, 8);
    sliceT^.base := Sym.tU8;
    results[0] := nil;
    results[1] := Sym.tInt;
    results[2] := Sym.tReal;
    results[3] := sliceT;
    results[4] := tuple2;
    results[5] := tuple3;
    results[6] := Sym.tF32;
    results[7] := Sym.tI16;
    results[8] := record3;
end;

(* Variables *)

(* the address of a variable of the procedure that has one: in the frame,
   a chunk, or a slot holding its address *)
proc memAdr: Gen.Adr;
var a: Gen.Adr; c: INT;
begin
    c := rnd(3);
    if c = 0 then
        a.base := Gen.bFrame; a.chunk := 0; a.hi := 0; a.off := slot(); if flag() then a.off := a.off + 8; end;
    elsif c = 1 then
        a.base := Gen.bGlobal; a.chunk := FirstGlob + rnd(NumGlobs); a.hi := 0; a.off := 8 * rnd(3);
    else
        a.base := Gen.bSlot; a.chunk := INT(slot()); a.hi := 0; a.off := 8 * rnd(3);
    end;
    return a;
end;

(* an address that can go on the stack: frame or chunk *)
proc pushableAdr: Gen.Adr;
var a: Gen.Adr;
begin
    a.chunk := 0; a.hi := 0;
    if flag() then
        a.base := Gen.bFrame; a.off := slot(); if flag() then a.off := a.off + 8; end;
    else
        a.base := Gen.bGlobal; a.chunk := FirstGlob + rnd(NumGlobs); a.off := 8 * rnd(3);
    end;
    return a;
end;

proc regAdr(r: INT): Gen.Adr;
var a: Gen.Adr;
begin
    a.base := Gen.bReg; a.chunk := r; a.hi := 0; a.off := 0;
    return a;
end;

proc stackAdr: Gen.Adr;
var a: Gen.Adr;
begin
    a.base := Gen.bStack; a.chunk := 0; a.hi := 0; a.off := 8 * rnd(3);
    return a;
end;

proc pushIntVar;
var a: Gen.Adr; sz: INT; c: INT;
begin
    sz := size();
    c := rnd(5);
    if (c = 0) and (numRegs > 0) then
        if flag() then Gen.setInPlace(regs[rnd(numRegs)]); end;
        Gen.pushVar(regAdr(regs[rnd(numRegs)]), 8, false, Gen.kWord);
    elsif c = 1 then
        Gen.pushAdr(pushableAdr());
        a := stackAdr();
        Gen.pushVar(a, sz, flag(), Gen.kWord);
    else
        a := memAdr();
        Gen.pushVar(a, sz, flag(), Gen.kWord);
    end;
end;

proc intExpr(b: INT); forward;
proc realExpr(k: Gen.Kind; b: INT); forward;
proc callExpr(want, b: INT); forward;

proc realKind: Gen.Kind;
begin
    if flag() then return Gen.kF64; end;
    return Gen.kF32;
end;

proc intExpr(b: INT);
var c, sz, n: INT; sg, f: BOOL; k: Gen.Kind; sy: Scan.Sym; a: Gen.Adr;
begin
    if b > 0 then c := rnd(14); else c := rnd(3); end;
    match c of
    | 0: Gen.pushConst(Gen.kWord, constVal());
    | 1: pushIntVar();
    | 2: pushIntVar();
    | 3, 4, 5:
        intExpr(b - 1); intExpr(b - 1);
        sy := Arith[rnd(10)]; sz := size(); sg := flag();
        Gen.op(sy, Gen.kWord, sz, sg);
    | 6:
        if flag() then
            intExpr(b - 1); intExpr(b - 1);
            sy := Cmps[rnd(6)]; sg := flag();
            Gen.compare(sy, Gen.kWord, sg);
        else
            k := realKind();
            realExpr(k, b - 1); realExpr(k, b - 1);
            sy := Cmps[rnd(6)];
            Gen.compare(sy, k, false);
        end;
    | 7:
        intExpr(b - 1);
        n := rnd(4); sz := size(); sg := flag();
        if n = 0 then Gen.neg(Gen.kWord, sz, sg);
        elsif n = 1 then Gen.complement(sz, sg);
        elsif n = 2 then Gen.notBool();
        else Gen.narrow(sz, sg); end;
    | 8:
        (* an element of an array in the frame or a chunk *)
        intExpr(b - 1);
        a := pushableAdr();
        sz := size(); sg := flag();
        n := 10 + rnd(100);
        Gen.checkIndex(n, pos());
        Gen.indexArray(a, sz);
        a := stackAdr(); a.off := 0;
        Gen.pushVar(a, sz, sg, Gen.kWord);
    | 9:
        (* an element of a slice, in a frame slot or on the stack, or in registers *)
        n := rnd(3);
        sz := size(); sg := flag();
        if n = 0 then
            a := memAdr();
            if a.base = Gen.bGlobal then a.base := Gen.bFrame; end;
            intExpr(b - 1);
            f := flag();
            Gen.indexSlice(a, sz, f, pos());
        elsif n = 1 then
            Gen.pushAdr(pushableAdr());
            intExpr(b - 1);
            a := stackAdr(); a.off := 0;
            f := flag();
            Gen.indexSlice(a, sz, f, pos());
        else
            a.base := Gen.bReg; a.chunk := X.R13; a.hi := X.R14; a.off := 0;
            intExpr(b - 1);
            f := flag();
            Gen.indexSlice(a, sz, f, pos());
        end;
        a := stackAdr(); a.off := 0;
        Gen.pushVar(a, sz, sg, Gen.kWord);
    | 10:
        k := realKind();
        realExpr(k, b - 1);
        Gen.realToInt(k);
    | 11: callExpr(1, b - 1);
    | 12:
        (* x + 1, and the offset noted on a word *)
        intExpr(b - 1);
        Gen.pushConst(Gen.kWord, rnd(100) - 50);
        Gen.op(Scan.sPlus, Gen.kWord, 8, false);
    | else:
        intExpr(b - 1);
        Gen.pushConst(Gen.kWord, constVal());
        sy := Arith[rnd(10)]; sz := size(); sg := flag();
        Gen.op(sy, Gen.kWord, sz, sg);
    end;
end;

proc realExpr(k: Gen.Kind; b: INT);
var c, n: INT; sy: Scan.Sym; a: Gen.Adr; k2: Gen.Kind; v: I64;
begin
    if b > 0 then c := rnd(9); else c := rnd(3); end;
    match c of
    | 0:
        n := rnd(4);
        if n = 0 then v := 3FF0000000000000H;
        elsif n = 1 then v := 4000000000000000H;
        elsif n = 2 then v := 0;
        else v := 3FE0000000000000H; end;
        Gen.pushConst(k, v);
    | 1:
        a := memAdr();
        if k = Gen.kF32 then Gen.pushVar(a, 4, false, k); else Gen.pushVar(a, 8, false, k); end;
    | 2:
        if numX > 0 then
            if flag() then Gen.setInPlace(xregs[rnd(numX)]); end;
            Gen.pushVar(regAdr(xregs[rnd(numX)]), 8, false, k);
        else
            Gen.pushAdr(pushableAdr());
            a := stackAdr();
            Gen.pushVar(a, 8, false, k);
        end;
    | 3, 4:
        realExpr(k, b - 1); realExpr(k, b - 1);
        sy := RealOps[rnd(4)];
        Gen.op(sy, k, 8, false);
    | 5:
        intExpr(b - 1);
        Gen.intToReal(k, flag());
    | 6:
        realExpr(k, b - 1);
        Gen.neg(k, 8, false);
    | 7:
        if k = Gen.kF32 then k2 := Gen.kF64; else k2 := Gen.kF32; end;
        realExpr(k2, b - 1);
        Gen.realToReal(k2);
    | else: callExpr(2, b - 1);
    end;
end;

(* A call of one of the procedures, with arguments of all kinds. want: 0
   for a statement, any result; 1 an integer is left on the stack, 2 a
   real. *)
proc callExpr(want, b: INT);
var
    c: Gen.CallInfo; sig: ^Sym.Type; i, n, kind, r, ni: INT; k: Gen.Kind;
begin
    sig := Sym.newType(Sym.fProc, 8, 8);
    sig^.variadic := rnd(5) = 0;
    if want = 1 then
        r := rnd(5);
        if r = 0 then sig^.base := Sym.tBool;
        elsif r = 1 then sig^.base := Sym.tI8;
        elsif r = 2 then sig^.base := Sym.tU32;
        elsif r = 3 then sig^.base := tuple2;
        else sig^.base := Sym.tInt; end;
    elsif want = 2 then
        if flag() then sig^.base := Sym.tReal; else sig^.base := Sym.tF32; end;
    else
        sig^.base := results[rnd(9)];
    end;
    c.sig := sig; c.param := nil; c.obj := nil; c.ext := rnd(4) = 0;
    c.n := 0; c.target := 0;
    c.chunk := FirstProc + rnd(NumProcs);
    if rnd(5) = 0 then c.chunk := -1; c.ext := false; c.target := slot(); end;
    n := rnd(8);
    for i := 0 to n - 1 do
        kind := rnd(4);
        if kind = 0 then
            k := realKind();
            realExpr(k, b);
            c.isF[c.n] := true; c.pair[c.n] := false;
            INC(c.n);
        elsif kind = 1 then
            intExpr(b); intExpr(b);
            c.isF[c.n] := false; c.pair[c.n] := true;
            c.isF[c.n + 1] := false; c.pair[c.n + 1] := false;
            INC(c.n, 2);
        else
            intExpr(b);
            c.isF[c.n] := false; c.pair[c.n] := false;
            INC(c.n);
        end;
    end;
    Gen.call(c);
    (* what comes back: a value or two, or nothing, or a temporary *)
    ni := 0;
    if sig^.base # nil then
        if sig^.base^.form = Sym.fSlice then ni := 0;
        elsif sig^.base = tuple2 then ni := 2;
        elsif Sym.behindPointer(sig^.base) then ni := 0;
        else ni := 1; end;
    end;
    if want = 0 then
        for i := 1 to ni do Gen.drop(); end;
    elsif ni = 2 then
        Gen.drop();   (* the second; the first is the value *)
    end;
end;

(* A condition, left as a BOOL on the stack *)
proc boolExpr(b: INT);
var sy: Scan.Sym; sg: BOOL;
begin
    if flag() then
        intExpr(b); intExpr(b);
        sy := Cmps[rnd(6)]; sg := flag();
        Gen.compare(sy, Gen.kWord, sg);
    else
        intExpr(b);
    end;
end;

proc stmt(b: INT); forward;

(* a variable assigned the value on top: its address, if on the stack,
   having been pushed first *)
proc assign(b: INT);
var a: Gen.Adr; c, sz: INT; k: Gen.Kind;
begin
    c := rnd(6);
    sz := size();
    if c = 0 then
        a := memAdr();
        intExpr(b);
        Gen.popVar(a, sz);
    elsif c = 1 then
        Gen.pushAdr(pushableAdr());
        a := stackAdr();
        intExpr(b);
        Gen.popVar(a, sz);
    elsif (c = 2) and (numRegs > 0) then
        a := regAdr(regs[rnd(numRegs)]);
        Gen.setInPlace(a.chunk);
        Gen.pushVar(a, 8, false, Gen.kWord);
        intExpr(b);
        Gen.op(Arith[rnd(3)], Gen.kWord, 8, false);
        Gen.popVar(a, 8);
    elsif (c = 3) and (numX > 0) then
        k := realKind();
        a := regAdr(xregs[rnd(numX)]);
        realExpr(k, b);
        Gen.popVar(a, 8);
    elsif c = 4 then
        k := realKind();
        a := memAdr();
        realExpr(k, b);
        if k = Gen.kF32 then Gen.popVar(a, 4); else Gen.popVar(a, 8); end;
    else
        a := memAdr();
        Gen.pushConst(Gen.kWord, constVal());
        Gen.popVar(a, sz);
    end;
end;

proc retStmt(b: INT);
var i: INT;
begin
    if curRes = 1 then intExpr(b);
    elsif curRes = 7 then intExpr(b);
    elsif curRes = 2 then realExpr(Gen.kF64, b);
    elsif curRes = 6 then realExpr(Gen.kF32, b);
    elsif (curRes = 3) or (curRes = 4) then intExpr(b); intExpr(b);
    elsif curRes = 5 then
        for i := 0 to 2 do intExpr(b); Gen.resultTo(8 * i, 8); end;
    elsif curRes = 8 then
        Gen.pushAdr(pushableAdr());
        Gen.copyResult(0, 24);
    end;
    Gen.returnJump();
end;

proc stmt(b: INT);
var
    c, n, lo, i, start, saved, sz, tmp: INT; L, E, S, fj, tj: INT; a, a2: Gen.Adr; sy: Scan.Sym; sg: BOOL;
    mk: I64; f: BOOL;
begin
    mk := Gen.tempMark();
    if b <= 0 then c := rnd(4); else c := rnd(22); end;
    match c of
    | 0, 1, 2, 3: assign(b);
    | 4:
        (* if cond then s end *)
        L := Gen.NoLabel;
        boolExpr(b);
        Gen.jumpIf(L, false);
        stmt(b - 1);
        Gen.fix(L);
    | 5:
        (* while cond do s end *)
        L := Gen.NoLabel;
        Gen.alignLoop();
        start := Chunk.pc;
        boolExpr(b);
        Gen.jumpIf(L, false);
        stmt(b - 1);
        Gen.jumpBack(start);
        Gen.fix(L);
    | 6:
        (* if a < b then s end, with a jump on the comparison *)
        L := Gen.NoLabel;
        intExpr(b); intExpr(b);
        sy := Cmps[rnd(6)]; sg := flag();
        if flag() then Gen.jumpCmp(sy, sg, L); else Gen.jumpOut(sy, sg, L); end;
        stmt(b - 1);
        Gen.fix(L);
    | 7:
        (* v := a < b and c, a condition worked out into a BOOL *)
        fj := Gen.NoLabel; tj := Gen.NoLabel;
        intExpr(b); intExpr(b);
        sy := Cmps[rnd(6)]; sg := flag();
        Gen.condValue(sy, sg, fj, tj);
        a := memAdr();
        Gen.popVar(a, 1);
    | 8: callExpr(0, b);
    | 9:
        (* a match through a jump table *)
        a := memAdr();
        if a.base = Gen.bSlot then a.base := Gen.bFrame; a.off := slots[0]; end;
        intExpr(b);
        Gen.popVar(a, 8);
        E := Gen.NoLabel;
        n := 2 + rnd(4); lo := rnd(5) - 2;
        if flag() then S := Gen.NoLabel; else S := Chunk.pc; end;
        start := Gen.jumpTable(a.off, lo, n, S, E);
        for i := 0 to n - 1 do Gen.tableEntry(start, Chunk.pc + 4 * (n - i)); end;
        for i := 0 to n - 1 do
            stmt(b - 1);
        end;
        Gen.fix(E);
    | 10:
        Gen.pushAdr(pushableAdr()); Gen.pushAdr(pushableAdr());
        n := 1 + rnd(150); lo := 8 * rnd(3);
        Gen.copyBlock(n, lo);
    | 11:
        Gen.pushAdr(pushableAdr());
        a := memAdr();
        if flag() and (numRegs > 1) then
            a.base := Gen.bReg; a.chunk := regs[0]; a.hi := regs[1]; a.off := 0;
        end;
        n := 1 + rnd(150);
        Gen.copyTo(a, n);
    | 12:
        a := memAdr();
        n := 1 + rnd(100);
        Gen.zeroVar(a, n);
    | 13:
        (* a slice of an array, of a slice, of a pointer *)
        tmp := INT(Gen.allocTemp(16, 8));
        n := rnd(3);
        sz := size(); sg := flag();
        if n = 0 then
            a := pushableAdr();
            Gen.pushAdr(a); intExpr(b); intExpr(b);
            a := stackAdr(); a.off := 0;
            f := flag(); n := 10 + rnd(50);
            Gen.slice(a, f, n, sz, tmp, sg, pos());
        elsif n = 1 then
            a := memAdr();
            if a.base = Gen.bGlobal then a.base := Gen.bFrame; end;
            intExpr(b); intExpr(b);
            Gen.slice(a, false, 0, sz, tmp, sg, pos());
        else
            intExpr(b); intExpr(b); intExpr(b);
            Gen.slicePtr(sz, tmp, sg, pos());
        end;
    | 14:
        a.off := slot(); a2.off := slot(); sz := size(); f := flag();
        Gen.copySlice(a.off, a2.off, sz, f, pos());
    | 15:
        n := rnd(4); sz := size(); sg := flag();
        if n = 0 then
            Gen.pushAdr(pushableAdr()); intExpr(b);
            f := flag();
            Gen.incDec(sz, sg, f);
        elsif (n = 1) and (numRegs > 0) then
            intExpr(b);
            Gen.incDecReg(regs[0], sz, sg, flag());
        elsif n = 2 then
            intExpr(b);
            n := 3 + rnd(6); lo := FirstGlob + rnd(NumGlobs);
            Gen.checkEnum(n, lo, pos());
            Gen.drop();
        else
            intExpr(b);
            n := rnd(8000);
            Gen.checkNil(n, pos());
            Gen.drop();
        end;
    | 16:
        n := rnd(3);
        if n = 0 then
            a.off := slot(); a2.off := slot(); n := rnd(4); f := flag();
            Gen.compareSeq(a.off, a2.off, n, f);
            Gen.drop();
        elsif n = 1 then
            intExpr(b);
            Gen.errorText(Gen.allocTemp(16, 8));
        else
            intExpr(b);
            n := 1 + rnd(200);
            Gen.zeroNew(n);
            Gen.drop();
        end;
    | 17:
        n := rnd(3);
        if n = 0 then
            intExpr(b); intExpr(b); intExpr(b);
            Gen.atomic(Sym.bCas);
        elsif n = 1 then
            intExpr(b); intExpr(b);
            Gen.atomic(Sym.bXchg);
        else
            intExpr(b); intExpr(b);
            Gen.atomic(Sym.bXadd);
        end;
        Gen.drop();
    | 18:
        n := rnd(7);
        for i := 1 to n do intExpr(b); end;
        Gen.sysCall(n);
        Gen.drop();
        if flag() then Gen.fence(); end;
    | 19:
        (* defer s *)
        L := Gen.NoLabel;
        start, saved := Gen.deferBegin(L);
        stmt(b - 1);
        Gen.deferEnd(L, saved);
        Gen.runDefer(start);
    | 20:
        if curRes # 0 then retStmt(b); else assign(b); end;
    | else:
        if curRes # 0 then
            Gen.tryAlign();
            Gen.tryReturn(slot());
        else
            assign(b);
        end;
    end;
    Gen.releaseTemps(mk);
end;

(* Each statement may be preceded by a few that are made and taken back,
   as the parser does when it compiles a body a second time *)
proc genProc(c: INT);
var
    sig: ^Sym.Type; params, p, last: ^Sym.Obj; i, n, kind, mask, j, ns, line: INT; t: ^Sym.Type;
    mk: Gen.CodeMark; open: BOOL;
begin
    sig := Sym.newType(Sym.fProc, 8, 8);
    curRes := rnd(9);
    sig^.base := results[curRes];
    params := nil; last := nil;
    n := rnd(8);
    for i := 0 to n - 1 do
        kind := rnd(5);
        if kind = 0 then t := Sym.tReal;
        elsif kind = 1 then t := sliceT;
        elsif kind = 2 then t := Sym.tI32;
        else t := Sym.tInt; end;
        p := Sym.newObj(Sym.oVar, 0, t);
        p^.param := true;
        p^.isVar := kind = 4;
        if last = nil then params := p; else last^.next := p; end;
        last := p;
    end;
    Gen.beginProc(sig, params);
    for i := 0 to 5 do slots[i] := Gen.allocPerm(8, 8); end;
    mask := rnd(32);
    j := rnd(16);
    mask := mask | (j shl Gen.XBit);
    if rnd(3) = 0 then mask := 0; end;
    numRegs := 0; numX := 0;
    for j := 0 to 4 do
        if (mask & (1 shl j)) # 0 then regs[numRegs] := Gen.VarRegs[j]; INC(numRegs); end;
    end;
    for j := 0 to 3 do
        if (mask & (1 shl (Gen.XBit + j))) # 0 then
            xregs[numX] := Gen.XVarRegs[j]; INC(numX);
            Gen.xHome(Gen.XVarRegs[j], Gen.allocPerm(8, 8));
        end;
    end;
    (* some parameters live in registers: a register variable's, or kept
       where they arrived *)
    j := 0;
    p := params;
    while p # nil do
        if (p^.typ = Sym.tInt) and (not p^.isVar) and (j < numRegs) and flag() then
            p^.reg := regs[j]; INC(j);
        elsif (p^.typ = Sym.tReal) and (numX > 0) and flag() then
            p^.reg := xregs[0];
        elsif flag() then
            Gen.keepArrived(p);
        end;
        p := p^.next;
    end;
    Gen.useRegs(mask);
    line := 1 + rnd(40);
    Gen.enterBody(c, line);
    Gen.markCode(mk);
    (* a body made and taken back *)
    if flag() then
        stmt(2);
        Gen.rewind(mk);
        Gen.redo(mk);   (* the jumps to the exit went with the code *)
    end;
    ns := 2 + rnd(8);
    for i := 1 to ns do stmt(3); end;
    open := flag() and (sig^.base # nil);
    if (sig^.base # nil) and (not open) then retStmt(2); end;
    _ := Gen.endProc(c, open);
    Fmt.print("proc {} lost {} regs {} saves {} at {}\n", [Fmt.int(c), Fmt.int(bit(Gen.lost)), Fmt.int(mask),
        Fmt.int(Chunk.chunks[c].saveMask), Fmt.int(Chunk.chunks[c].saveAt)]);
end;

(* The name p0, p1, ... of chunk i, interned *)
proc chunkNameOf(i: INT): INT;
var s: [3]U8;
begin
    s[0] := 'p'; s[1] := U8(48 + i div 10); s[2] := U8(48 + i mod 10);
    return Scan.intern(ADR(s[0]), 3);
end;

proc main*;
var i, c: INT; path: []U8; links: [2]Gen.Link; entry: INT; dyn: BOOL;
begin
    seed := 5;
    path := "lib/Rt.raz";
    if LEN(Scan.open(path)) # 0 then Diag.fatal("no file"); end;
    dyn := ARGC > 1;
    X.setListing(true);
    Chunk.setCurFile(Scan.intern(ADR(path[0]), LEN(path)));
    for i := 0 to NumProcs - 1 do c := Chunk.newChunk(Chunk.secText, -1, chunkNameOf(i)); Chunk.setLive(c); end;
    for i := 0 to NumGlobs - 1 do
        c := Chunk.newChunk(Chunk.secBss, -1, chunkNameOf(NumProcs + i));
        Chunk.setBss(c, 64, 8);
    end;
    makeTypes();
    for i := 0 to NumProcs - 1 do genProc(FirstProc + i); end;
    links[0].chunk := FirstProc; links[0].into := FirstGlob;
    links[1].chunk := FirstProc + 1; links[1].into := FirstGlob + 1;
    entry := Gen.entryPoint(dyn, nil, nil, FirstProc + 2, FirstProc + 3, links, 2);
    Fmt.print("entry {} pc {} fixups {} lines {} said {}\n", [Fmt.int(entry), Fmt.int(Chunk.pc),
        Fmt.int(Chunk.numFixups), Fmt.int(Chunk.numLines), Fmt.int(X.saidCount())]);
    for i := 0 to Chunk.pc - 1 do Out.hex(U64(Chunk.text[i]), 2); end;
    Out.ln;
    for i := 0 to Chunk.numFixups - 1 do
        Fmt.print("F {} {} {}\n", [Fmt.int(Chunk.fixups[i].at), Fmt.int(Chunk.fixups[i].chunk), Fmt.int(Chunk.fixups[i].addend)]);
    end;
    for i := 0 to Chunk.numLines - 1 do
        Fmt.print("L {} {} {} {}\n", [Fmt.int(Chunk.lines[i].at), Fmt.int(Chunk.lines[i].chunk),
            Fmt.int(Chunk.lines[i].line), Fmt.int(Chunk.lines[i].col)]);
    end;
    X.list(-1);
end;

end GenDump.
