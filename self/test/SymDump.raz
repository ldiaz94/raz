(* Builds types and objects by a fixed pseudo-random script, asks of them
   what the parser asks of Sym, and prints the answers: self/Sym.raz's
   side of a test against the seed's, SymDump.pas, which prints the same.
   With the argument dup or deep it ends in the error of a name declared
   twice, or of too many scopes. *)
module SymDump;
import Out, Fmt, Files, Heap, Diag, Scan, Sym;

const
    Words: [20][]U8 = ["alpha", "alpho", "beta", "bet", "gamma", "gama", "delta", "Delta",
        "eps", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu", "nu", "xi", "omicron", "pi"];

var
    seed: I64;
    names: [20]INT;
    mods: [3]^Sym.Module;
    base: [12]^Sym.Type;
    pool: [300]^Sym.Type;
    objs: [300]^Sym.Obj;
    classes: [8]Sym.Class;
    numPool, numObjs: INT;

proc rnd(n: INT): INT;
begin
    seed := (seed * 1103515245 + 12345) & 7FFFFFFFH;
    return INT((seed shr 8) mod I64(n));
end;

proc bit(f: BOOL): INT;
begin
    if f then return 1; end;
    return 0;
end;

proc nm(i: INT): []U8;
begin
    return Scan.nameOf(names[i]);
end;

(* The result of a call that must succeed *)
proc ok(e: ERROR);
begin
    if e # nil then Diag.finish; end;
end;

proc fields(m: INT; allowVar: BOOL): ^Sym.Obj;
var f, first, last: ^Sym.Obj; j, x, y, z: INT;
begin
    first := nil; last := nil;
    for j := 1 to m do
        x := rnd(20); y := rnd(numPool);
        f := Sym.newObj(Sym.oField, names[x], pool[y]);
        z := rnd(2); f^.exported := z = 0;
        z := rnd(3); f^.isVar := allowVar and (z = 0);
        f^.val := j * 8;
        if first = nil then first := f; else last^.next := f; end;
        last := f;
    end;
    return first;
end;

proc add(t: ^Sym.Type);
begin
    if numPool < 300 then pool[numPool] := t; INC(numPool); end;
end;

proc makeType;
var t: ^Sym.Type; r, m, x: INT; f: ^Sym.Obj;
begin
    r := rnd(11);
    match r of
    | 0: t := Sym.newType(Sym.fPtr, 8, 8);
    | 1: t := Sym.newType(Sym.fArray, 0, 1);
    | 2: t := Sym.newType(Sym.fSlice, 16, 8);
    | 3: t := Sym.newType(Sym.fRecord, 0, 8);
    | 4: t := Sym.newType(Sym.fProc, 8, 8);
    | 5: t := Sym.newType(Sym.fSet, 8, 8);
    | 6: t := Sym.newType(Sym.fVariant, 16, 8);
    | 7: t := Sym.newType(Sym.fEnum, 1, 1);
    | 8: t := Sym.newType(Sym.fRecord, 16, 8);
    | 9: t := Sym.newType(Sym.fProc, 8, 8);
    | else: t := Sym.newType(Sym.fPtr, 8, 8);
    end;
    x := rnd(numPool); t^.base := pool[x];
    t^.len := rnd(5);
    x := rnd(4); t^.vol := x = 0;
    x := rnd(4); t^.variadic := (t^.form = Sym.fProc) and (x = 0);
    x := rnd(2); t^.tuple := (t^.form = Sym.fRecord) and (x = 0);
    if (t^.form = Sym.fRecord) or (t^.form = Sym.fProc) or (t^.form = Sym.fVariant) then
        m := rnd(4);
        t^.fields := fields(m, t^.form = Sym.fProc);
        t^.len := m;
        if t^.form = Sym.fRecord then t^.base := nil; end;
        x := rnd(2);
        if (t^.form = Sym.fProc) and (x = 0) then t^.base := nil; end;
        if t^.form = Sym.fVariant then
            f := t^.fields;
            while f # nil do
                f^.cls := Sym.oCase;
                x := rnd(3); f^.fields := fields(x, false);
                f := f^.next;
            end;
        end;
    end;
    x := rnd(3);
    if x = 0 then
        x := rnd(20); t^.obj := Sym.newObj(Sym.oType, names[x], t);
        x := rnd(3); t^.obj^.home := mods[x];
    end;
    add(t);
end;

proc main*;
var
    i, k, op, x, y, z, n, d: INT; t, o2: ^Sym.Type; o: ^Sym.Obj; v: I64;
    saved: [Sym.MaxDepth]INT; arg: []U8;
begin
    seed := 11;
    classes := [Sym.oConst, Sym.oType, Sym.oVar, Sym.oProc, Sym.oModule, Sym.oField, Sym.oCase, Sym.oBuiltin];
    for i := 0 to 19 do names[i] := Scan.intern(ADR(Words[i][0]), LEN(Words[i])); end;
    for i := 0 to 2 do
        NEW(mods[i], Heap.heap);
        mods[i]^.sname := names[i * 5];
    end;
    Sym.setCurModule(mods[0]);
    base[0] := Sym.tI8; base[1] := Sym.tI16; base[2] := Sym.tI32; base[3] := Sym.tI64; base[4] := Sym.tU8;
    base[5] := Sym.tU16; base[6] := Sym.tU32; base[7] := Sym.tU64; base[8] := Sym.tBool; base[9] := Sym.tF32;
    base[10] := Sym.tReal; base[11] := Sym.tInt;
    for i := 0 to 11 do add(base[i]); end;
    arg := "";
    if ARGC > 1 then arg := Files.arg(1); end;
    if LEN(arg) > 0 then
        if LEN(Scan.open("lib/Rt.raz")) # 0 then Diag.fatal("no file"); end;
        Scan.next; Scan.next;
    end;
    numObjs := 0;
    for k := 1 to 4000 do
        op := rnd(14);
        match op of
        | 0, 1, 2: makeType;
        | 3, 4:
            if numObjs < 300 then
                x := rnd(8); y := rnd(20);
                if Sym.find(x, names[y]) = nil then
                    z := rnd(8); n := rnd(numPool);
                    o := Sym.newObj(classes[z], names[y], pool[n]);
                    z := rnd(2); o^.exported := z = 0;
                    z := rnd(3); o^.home := mods[z];
                    ok(Sym.insert(o, x));
                    objs[numObjs] := o; INC(numObjs);
                    Fmt.print("I {} {} {}\n", [Fmt.int(x), Fmt.str(nm(y)), Fmt.int(o^.scope)]);
                end;
            end;
        | 5:
            x := rnd(8); y := rnd(20); o := Sym.find(x, names[y]);
            Fmt.print("F {} {} ", [Fmt.int(x), Fmt.str(nm(y))]);
            if o = nil then Out.str("-\n");
            else Fmt.print("{} {}\n", [Fmt.int(INT(o^.cls)), Fmt.int(o^.scope)]); end;
        | 6:
            x := rnd(8); y := rnd(20);
            if Sym.scopeDepth() < 6 then ok(Sym.openScope(x)); end;
            o := Sym.lookup(names[y]);
            Fmt.print("L {} {} ", [Fmt.int(Sym.scopeDepth()), Fmt.str(nm(y))]);
            if o = nil then Out.str("-\n");
            else Fmt.print("{} {}\n", [Fmt.int(INT(o^.cls)), Fmt.int(o^.scope)]); end;
            z := rnd(2);
            if (Sym.scopeDepth() > 1) and (z = 0) then Sym.closeScope; end;
        | 7:
            y := rnd(20); x := rnd(9) - 1; z := rnd(3); Sym.setCurModule(mods[z]);
            o := Sym.closest(names[y], x);
            Fmt.print("C {} {} ", [Fmt.str(nm(y)), Fmt.int(x)]);
            if o = nil then Out.str("-\n");
            else Fmt.print("{} {}\n", [Fmt.str(Scan.nameOf(o^.name)), Fmt.int(o^.scope)]); end;
        | 8:
            x := rnd(numPool); z := rnd(3); Sym.setCurModule(mods[z]);
            Fmt.print("T {}\n", [Fmt.str(Sym.typeName(pool[x]))]);
        | 9:
            x := rnd(numPool); y := rnd(numPool);
            Fmt.print("S {} {}\n", [Fmt.int(bit(Sym.same(pool[x], pool[y]))), Fmt.int(bit(Sym.same(pool[x], pool[x])))]);
            t := Sym.newType(Sym.fPtr, 8, 8); t^.base := pool[x];
            o2 := t; t := Sym.newType(Sym.fPtr, 8, 8); t^.base := pool[x];
            Fmt.print("S {}\n", [Fmt.int(bit(Sym.same(o2, t)))]);
        | 10:
            if numObjs > 0 then
                x := rnd(numObjs);
                Out.str("P "); Out.hex(Sym.fingerprint(objs[x]), 16); Out.ln;
            end;
        | 11:
            x := rnd(numPool); y := rnd(1 shl 20); z := rnd(2); n := rnd(2);
            v := I64(y) * 4096 * I64(z) - I64(y) * I64(n);
            t := pool[x];
            Fmt.print("B {} {} {} {} {} {} {}\n", [Fmt.int(bit(Sym.fits(v, t))), Fmt.int(bit(Sym.isInt(t))),
                Fmt.int(bit(Sym.isScalar(t))), Fmt.int(bit(Sym.isAggregate(t))), Fmt.int(bit(Sym.inTwoRegs(t))),
                Fmt.int(bit(Sym.behindPointer(t))), Fmt.int(Sym.alignUp(y, 1 shl z))]);
        | 12:
            if (Sym.scopeDepth() > 1) and (Sym.scopeDepth() < 6) then
                d := Sym.saveScopes(saved);
                Fmt.print("V {} {}\n", [Fmt.int(Sym.scopeDepth()), Fmt.int(Sym.topScope())]);
                Sym.restoreScopes(d, saved);
                Fmt.print("V {} {}\n", [Fmt.int(Sym.scopeDepth()), Fmt.int(Sym.topScope())]);
                x := Sym.newScope();
                Fmt.print("N {}\n", [Fmt.int(x)]);
            end;
        | else:
            x := Sym.scopeDepth();
            if x > 3 then Sym.cutScopes(2); end;
            Fmt.print("X {} {}\n", [Fmt.int(x), Fmt.int(Sym.scopeDepth())]);
        end;
    end;
    for i := 0 to 11 do
        Fmt.print("U {} {} {} {}\n", [Fmt.int(INT(base[i]^.form)), Fmt.int(base[i]^.size),
            Fmt.int(bit(base[i]^.signed)), Fmt.str(Scan.nameOf(base[i]^.obj^.name))]);
    end;
    if arg = "dup" then
        o := Sym.newObj(Sym.oVar, names[3], Sym.tI8);
        ok(Sym.insert(o, 100));
        ok(Sym.insert(o, 100));
    end;
    if arg = "deep" then
        Sym.cutScopes(1);
        for i := 1 to Sym.MaxDepth + 1 do ok(Sym.openScope(i)); end;
    end;
end;

end SymDump.
