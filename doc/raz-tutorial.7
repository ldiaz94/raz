  over lines
.Ed
.Pp
.Cm [5]INT
is an array: five
.Cm INT Ns s
in a row, copied when it is assigned.
.Cm []INT
is a slice: a pointer to elements that live elsewhere, and their
number,
.Cm LEN(s) .
.Cm a[lo..hi]
is the slice of the elements from
.Cm lo
up to, but not including,
.Cm hi ,
and an array goes silently where a slice is wanted.
A slice of a local array is good only while its procedure runs, so
returning one is an error: take the array as a
.Cm var
parameter instead.
.Pp
A string is a slice of bytes,
.Cm []U8 ,
in UTF-8, and its bytes are constant;
.Cm [8]U8
made from one is a copy.
Arrays and slices of integers compare with
.Cm =
and
.Cm # ;
.Cm Str
has the rest: ordering, finding, trimming, cutting a string into
parts, which are slices of it, UTF-8, and numbers to and from text.
.Pp
A string between backquotes is raw: no escapes, and it may run over
lines.
When the opening backquote ends its line and the closing one has
only blanks before it, those blanks come off every line, so the text
stands at the indent of the code around it.
.Pp
A
.Cm for
loop takes its bounds once, and never steps past the last: with an
empty slice,
.Cm "0 to LEN(s) - 1"
doesn't run at all.
.Cm break
leaves a loop, and
.Cm continue
ends its round: a
.Cm for
steps, and a
.Cm while
tests again; so a
.Cm while
moves on, as
.Cm "i := i + n" ,
before it can
.Cm continue .
.Sh 6. RECORDS AND POINTERS
.Bd -literal -offset indent
module Boxes;
import Fmt, SYSTEM;

type
    Point = record x, y: INT; end;
    Box = record lo, hi: Point; end;

proc area(b: Box): INT;
begin
    return (b.hi.x - b.lo.x) * (b.hi.y - b.lo.y);
end;

proc grow(b: ^Box; n: INT);
begin
    DEC(b^.lo.x, n);
    DEC(b^.lo.y, n);
    INC(b^.hi.x, n);
    INC(b^.hi.y, n);
end;

proc main*;
var b: Box; p: ^Point;
begin
    b := {lo: {x: 1, y: 1}, hi: {x: 4, y: 3}};
    Fmt.print("{}\en", [Fmt.int(area(b))]);
    grow(SYSTEM.ADR(b), 1);
    p := SYSTEM.ADR(b.hi);
    p^.x := 10;
    Fmt.print("{} {}\en", [Fmt.int(area(b)), Fmt.int(b.hi.x)]);
end;

end Boxes.
.Ed
.Bd -literal -offset indent
6
40 10
.Ed
.Pp
A record is laid out as C lays out a struct.
.Cm "{lo: ..., hi: ...}"
builds one, naming its fields; the ones it leaves out are zero.
.Cm ^Box
is a pointer to a
.Cm Box ,
.Cm SYSTEM.ADR(b)
the address of
.Cm b ,
and
.Cm b^
what a pointer points at.
A pointer is never the record:
.Cm b^.lo ,
never
.Cm b.lo .
.Pp
A slice is a pointer and a length, and a record can keep the two
apart, as an interpreter keeps a string, or as C wants them:
.Bd -literal -offset indent
module Spans;
import Out, SYSTEM;

type Span = record p: ^U8; n: INT; end;

proc spanOf(s: []const U8): Span;
begin
    return {p: SYSTEM.PTR(s), n: LEN(s)};
end;

proc text(sp: Span): []U8;
begin
    return sp.p[0..sp.n];
end;

proc main*;
var words: [3]Span; i: INT;
begin
    words := [spanOf("one"), spanOf(""), spanOf("three")];
    for i := 0 to 2 do
        Out.int(words[i].n); Out.char(' ');
        Out.str(text(words[i])); Out.ln;
    end;
end;

end Spans.
.Ed
.Bd -literal -offset indent
3 one
0
5 three
.Ed
.Pp
.Cm LEN(s)
is the length, and
.Cm SYSTEM.PTR(s)
the pointer, a
.Cm ^U8
for a
.Cm []U8 ,
with no check.
.Cm SYSTEM.ADR(s[0])
looks the same, and passes every test but the one with an empty
string: there
.Cm s[0]
is out of range, and the program stops.
.Cm SYSTEM.PTR
of an empty slice is what the slice holds, which is
.Cm nil
for one never set, so nothing needs testing first.
.Cm sp.p[0..sp.n]
is the slice again, empty when
.Cm sp.n
is 0, whatever
.Cm sp.p
is.
Of an array,
.Cm SYSTEM.PTR(a)
is the address of its first element.
.Sh 7. BYTES AND VIEWS
A file, a network packet or a device hands a program bytes, and the
program wants numbers and records out of them.
A
.Em view
reads and writes bytes as another type.
.Bd -literal -offset indent
module Packet;
import Out;

type Header = record kind: U16; flags: U16; size: U32; end;

var buf: [16]U8;

proc main*;
var i: INT; n: I64; h: Header; x: F64;
begin
    buf[0].(I64) := 258;        (* buf[0] to buf[7] now hold 258 *)
    for i := 0 to 7 do Out.int(I64(buf[i])); Out.char(' '); end;
    Out.ln;
    n := buf[0].(I64);          (* and give it back *)
    Out.int(n); Out.ln;

    buf[8].(Header) := {kind: 1, size: 4096};
    h := buf[8].(Header);
    Out.int(I64(h.size)); Out.ln;
    INC(buf[8].(Header).size, 4);
    Out.int(I64(buf[8].(Header).size)); Out.ln;

    x := 1.0;
    Out.hex(x.(U64), 16); Out.ln;   (* the bits of 1.0 *)
    Out.int(I64(x)); Out.ln;        (* the number 1.0 *)
end;

end Packet.
.Ed
.Bd -literal -offset indent
