.Ed
.Pp
A procedure that can fail returns an
.Cm ERROR
beside its result, and
.Cm nil
when it didn't.
Each
.Cm ERROR
constant is an error of its own, compared with
.Cm =
by which declaration made it, never by its message;
.Cm MSG(err)
is the message.
An exported one, as
.Cm Empty
is here, lets the callers tell it from the others.
.Pp
A caller that can't deal with an error passes it on to its own caller
with
.Cm try ,
as
.Cm total
does: if the call returned an error that isn't
.Cm nil ,
the procedure
.Cm try
stands in returns that error, with zero for its other results, and
otherwise
.Cm try
is the call's other results, here a number.
.Cm try
is a
.Cm return ,
written where the call is: it has no handler, keeps no state and
unwinds nothing, so every place a procedure can leave is in its text.
The procedure it stands in must itself end in an
.Cm ERROR ,
so
.Cm main ,
which returns none, tests each error and deals with it.
raz has no exceptions.
.Sh 10. DEFER
.Bd -literal -offset indent
module Defers;
import Out, Sys;

proc step(n: INT);
begin
    Out.str("in "); Out.int(n); Out.ln;
    defer Out.str("out\en");
    if n = 2 then return; end;
    defer Out.str("done\en");
    Out.str("working\en");
end;

(* the lines of the file at path, or -1 if it can't be read *)
proc lines(path: []const U8): INT;
var fd, n, i, count: INT; buf: [4096]U8;
begin
    fd := Sys.openRead(path);
    if fd < 0 then return -1; end;
    defer Sys.close(fd);
    count := 0;
    n := Sys.read(fd, buf);
    while n > 0 do
        for i := 0 to n - 1 do
            if buf[i] = '\en' then INC(count); end;
        end;
        n := Sys.read(fd, buf);
    end;
    return count;
end;

proc main*;
begin
    step(1);
    step(2);
    Out.int(lines("/dev/null")); Out.ln;
    Out.int(lines("/no/such/file")); Out.ln;
end;

end Defers.
.Ed
.Bd -literal -offset indent
in 1
working
done
out
in 2
out
0
-1
.Ed
.Pp
.Cm "defer s;"
runs
.Cm s
when the program leaves the statements the
.Cm defer
stands in: at their end, or by a
.Cm return ,
a
.Cm break
or a
.Cm continue .
Deferred statements run the last first, and only those whose
.Cm defer
was reached.
So a file is closed beside the line that opens it, however the
procedure ends.
.Sh 11. CHECKS, AND WHAT A FAILURE SAYS
.Bd -literal -offset indent
module Fail;
import Out;

proc show(a: []INT; i: INT);
begin
    Out.int(a[i]);
    Out.ln;
end;

proc main*;
var a: [3]INT; i: INT;
begin
    for i := 0 to 3 do
        show(a, i);
    end;
end;

end Fail.
.Ed
.Bd -literal -offset indent
0
0
0
Fail.raz:6:15: index 3 is out of range for a length of 3
  in Fail.show at Fail.raz:6:15: i = 3
  in Fail.main at Fail.raz:14:9: i = 3
.Ed
.Pp
Every index and slice is checked.
A failed check says where it failed and with what values, then the
calls under way with their variables, and ends the program with
status 2.
So do a
.Cm nil
pointer, a division by zero and a stack overflow.
.Pp
A module that is sure of its indexes may say
.Cm "check off;"
after its imports (it must import SYSTEM), for speed; an index out of range there reads or
writes whatever it reaches.
The program carries line numbers for
.Xr gdb 1 ,
and
.Ev RAZ_PROFILE Ns =1
in its environment has it say where its time went;
.Xr raz 1
says more.
.Sh 12. ENUMERATIONS, SETS, VARIANTS AND MATCH
.Bd -literal -offset indent
module Shapes;
import Out, Fmt, Math;

type
    Colour = (red, green, blue);
    Colours = set of Colour;
    Shape = variant
        circle(r: F64);
        rect(w, h: F64);
        dot;
    end;

const Some: []Shape = [circle(1.0), rect(2.0, 3.5), dot];

proc area(const s: Shape): F64;
begin
    match s of
    | circle(r): return Math.pi * r * r;
    | rect(w, h): return w * h;
    | dot: return 0.0;
    end;
end;

proc kind(c: I32): []const U8;
begin
    match c of
    | ' ', '\et', '\en': return "space";
    | '0' .. '9': return "digit";
    | 'a' .. 'z', 'A' .. 'Z': return "letter";
    | else: return "other";
    end;
end;

proc colour(name: []const U8): Colour;
begin
    match name of
    | "red", "rose": return red;
    | "green": return green;
    | else: return blue;
    end;
end;

proc main*;
var i: INT; warm: Colours; c: Colour;
begin
    for i := 0 to LEN(Some) - 1 do
        Fmt.print("{}\en", [Fmt.real(area(Some[i]), 2)]);
    end;
    Fmt.print("{} {} {}\en", [Fmt.str(kind('7')), Fmt.str(kind('x')),
        Fmt.str(kind('+'))]);
    warm := {red, blue} - {blue} + {green};
    for c := red to blue do
        if c in warm then Out.int(I64(c)); Out.ln; end;
    end;
    Out.int(I64(colour("rose"))); Out.int(I64(colour("green"))); Out.ln;
end;

end Shapes.
.Ed
.Bd -literal -offset indent
3.14
7.00
0.00
digit letter other
0
1
01
.Ed
.Pp
An enumeration is a list of names, in order, each of which may be
written with its type,
.Cm Color.red ;
two enumerations may share a name, which is then always written so.
A
.Cm "set of"
it holds any choice of them, in the bits of a word, with
.Cm in ,
.Cm +
for union,
.Cm *
for intersection and
.Cm -
for difference.
.Pp
A variant holds one of its cases, each with fields of its own, and
.Cm match
is the only way to read them: it runs the arm of the case the variant
holds, naming its fields.
A constant may hold variants, each a case built from constants, as
.Cm Some
does; a
.Cm match
on one names fields that are only read.
Every case has an arm, unless an
.Cm "| else:"
comes last.
On an integer,
.Cm match
takes constants and ranges, and on a string, string constants; both
must have an
.Cm "| else:" .
.Sh 13. GENERIC MODULES
A module may take types, and the procedures it needs on them, as
parameters.
.Pa Biggest.raz :
.Bd -literal -offset indent
module Biggest(T; less: proc(a, b: T): BOOL);

(* the biggest of s, which mustn't be empty *)
proc max*(s: []T): T;
var i: INT; m: T;
begin
    m := s[0];
    for i := 1 to LEN(s) - 1 do
        if less(m, s[i]) then m := s[i]; end;
    end;
    return m;
end;

end Biggest.
.Ed
.Bd -literal -offset indent
module Generics;
import Out, Ints := Biggest(INT, before),
    Words := Biggest([]const U8, shorter), Order := Sort(INT, before);

proc before(a, b: INT): BOOL;
begin
    return a < b;
end;

proc shorter(a, b: []const U8): BOOL;
begin
    return LEN(a) < LEN(b);
end;

proc main*;
var a: [5]INT; i: INT;
begin
    a := [3, 1, 4, 1, 5];
    Out.int(Ints.max(a)); Out.ln;
    Out.str(Words.max(["a", "tree", "is"])); Out.ln;
    Order.sort(a);
    for i := 0 to 4 do Out.int(a[i]); Out.char(' '); end;
    Out.ln;
end;

end Generics.
.Ed
.Bd -literal -offset indent
5
tree
1 1 3 4 5
.Ed
.Pp
Each import with its own arguments makes an instance: the module
compiled again, with
.Cm T
standing for the type given, and
.Cm less
calling the procedure given.
The arguments may name what the importing module declares later, as
.Cm before
is here.
The library's
.Cm List , Map , Vec ,
a growable array, and
.Cm Sort
are generic modules:
.Bd -literal -offset indent
import Count := Map([]const U8, INT, Str.hash, Str.eq);
.Ed
.Sh 14. TALKING TO C
.Bd -literal -offset indent
module Qsort;
import Out, Fmt, SYSTEM;

link "libm.so.6";

extern proc qsort(base: ^U8; n, size: UINT;
    less: proc(a, b: ^U8): I32);
extern proc cbrt(x: F64): F64;

(* the order of two INTs, as C's qsort wants it *)
proc order(a, b: ^U8): I32;
var x, y: ^INT;
begin
    x := ^INT(a);
    y := ^INT(b);
    if x^ < y^ then return -1; elsif x^ > y^ then return 1; end;
    return 0;
end;

proc main*;
var a: [5]INT; i: INT;
begin
    a := [30, 10, 50, 20, 40];
    qsort(^U8(SYSTEM.ADR(a)), LEN(a), SIZE(INT), order);
    for i := 0 to 4 do Out.int(a[i]); Out.char(' '); end;
    Out.ln;
    Fmt.print("{}\en", [Fmt.real(cbrt(27.0), 3)]);
end;

end Qsort.
.Ed
.Bd -literal -offset indent
10 20 30 40 50
3.000
.Ed
.Pp
A module that says
.Cm "import SYSTEM"
may declare
.Cm extern
procedures and name libraries with
.Cm link .
An
.Cm extern
procedure is found by its name in the C library, or in a library a
.Cm link
line names.
Its parameters are integers, reals, pointers and procedures, as C
declares them; a raz procedure of such types can be given to C to call
back, as
.Cm order
is.
.Cm ^INT(a)
sees the address
.Cm a
as a pointer to an
.Cm INT .
A slice goes to C as two arguments,
.Cm SYSTEM.PTR(s)
and
.Cm LEN(s) ,
which an empty slice gives too (section 6).
.Pp
A program that uses C is linked against it dynamically, and starts
through it; one that doesn't is a static executable with nothing in it
but its own code.
.Cm Out
and C's
.Xr printf 3
keep two buffers, so a program that writes with both flushes one
before it writes with the other.
.Sh 15. THREADS
.Bd -literal -offset indent
module Hits;
import Out, Thread, SYSTEM;

const Workers = 4;

var
    hits: INT;      (* added to by every thread at once, by XADD *)
    m: Thread.Mutex;
    total: INT;     (* added to under m *)

proc work(arg: ^U8);
var i, n, sum: INT;
begin
    n := INT(arg);
    sum := 0;
    for i := 1 to n do
        sum := sum + i;
        _ := XADD(hits, 1);
    end;
    Thread.lock(m);
    total := total + sum;
    Thread.unlock(m);
end;

proc main*;
var t: [Workers]^Thread.Thread; i: INT; err: ERROR;
begin
    for i := 0 to Workers - 1 do
        t[i], err := Thread.spawn(work, ^U8(1000 * (i + 1)));
        if err # nil then Out.str(MSG(err)); Out.ln; return; end;
    end;
    for i := 0 to Workers - 1 do Thread.join(t[i]); end;
    Out.int(hits); Out.char(' '); Out.int(total); Out.ln;
end;

end Hits.
.Ed
.Bd -literal -offset indent
10000 15005000
.Ed
.Pp
.Cm Thread.spawn
runs a procedure in a thread of its own, with a stack of its own, and
.Cm Thread.join
waits for it to end.
.Cm XADD ,
.Cm CAS
and
.Cm XCHG
change a word atomically; a
.Cm Thread.Mutex
keeps a longer section to one thread at a time.
.Cm Out
and
.Cm Heap
lock themselves.
.Pp
.Cm Thread
makes its own threads, without C, in a program that doesn't use C; in
one that does, it makes them with C's
.Xr pthread_create 3
instead, and the program is the same.
.Cm Thread.signal
sends a signal to one thread alone, so that, with
.Cm Sys.handle ,
another thread can break into a read it waits in.
