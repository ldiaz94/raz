258
4096
4100
3FF0000000000000
1
.Ed
.Pp
Read
.Cm buf[0].(I64)
as
.Dq "the I64 whose bytes start at buf[0]" .
An
.Cm I64
is 8 bytes, so the view is made of
.Cm buf[0]
to
.Cm buf[7] :
.Bd -literal -offset indent
buf:   [0] [1] [2] [3] [4] [5] [6] [7] [8] ...
        2   1   0   0   0   0   0   0
       \e______ buf[0].(I64) = 258 ______/
.Ed
.Pp
Nothing is copied to make a view: it
.Em is
those bytes, as
.Cm p^
is the variable
.Cm p
points at.
Assigning it writes them, and so changes
.Cm buf ;
reading it reads them.
So a view goes wherever a variable goes: on the left of
.Cm := ,
in
.Cm INC ,
and with a field or an index after it, as
.Cm buf[8].(Header).size
is the
.Cm size
field of the
.Cm Header
whose bytes start at
.Cm buf[8] .
.Pp
258 is
.Cm 102H ,
and its low byte, 2, comes first: x86-64 puts a number's low byte
first in memory.
Another machine may put it last; a format with an order of its own is
read a byte at a time, with
.Cm Str.le
or
.Cm Str.be ,
if the program is to run everywhere.
.Pp
A view isn't a conversion.
A conversion works on the value, a view on the bytes:
.Cm I64(x)
is 1, the number, while
.Cm x.(U64)
is
.Cm 3FF0000000000000H ,
the bits that hold 1.0.
When the program means a number it wants a conversion; when it means
the bytes as they lie, a view.
.Pp
The view must lie inside the variable it is made of.
For an element, as
.Cm buf[i].(I64) ,
that is from
.Cm buf[i]
to the end of
.Cm buf ,
and the program checks it as it checks an index:
.Bd -literal -offset indent
module Overrun;
import Out;

var buf: [16]U8;

proc main*;
var i: INT;
begin
    i := 0;
    while i < 16 do
        buf[i].(I32) := 1;
        i := i + 3;
    end;
    Out.str("done\en");
end;

end Overrun.
.Ed
.Bd -literal -offset indent
Overrun.raz:11:13: a view at index 15 runs past a length of 16
  in Overrun.main at Overrun.raz:11:13: i = 15
.Ed
.Pp
The
.Cm I32
at
.Cm buf[15]
would be
.Cm buf[15]
to
.Cm buf[18] ,
three bytes past the end.
An index the compiler knows, it checks itself:
.Cm buf[14].(I32)
doesn't compile.
A view of a whole variable must fit in it:
.Cm x.(U64)
needs
.Cm x
to have 8 bytes at least.
.Pp
A view is an integer, a real or a pointer, or a record or array made
of them: types that any bytes are a value of.
A
.Cm BOOL
or an enumeration isn't, since some bytes are none of its values:
view an integer, and compare or convert it.
A view may start at any byte, so it has no address:
.Cm SYSTEM.ADR
of it is an error.
Copy it to a variable first.
Before views, a program made a pointer for each access, as
.Cm "p := ^I64(SYSTEM.ADR(buf[0]))"
and then
.Cm "p^ := 258" ,
which checks nothing.
.Sh 8. MEMORY AND ALLOCATORS
.Bd -literal -offset indent
module Stack;
import Out, Mem, Heap, Arena, SYSTEM;

type Node = record next: ^Node; val: INT; end;

(* a node holding v on top of top, from the allocator a;
   nil if a has no room *)
proc push(top: ^Node; v: INT; a: ^Mem.Allocator): ^Node;
var n: ^Node;
begin
    NEW(n, a);
    if n # nil then
        n^.next := top;
        n^.val := v;
    end;
    return n;
end;

proc main*;
var top, n: ^Node; i: INT; ar: Arena.Arena;
begin
    for i := 1 to 3 do top := push(top, i, Heap.heap); end;
    while top # nil do
        Out.int(top^.val); Out.char(' ');
        n := top;
        top := top^.next;
        Mem.free(Heap.heap, ^U8(n));
    end;
    Out.ln;
    if not Arena.init(ar, 100000) then return; end;
    for i := 1 to 1000 do top := push(top, i, SYSTEM.ADR(ar.base)); end;
    Out.int(top^.val); Out.ln;
    Arena.done(ar);            (* every node at once *)
end;

end Stack.
.Ed
.Bd -literal -offset indent
3 2 1
1000
.Ed
.Pp
raz has no garbage collector, and no allocator of its own: memory
comes from an allocator, a
.Cm Mem.Allocator ,
which the program chooses and passes.
.Cm "NEW(n, a)"
sets
.Cm n
to a fresh, zeroed
.Cm Node
from
.Cm a ,
or to
.Cm nil
if
.Cm a
has no room.
.Cm Heap.heap
is the general one, which
.Cm Mem.free
gives memory back to.
An
.Cm Arena
hands out memory from one block, and frees it all at once.
.Cm Buf , List
and
.Cm Map
take the allocator they use from
.Cm init .
.Sh 9. ERRORS
.Bd -literal -offset indent
module Errors;
import Out, Str;

const
    Empty*: ERROR = "nothing to read";
    TooBig*: ERROR = "not a number up to 1000";

(* the number s holds, up to 1000 *)
proc number(s: []const U8): (INT, ERROR);
var n: I64; ok: BOOL;
begin
    if LEN(s) = 0 then return 0, Empty; end;
    n, ok := Str.toInt(s);
    if not ok or (n > 1000) then return 0, TooBig; end;
    return INT(n), nil;
end;

(* the sum of the numbers in words: the first error ends it *)
proc total(words: [][]const U8): (INT, ERROR);
var i, sum: INT;
begin
    for i := 0 to LEN(words) - 1 do
        sum := sum + try number(words[i]);
    end;
    return sum, nil;
end;

proc main*;
var words: [3][]const U8; i, n: INT; err: ERROR;
begin
    words := ["42", "", "12345"];
    for i := 0 to 2 do
        n, err := number(words[i]);
        if err = nil then Out.int(n);
        elsif err = Empty then Out.str("empty");
        else Out.str(MSG(err));
        end;
        Out.ln;
    end;
    n, err := total(["1", "2", "3"]);
    Out.int(n); Out.ln;
    n, err := total(words);
    if err # nil then Out.str(MSG(err)); Out.ln; end;
end;

end Errors.
.Ed
.Bd -literal -offset indent
