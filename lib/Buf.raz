(* A growable byte buffer, its memory from an allocator. *)
module Buf;
import Mem, Arena, Rt;

type
    Buf* = record
        a: ^Mem.Allocator;
        data: ^U8;
        len*, cap: INT;
    end;

(* An empty buffer, which takes its memory from a. *)
proc init*(b: ^Buf; a: ^Mem.Allocator);
begin
    b^ := {a: a};
end;

(* Room for n more bytes; false if the allocator has none. *)
proc room*(b: ^Buf; n: INT): BOOL;
var cap: INT; p: ^U8;
begin
    if b^.len + n <= b^.cap then return true; end;
    cap := b^.cap * 2;
    if cap < 64 then cap := 64; end;
    while cap < b^.len + n do cap := cap * 2; end;
    p := Mem.alloc(b^.a, cap, 1);
    if p = nil then return false; end;
    if b^.len > 0 then COPY(p[0..b^.len], b^.data[0..b^.len]); end;
    if b^.data # nil then Mem.free(b^.a, b^.data); end;
    b^.data := p;
    b^.cap := cap;
    return true;
end;

(* Adds the byte c at the end; if room for it can't be had, it is
   dropped and the buffer is as it was. *)
proc add*(b: ^Buf; c: U8);
begin
    if room(b, 1) then
        b^.data[b^.len] := c;
        INC(b^.len);
    end;
end;

(* Adds the bytes of s at the end; if room for them can't be had, none
   is added. *)
proc str*(b: ^Buf; s: []U8);
begin
    if room(b, LEN(s)) then
        COPY(b^.data[b^.len..b^.len + LEN(s)], s);
        INC(b^.len, LEN(s));
    end;
end;

(* What the buffer holds, until it next grows. *)
proc bytes*(b: ^Buf): []U8;
begin
    if b^.len = 0 then return ""; end;
    return b^.data[0..b^.len];
end;

(* Empties the buffer, keeping its memory for what comes next. *)
proc reset*(b: ^Buf);
begin
    b^.len := 0;
end;

(* Gives the buffer's memory back, leaving it empty. *)
proc done*(b: ^Buf);
begin
    if b^.data # nil then Mem.free(b^.a, b^.data); end;
    b^.data := nil;
    b^.len := 0;
    b^.cap := 0;
end;

(* The module's test, over an arena. *)
proc main*;
var ar: Arena.Arena; b: Buf; i: INT; s: []U8;
begin
    if not Arena.init(ADR(ar), 1 shl 20) then Rt.stop("Buf: no arena"); end;
    init(ADR(b), ADR(ar.base));
    if LEN(bytes(ADR(b))) # 0 then Rt.stop("Buf: not empty"); end;
    for i := 0 to 9999 do add(ADR(b), U8(i mod 251)); end;
    str(ADR(b), "end");
    s := bytes(ADR(b));
    if (LEN(s) # 10003) or (s[9998] # U8(9998 mod 251)) or (s[10000..10003] # "end") then
        Rt.stop("Buf: contents");
    end;
    reset(ADR(b));
    str(ADR(b), "again");
    if bytes(ADR(b)) # "again" then Rt.stop("Buf.reset"); end;
    done(ADR(b));
    Arena.done(ADR(ar));
end;

end Buf.
