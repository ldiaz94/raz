(* The run time, for macOS on arm64, with lib/Rt.raz's interface, which
   every file of Rt keeps. The compiler finds exit, fail and cExit by
   these names. exit runs the procedures atExit registered, then ends
   the program by C's exit, which the entry point gives cExit, as every
   program on a Mac reaches the kernel through libSystem; fail says
   what failed, with its values, and stop its message, and they end it
   with status 2; and a fault the machine catches, a nil pointer or
   procedure or a stack overflow, is told by a handler, on a stack of
   its own, as on Linux, and ends it so too. A failure is told by its
   address, as on Linux in a program built with raz -s: the places, the
   calls under way and the profiler are what PLAN.md 5's step 7 brings
   here; place, trace and startProfile do nothing yet. *)
module Rt;
import SYSTEM;

const
    Full*: ERROR = "too many procedures to run at exit";   (* atExit's *)
    MaxAtExit = 32;
    Digits = "0123456789abcdef";
    (* the signals a fault raises, and sigaction's flags SA_ONSTACK,
       SA_RESETHAND and SA_SIGINFO, as macOS's <signal.h> has them *)
    SigIll = 4; SigTrap = 5; SigFpe = 8; SigBus = 10; SigSegv = 11;
    Flags = 1H + 4H + 40H;
    Low = 100000000H;   (* page zero: no address below this is ever mapped *)

type
    (* What sigaction and sigaltstack take, as macOS lays them out *)
    Action = record handler: proc(sig: I32; info, ctx: ^U8); mask, flags: I32; end;
    Stack = record sp: ^U8; size: INT; flags: I32; end;

extern proc write(fd: I32; buf: ^U8; n: UINT): INT;
extern proc sigaction(sig: I32; act, old: ^U8): I32;
extern proc sigaltstack(ss, old: ^U8): I32;

var
    atExits: [MaxAtExit]proc;
    numAtExit: INT;
    ending: INT;                (* the status exit was given, once it has been *)
    cExit: proc(status: I32);   (* C's exit, set first thing *)
    placer: proc(a: UINT);      (* place, set first thing, or nil under raz -s *)
    profiler: proc;             (* startProfile, set first thing, or nil *)
    line: [256]U8;              (* the message being made *)
    lineLen: INT;
    act: Action;
    alt: Stack;
    altStack: [65536]U8;        (* where the handler runs, even when the stack is full *)

(* Registers p to run when the program ends by exit *)
proc atExit*(p: proc): ERROR;
begin
    if numAtExit = MaxAtExit then return Full; end;
    atExits[numAtExit] := p;
    INC(numAtExit);
    return nil;
end;

(* The status exit was given, while the procedures atExit registered
   run; 0 before *)
proc exitStatus*: INT;
begin
    return ending;
end;

(* Runs the procedures registered with atExit, the last first, each
   taken off first so that it runs once, then ends the program with
   status *)
proc exit*(status: INT);
var p: proc;
begin
    ending := status;
    while numAtExit > 0 do
        DEC(numAtExit);
        p := atExits[numAtExit];
        p();
    end;
    cExit(I32(status));
end;

(* Says msg, and then a line feed, on standard error, then ends the
   program by exit with status 2 *)
proc stop*(msg: []const U8);
begin
    _ := write(2, SYSTEM.PTR(msg), UINT(LEN(msg)));
    _ := write(2, SYSTEM.PTR("\n"), 1);
    exit(2);
end;

(* Messages, made in line, as lib/Rt.raz makes them, one byte kept for
   the line feed, and written by say in one piece *)
proc put(s: []const U8);
var i: INT;
begin
    for i := 0 to LEN(s) - 1 do
        if lineLen < LEN(line) - 1 then
            line[lineLen] := s[i];
            INC(lineLen);
        end;
    end;
end;

(* The digits from the last, a negative n's from its negative
   remainders, so that the lowest INT comes out too *)
proc putInt(n: INT);
var buf: [20]U8; i: INT; neg: BOOL;
begin
    neg := n < 0;
    i := 20;
    repeat
        DEC(i);
        if neg then buf[i] := U8(-(n mod 10)) + '0'; else buf[i] := U8(n mod 10) + '0'; end;
        n := n div 10;
    until n = 0;
    if neg then put("-"); end;
    put(buf[i..20]);
end;

proc putHex(u: UINT);
var buf: [16]U8; i: INT;
begin
    i := 16;
    repeat
        DEC(i);
        buf[i] := Digits[INT(u & 15)];
        u := u shr 4;
    until u = 0;
    put("0x");
    put(buf[i..16]);
end;

proc putStr(s: ^U8);
var n: INT;
begin
    n := 0;
    while s[n] # 0 do INC(n); end;
    put(s[0..n]);
end;

proc say;
begin
    line[lineLen] := '\n';
    _ := write(2, SYSTEM.PTR(line), UINT(lineLen + 1));
    lineLen := 0;
end;

(* Puts where the code at address a is: its address, for now *)
proc where(a: UINT);
begin
    if placer # nil then placer(a); end;
    put("at ");
    putHex(a);
    put(": ");
end;

(* Where the code at address a comes from: not told yet *)
proc place*(a: UINT);
begin
    _ := a;
end;

(* The calls under way: not told yet *)
proc trace*;
begin
end;

(* A check failed in the code at address at: says where, and what
   failed, as lib/Rt.raz's fail, whose comment says what each kind is,
   then ends the program by exit with status 2. The registers that
   x86-64's trap report shows are none here. *)
proc fail*(what, a, b, len: INT; at: UINT; name: ^U8; rdi, rsi: UINT);
begin
    _ := rdi; _ := rsi;
    where(at);
    if what = 4 then put("stopped by a nil pointer");
    elsif what = 5 then put("stopped by a division fault");
    elsif what = 6 then put("stopped by a stack overflow");
    elsif what = 0 then put("index "); putInt(a);
    elsif what = 7 then
        put("a view at index "); putInt(a);
        put(" runs past a length of "); putInt(len);
    elsif (what = 1) or (what = 3) then
        put("slice "); putInt(a); put(".."); putInt(b);
        if what = 3 then put(" runs backwards"); end;
    else
        putInt(a); put(" isn't a position of "); putStr(name);
    end;
    if what < 2 then put(" is out of range for a length of "); putInt(len); end;
    say;
    exit(2);
end;

(* A fault stops the program: says where it was and why on standard
   error, then ends it by exit with status 2, as a failed check does.
   info and ctx are the kernel's siginfo and ucontext: the address that
   faulted is at 24 in siginfo, and the registers at uc_mcontext, a
   pointer at 48 in ucontext, past 16 bytes of the exception's state:
   x0 to x28, then fp, lr, sp and pc. *)
proc onSignal(sig: I32; info, ctx: ^U8);
var adr, sp, pc: UINT; q: ^UINT; why: []const U8;
begin
    q := ^UINT(info + 24);
    adr := q^;
    q := ^UINT(ctx + 48);
    q := ^UINT(q^ + 16);
    sp := q[31];
    pc := q[32];
    if sig = SigFpe then why := "a division fault";
    elsif pc < Low then
        why := "a nil procedure";
        pc := q[30] - 4;   (* the call, by its return address in lr *)
    elsif adr < Low then why := "a nil pointer";
    elsif adr - sp + 100000H < 200000H then why := "a stack overflow";   (* within a megabyte of sp *)
    elsif (sig = SigIll) or (sig = SigTrap) then why := "a trap";
    else why := "a bad address";
    end;
    where(pc);
    put("stopped by ");
    put(why);
    say;
    exit(2);
end;

(* The profiler: none yet *)
proc startProfile*;
begin
end;

begin
    _ := profiler;   (* started here when RAZ_PROFILE is set, by step 7's Rt *)
    alt := {sp: SYSTEM.ADR(altStack[0]), size: LEN(altStack)};
    _ := sigaltstack(^U8(SYSTEM.ADR(alt)), nil);
    act := {handler: onSignal, flags: Flags};
    _ := sigaction(SigSegv, ^U8(SYSTEM.ADR(act)), nil);
    _ := sigaction(SigBus, ^U8(SYSTEM.ADR(act)), nil);
    _ := sigaction(SigFpe, ^U8(SYSTEM.ADR(act)), nil);
    _ := sigaction(SigIll, ^U8(SYSTEM.ADR(act)), nil);
    _ := sigaction(SigTrap, ^U8(SYSTEM.ADR(act)), nil);
end Rt.
