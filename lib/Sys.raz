(* System calls through the C library: Sys for the targets that have no
   file of their own, with the same exports. A program that imports it
   uses C.

   It keeps to POSIX's names, and raw mode is cfmakeraw's. A terminal's
   modes, Mode, are its struct termios whole, of whatever layout, and
   only the two struct timeval that begin struct rusage are read. What
   is glibc's, on x86-64: where a name lies in struct dirent; struct
   stat; open's flags; the numbers of the requests TIOCGWINSZ,
   TIOCSWINSZ and TIOCSCTTY; close_range; SOCK_CLOEXEC, AF_INET6 and
   SO_REUSEADDR; struct sockaddr_un and sockaddr_in, which on the BSDs
   start with a byte of length; the numbers of the signals and of the
   limits, and RLIM_INFINITY, all ones. A C library that differs needs
   a Sys of its own. *)
module Sys;
import C;

const
    stdin* = 0;     (* standard input's file descriptor *)
    stdout* = 1;    (* standard output's *)
    stderr* = 2;    (* standard error's *)
    (* the bytes Out keeps before it writes them; a target with little
       memory keeps fewer *)
    outSize* = 4096;
    (* signals, by their numbers on Linux; another target has its own *)
    sigHup* = 1; sigInt* = 2; sigQuit* = 3; sigKill* = 9; sigPipe* = 13;
    sigTerm* = 15; sigChld* = 17; sigCont* = 18; sigStop* = 19;
    sigTstp* = 20; sigTtin* = 21; sigTtou* = 22; sigWinch* = 28;
    sigUsr1* = 10; sigUsr2* = 12; sigAlrm* = 14;
    (* the limits limit and setLimit take, by their numbers on Linux;
       another target has its own *)
    limitCpu* = 0;          (* seconds of the processor *)
    limitFileSize* = 1;     (* bytes in a file it writes *)
    limitData* = 2;         (* bytes of its data *)
    limitStack* = 3;        (* bytes of its stack *)
    limitCore* = 4;         (* bytes of a core dump *)
    limitProcs* = 6;        (* processes of its user *)
    limitFiles* = 7;        (* one more than its highest fd *)
    limitMemory* = 9;       (* bytes of its address space *)
    DirentName = 19;          (* the offset of d_name in glibc's struct dirent *)
    DirentType = 18;          (* and of d_type *)
    TIOCGWINSZ = 5413H;       (* glibc's, as the two below *)
    TIOCSWINSZ = 5414H;
    TIOCSCTTY = 540EH;

type
    (* What open is asked for: reading, writing or both, and what else
       it does to the file. *)
    Access* = (reading, writing, creating, exclusive, truncating,
        appending, executing);
    Accesses* = set of Access;   (* what open is given *)

    (* What info says of a file. *)
    Info* = record
        size*: I64;     (* in bytes *)
        mtime*: I64;    (* its contents' last change, in ns since 1970 *)
        mode*: INT;     (* its permission bits, rwxrwxrwx *)
        dir*: BOOL;     (* a directory *)
        file*: BOOL;    (* not a directory, device, pipe or socket *)
        symlink*: BOOL; (* the path itself is a symbolic link *)
        ino*: U64;      (* its inode, which a rename keeps and a new file doesn't *)
        dev*: U64;      (* the file system it is on; with ino, it names the file *)
    end;

    (* What a directory says a name in it is, without asking the file:
       a regular file, a directory, a symbolic link, or something else
       (a device, pipe or socket); unknown where the file system
       doesn't say, and linkInfo must be asked. *)
    Kind* = (unknown, isFile, isDir, isLink, isOther);

    (* An open directory: C's DIR. *)
    Dir* = record
        d: ^U8;
        kind: Kind;     (* of the name nextEntry gave last *)
    end;

    (* A program for spawn to start. *)
    Program* = record
        path*: []U8;
        args*: [][]U8;      (* the first is its name *)
        env*: [][]U8;       (* NAME=value, each added to this environment *)
        onlyEnv*: BOOL;     (* env is its whole environment *)
        dir*: []U8;         (* its working directory; "" for this program's *)
        fds*: [3]INT;       (* stdin, stdout, stderr; 0 for this program's *)
        group*: INT;        (* its group: 0 for this program's, -1 a new one *)
        foreground*: BOOL;  (* its group gets the terminal on standard input *)
        tty*: INT;          (* a pseudo-terminal to start a session on, or 0 *)
        more*: []INT;       (* fds above 2 passed on to it at the same numbers *)
    end;
    (* How a program that wait waited for changed. *)
    Status* = (running, exited, killed, stopped);

    (* glibc's struct sigaction; a handler of 0 is SIG_DFL, 1 SIG_IGN *)
    Handler = proc(sig: I32);
    Sigaction = record
        handler: Handler;
        mask: [16]U64;
        flags: I32;
        restorer: ^U8;
    end;

    (* A terminal's modes, as getMode reads them and setMode sets them:
       a struct termios, of the C library's size, 256 bytes at most. *)
    Mode* = record
        t: [256]U8;
    end;

    (* struct rusage: what is read of it, the time used in the program
       and in the system, each a struct timeval, its microseconds at
       most an int and little-endian, then room for the rest *)
    Timeval = record sec: I64; usec: I32; pad: I32; end;
    Rusage = record user, system: Timeval; rest: [32]I64; end;

    Winsize = record rows, cols, xpixel, ypixel: U16; end;
    Pollfd = record fd: I32; events, revents: I16; end;

    (* glibc's struct sockaddr_un: AF_UNIX, then the path and its zero *)
    SockaddrUn = record
        family: U16;
        path: [108]U8;
    end;
    (* struct sockaddr_in or sockaddr_in6: AF_INET and the IPv4 address
       in data[0..4], or AF_INET6 and the IPv6 one in data[4..20] *)
    Sockaddr = record
        family: U16;
        port: [2]U8;
        data: [24]U8;
    end;
    (* Whom a datagram came from, as receive says and reply takes: the
       address recvfrom fills in, and its size. *)
    Peer* = record
        a: Sockaddr;
        size: INT;
    end;
    (* struct msghdr, what sendmsg and recvmsg take: no address, one
       buffer, and a control message; the sizes and flags are ints
       with room after them, kept zero *)
    Msghdr = record
        name: ^U8; nameSize: INT;
        iov: ^Iovec; iovLen: INT;
        control: ^U8; controlSize: INT;
        flags: INT;
    end;
    Iovec = record base: ^U8; size: INT; end;
    (* struct cmsghdr, SCM_RIGHTS's: its size, counted to the last fd,
       then the fds, as many as sendFds sends *)
    Rights = record
        size: INT;
        level, kind: I32;
        fds: [16]I32;
    end;
    Timespec = record sec, nsec: I64; end;

var
    cwd: [4096]U8;    (* what workDir gives *)
    linked: [4096]U8; (* what readLink gives *)
    saved: [256]U8;   (* the terminal as rawMode found it: a struct termios, of the C library's size *)
    host: [256]U8;    (* what hostName gives *)
    sigRead, sigWrite: I32;   (* the pipe the handler of caught signals writes their numbers to, once open *)

(* minus errno, as a system call returns it *)
proc failed: INT;
var e: ^I32;
begin
    e := C.__errno_location();
    return -INT(e^);
end;

(* Writes s to the file descriptor fd; the number of bytes written, or
   minus an errno. *)
proc write*(fd: INT; s: []U8): INT;
var r: INT;
begin
    if LEN(s) = 0 then return 0; end;
    r := C.write(I32(fd), ADR(s[0]), UINT(LEN(s)));
    if r < 0 then return failed(); end;
    return r;
end;

(* Reads into buf from fd; the number of bytes read, 0 at the end, or
   minus an errno. *)
proc read*(fd: INT; buf: []U8): INT;
var r: INT;
begin
    if LEN(buf) = 0 then return 0; end;
    r := C.read(I32(fd), ADR(buf[0]), UINT(LEN(buf)));
    if r < 0 then return failed(); end;
    return r;
end;

(* path, a C string in buf, or false if it doesn't fit. *)
proc cstr(path, buf: []U8): BOOL;
begin
    if LEN(path) >= LEN(buf) then return false; end;
    COPY(buf, path);
    buf[LEN(path)] := 0;
    return true;
end;

(* open's flags for how; glibc's numbers *)
proc flags(how: Accesses): I32;
var f: I32;
begin
    f := 0;                                         (* O_RDONLY *)
    if writing in how then
        f := 1;                                     (* O_WRONLY *)
        if reading in how then f := 2; end;         (* O_RDWR *)
    end;
    if creating in how then f := f | 40H; end;
    if exclusive in how then f := f | 80H; end;
    if truncating in how then f := f | 200H; end;
    if appending in how then f := f | 400H; end;
    return f;
end;

(* The file at path, opened as how asks: its file descriptor, or minus
   an errno. A file it creates has the permission bits mode, less
   those the umask takes away. *)
proc openMode*(path: []U8; how: Accesses; mode: INT): INT;
var buf: [4096]U8; r: INT;
begin
    if executing in how then return -22; end;      (* EINVAL: access asks it, open can't *)
    if not cstr(path, buf) then return -36; end;
    r := INT(C.open(ADR(buf[0]), flags(how), mode));
    if r < 0 then return failed(); end;
    return r;
end;

(* openMode with 644: a file it creates is readable by all, writable
   by its owner. *)
proc open*(path: []U8; how: Accesses): INT;
begin
    return openMode(path, how, 1A4H);                  (* 644 *)
end;

(* The file at path, opened for reading. *)
proc openRead*(path: []U8): INT;
begin
    return open(path, {reading});
end;

(* The file at path, made empty or new, opened for writing. *)
proc create*(path: []U8): INT;
begin
    return open(path, {writing, creating, truncating});
end;

(* Moves fd to pos from the start of its file, or from the end if
   fromEnd: the new position, or minus an errno. *)
proc seek*(fd: INT; pos: I64; fromEnd: BOOL): I64;
var r: I64;
begin
    if fromEnd then r := C.lseek(I32(fd), pos, 2);    (* SEEK_END *)
    else r := C.lseek(I32(fd), pos, 0); end;          (* SEEK_SET *)
    if r < 0 then return failed(); end;
    return r;
end;

(* Where in its file fd is, without moving: the next read or write's
   position, or minus an errno. *)
proc position*(fd: INT): I64;
var r: I64;
begin
    r := C.lseek(I32(fd), 0, 1);                      (* SEEK_CUR *)
    if r < 0 then return failed(); end;
    return r;
end;

(* The file fd makes size bytes long, cut or filled with zeros; its
   position stays. 0, or minus an errno. *)
proc truncate*(fd: INT; size: I64): INT;
begin
    if C.ftruncate(I32(fd), size) # 0 then return failed(); end;
    return 0;
end;

(* Returns once what was written to fd is on the disk: 0, or minus an
   errno. *)
proc sync*(fd: INT): INT;
begin
    if C.fsync(I32(fd)) # 0 then return failed(); end;
    return 0;
end;

(* Returns once everything written to the file system that holds fd
   is on the disk: 0, or minus an errno. POSIX has no call for one file
   system, so it is sync's, which flushes them all and does no less;
   fd is still asked whether it is open, for the -9 (EBADF) Linux's
   syncfs gives one that isn't. *)
proc syncAll*(fd: INT): INT;
begin
    if C.fcntl(I32(fd), 1, 0) < 0 then return failed(); end;   (* F_GETFD *)
    C.sync;
    return 0;
end;

(* Takes the lock on the open file fd, which only one program holds at
   a time, and which goes when fd is closed or the program ends,
   however it ends. If another program holds it, waits for it if wait,
   and otherwise returns -11 (EAGAIN). 0, or minus an errno. *)
proc lock*(fd: INT; wait: BOOL): INT;
var how: I32;
begin
    how := 2;                                          (* LOCK_EX *)
    if not wait then how := how | 4; end;              (* LOCK_NB *)
    if C.flock(I32(fd), how) # 0 then return failed(); end;
    return 0;
end;

(* Closes the file descriptor fd. *)
proc close*(fd: INT);
begin
    _ := C.close(I32(fd));
end;

(* A new file descriptor for the file fd is open on, the lowest free:
   it, or minus an errno. *)
proc dup*(fd: INT): INT;
var r: I32;
begin
    r := C.dup(I32(fd));
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* Makes the file descriptor into stand for the file fd is open on,
   closing what into was first: into, or minus an errno. *)
proc dupTo*(fd, into: INT): INT;
var r: I32;
begin
    r := C.dup2(I32(fd), I32(into));
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* Whether fd stays open in the program exec runs in this one's place:
   yes, or no, closed then, as pipe's fds are at first. 0, or minus an
   errno. *)
proc keepOnExec*(fd: INT; yes: BOOL): INT;
var f: I32;
begin
    f := C.fcntl(I32(fd), 1, 0);                    (* F_GETFD *)
    if f < 0 then return failed(); end;
    if yes then f := f & ~1; else f := f | 1; end;  (* FD_CLOEXEC *)
    if C.fcntl(I32(fd), 2, f) < 0 then return failed(); end;   (* F_SETFD *)
    return 0;
end;

(* size bytes of fresh, zeroed memory from the system, a multiple of
   pages, or nil. *)
proc mmap*(size: INT): ^U8;
var p: ^U8;
begin
    p := C.mmap(nil, UINT(size), 3, 22H, -1, 0);   (* read, write; private, anonymous *)
    if INT(p) = -1 then return nil; end;
    return p;
end;

(* Gives back to the system the size bytes at p that mmap gave. *)
proc munmap*(p: ^U8; size: INT);
begin
    _ := C.munmap(p, UINT(size));
end;

(* A file in memory, with no name, of size zeroed bytes: its fd, or
   minus an errno. It is closed in a program exec starts. *)
proc memFile*(size: INT): INT;
var name: [4]U8; fd: I32; err: INT;
begin
    _ := cstr("raz", name);                     (* the name /proc shows *)
    fd := C.memfd_create(ADR(name[0]), 1);      (* MFD_CLOEXEC *)
    if fd < 0 then return failed(); end;
    if C.ftruncate(fd, I64(size)) # 0 then
        err := failed();                        (* before close can change errno *)
        _ := C.close(fd);
        return err;
    end;
    return INT(fd);
end;

(* The first size bytes of the file fd, mapped to be read and written,
   and shared: what this program writes there, every program that maps
   the file sees. nil if it can't be; munmap gives them back. *)
proc mapFile*(fd, size: INT): ^U8;
var p: ^U8;
begin
    p := C.mmap(nil, UINT(size), 3, 1, I32(fd), 0);   (* read, write; MAP_SHARED *)
    if INT(p) = -1 then return nil; end;
    return p;
end;

(* Renames old to new, replacing what new names: 0, or minus an errno. *)
proc rename*(old, new: []U8): INT;
var a, b: [4096]U8;
begin
    if not cstr(old, a) or not cstr(new, b) then return -36; end;
    if C.rename(ADR(a[0]), ADR(b[0])) # 0 then return failed(); end;
    return 0;
end;

(* Removes the file at path; not a directory. *)
proc remove*(path: []U8): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.unlink(ADR(a[0])) # 0 then return failed(); end;
    return 0;
end;

(* Makes a directory at path, readable by all, writable by its owner. *)
proc makeDir*(path: []U8): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.mkdir(ADR(a[0]), 1EDH) # 0 then return failed(); end;   (* mode 755 *)
    return 0;
end;

(* Removes the directory at path, which must be empty. *)
proc removeDir*(path: []U8): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.rmdir(ADR(a[0])) # 0 then return failed(); end;
    return 0;
end;

(* Sets the permission bits of what path names. *)
proc chmod*(path: []U8; mode: INT): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.chmod(ADR(a[0]), U32(mode)) # 0 then return failed(); end;
    return 0;
end;

(* 0 if this user, by its real ids, may do with path what how asks:
   reading, writing and executing; minus an errno, -13 (EACCES) if not.
   An empty how asks only whether path is there. *)
proc access*(path: []U8; how: Accesses): INT;
var a: [4096]U8; m: I32;
begin
    if not cstr(path, a) then return -36; end;
    m := 0;                                         (* F_OK *)
    if reading in how then m := m | 4; end;         (* R_OK *)
    if writing in how then m := m | 2; end;         (* W_OK *)
    if executing in how then m := m | 1; end;       (* X_OK *)
    if C.access(ADR(a[0]), m) # 0 then return failed(); end;
    return 0;
end;

(* Sets the bits taken from every file this program, and the programs
   it starts, make: the mask it was. *)
proc umask*(mask: INT): INT;
begin
    return INT(C.umask(U32(mask & 1FFH)) & 1FFH);
end;

(* Makes path a symbolic link to target. *)
proc symlink*(target, path: []U8): INT;
var a, b: [4096]U8;
begin
    if not cstr(target, a) or not cstr(path, b) then return -36; end;
    if C.symlink(ADR(a[0]), ADR(b[0])) # 0 then return failed(); end;
    return 0;
end;

(* What the symbolic link at path names, good until the next call; and
   0, or minus an errno. *)
proc readLink*(path: []U8): ([]U8, INT);
var a: [4096]U8; n: INT;
begin
    if not cstr(path, a) then return "", -36; end;
    n := C.readlink(ADR(a[0]), ADR(linked[0]), UINT(LEN(linked)));
    if n < 0 then return "", failed(); end;
    if n = LEN(linked) then return "", -36; end;          (* it may be cut short *)
    return linked[0..n], 0;
end;

(* An Info from a struct stat, all but symlink. *)
proc fromStat(st: [18]INT): Info;
var i: Info;
begin
    i.size := st[6];                                 (* st_size *)
    i.dev := U64(st[0]);                             (* st_dev *)
    i.ino := U64(st[1]);                             (* st_ino *)
    i.mtime := st[11] * 1000000000 + st[12];         (* st_mtim *)
    i.mode := st[3] & 1FFH;
    i.dir := st[3] & 0F000H = 4000H;               (* S_IFDIR *)
    i.file := st[3] & 0F000H = 8000H;              (* S_IFREG *)
    return i;
end;

(* The size of what path names, whether it is a directory or a regular
   file, following a symbolic link, and whether path is one; and 0, or
   minus an errno. *)
proc info*(path: []U8): (Info, INT);
var a: [4096]U8; st: [18]INT; i: Info; isLink: BOOL;   (* glibc's struct stat: 144 bytes *)
begin
    if not cstr(path, a) then return i, -36; end;
    if C.lstat(ADR(a[0]), ^U8(ADR(st))) # 0 then return i, failed(); end;
    isLink := st[3] & 0F000H = 0A000H;                 (* st_mode is S_IFLNK *)
    if C.stat(ADR(a[0]), ^U8(ADR(st))) # 0 then return i, failed(); end;
    i := fromStat(st);
    i.symlink := isLink;
    return i, 0;
end;

(* info of path itself: if it is a symbolic link, of the link, not of
   what it names, so that symlink is true, dir and file false, and the
   size the length of what it names. *)
proc linkInfo*(path: []U8): (Info, INT);
var a: [4096]U8; st: [18]INT; i: Info;
begin
    if not cstr(path, a) then return i, -36; end;
    if C.lstat(ADR(a[0]), ^U8(ADR(st))) # 0 then return i, failed(); end;
    i := fromStat(st);
    i.symlink := st[3] & 0F000H = 0A000H;              (* S_IFLNK *)
    return i, 0;
end;

(* info of the file open on fd, which is never a link. *)
proc infoOf*(fd: INT): (Info, INT);
var st: [18]INT; i: Info;
begin
    if C.fstat(I32(fd), ^U8(ADR(st))) # 0 then return i, failed(); end;
    return fromStat(st), 0;
end;

(* The bytes free to an ordinary user on path's file system, and the
   bytes in all. *)
proc space*(path: []U8): (I64, I64, INT);
var a: [4096]U8; st: [14]INT;    (* glibc's struct statvfs: 112 bytes *)
begin
    if not cstr(path, a) then return 0, 0, -36; end;
    if C.statvfs(ADR(a[0]), ^U8(ADR(st))) # 0 then return 0, 0, failed(); end;
    return st[4] * st[1], st[2] * st[1], 0;          (* f_bavail, f_blocks, in f_frsize *)
end;

(* The Kind of a d_type, as getdents64 and readdir give it: DT_REG is
   8, DT_DIR 4, DT_LNK 10, DT_UNKNOWN 0, and the rest (pipes, devices,
   sockets) other things. *)
proc kindOf(t: U8): Kind;
begin
    if t = 8 then return isFile;
    elsif t = 4 then return isDir;
    elsif t = 10 then return isLink;
    elsif t = 0 then return unknown;
    end;
    return isOther;
end;

(* Opens the directory at path, for nextEntry. *)
proc openDir*(d: ^Dir; path: []U8): INT;
var a: [4096]U8;
begin
    d^.kind := unknown;
    if not cstr(path, a) then return -36; end;
    d^.d := C.opendir(ADR(a[0]));
    if d^.d = nil then return failed(); end;
    return 0;
end;

(* The next name in the directory, good until the next call, but . and
   .., in no order; false at the end. *)
proc nextEntry*(d: ^Dir): ([]U8, BOOL);
var e: ^U8; n: INT;
begin
    while true do
        e := C.readdir(d^.d);
        if e = nil then return "", false; end;
        d^.kind := kindOf(e[DirentType]);
        e := e + DirentName;
        n := 0;
        while e[n] # 0 do INC(n); end;
        if (e[0..n] # ".") and (e[0..n] # "..") then return e[0..n], true; end;
    end;
    return "", false;
end;

(* What the name nextEntry gave last is, as the directory says, so that
   a walk needn't ask each file with linkInfo; unknown where the file
   system doesn't say. A link is isLink, whatever it names. *)
proc entryKind*(d: ^Dir): Kind;
begin
    return d^.kind;
end;

(* Closes the directory d that openDir opened. *)
proc closeDir*(d: ^Dir);
begin
    _ := C.closedir(d^.d);
end;

(* Puts the terminal on fd into raw mode, as cfmakeraw makes it: no
   echo, no lines, no signals, no flow control, no CR to NL, no NL to
   CR NL; false if fd isn't a terminal. *)
proc rawMode*(fd: INT): BOOL;
var t: [256]U8;
begin
    if C.tcgetattr(I32(fd), ADR(saved[0])) # 0 then return false; end;
    t := saved;
    C.cfmakeraw(ADR(t[0]));
    return C.tcsetattr(I32(fd), 0, ADR(t[0])) = 0;   (* TCSANOW *)
end;

(* The terminal on fd as rawMode found it. *)
proc restoreMode*(fd: INT);
begin
    _ := C.tcsetattr(I32(fd), 0, ADR(saved[0]));
end;

(* The modes of the terminal on fd, as a shell keeps them for each job;
   and 0, or minus an errno, -25 (ENOTTY) if it isn't a terminal. *)
proc getMode*(fd: INT): (Mode, INT);
var m: Mode;
begin
    if C.tcgetattr(I32(fd), ADR(m.t[0])) # 0 then return m, failed(); end;
    return m, 0;
end;

(* Gives the terminal on fd the modes m, once what was written to it
   is sent: 0, or minus an errno. *)
proc setMode*(fd: INT; m: Mode): INT;
begin
    if C.tcsetattr(I32(fd), 1, ADR(m.t[0])) # 0 then return failed(); end;   (* TCSADRAIN *)
    return 0;
end;

(* The columns and rows of the terminal on fd; 80 by 24 if it doesn't
   say. *)
proc termSize*(fd: INT): (INT, INT);
var w: Winsize;
begin
    if (C.ioctl(I32(fd), TIOCGWINSZ, ADR(w)) # 0) or (w.cols = 0) or (w.rows = 0) then
        return 80, 24;
    end;
    return INT(w.cols), INT(w.rows);
end;

(* Whether fd has something to read within ms milliseconds; ms < 0
   waits as long as it takes. *)
proc ready*(fd, ms: INT): BOOL;
var p: Pollfd; r: I32;
begin
    p := {fd: I32(fd), events: 1};                   (* POLLIN *)
    repeat r := C.poll(^U8(ADR(p)), 1, I32(ms)); until (r >= 0) or (failed() # -4);   (* EINTR: a signal caught *)
    return r > 0;
end;

(* The time on clock, in nanoseconds. *)
proc time(clock: I32): I64;
var t: Timespec;
begin
    _ := C.clock_gettime(clock, ^U8(ADR(t)));
    return t.sec * 1000000000 + t.nsec;
end;

(* The clock that only goes forward, in nanoseconds: for how long
   something takes. *)
proc clock*: I64;
begin
    return time(1);                                     (* CLOCK_MONOTONIC *)
end;

(* The time in nanoseconds since 1970-01-01, UTC. *)
proc now*: I64;
begin
    return time(0);                                     (* CLOCK_REALTIME *)
end;

(* Waits ms milliseconds. *)
proc sleep*(ms: INT);
var t: Timespec; at: I64;
begin
    at := clock() + I64(ms) * 1000000;
    t := {sec: at div 1000000000, nsec: at mod 1000000000};
    repeat until C.clock_nanosleep(1, 1, ^U8(ADR(t)), nil) # 4;   (* until t, again after EINTR *)
end;

(* Fills b with random bytes, from the kernel. *)
proc random*(b: []U8);
var n, r: INT;
begin
    n := 0;
    while n < LEN(b) do                                 (* a signal may cut it short *)
        r := C.getrandom(ADR(b[n]), UINT(LEN(b) - n), 0);
        if r > 0 then INC(n, r); end;
    end;
end;

(* A socket of family and kind, connected to the address at a, of size
   bytes, or, if serving, bound to it and taking connections: its file
   descriptor, or minus an errno. It is closed in a program exec
   starts. *)
proc socket(family, kind: INT; a: ^U8; size: INT; serving: BOOL): INT;
var fd, r, one: I32; err: INT;
begin
    fd := C.socket(I32(family), I32(kind) | 80000H, 0);    (* SOCK_CLOEXEC *)
    if fd < 0 then return failed(); end;
    if serving then
        one := 1;                                       (* so that a server can start again at once *)
        _ := C.setsockopt(fd, 1, 2, ^U8(ADR(one)), 4);  (* SOL_SOCKET, SO_REUSEADDR *)
        r := C.bind(fd, a, U32(size));
        if (r = 0) and (kind = 1) then                  (* a stream socket takes connections; *)
            r := C.listen(fd, 4096);                    (* one of datagrams only receives *)
        end;
    else
        r := C.connect(fd, a, U32(size));
    end;
    if r # 0 then
        err := failed();                                (* before close can change errno *)
        _ := C.close(fd);
        return err;
    end;
    return INT(fd);
end;

(* path as a Unix socket's address in a, or false if it is too long. *)
proc unixAddr(path: []U8; a: ^SockaddrUn): BOOL;
begin
    if LEN(path) >= LEN(a^.path) then return false; end;
    a^.family := 1;                                     (* AF_UNIX *)
    COPY(a^.path, path);
    return true;
end;

(* A stream socket connected to the Unix socket at path. *)
proc connect*(path: []U8): INT;
var a: SockaddrUn;
begin
    if not unixAddr(path, ADR(a)) then return -36; end;    (* ENAMETOOLONG *)
    return socket(1, 1, ^U8(ADR(a)), SIZE(SockaddrUn), false);   (* SOCK_STREAM *)
end;

(* A stream socket made at path, which must not be there yet, taking
   connections. *)
proc listen*(path: []U8): INT;
var a: SockaddrUn;
begin
    if not unixAddr(path, ADR(a)) then return -36; end;
    return socket(1, 1, ^U8(ADR(a)), SIZE(SockaddrUn), true);
end;

(* addr, an IPv4 or IPv6 address as numbers, and port, in a: the size
   of its struct sockaddr_in or sockaddr_in6, or 0 if either is
   wrong. *)
proc inetAddr(addr: []U8; port: INT; a: ^Sockaddr): INT;
var s: [64]U8;
begin
    if (port < 0) or (port > 65535) or not cstr(addr, s) then return 0; end;
    a^.port[0] := U8(port shr 8);                       (* in the network's order, the high byte first *)
    a^.port[1] := U8(port & 255);
    if C.inet_pton(2, ADR(s[0]), ADR(a^.data[0])) = 1 then a^.family := 2; return 16; end;     (* AF_INET *)
    if C.inet_pton(10, ADR(s[0]), ADR(a^.data[4])) = 1 then a^.family := 10; return 28; end;   (* AF_INET6 *)
    return 0;
end;

(* A socket of kind at addr and port, as socket makes it; -22 (EINVAL)
   if they are wrong. *)
proc inet(addr: []U8; port, kind: INT; serving: BOOL): INT;
var a: Sockaddr; size: INT;
begin
    size := inetAddr(addr, port, ADR(a));
    if size = 0 then return -22; end;
    return socket(INT(a.family), kind, ^U8(ADR(a)), size, serving);
end;

(* A stream socket connected to port at addr, an IPv4 or IPv6 address
   as numbers. *)
proc connectTcp*(addr: []U8; port: INT): INT;
begin
    return inet(addr, port, 1, false);                  (* SOCK_STREAM *)
end;

(* A socket of datagrams to and from port at addr. *)
proc connectUdp*(addr: []U8; port: INT): INT;
begin
    return inet(addr, port, 2, false);                  (* SOCK_DGRAM *)
end;

(* A stream socket taking connections on port at addr; "0.0.0.0" or
   "::" is every address the machine has. *)
proc listenTcp*(addr: []U8; port: INT): INT;
begin
    return inet(addr, port, 1, true);
end;

(* A socket of datagrams on port at addr, from anyone, for receive and
   reply. *)
proc listenUdp*(addr: []U8; port: INT): INT;
begin
    return inet(addr, port, 2, true);
end;

(* The next connection to the socket fd, waiting for one: a socket of
   its own, closed in a program exec starts; or minus an errno. *)
proc accept*(fd: INT): INT;
var r: I32;
begin
    r := C.accept4(I32(fd), nil, nil, 80000H);          (* SOCK_CLOEXEC *)
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* Writes s to the socket fd, as write does, but returns -32 (EPIPE)
   where write would stop the program with SIGPIPE: when the other end
   has closed it. *)
proc send*(fd: INT; s: []U8): INT;
var r: INT;
begin
    if LEN(s) = 0 then return 0; end;
    r := C.send(I32(fd), ADR(s[0]), UINT(LEN(s)), 4000H);   (* MSG_NOSIGNAL, glibc's *)
    if r < 0 then return failed(); end;
    return r;
end;

(* The first of reads that has something to read within ms
   milliseconds, or of writes that has room to write, or that has
   reached its end or failed, so that a read or a write won't wait; -1
   if none has. ms < 0 waits as long as it takes. At most 64 fds in
   all. *)
proc readyFor*(reads, writes: []INT; ms: INT): INT;
var p: [64]Pollfd; n, i: INT; r: I32;
begin
    n := 0;
    for i := 0 to LEN(reads) - 1 do
        if n < LEN(p) then
            p[n] := {fd: I32(reads[i]), events: 1};                         (* POLLIN *)
            INC(n);
        end;
    end;
    for i := 0 to LEN(writes) - 1 do
        if n < LEN(p) then
            p[n] := {fd: I32(writes[i]), events: 4};                        (* POLLOUT *)
            INC(n);
        end;
    end;
    repeat r := C.poll(^U8(ADR(p)), UINT(n), I32(ms)); until (r >= 0) or (failed() # -4);   (* EINTR *)
    if r <= 0 then return -1; end;
    for i := 0 to n - 1 do
        if p[i].revents # 0 then return INT(p[i].fd); end;
    end;
    return -1;
end;

(* The first of fds that has something to read within ms milliseconds,
   or that has reached its end or failed, so that a read won't wait; -1
   if none has. ms < 0 waits as long as it takes. At most 64 fds. *)
proc readyOf*(fds: []INT; ms: INT): INT;
begin
    return readyFor(fds, [], ms);
end;

(* Reads and writes on fd made to wait, as they do at first; or, if not
   yes, to return -11 (EAGAIN) at once where they would wait. 0, or
   minus an errno. *)
proc setBlocking*(fd: INT; yes: BOOL): INT;
var flags: I32;
begin
    flags := C.fcntl(I32(fd), 3, 0);                (* F_GETFL *)
    if flags < 0 then return failed(); end;
    if yes then flags := flags & ~I32(800H); else flags := flags | 800H; end;   (* O_NONBLOCK *)
    if C.fcntl(I32(fd), 4, flags) < 0 then return failed(); end;           (* F_SETFL *)
    return 0;
end;

(* The address of b's first byte, or nil if it has none, for a call
   that takes an address and a length. *)
proc bytes(b: []U8): ^U8;
begin
    if LEN(b) = 0 then return nil; end;
    return ADR(b[0]);
end;

(* A stream socket connected to port at addr, as connectTcp makes it,
   or -110 (ETIMEDOUT) if it isn't connected within ms milliseconds.
   It starts to connect without waiting, then waits for the socket to
   be writable, which it is once connected or refused, and asks which. *)
proc connectTcpWithin*(addr: []U8; port, ms: INT): INT;
var a: Sockaddr; size, r: INT; fd, err: I32; errSize: U32;
begin
    size := inetAddr(addr, port, ADR(a));
    if size = 0 then return -22; end;
    fd := C.socket(I32(a.family), 1 | 80800H, 0);      (* SOCK_STREAM, SOCK_CLOEXEC, SOCK_NONBLOCK *)
    if fd < 0 then return failed(); end;
    r := 0;
    if C.connect(fd, ^U8(ADR(a)), U32(size)) # 0 then r := failed(); end;
    if r = -115 then                                    (* EINPROGRESS *)
        r := -110;
        if readyFor([], [INT(fd)], ms) = INT(fd) then
            errSize := 4;
            if C.getsockopt(fd, 1, 4, ^U8(ADR(err)), ADR(errSize)) = 0 then   (* SOL_SOCKET, SO_ERROR *)
                r := -INT(err);
            else
                r := failed();
            end;
        end;
    end;
    if r = 0 then r := setBlocking(INT(fd), true); end;
    if r < 0 then _ := C.close(fd); return r; end;
    return INT(fd);
end;

(* The port the socket fd is bound to, or minus an errno: for a socket
   made on port 0, the one the system chose. *)
proc localPort*(fd: INT): INT;
var a: Sockaddr; size: U32;
begin
    size := U32(SIZE(Sockaddr));
    if C.getsockname(I32(fd), ^U8(ADR(a)), ADR(size)) # 0 then return failed(); end;
    return (INT(a.port[0]) shl 8) | INT(a.port[1]);
end;

(* The next datagram to the socket fd, waiting for one: its first
   LEN(buf) bytes in buf, the rest lost, and who sent it. The number is
   the bytes in buf, or minus an errno. *)
proc receive*(fd: INT; buf: []U8): (INT, Peer);
var p: Peer; size: U32; n: INT;
begin
    size := U32(SIZE(Sockaddr));
    n := C.recvfrom(I32(fd), bytes(buf), UINT(LEN(buf)), 0, ^U8(ADR(p.a)), ADR(size));
    if n < 0 then n := failed(); end;
    p.size := INT(size);
    return n, p;
end;

(* Sends s, as one datagram, from the socket fd to peer, as receive
   gave it: the bytes sent, or minus an errno. *)
proc reply*(fd: INT; peer: Peer; s: []U8): INT;
var r: INT;
begin
    r := C.sendto(I32(fd), bytes(s), UINT(LEN(s)), 4000H, ^U8(ADR(peer.a)), U32(peer.size));   (* MSG_NOSIGNAL *)
    if r < 0 then return failed(); end;
    return r;
end;

(* Sends s, at least one byte, to the Unix socket fd, as send does, and
   with it the files fds, at most 16, which the program that receives
   them then has open too: the bytes sent, or minus an errno. *)
proc sendFds*(fd: INT; s: []U8; fds: []INT): INT;
var m: Msghdr; v: Iovec; c: Rights; i, r: INT;
begin
    if (LEN(s) = 0) or (LEN(fds) > LEN(c.fds)) then return -22; end;
    v := {base: ADR(s[0]), size: LEN(s)};
    m := {iov: ADR(v), iovLen: 1};
    if LEN(fds) > 0 then
        c := {size: 16 + 4 * LEN(fds), level: 1, kind: 1};     (* SOL_SOCKET, SCM_RIGHTS *)
        for i := 0 to LEN(fds) - 1 do c.fds[i] := I32(fds[i]); end;
        m.control := ^U8(ADR(c));
        m.controlSize := (c.size + 7) & ~7;              (* CMSG_SPACE: whole quadwords *)
    end;
    r := C.sendmsg(I32(fd), ^U8(ADR(m)), 4000H);  (* MSG_NOSIGNAL *)
    if r < 0 then return failed(); end;
    return r;
end;

(* Reads into buf from the Unix socket fd, as read does, and puts the
   files sent with what it read in fds, as many as fit, closing the
   rest: the bytes read, or minus an errno, and the files put in fds.
   Each is closed in a program exec starts. *)
proc receiveFds*(fd: INT; buf: []U8; fds: []INT): (INT, INT);
var m: Msghdr; v: Iovec; c: Rights; n, k, i: INT;
begin
    v := {base: bytes(buf), size: LEN(buf)};
    m := {iov: ADR(v), iovLen: 1, control: ^U8(ADR(c)), controlSize: SIZE(Rights)};
    n := C.recvmsg(I32(fd), ^U8(ADR(m)), 40000000H);   (* MSG_CMSG_CLOEXEC *)
    if n < 0 then return failed(), 0; end;
    k := 0;
    if (m.controlSize >= 16) and (c.level = 1) and (c.kind = 1) then
        for i := 0 to (c.size - 16) div 4 - 1 do
            if k < LEN(fds) then
                fds[k] := INT(c.fds[i]);
                INC(k);
            else
                _ := C.close(c.fds[i]);
            end;
        end;
    end;
    return n, k;
end;

(* The value of the environment variable name; "" if it isn't set. *)
proc env*(name: []U8): []U8;
var a: [4096]U8; s: ^U8; n: INT;
begin
    if not cstr(name, a) then return ""; end;
    s := C.getenv(ADR(a[0]));
    if s = nil then return ""; end;
    n := 0;
    while s[n] # 0 do INC(n); end;
    return s[0..n];
end;

(* The environment's ith NAME=value, from 0, and true; "" and false
   past the last. *)
proc envAt*(i: INT): ([]U8, BOOL);
var e: ^^U8; s: ^U8; j, n: INT;
begin
    if i < 0 then return "", false; end;
    e := C.environ;
    for j := 0 to i do
        if e[j] = nil then return "", false; end;
    end;
    s := e[i];
    n := 0;
    while s[n] # 0 do INC(n); end;
    return s[0..n], true;
end;

(* The working directory, good until the next call; and 0, or minus an
   errno. *)
proc workDir*: ([]U8, INT);
var n: INT;
begin
    if C.getcwd(ADR(cwd[0]), LEN(cwd)) = nil then return "", failed(); end;
    n := 0;
    while cwd[n] # 0 do INC(n); end;
    return cwd[0..n], 0;
end;

(* Makes path the working directory. *)
proc setWorkDir*(path: []U8): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.chdir(ADR(a[0])) # 0 then return failed(); end;
    return 0;
end;

(* A pseudo-terminal: the file descriptor of its controlling side, or
   minus an errno. Its other side, the terminal its programs run on, is
   unlocked, for spawn to open. *)
proc openPty*: INT;
var fd: I32; err: INT;
begin
    fd := C.posix_openpt(102H);                       (* O_RDWR, O_NOCTTY: glibc's *)
    if fd < 0 then return failed(); end;
    if (C.grantpt(fd) # 0) or (C.unlockpt(fd) # 0) then
        err := failed();
        _ := C.close(fd);
        return err;
    end;
    return INT(fd);
end;

(* Tells the terminal of the pseudo-terminal fd that it has cols
   columns and rows rows: 0, or minus an errno. *)
proc setTermSize*(fd, cols, rows: INT): INT;
var w: Winsize;
begin
    w := {rows: U16(rows), cols: U16(cols)};
    if C.ioctl(I32(fd), TIOCSWINSZ, ADR(w)) # 0 then return failed(); end;
    return 0;
end;

(* Copies s and a zero to at: the byte after them. *)
proc put(s: []U8; at: ^U8): ^U8;
begin
    COPY(at[0..LEN(s)], s);
    at[LEN(s)] := 0;
    return at + (LEN(s) + 1);
end;

(* Whether the NAME=value s, a C string, names a variable that one of
   env gives. *)
proc replaced(s: ^U8; env: [][]U8): BOOL;
var i, n: INT;
begin
    for i := 0 to LEN(env) - 1 do
        n := 0;
        while (n < LEN(env[i])) and (s[n] = env[i][n]) and (s[n] # '=') do INC(n); end;
        if (n < LEN(env[i])) and (env[i][n] = '=') and (s[n] = '=') then return true; end;
    end;
    return false;
end;

(* What execve takes, in fresh memory of the size returned: args as C
   strings and a nil, then the environment old with each NAME=value of
   env in place of its variable or added, and a nil; or nil. The
   environment follows the arguments. *)
proc argsAndEnv(args, env: [][]U8; old: ^^U8): (^^U8, INT);
var p: ^^U8; s: ^U8; size, n, i, k: INT;
begin
    n := 0;
    while old[n] # nil do INC(n); end;
    size := (LEN(args) + n + LEN(env) + 2) * SIZE(^U8);
    for i := 0 to LEN(args) - 1 do INC(size, LEN(args[i]) + 1); end;
    for i := 0 to LEN(env) - 1 do INC(size, LEN(env[i]) + 1); end;
    p := ^^U8(mmap(size));
    if p = nil then return nil, 0; end;
    s := ^U8(p + (LEN(args) + n + LEN(env) + 2));
    k := 0;
    for i := 0 to LEN(args) - 1 do p[k] := s; s := put(args[i], s); INC(k); end;
    p[k] := nil;
    INC(k);
    for i := 0 to n - 1 do
        if not replaced(old[i], env) then p[k] := old[i]; INC(k); end;
    end;
    for i := 0 to LEN(env) - 1 do p[k] := s; s := put(env[i], s); INC(k); end;
    p[k] := nil;
    return p, size;
end;

(* A pipe: the fd to read and the fd to write, both closed in a program
   exec starts; or minus an errno and -1. *)
proc pipe*: (INT, INT);
var fds: [2]I32;
begin
    if C.pipe2(ADR(fds[0]), 80000H) # 0 then return failed(), -1; end;   (* O_CLOEXEC, glibc's *)
    return INT(fds[0]), INT(fds[1]);
end;

(* This program's process id. *)
proc pid*: INT;
begin
    return INT(C.getpid());
end;

(* The user this program runs as: its real id. *)
proc uid*: INT;
begin
    return INT(C.getuid());
end;

(* The user whose rights this program has, its effective id: 0 is
   root. *)
proc euid*: INT;
begin
    return INT(C.geteuid());
end;

(* The name of this machine, good until the next call; and 0, or minus
   an errno. *)
proc hostName*: ([]U8, INT);
var n: INT;
begin
    if C.gethostname(ADR(host[0]), LEN(host) - 1) # 0 then return "", failed(); end;
    host[LEN(host) - 1] := 0;                         (* POSIX doesn't promise one if it is cut *)
    n := 0;
    while host[n] # 0 do INC(n); end;
    return host[0..n], 0;
end;

(* The time on the processor, in ns, that this program has used, or,
   if children, the programs it started and waited for: in the program
   itself, and in the system for it. *)
proc cpuTime*(children: BOOL): (I64, I64);
var ru: Rusage;
begin
    if children then _ := C.getrusage(-1, ^U8(ADR(ru)));   (* RUSAGE_CHILDREN *)
    else _ := C.getrusage(0, ^U8(ADR(ru)));                (* RUSAGE_SELF *)
    end;
    return ru.user.sec * 1000000000 + I64(ru.user.usec) * 1000,
        ru.system.sec * 1000000000 + I64(ru.system.usec) * 1000;
end;

(* The limit which, one of the limit constants: the soft one, which
   this program may raise up to the hard one; -1 for none; and 0, or
   minus an errno. *)
proc limit*(which: INT): (I64, I64, INT);
var r: [2]I64;   (* struct rlimit; RLIM_INFINITY is -1 *)
begin
    if C.getrlimit(I32(which), ^U8(ADR(r))) # 0 then return 0, 0, failed(); end;
    return r[0], r[1], 0;
end;

(* Sets the limit which to soft and hard, -1 for none: 0, or minus an
   errno. *)
proc setLimit*(which: INT; soft, hard: I64): INT;
var r: [2]I64;
begin
    r := [soft, hard];
    if C.setrlimit(I32(which), ^U8(ADR(r))) # 0 then return failed(); end;
    return 0;
end;

(* Moves the program pid, or this one if pid is 0, to the process group
   group, or to a new one it leads if group is 0. *)
proc setGroup*(pid, group: INT): INT;
begin
    if C.setpgid(I32(pid), I32(group)) # 0 then return failed(); end;
    return 0;
end;

(* Gives the keys of the terminal on fd, and its signals, to the process
   group group. *)
proc foreground*(fd, group: INT): INT;
begin
    if C.tcsetpgrp(I32(fd), I32(group)) # 0 then return failed(); end;
    return 0;
end;

(* The process group the terminal on fd gives its keys to, or minus an
   errno. *)
proc foregroundOf*(fd: INT): INT;
var g: I32;
begin
    g := C.tcgetpgrp(I32(fd));
    if g < 0 then return failed(); end;
    return INT(g);
end;

(* Where spawn looks for a program named without a /, if PATH is unset
   or empty: glibc's execvp looks in these. *)
const defaultPath = "/bin:/usr/bin";

(* The ith directory of search, a list of them with : between, as PATH
   is: dir, "." if it is empty, and where the next starts; -1 past the
   last. *)
proc pathDir(search: []U8; i: INT): ([]U8, INT);
var j: INT;
begin
    if i > LEN(search) then return "", -1; end;
    j := i;
    while (j < LEN(search)) and (search[j] # ':') do INC(j); end;
    if j = i then return ".", j + 1; end;
    return search[i..j], j + 1;
end;

(* dir, a /, and name, a C string in buf; false if it doesn't fit. *)
proc joinPath(dir, name, buf: []U8): BOOL;
var n: INT;
begin
    n := LEN(dir) + 1 + LEN(name);
    if n >= LEN(buf) then return false; end;
    COPY(buf, dir);
    buf[LEN(dir)] := '/';
    COPY(buf[LEN(dir) + 1..n], name);
    buf[n] := 0;
    return true;
end;

(* Whether name holds a /, and so is a path, not a name to look for. *)
proc isPath(name: []U8): BOOL;
var i: INT;
begin
    for i := 0 to LEN(name) - 1 do
        if name[i] = '/' then return true; end;
    end;
    return false;
end;

(* Runs the program at name, as execve does; or, for a name without a
   /, the first program of that name in the directories of search, as
   execvp does: each in turn, an empty one being the working directory.
   It returns only if none could be run. It runs in spawn's child, after
   the fork, so it takes no memory: each path is made in buf. *)
proc run(name, search, buf: []U8; argv, envp: ^^U8);
var dir: []U8; i: INT;
begin
    if isPath(name) or (LEN(name) = 0) then
        if cstr(name, buf) then _ := C.execve(ADR(buf[0]), argv, envp); end;
        return;
    end;
    dir, i := pathDir(search, 0);
    while i >= 0 do
        if joinPath(dir, name, buf) then _ := C.execve(ADR(buf[0]), argv, envp); end;
        dir, i := pathDir(search, i);
    end;
end;

(* The program exec runs for name, as a C string in buf: name itself
   if it has a /, or else the first file of that name in the
   directories of search that is no directory and that this user may
   run. 0; or -2 (ENOENT) if there is none, or -13 (EACCES) if one is
   there and can't be run. *)
proc find(name, search, buf: []U8): INT;
var dir: []U8; i, err, r: INT; f: Info;
begin
    if isPath(name) then
        if not cstr(name, buf) then return -36; end;
        return 0;
    end;
    r := -2;                                          (* ENOENT *)
    dir, i := pathDir(search, 0);
    while (LEN(name) > 0) and (i >= 0) do
        if joinPath(dir, name, buf) then
            f, err := info(buf[0..LEN(dir) + 1 + LEN(name)]);
            if (err = 0) and not f.dir then
                if C.access(ADR(buf[0]), 1) = 0 then return 0; end;   (* X_OK *)
                r := -13;                             (* EACCES *)
            end;
        end;
        dir, i := pathDir(search, i);
    end;
    return r;
end;

(* The name of the terminal of the pseudo-terminal fd, as a C string
   in name, which isn't safe to ask after a fork: 0, or minus an
   errno. *)
proc ptyName(fd: INT; name: []U8): INT;
var s: ^U8; n: INT;
begin
    s := C.ptsname(I32(fd));
    if s = nil then return failed(); end;
    n := 0;
    while s[n] # 0 do INC(n); end;
    if not cstr(s[0..n], name) then return -36; end;
    return 0;
end;

(* Closes every fd from 3 on but those of keep, which stay open in the
   program exec starts. It runs in spawn's child, after the fork, so it
   takes no memory: it closes the runs between the fds kept, the lowest
   first, each with one close_range. *)
proc closeAllBut(keep: []INT);
var lo, next, i: INT;
begin
    lo := 3;
    repeat
        next := -1;
        for i := 0 to LEN(keep) - 1 do
            if (keep[i] >= lo) and ((next < 0) or (keep[i] < next)) then next := keep[i]; end;
        end;
        if next < 0 then
            _ := C.close_range(U32(lo), 0FFFFFFFFH, 0);    (* the rest *)
        else
            if next > lo then _ := C.close_range(U32(lo), U32(next - 1), 0); end;
            _ := C.fcntl(I32(next), 2, 0);              (* F_SETFD: kept on exec *)
            lo := next + 1;
        end;
    until next < 0;
end;

(* What p asks of the program before it runs, done to this one: a
   session on the terminal name, if p.tty, or else its group, its
   terminal's foreground, and its standard input, output and error;
   then its working directory, the C string dir. 0, or minus an
   errno. *)
proc takeOn(p: Program; name, dir: []U8): INT;
var fd: I32; i: INT;
begin
    if p.tty # 0 then
        _ := C.setsid();
        fd := C.open(ADR(name[0]), 2);                (* O_RDWR *)
        if fd < 0 then return failed(); end;
        if C.ioctl(fd, TIOCSCTTY, 0) # 0 then return failed(); end;
        for i := 0 to 2 do _ := C.dup2(fd, I32(i)); end;
    else
        if p.group = -1 then _ := C.setpgid(0, 0);
        elsif p.group # 0 then _ := C.setpgid(0, I32(p.group));
        end;
        if p.foreground then _ := C.tcsetpgrp(0, C.getpgrp()); end;
        for i := 0 to 2 do
            if p.fds[i] # 0 then _ := C.dup2(I32(p.fds[i]), I32(i)); end;
        end;
    end;
    if (LEN(p.dir) > 0) and (C.chdir(ADR(dir[0])) # 0) then return failed(); end;
    return 0;
end;

(* Starts the program p describes, found as run says: its process id,
   or minus an errno. A program that can't be started ends with status
   127. Every signal is blocked from the fork until the program has its
   own: its group, its terminal's foreground, and signals as they are
   at first. *)
proc spawn*(p: Program): INT;
var
    a, dir, name: [4096]U8; argv: ^^U8; none: ^U8; size, err, i, g: INT; search: []U8;
    all, old, empty: [16]U64; dfl: Sigaction; pid: I32;   (* sigset_t: 128 bytes *)
begin
    if not cstr(p.path, a) or not cstr(p.dir, dir) then return -36; end;   (* ENAMETOOLONG *)
    if p.tty # 0 then
        err := ptyName(p.tty, name);                  (* here, since it isn't safe after fork *)
        if err # 0 then return err; end;
    end;
    none := nil;
    if p.onlyEnv then
        argv, size := argsAndEnv(p.args, p.env, ADR(none));
    else
        argv, size := argsAndEnv(p.args, p.env, C.environ);
    end;
    if argv = nil then return -12; end;               (* ENOMEM *)
    search := env("PATH");                            (* read here, before the fork *)
    if LEN(search) = 0 then search := defaultPath; end;
    for i := 0 to LEN(all) - 1 do all[i] := 0FFFFFFFFFFFFFFFFH; end;
    _ := C.sigprocmask(2, ^U8(ADR(all)), ^U8(ADR(old)));  (* SIG_SETMASK *)
    pid := C.fork();
    if pid = 0 then
        if takeOn(p, name, dir) # 0 then C._exit(127); end;
        closeAllBut(p.more);
        for i := 1 to 64 do _ := C.sigaction(I32(i), ^U8(ADR(dfl)), nil); end;
        _ := C.sigprocmask(2, ^U8(ADR(empty)), nil);
        run(p.path, search, a, argv, argv + (LEN(p.args) + 1));
        C._exit(127);
    end;
    err := failed();
    if (pid > 0) and (p.tty = 0) then
        (* as the program does, for whichever of the two runs first *)
        g := p.group;
        if g = -1 then g := INT(pid); elsif g = 0 then g := INT(C.getpgrp()); end;
        if p.group # 0 then _ := C.setpgid(pid, I32(g)); end;
        if p.foreground then _ := C.tcsetpgrp(0, I32(g)); end;
    end;
    _ := C.sigprocmask(2, ^U8(ADR(old)), nil);
    munmap(^U8(argv), size);
    if pid < 0 then return err; end;
    return INT(pid);
end;

(* Runs the program p describes in this one's place, as spawn would
   start it, but keeping this program's other fds as they are, open
   unless keepOnExec said no; the fds of p.more are kept. It returns
   only if it can't: -2 (ENOENT) or -13 (EACCES) if there is no
   program to run, before anything is done; or, once the program's
   terminal, group, fds and working directory are as p asks, which
   stay so, minus the errno that stopped it, with this program's
   signals given back as they were. *)
proc exec*(p: Program): INT;
var
    a, dir, name: [4096]U8; argv: ^^U8; none: ^U8; size, r, i: INT; search: []U8;
    all, old, empty: [16]U64; dfl: Sigaction; acts: [65]Sigaction;
begin
    if not cstr(p.dir, dir) then return -36; end;    (* ENAMETOOLONG *)
    if p.tty # 0 then
        r := ptyName(p.tty, name);
        if r # 0 then return r; end;
    end;
    search := env("PATH");
    if LEN(search) = 0 then search := defaultPath; end;
    r := find(p.path, search, a);
    if r < 0 then return r; end;
    none := nil;
    if p.onlyEnv then
        argv, size := argsAndEnv(p.args, p.env, ADR(none));
    else
        argv, size := argsAndEnv(p.args, p.env, C.environ);
    end;
    if argv = nil then return -12; end;               (* ENOMEM *)
    r := takeOn(p, name, dir);
    if r = 0 then
        for i := 0 to LEN(p.more) - 1 do
            if p.more[i] > 2 then _ := keepOnExec(p.more[i], true); end;
        end;
        (* every signal as it is at first and none blocked, as spawn
           gives them, each kept to give back if execve fails *)
        for i := 0 to LEN(all) - 1 do all[i] := 0FFFFFFFFFFFFFFFFH; end;
        _ := C.sigprocmask(2, ^U8(ADR(all)), ^U8(ADR(old)));  (* SIG_SETMASK *)
        for i := 1 to 64 do _ := C.sigaction(I32(i), ^U8(ADR(dfl)), ^U8(ADR(acts[i]))); end;
        _ := C.sigprocmask(2, ^U8(ADR(empty)), nil);
        _ := C.execve(ADR(a[0]), argv, argv + (LEN(p.args) + 1));
        r := failed();
        _ := C.sigprocmask(2, ^U8(ADR(all)), nil);
        for i := 1 to 64 do _ := C.sigaction(I32(i), ^U8(ADR(acts[i])), nil); end;
        _ := C.sigprocmask(2, ^U8(ADR(old)), nil);
    end;
    munmap(^U8(argv), size);
    return r;
end;

(* Waits for the program pid, or any of this program's if pid is -1, to
   change, if block, and says which one changed and how: exited, with
   its exit status; killed or stopped, with the signal's number. Without
   block it doesn't wait: 0 and running if none has changed. Minus an
   errno, and running, if there is none to wait for. The status is read
   as glibc's macros read it. *)
proc wait*(pid: INT; block: BOOL): (INT, Status, INT);
var status, options, r: I32;
begin
    options := 3;                                     (* WNOHANG, WUNTRACED *)
    if block then options := 2; end;
    r := C.waitpid(I32(pid), ADR(status), options);
    if r < 0 then return failed(), running, 0; end;
    if r = 0 then return 0, running, 0; end;
    if status & 7FH = 0 then return INT(r), exited, INT(status) shr 8 & 0FFH; end;
    if status & 0FFH = 7FH then return INT(r), stopped, INT(status) shr 8 & 0FFH; end;
    return INT(r), killed, INT(status) & 7FH;
end;

(* Sends the program pid, or the group -pid, the signal: 0, or minus an
   errno. *)
proc kill*(pid, signal: INT): INT;
begin
    if C.kill(I32(pid), I32(signal)) # 0 then return failed(); end;
    return 0;
end;

(* The handler of caught signals: their numbers go down the pipe, which
   catch gives the end of to read. *)
proc onSignal(sig: I32);
var e: ^I32; saved: I32; b: [1]U8;
begin
    e := C.__errno_location();
    saved := e^;                                      (* as the code it stopped left it *)
    b[0] := U8(sig);
    _ := C.write(sigWrite, ADR(b[0]), 1);
    e^ := saved;
end;

(* Catches the signals sigs: they don't do what they would, but give
   their numbers on an fd, which a later catch adds to and gives again;
   or minus an errno. *)
proc catch*(sigs: []INT): INT;
var fds: [2]I32; act: Sigaction; i: INT;
begin
    for i := 0 to LEN(sigs) - 1 do
        if (sigs[i] < 1) or (sigs[i] > 64) or (sigs[i] = sigKill) or (sigs[i] = sigStop)
                or (sigs[i] = 8) or (sigs[i] = 11) then  (* SIGFPE and SIGSEGV, Rt's *)
            return -22;                               (* EINVAL *)
        end;
    end;
    if sigWrite = 0 then
        if C.pipe2(ADR(fds[0]), 80800H) # 0 then return failed(); end;   (* O_NONBLOCK, O_CLOEXEC *)
        sigRead := fds[0];
        sigWrite := fds[1];
    end;
    act := {handler: onSignal, flags: 10000000H};    (* SA_RESTART *)
    for i := 0 to LEN(sigs) - 1 do
        if C.sigaction(I32(sigs[i]), ^U8(ADR(act)), nil) # 0 then return failed(); end;
    end;
    return INT(sigRead);
end;

(* The next signal catch's fd has, or 0 if none is waiting. *)
proc caught*(fd: INT): INT;
var b: [1]U8;
begin
    if read(fd, b) # 1 then return 0; end;
    return INT(b[0]);
end;

(* Makes the signal sig do nothing, or, if not yes, what it does at
   first: 0, or minus an errno. *)
proc ignore*(sig: INT; yes: BOOL): INT;
var act: Sigaction;
begin
    if yes then act.handler := Handler(1); end;      (* SIG_IGN *)
    if C.sigaction(I32(sig), ^U8(ADR(act)), nil) # 0 then return failed(); end;
    return 0;
end;

(* Whether the file descriptor fd is a terminal. *)
proc isTerminal*(fd: INT): BOOL;
begin
    return C.isatty(I32(fd)) = 1;
end;

(* Gives the processor to another thread. *)
proc yield*;
begin
    _ := C.sched_yield();
end;

(* Ends the program, at once, with status. *)
proc exit*(status: INT);
begin
    C._exit(I32(status));
end;

(* The test of programs: one on a pseudo-terminal of 100 by 30 prints
   its arguments, a variable put in place and its size, and leads the
   terminal's foreground until it ends with status 3; one in a
   directory and an environment of its own writes to a pipe; one in a
   group of its own is stopped and killed through it; one that isn't
   there ends with 127. Then signals: caught as a program ends and as
   one is sent; and a program starts with them neither caught nor
   ignored. *)
proc testPrograms;
var pty, child, n, m, r, w, sigs, c: INT; st: Status; buf: [64]U8;
begin
    pty := openPty();
    if (pty < 0) or (setTermSize(pty, 100, 30) # 0) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "echo $0 $1 $HOME; stty size; read x; exit 3", "a", "b"],
        env: ["HOME=/h"], tty: pty});
    if child <= 0 then exit(2); end;
    n := 0;
    while n < 16 do
        if not ready(pty, 5000) then exit(2); end;
        m := read(pty, buf[n..LEN(buf)]);
        if m <= 0 then exit(2); end;
        INC(n, m);
    end;
    if (buf[0..n] # "a b /h\r\n30 100\r\n") or (foregroundOf(pty) # child) then exit(2); end;
    if write(pty, "\n") # 1 then exit(2); end;
    repeat
        if not ready(pty, 5000) then exit(2); end;
    until read(pty, buf) <= 0;                      (* -5, EIO, once the terminal has no program *)
    close(pty);
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 3) then exit(2); end;

    r, w := pipe();
    if w < 0 then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "echo $X $HOME; pwd"], env: ["X=x"], onlyEnv: true,
        dir: "/tmp", fds: [0, w, 0]});
    close(w);
    n := 0;
    repeat
        m := read(r, buf[n..LEN(buf)]);
        if m > 0 then INC(n, m); end;
    until m <= 0;
    close(r);
    if buf[0..n] # "x\n/tmp\n" then exit(2); end;
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 0) then exit(2); end;

    (* a pipe filled without waiting, then emptied: room to write again *)
    r, w := pipe();
    if (w < 0) or (setBlocking(w, false) # 0) or (setBlocking(r, false) # 0) then exit(2); end;
    repeat n := write(w, buf); until n < 0;
    if (n # -11) or (readyFor([], [w], 0) # -1) or (readyFor([r], [w], 0) # r) then exit(2); end;
    repeat n := read(r, buf); until n < 0;
    if (n # -11) or (readyFor([r], [w], 0) # w) or (setBlocking(w, true) # 0) then exit(2); end;
    close(r);
    close(w);

    child := spawn({path: "/bin/sleep", args: ["sleep", "10"], group: -1});
    r, st, c := wait(child, false);
    if (r # 0) or (st # running) or (kill(-child, sigStop) # 0) then exit(2); end;
    r, st, c := wait(child, true);
    if (r # child) or (st # stopped) or (c # sigStop) or (kill(-child, sigKill) # 0) then exit(2); end;
    r, st, c := wait(-1, true);
    if (r # child) or (st # killed) or (c # sigKill) then exit(2); end;
    r, st, c := wait(-1, true);
    if r # -10 then exit(2); end;                   (* ECHILD: none left *)
    child := spawn({path: "/no/such/program", args: ["x"]});
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 127) then exit(2); end;
    (* a name without a / is looked for along PATH *)
    child := spawn({path: "sh", args: ["sh", "-c", "exit 4"]});
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 4) then exit(2); end;
    child := spawn({path: "no-such-program-on-path", args: ["x"]});
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 127) then exit(2); end;

    sigs := catch([sigChld, sigHup]);
    if (sigs < 0) or (catch([sigWinch]) # sigs) or (catch([11]) # -22) or (catch([sigKill]) # -22) then exit(2); end;
    if (caught(sigs) # 0) or (ignore(sigInt, true) # 0) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "kill -INT $$; exit 0"]});
    if not ready(sigs, 5000) or (caught(sigs) # sigChld) then exit(2); end;
    r, st, c := wait(child, true);
    if (st # killed) or (c # sigInt) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "kill -HUP $$; exit 0"]});
    r, st, c := wait(child, true);
    if (st # killed) or (c # sigHup) then exit(2); end;
    while caught(sigs) # 0 do end;
    if (kill(pid(), sigHup) # 0) or not ready(sigs, 1000) or (caught(sigs) # sigHup) then exit(2); end;
    if ignore(sigInt, false) # 0 then exit(2); end;
end;

(* The test of what a shell needs: fds copied, moved and kept on
   exec; a program given an fd at its own number, and one not; access,
   the umask and the environment by number; a terminal's modes; time
   used; limits; who and where; and exec, with nothing to run, and
   with a program that can't be run, after which the signals caught
   are caught still. *)
proc testShell;
var
    r, w, fd, n, k, child, c, err, pty, sigs, mask: INT; st: Status; buf: [64]U8;
    m, raw: Mode; soft, hard, s2, h2, user, system: I64; e: []U8; ok, path: BOOL;
begin
    r, w := pipe();
    if w < 0 then exit(2); end;
    fd := dup(w);
    if (fd < 0) or (write(fd, "ab") # 2) or (read(r, buf) # 2) then exit(2); end;
    close(fd);
    if (dupTo(w, 9) # 9) or (write(9, "c") # 1) or (read(r, buf) # 1) or (buf[0] # 'c') then exit(2); end;
    if (keepOnExec(9, false) # 0) or (keepOnExec(9, true) # 0) or (keepOnExec(-1, true) # -9) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "echo more >&9"], more: [9]});
    close(9);
    close(w);
    n := 0;
    repeat
        k := read(r, buf[n..LEN(buf)]);
        if k > 0 then INC(n, k); end;
    until k <= 0;
    close(r);
    if buf[0..n] # "more\n" then exit(2); end;
    k, st, c := wait(child, true);
    if (st # exited) or (c # 0) then exit(2); end;
    r, w := pipe();
    if (w < 0) or (dupTo(w, 9) # 9) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "{ echo none >&9; } 2>/dev/null"]});   (* 9 is closed in it *)
    close(9);
    close(w);
    if read(r, buf) # 0 then exit(2); end;
    close(r);
    k, st, c := wait(child, true);
    if (st # exited) or (c = 0) then exit(2); end;

    if (access("/bin/sh", {executing}) # 0) or (access("/", {reading}) # 0)
        or (access("/no/such/file", {}) # -2) or (open("/bin/sh", {executing}) # -22) then exit(2); end;
    mask := umask(3FH);                             (* 077 *)
    if umask(mask) # 3FH then exit(2); end;
    path := false;
    n := 0;
    repeat
        e, ok := envAt(n);
        if ok and (LEN(e) > 5) and (e[0..5] = "PATH=") then path := true; end;
        INC(n);
    until not ok;
    e, ok := envAt(-1);
    if not path or ok or (LEN(e) # 0) then exit(2); end;

    (* a terminal's modes, kept and given back *)
    pty := openPty();
    m, err := getMode(pty);
    if (err # 0) or not rawMode(pty) then exit(2); end;
    raw, err := getMode(pty);
    if (err # 0) or (raw.t = m.t) or (setMode(pty, m) # 0) then exit(2); end;
    raw, err := getMode(pty);
    if (err # 0) or (raw.t # m.t) then exit(2); end;
    m, err := getMode(-1);
    if err # -9 then exit(2); end;                  (* EBADF *)
    r, w := pipe();
    m, err := getMode(r);
    if err # -25 then exit(2); end;                 (* ENOTTY *)
    close(r);
    close(w);
    close(pty);

    user, system := cpuTime(false);
    if (user < 0) or (system < 0) or (user + system = 0) then exit(2); end;
    user, system := cpuTime(true);
    if (user < 0) or (system < 0) then exit(2); end;
    soft, hard, err := limit(limitFiles);
    if (err # 0) or (soft < 16) or (setLimit(limitFiles, soft - 1, hard) # 0) then exit(2); end;
    s2, h2, err := limit(limitFiles);
    if (err # 0) or (s2 # soft - 1) or (h2 # hard) or (setLimit(limitFiles, soft, hard) # 0) then exit(2); end;
    soft, hard, err := limit(10000);
    if err # -22 then exit(2); end;                 (* EINVAL *)
    e, err := hostName();
    if (err # 0) or (LEN(e) = 0) or (uid() < 0) or (euid() < 0) then exit(2); end;

    sigs := catch([sigUsr1]);
    while caught(sigs) # 0 do end;                  (* the sigChld of the programs above *)
    if (sigs < 0) or (exec({path: "no-such-program-on-path", args: ["x"]}) # -2) then exit(2); end;
    if exec({path: "/etc/passwd", args: ["x"]}) # -13 then exit(2); end;   (* not executable *)
    if (kill(pid(), sigUsr1) # 0) or not ready(sigs, 1000) or (caught(sigs) # sigUsr1) then exit(2); end;
end;

(* The test of time, random bytes and the network: a sleep the clock
   sees; addresses read and refused; a TCP connection on the loopback;
   a datagram to a port where no one listens, refused; servers on
   ports the system chooses, of streams and of datagrams. *)
proc testNet;
var t: I64; l, c, a, u, port, n: INT; x, y: [16]U8; s, s6: Sockaddr; peer: Peer;
begin
    t := clock();
    sleep(20);
    t := clock() - t;
    if (t < 20000000) or (t > 2000000000) or (now() < 1700000000 * 1000000000) then exit(2); end;
    random(x);
    random(y);
    if x[0..16] = y[0..16] then exit(2); end;
    if (inetAddr("10.0.0.255", 80, ADR(s)) # 16) or (s.port[0] # 0) or (s.port[1] # 80)
            or (s.data[0] # 10) or (s.data[2] # 0) or (s.data[3] # 255) then
        exit(2);
    end;
    if (inetAddr("1:aBcd::ff", 258, ADR(s6)) # 28) or (s6.port[0] # 1) or (s6.port[1] # 2)
            or (s6.data[0] # 0) or (s6.data[5] # 1) or (s6.data[6] # 0ABH) or (s6.data[7] # 0CDH)
            or (s6.data[18] # 0) or (s6.data[19] # 0FFH) then
        exit(2);
    end;
    if (inetAddr("::", 0, ADR(s6)) # 28) or (inetAddr("1:2:3:4:5:6:7:8", 0, ADR(s6)) # 28) then exit(2); end;
    if (connectTcp("1.2.3", 80) # -22) or (connectTcp("1.2.3.256", 80) # -22) or (connectTcp("1::2::3", 80) # -22)
            or (connectTcp("1:2:3:4:5:6:7:8:9", 80) # -22) or (connectTcp("1:", 80) # -22)
            or (connectTcp("12345::", 80) # -22) or (connectTcp("::1", 65536) # -22) then
        exit(2);
    end;
    l := listenTcp("127.0.0.1", 47391);
    c := connectTcp("127.0.0.1", 47391);
    if (l < 0) or (c < 0) then exit(2); end;
    a := accept(l);
    if (a < 0) or (send(c, "hi") # 2) or (read(a, x) # 2) or (x[0..2] # "hi") then exit(2); end;
    close(a);
    close(c);
    close(l);
    u := connectUdp("127.0.0.1", 47391);
    if (u < 0) or (send(u, "x") # 1) or not ready(u, 1000) or (read(u, x) # -111) then exit(2); end;   (* ECONNREFUSED *)
    close(u);
    (* a server on a port the system chooses, and a connection to it
       within a time; then none, where no one listens *)
    l := listenTcp("127.0.0.1", 0);
    port := localPort(l);
    if (l < 0) or (port <= 0) then exit(2); end;
    c := connectTcpWithin("127.0.0.1", port, 1000);
    a := accept(l);
    if (c < 0) or (a < 0) or (send(c, "hi") # 2) or (read(a, x) # 2) then exit(2); end;
    close(a);
    close(c);
    close(l);
    if connectTcpWithin("127.0.0.1", port, 1000) # -111 then exit(2); end;
    (* a datagram to a server, and its answer *)
    l := listenUdp("127.0.0.1", 0);
    port := localPort(l);
    u := connectUdp("127.0.0.1", port);
    if (l < 0) or (port <= 0) or (u < 0) or (send(u, "ping") # 4) then exit(2); end;
    n, peer := receive(l, x[0..2]);
    if (n # 2) or (x[0..2] # "pi") or (reply(l, peer, "pong") # 4) then exit(2); end;
    if (read(u, x) # 4) or (x[0..4] # "pong") then exit(2); end;
    close(u);
    close(l);
end;

(* The module's test, as Linux's Sys has it: a file written, read back
   and closed; a directory made, listed and emptied; no terminal; a
   socket, sent to after its end; programs; time and the network. *)
proc main*;
var free, total: I64; fd, n, err, w, h, l, c, a, m, k: INT; got: [1]INT; buf: [16]U8; p, q: ^U8; i, j: Info; d: Dir; name: []U8; ok: BOOL;
begin
    fd := create("/tmp/raz-sys-test");
    if fd < 0 then exit(2); end;
    if write(fd, "hello") # 5 then exit(2); end;
    close(fd);
    fd := openRead("/tmp/raz-sys-test");
    if fd < 0 then exit(2); end;
    n := read(fd, buf);
    if (n # 5) or (buf[0..5] # "hello") or (read(fd, buf) # 0) then exit(2); end;
    close(fd);
    if openRead("/no/such/file") >= 0 then exit(2); end;
    if isTerminal(-1) then exit(2); end;
    p := mmap(100);
    if (p = nil) or (p[99] # 0) then exit(2); end;
    munmap(p, 100);
    (* files and directories *)
    _ := remove("/tmp/raz-sys-dir/f");
    _ := remove("/tmp/raz-sys-dir/g");
    _ := makeDir("/tmp/raz-sys-dir");
    fd := create("/tmp/raz-sys-dir/f");
    if (fd < 0) or (write(fd, "abc") # 3) then exit(2); end;
    close(fd);
    if rename("/tmp/raz-sys-dir/f", "/tmp/raz-sys-dir/g") # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/g");
    if (err # 0) or (i.size # 3) or i.dir or not i.file or i.symlink then exit(2); end;
    i, err := info("/tmp/raz-sys-dir");
    if (err # 0) or not i.dir or i.file then exit(2); end;
    i, err := info("/dev/null");
    if (err # 0) or i.dir or i.file then exit(2); end;
    free, total, err := space("/tmp");
    if (err # 0) or (total <= 0) or (free < 0) or (free > total) then exit(2); end;
    free, total, err := space("/no/such/dir");
    if err # -2 then exit(2); end;
    _ := remove("/tmp/raz-sys-link");
    if symlink("/tmp/raz-sys-dir", "/tmp/raz-sys-link") # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-link");
    if (err # 0) or not i.dir or not i.symlink then exit(2); end;
    i, err := linkInfo("/tmp/raz-sys-link");
    if (err # 0) or i.dir or i.file or not i.symlink or (i.size # 16) then exit(2); end;
    i, err := linkInfo("/tmp/raz-sys-dir");
    if (err # 0) or not i.dir or i.symlink or (i.ino = 0) then exit(2); end;
    name, err := readLink("/tmp/raz-sys-link");
    if (err # 0) or (name # "/tmp/raz-sys-dir") then exit(2); end;
    name, err := readLink("/tmp/raz-sys-dir");
    if err # -22 then exit(2); end;                    (* EINVAL: not a link *)
    _ := remove("/tmp/raz-sys-link");
    if symlink("/no/such/file", "/tmp/raz-sys-link") # 0 then exit(2); end;   (* dangling *)
    i, err := linkInfo("/tmp/raz-sys-link");
    if (err # 0) or not i.symlink or (i.size # 13) then exit(2); end;
    _ := remove("/tmp/raz-sys-link");
    (* open as asked, seek, the mode and the time *)
    _ := remove("/tmp/raz-sys-dir/h");
    fd := open("/tmp/raz-sys-dir/h", {writing, creating, exclusive});
    if (fd < 0) or (write(fd, "abc") # 3) then exit(2); end;
    close(fd);
    if open("/tmp/raz-sys-dir/h", {writing, creating, exclusive}) # -17 then exit(2); end;
    fd := open("/tmp/raz-sys-dir/h", {writing, appending});
    if (fd < 0) or (seek(fd, 0, false) # 0) or (write(fd, "de") # 2) then exit(2); end;
    close(fd);
    fd := open("/tmp/raz-sys-dir/h", {reading, writing});
    if (seek(fd, -2, true) # 3) or (read(fd, buf) # 2) or (buf[0..2] # "de") then exit(2); end;
    if (seek(fd, 1, false) # 1) or (write(fd, "B") # 1) or (seek(fd, 0, false) # 0) then exit(2); end;
    if (read(fd, buf) # 5) or (buf[0..5] # "aBcde") then exit(2); end;
    (* where it is, its size open, cut short, on the disk *)
    if (position(fd) # 5) or (seek(fd, 2, false) # 2) or (position(fd) # 2) then exit(2); end;
    if (truncate(fd, 4) # 0) or (position(fd) # 2) or (sync(fd) # 0) then exit(2); end;
    i, err := infoOf(fd);
    if (err # 0) or (i.size # 4) or not i.file or i.symlink then exit(2); end;
    m := INT(i.ino);
    i, err := info("/tmp/raz-sys-dir/h");
    if (err # 0) or (INT(i.ino) # m) or (syncAll(fd) # 0) then exit(2); end;
    if syncAll(-1) # -9 then exit(2); end;   (* EBADF *)
    (* the lock: one open file holds it, another can't take it until
       the first is closed *)
    k := openRead("/tmp/raz-sys-dir/h");
    if (lock(fd, false) # 0) or (lock(k, false) # -11) then exit(2); end;
    close(fd);
    if lock(k, true) # 0 then exit(2); end;
    close(k);
    if (position(fd) # -9) or (truncate(fd, 0) # -9) or (sync(fd) # -9) then exit(2); end;   (* EBADF *)
    i, err := infoOf(fd);
    if err # -9 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/h");
    if (err # 0) or (i.mode & 1C0H # 180H) or (i.mtime < 1700000000 * 1000000000) then exit(2); end;
    if chmod("/tmp/raz-sys-dir/h", 1EDH) # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/h");
    if i.mode # 1EDH then exit(2); end;
    _ := remove("/tmp/raz-sys-dir/h");
    fd := openMode("/tmp/raz-sys-dir/h", {writing, creating}, 1C0H);   (* rwx------ *)
    close(fd);
    i, err := info("/tmp/raz-sys-dir/h");
    if (fd < 0) or (err # 0) or (i.mode # 1C0H) then exit(2); end;
    _ := remove("/tmp/raz-sys-dir/h");
    i, err := info("/no/such/file");
    if err >= 0 then exit(2); end;
    if openDir(ADR(d), "/tmp/raz-sys-dir") # 0 then exit(2); end;
    name, ok := nextEntry(ADR(d));
    if not ok or (name # "g") then exit(2); end;
    if (entryKind(ADR(d)) # isFile) and (entryKind(ADR(d)) # unknown) then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/g");
    j, err := info("/tmp/raz-sys-dir");
    if (err # 0) or (i.dev # j.dev) or (i.ino = j.ino) then exit(2); end;
    name, ok := nextEntry(ADR(d));
    if ok then exit(2); end;
    closeDir(ADR(d));
    if (remove("/tmp/raz-sys-dir/g") # 0) or (remove("/tmp/raz-sys-dir/g") >= 0) then exit(2); end;
    if openDir(ADR(d), "/no/such/dir") >= 0 then exit(2); end;
    (* the terminal: none here, fd -1 *)
    if rawMode(-1) or ready(-1, 0) then exit(2); end;
    w, h := termSize(-1);
    if (w # 80) or (h # 24) then exit(2); end;
    (* the environment *)
    if (LEN(env("PATH")) = 0) or (LEN(env("RAZ_NO_SUCH_VARIABLE")) # 0) then exit(2); end;
    name, err := workDir();
    if (err # 0) or (LEN(name) = 0) or (name[0] # '/') then exit(2); end;
    if (setWorkDir("/tmp/raz-sys-dir") # 0) or (removeDir("/tmp/raz-sys-dir") # 0) then exit(2); end;
    if (setWorkDir("/") # 0) or (removeDir("/tmp/raz-sys-dir") # -2) then exit(2); end;
    (* a socket: nothing at a path, then a listener that a connection
       makes ready, and a byte from it to the connection *)
    if connect("/tmp/raz-no-such-socket") # -2 then exit(2); end;    (* ENOENT *)
    _ := remove("/tmp/raz-sys-socket");
    l := listen("/tmp/raz-sys-socket");
    if (l < 0) or (listen("/tmp/raz-sys-socket") # -98) then exit(2); end;    (* EADDRINUSE: there already *)
    c := connect("/tmp/raz-sys-socket");
    if c < 0 then exit(2); end;
    if readyOf([c], 0) # -1 then exit(2); end;
    if readyOf([c, l], 1000) # l then exit(2); end;
    a := accept(l);
    if (a < 0) or (send(a, "x") # 1) or (readyOf([l, c], 1000) # c) then exit(2); end;
    if (read(c, buf) # 1) or (buf[0] # 'x') then exit(2); end;
    close(a);
    if (readyOf([c], 1000) # c) or (read(c, buf) # 0) then exit(2); end;   (* its end *)
    if send(c, "x") # -32 then exit(2); end;           (* EPIPE, and no SIGPIPE *)
    close(c);
    close(l);
    _ := remove("/tmp/raz-sys-socket");
    (* a file in memory, mapped, and passed with a byte down a socket
       twice, with room for one: what the other side maps is the same *)
    m := memFile(8192);
    p := mapFile(m, 8192);
    if (m < 0) or (p = nil) or (p[8191] # 0) then exit(2); end;
    p[100] := 42;
    l := listen("/tmp/raz-sys-socket");
    c := connect("/tmp/raz-sys-socket");
    a := accept(l);
    if (l < 0) or (c < 0) or (a < 0) or (sendFds(c, "", [m]) # -22) or (sendFds(c, "f", [m, m]) # 1) then exit(2); end;
    n, k := receiveFds(a, buf, got);
    if (n # 1) or (k # 1) or (buf[0] # 'f') then exit(2); end;
    q := mapFile(got[0], 8192);
    if (q = nil) or (q[100] # 42) then exit(2); end;
    q[200] := 7;
    if p[200] # 7 then exit(2); end;
    munmap(p, 8192);
    munmap(q, 8192);
    close(got[0]);
    close(m);
    close(a);
    close(c);
    close(l);
    _ := remove("/tmp/raz-sys-socket");
    testPrograms;
    testShell;
    testNet;
end;

end Sys.
