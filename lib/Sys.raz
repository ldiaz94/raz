(* System calls through the C library: Sys for the targets that have no
   file of their own, with the same exports. A program that imports it
   uses C.

   It keeps to POSIX's names, and raw mode is cfmakeraw's. What the C
   library fixes for its target, the numbers of flags, requests,
   signals, limits and errnos, where a field lies in a struct, and the
   two procedures whose names differ, it takes from CAbi, one file per
   target, which tools/cabi.c writes; so a struct the C library fills
   in or reads is bytes here, its fields read and written at CAbi's
   offsets by field and setField. A failure is minus Linux's errno, on
   every target: linux maps the C library's, and errorText maps back.
   A terminal's modes, Mode, are its struct termios whole, which cabi
   checks fits in 256 bytes. Still Linux's: memfd_create, getrandom,
   pipe2 and accept4, which glibc and musl have, and what a wait
   status holds, which every Unix encodes alike. *)
module Sys;
import C, CAbi;

const
    stdin* = 0;     (* standard input's file descriptor *)
    stdout* = 1;    (* standard output's *)
    stderr* = 2;    (* standard error's *)
    (* the bytes Out keeps before it writes them; a target with little
       memory keeps fewer *)
    outSize* = 4096;
    (* signals, by the target's numbers *)
    sigHup* = CAbi.sigHup; sigInt* = CAbi.sigInt; sigQuit* = CAbi.sigQuit;
    sigKill* = CAbi.sigKill; sigPipe* = CAbi.sigPipe; sigTerm* = CAbi.sigTerm;
    sigChld* = CAbi.sigChld; sigCont* = CAbi.sigCont; sigStop* = CAbi.sigStop;
    sigTstp* = CAbi.sigTstp; sigTtin* = CAbi.sigTtin; sigTtou* = CAbi.sigTtou;
    sigWinch* = CAbi.sigWinch; sigUsr1* = CAbi.sigUsr1; sigUsr2* = CAbi.sigUsr2;
    sigAlrm* = CAbi.sigAlrm;
    (* the limits limit and setLimit take, by the target's numbers *)
    limitCpu* = CAbi.rlimitCpu;         (* seconds of the processor *)
    limitFileSize* = CAbi.rlimitFsize;  (* bytes in a file it writes *)
    limitData* = CAbi.rlimitData;       (* bytes of its data *)
    limitStack* = CAbi.rlimitStack;     (* bytes of its stack *)
    limitCore* = CAbi.rlimitCore;       (* bytes of a core dump *)
    limitProcs* = CAbi.rlimitNproc;     (* processes of its user *)
    limitFiles* = CAbi.rlimitNofile;    (* one more than its highest fd *)
    limitMemory* = CAbi.rlimitAs;       (* bytes of its address space *)
    (* errors, minus Linux's errnos, as on every target *)
    errPerm* = -1; errNoEntry* = -2; errNoProcess* = -3; errIntr* = -4;
    errIo* = -5; errBadFd* = -9; errChild* = -10; errAgain* = -11;
    errNoMemory* = -12; errDenied* = -13; errExists* = -17;
    errNotDir* = -20; errIsDir* = -21; errInvalid* = -22;
    errNotTerminal* = -25; errNoSpace* = -28; errPipe* = -32;
    errNameTooLong* = -36; errNotEmpty* = -39; errLoop* = -40;
    errAddrInUse* = -98; errNetUnreach* = -101; errConnAborted* = -103; errConnReset* = -104;
    errTimedOut* = -110; errRefused* = -111; errHostUnreach* = -113;
    errInProgress* = -115;

type
    (* What open is asked for: reading, writing or both, and what else
       it does to the file; nonblocking, that open doesn't wait (for a
       fifo's other end) and reads and writes on the file don't either. *)
    Access* = (reading, writing, creating, exclusive, truncating,
        appending, executing, nonblocking);
    Accesses* = set of Access;   (* what open is given *)

    (* What info says of a file. *)
    Info* = record
        size*: I64;     (* in bytes *)
        mtime*: I64;    (* its contents' last change, in ns since 1970 *)
        seconds*: I64;  (* mtime in whole seconds, rounded down: exact past 2262 and before 1677, where mtime wraps *)
        mode*: INT;     (* its permission bits, rwxrwxrwx *)
        dir*: BOOL;     (* a directory *)
        file*: BOOL;    (* not a directory, device, pipe or socket *)
        symlink*: BOOL; (* the path itself is a symbolic link *)
        ino*: U64;      (* its inode, which a rename keeps and a new file doesn't *)
        dev*: U64;      (* the file system it is on; with ino, it names the file *)
        links*: U64;    (* how many names it has: 1 for a file no hard link shares *)
        special*: INT;  (* its set-user-id, set-group-id and sticky bits, as chmod takes them: 800H, 400H, 200H *)
    end;

    (* What a directory says a name in it is, without asking the file:
       a regular file, a directory, a symbolic link, or something else
       (a device, pipe or socket); unknown where the file system
       doesn't say, and linkInfo must be asked. *)
    Kind* = (unknown, isFile, isDir, isLink, isOther);

    (* An open directory: C's DIR. *)
    Dir* = record
        d: ^U8;
        kind: Kind;     (* of the name nextEntry gave last *)
    end;

    (* A program for spawn to start. *)
    Program* = record
        path*: []U8;
        args*: [][]U8;      (* the first is its name *)
        env*: [][]U8;       (* NAME=value, each added to this environment *)
        onlyEnv*: BOOL;     (* env is its whole environment *)
        dir*: []U8;         (* its working directory; "" for this program's *)
        fds*: [3]INT;       (* stdin, stdout, stderr; 0 for this program's *)
        group*: INT;        (* its group: 0 for this program's, -1 a new one *)
        foreground*: BOOL;  (* its group gets the terminal on standard input *)
        tty*: INT;          (* a pseudo-terminal to start a session on, or 0 *)
        more*: []INT;       (* fds above 2 passed on to it at the same numbers *)
        keepIgnored*: BOOL; (* signals this program ignores stay ignored in it *)
    end;
    (* How a program that wait waited for changed. *)
    Status* = (running, exited, killed, stopped);

    (* a signal's handler; nil is SIG_DFL, 1 SIG_IGN *)
    Handler = proc(sig: I32);
    (* the C library's struct sigaction and sigset_t, as bytes, kept
       aligned for the pointers in them *)
    Sigaction = record b: [(CAbi.sigactionLen + 7) div 8]U64; end;
    Sigset = [(CAbi.sigsetLen + 7) div 8]U64;

    (* A terminal's modes, as getMode reads them and setMode sets them:
       a struct termios, of the C library's size, 256 bytes at most. *)
    Mode* = record
        t: [256]U8;
    end;

    Winsize = record rows, cols, xpixel, ypixel: U16; end;
    Pollfd = record fd: I32; events, revents: I16; end;

    (* a socket's address, struct sockaddr_storage, which holds any:
       a struct sockaddr_un, sockaddr_in or sockaddr_in6 *)
    Sockaddr = record b: [(CAbi.sockaddrLen + 7) div 8]U64; end;
    (* Whom a datagram came from, as receive says and reply takes: the
       address recvfrom fills in, and its size. *)
    Peer* = record
        a: Sockaddr;
        size: INT;
    end;
    (* Who is at the other end of a connected socket, as peer says. *)
    Remote* = record
        unix*: BOOL;    (* a Unix socket: uid and pid say who; no addr or port *)
        ipv6*: BOOL;    (* addr is an IPv6 address, 16 bytes; else an IPv4 one, 4 bytes then zeros *)
        addr*: [16]U8;  (* an IP peer's address *)
        port*: INT;     (* an IP peer's port *)
        uid*, pid*: INT;    (* a Unix peer's user and process, as the system recorded them when it connected *)
    end;
    (* struct msghdr, what sendmsg and recvmsg take, as bytes: no
       address, one buffer, and a control message, a struct cmsghdr
       and the fds sent, at most 16 *)
    Msghdr = record b: [(CAbi.msghdrLen + 7) div 8]U64; end;
    Iovec = record base: ^U8; size: INT; end;
    Control = record b: [(CAbi.cmsgDataAt + 4 * 16 + 7) div 8]U64; end;
    Timespec = record sec, nsec: I64; end;

var
    cwd: [4096]U8;    (* what workDir gives *)
    linked: [4096]U8; (* what readLink gives *)
    saved: [256]U8;   (* the terminal as rawMode found it: a struct termios, of the C library's size *)
    host: [256]U8;    (* what hostName gives *)
    sigRead, sigWrite: I32;   (* the pipe the handler of caught signals writes their numbers to, once open *)
    noted: [CAbi.sigMax + 1]INT;   (* 1 at sig when a signal handle took has come, until came asks *)
    broke: INT;       (* 1 when one has come since a call that ready or readyFor makes again began *)

(* err, minus an errno of the C library's, as minus Linux's errno of
   the same name; err itself if it has none *)
proc linux(err: INT): INT;
var i: INT;
begin
    for i := 0 to LEN(CAbi.errnos) - 2 by 2 do
        if -INT(CAbi.errnos[i]) = err then return -INT(CAbi.errnos[i + 1]); end;
    end;
    return err;
end;

(* minus errno, Linux's, as a system call returns it *)
proc failed: INT;
var e: ^I32;
begin
    e := CAbi.errno();
    return linux(-INT(e^));
end;

(* The integer of len bytes at p + at, a field of a C struct *)
proc field(p: ^U8; at, len: INT): I64;
var q8: ^I64; q4: ^U32; q2: ^U16;
begin
    if len = 8 then q8 := ^I64(p + at); return q8^;
    elsif len = 4 then q4 := ^U32(p + at); return I64(q4^);
    elsif len = 2 then q2 := ^U16(p + at); return I64(q2^);
    end;
    return I64(p[at]);
end;

(* Writes v to the field of len bytes at p + at, its low bytes *)
proc setField(p: ^U8; at, len: INT; v: I64);
var q8: ^I64; q4: ^U32; q2: ^U16;
begin
    if len = 8 then q8 := ^I64(p + at); q8^ := v;
    elsif len = 4 then q4 := ^U32(p + at); q4^ := U32(v & 0FFFFFFFFH);
    elsif len = 2 then q2 := ^U16(p + at); q2^ := U16(v & 0FFFFH);
    else p[at] := U8(v & 0FFH);
    end;
end;

(* Whether a call that failed is to be made again: when it failed with
   EINTR because a signal catch took broke into it, since on Linux those
   break into nothing; not when one handle took did, which the program
   is to see. broke is set to 0 before the call. *)
proc again: BOOL;
begin
    return (failed() = -4) and (XCHG(ADR(broke), 0) = 0);
end;

(* Writes s to the file descriptor fd; the number of bytes written, or
   minus an errno. *)
proc write*(fd: INT; s: []U8): INT;
var r: INT;
begin
    if LEN(s) = 0 then return 0; end;
    r := C.write(I32(fd), ADR(s[0]), UINT(LEN(s)));
    if r < 0 then return failed(); end;
    return r;
end;

(* Reads into buf from fd; the number of bytes read, 0 at the end, or
   minus an errno. *)
proc read*(fd: INT; buf: []U8): INT;
var r: INT;
begin
    if LEN(buf) = 0 then return 0; end;
    r := C.read(I32(fd), ADR(buf[0]), UINT(LEN(buf)));
    if r < 0 then return failed(); end;
    return r;
end;

(* path, a C string in buf, or false if it doesn't fit. *)
proc cstr(path, buf: []U8): BOOL;
begin
    if LEN(path) >= LEN(buf) then return false; end;
    COPY(buf, path);
    buf[LEN(path)] := 0;
    return true;
end;

(* open's flags for how, with O_CLOEXEC *)
proc flags(how: Accesses): I32;
var f: I32;
begin
    f := CAbi.oRdonly | CAbi.oCloexec;
    if writing in how then
        f := CAbi.oWronly;
        if reading in how then f := CAbi.oRdwr; end;
    end;
    if creating in how then f := f | CAbi.oCreat; end;
    if exclusive in how then f := f | CAbi.oExcl; end;
    if truncating in how then f := f | CAbi.oTrunc; end;
    if appending in how then f := f | CAbi.oAppend; end;
    if nonblocking in how then f := f | CAbi.oNonblock; end;
    return f;
end;

(* The file at path, opened as how asks: its file descriptor, closed in
   a program exec starts, or minus an errno. A file it creates has the
   permission bits mode, less those the umask takes away. *)
proc openMode*(path: []U8; how: Accesses; mode: INT): INT;
var buf: [4096]U8; r: INT;
begin
    if executing in how then return -22; end;      (* EINVAL: access asks it, open can't *)
    if not cstr(path, buf) then return -36; end;
    r := INT(C.open(ADR(buf[0]), flags(how), mode));
    if r < 0 then return failed(); end;
    return r;
end;

(* openMode with 644: a file it creates is readable by all, writable
   by its owner. *)
proc open*(path: []U8; how: Accesses): INT;
begin
    return openMode(path, how, 1A4H);                  (* 644 *)
end;

(* The file at path, opened for reading, closed in a program exec
   starts. *)
proc openRead*(path: []U8): INT;
begin
    return open(path, {reading});
end;

(* The file at path, made empty or new, opened for writing, closed in a
   program exec starts. *)
proc create*(path: []U8): INT;
begin
    return open(path, {writing, creating, truncating});
end;

(* Moves fd to pos from the start of its file, or from the end if
   fromEnd: the new position, or minus an errno. *)
proc seek*(fd: INT; pos: I64; fromEnd: BOOL): I64;
var r: I64;
begin
    if fromEnd then r := C.lseek(I32(fd), pos, CAbi.seekEnd);
    else r := C.lseek(I32(fd), pos, CAbi.seekSet); end;
    if r < 0 then return failed(); end;
    return r;
end;

(* Where in its file fd is, without moving: the next read or write's
   position, or minus an errno. *)
proc position*(fd: INT): I64;
var r: I64;
begin
    r := C.lseek(I32(fd), 0, CAbi.seekCur);
    if r < 0 then return failed(); end;
    return r;
end;

(* The file fd makes size bytes long, cut or filled with zeros; its
   position stays. 0, or minus an errno. *)
proc truncate*(fd: INT; size: I64): INT;
begin
    if C.ftruncate(I32(fd), size) # 0 then return failed(); end;
    return 0;
end;

(* Returns once what was written to fd is on the disk: 0, or minus an
   errno. *)
proc sync*(fd: INT): INT;
begin
    if C.fsync(I32(fd)) # 0 then return failed(); end;
    return 0;
end;

(* Returns once everything written to the file system that holds fd
   is on the disk: 0, or minus an errno. POSIX has no call for one file
   system, so it is sync's, which flushes them all and does no less;
   fd is still asked whether it is open, for the -9 (EBADF) Linux's
   syncfs gives one that isn't. *)
proc syncAll*(fd: INT): INT;
begin
    if C.fcntl(I32(fd), CAbi.fGetfd, 0) < 0 then return failed(); end;
    C.sync;
    return 0;
end;

(* Takes the lock on the open file fd, which only one program holds at
   a time, and which goes when fd is closed or the program ends,
   however it ends. If another program holds it, waits for it if wait,
   and otherwise returns -11 (EAGAIN). 0, or minus an errno. *)
proc lock*(fd: INT; wait: BOOL): INT;
var how: I32;
begin
    how := CAbi.lockEx;
    if not wait then how := how | CAbi.lockNb; end;
    if C.flock(I32(fd), how) # 0 then return failed(); end;
    return 0;
end;

(* Takes the lock on the open file fd as lock does, but shared: any
   number of programs may hold it so at once, as readers do, while none
   holds it as lock takes it. 0, or minus an errno. *)
proc lockShared*(fd: INT; wait: BOOL): INT;
var how: I32;
begin
    how := CAbi.lockSh;
    if not wait then how := how | CAbi.lockNb; end;
    if C.flock(I32(fd), how) # 0 then return failed(); end;
    return 0;
end;

(* Closes the file descriptor fd. *)
proc close*(fd: INT);
begin
    _ := C.close(I32(fd));
end;

(* Closes the file descriptor fd, as close does, and says whether that
   failed: 0, or minus an errno. A file system may report only at the
   close that what was written to the file never reached it, -28
   (ENOSPC) or -122 (EDQUOT) say, as NFS does; a program that must know
   its writes landed asks so. The fd is closed either way, so it is never
   closed again, after -4 (EINTR) too. *)
proc closeChecked*(fd: INT): INT;
begin
    if C.close(I32(fd)) # 0 then return failed(); end;
    return 0;
end;

(* A new file descriptor for the file fd is open on, the lowest free:
   it, or minus an errno. *)
proc dup*(fd: INT): INT;
var r: I32;
begin
    r := C.dup(I32(fd));
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* Makes the file descriptor into stand for the file fd is open on,
   closing what into was first: into, or minus an errno. *)
proc dupTo*(fd, into: INT): INT;
var r: I32;
begin
    r := C.dup2(I32(fd), I32(into));
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* A new file descriptor for the file fd is open on, the lowest free
   from least on, and closed on exec: it, or minus an errno. A shell
   keeps its own at 10 and above, out of the way of those a script
   names. *)
proc dupAbove*(fd, least: INT): INT;
var r: I32;
begin
    r := C.fcntl(I32(fd), CAbi.fDupfdCloexec, I32(least));
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* Whether fd stays open in the program exec runs in this one's place:
   yes, or no, closed then, as the fds open, pipe and socket give are at
   first. 0, or minus an
   errno. *)
proc keepOnExec*(fd: INT; yes: BOOL): INT;
var f: I32;
begin
    f := C.fcntl(I32(fd), CAbi.fGetfd, 0);
    if f < 0 then return failed(); end;
    if yes then f := f & ~I32(CAbi.fdCloexec); else f := f | CAbi.fdCloexec; end;
    if C.fcntl(I32(fd), CAbi.fSetfd, f) < 0 then return failed(); end;
    return 0;
end;

(* size bytes of fresh, zeroed memory from the system, a multiple of
   pages, or nil. *)
proc mmap*(size: INT): ^U8;
var p: ^U8;
begin
    p := C.mmap(nil, UINT(size), CAbi.protRead | CAbi.protWrite, CAbi.mapPrivate | CAbi.mapAnonymous, -1, 0);
    if INT(p) = -1 then return nil; end;
    return p;
end;

(* Gives back to the system the size bytes at p that mmap gave. *)
proc munmap*(p: ^U8; size: INT);
begin
    _ := C.munmap(p, UINT(size));
end;

(* A file in memory, with no name, of size zeroed bytes: its fd, or
   minus an errno. It is closed in a program exec starts. *)
proc memFile*(size: INT): INT;
var name: [4]U8; fd: I32; err: INT;
begin
    _ := cstr("raz", name);                     (* the name /proc shows *)
    fd := C.memfd_create(ADR(name[0]), CAbi.mfdCloexec);
    if fd < 0 then return failed(); end;
    if C.ftruncate(fd, I64(size)) # 0 then
        err := failed();                        (* before close can change errno *)
        _ := C.close(fd);
        return err;
    end;
    return INT(fd);
end;

(* The first size bytes of the file fd, mapped to be read and written,
   and shared: what this program writes there, every program that maps
   the file sees. nil if it can't be; munmap gives them back. *)
proc mapFile*(fd, size: INT): ^U8;
var p: ^U8;
begin
    p := C.mmap(nil, UINT(size), CAbi.protRead | CAbi.protWrite, CAbi.mapShared, I32(fd), 0);
    if INT(p) = -1 then return nil; end;
    return p;
end;

(* The first size bytes of the file fd, which may be open only to
   read, mapped to be read only: writing there stops the program. nil
   if it can't be; munmap gives them back. *)
proc mapRead*(fd, size: INT): ^U8;
var p: ^U8;
begin
    p := C.mmap(nil, UINT(size), CAbi.protRead, CAbi.mapPrivate, I32(fd), 0);
    if INT(p) = -1 then return nil; end;
    return p;
end;

(* Lets the pages from p, size bytes from a page boundary, be read and
   written as read and write say; neither, and touching them stops the
   program. 0, or minus an errno. *)
proc protect*(p: ^U8; size: INT; read, write: BOOL): INT;
var prot: I32;
begin
    prot := 0;                                  (* PROT_NONE *)
    if read then prot := CAbi.protRead; end;
    if write then prot := prot | CAbi.protWrite; end;
    if C.mprotect(p, UINT(size), prot) # 0 then return failed(); end;
    return 0;
end;

(* Renames old to new, replacing what new names: 0, or minus an errno. *)
proc rename*(old, new: []U8): INT;
var a, b: [4096]U8;
begin
    if not cstr(old, a) or not cstr(new, b) then return -36; end;
    if C.rename(ADR(a[0]), ADR(b[0])) # 0 then return failed(); end;
    return 0;
end;

(* Removes the file at path; not a directory. *)
proc remove*(path: []U8): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.unlink(ADR(a[0])) # 0 then return failed(); end;
    return 0;
end;

(* Makes a directory at path, readable by all, writable by its owner. *)
proc makeDir*(path: []U8): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.mkdir(ADR(a[0]), 1EDH) # 0 then return failed(); end;   (* mode 755 *)
    return 0;
end;

(* Makes a directory at path with the permission bits mode, less those
   the umask takes away: 1C0H (700) for one only its owner may enter. Of
   the bits above them Linux keeps only sticky, 200H. *)
proc makeDirMode*(path: []U8; mode: INT): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.mkdir(ADR(a[0]), U32(mode)) # 0 then return failed(); end;
    return 0;
end;

(* Removes the directory at path, which must be empty. *)
proc removeDir*(path: []U8): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.rmdir(ADR(a[0])) # 0 then return failed(); end;
    return 0;
end;

(* Sets the permission bits of what path names. *)
proc chmod*(path: []U8; mode: INT): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.chmod(ADR(a[0]), U32(mode)) # 0 then return failed(); end;
    return 0;
end;

(* Sets when the contents of what path names last changed, and when it
   was last read, to sec seconds and nsec nanoseconds since 1970, as a
   program copying a file keeps its time: Info.seconds gives sec back,
   whatever the time. *)
proc setTime*(path: []U8; sec: I64; nsec: INT): INT;
var a: [4096]U8; t: [2]Timespec;
begin
    if not cstr(path, a) then return -36; end;
    if (nsec < 0) or (nsec >= 1000000000) then return -22; end;   (* EINVAL *)
    t[0].sec := sec;
    t[0].nsec := nsec;
    t[1] := t[0];
    if C.utimensat(CAbi.atFdcwd, ADR(a[0]), ^U8(ADR(t)), 0) # 0 then return failed(); end;
    return 0;
end;

(* 0 if this user, by its real ids, may do with path what how asks:
   reading, writing and executing; minus an errno, -13 (EACCES) if not.
   An empty how asks only whether path is there. *)
proc access*(path: []U8; how: Accesses): INT;
var a: [4096]U8; m: I32;
begin
    if not cstr(path, a) then return -36; end;
    m := CAbi.fOk;
    if reading in how then m := m | CAbi.rOk; end;
    if writing in how then m := m | CAbi.wOk; end;
    if executing in how then m := m | CAbi.xOk; end;
    if C.access(ADR(a[0]), m) # 0 then return failed(); end;
    return 0;
end;

(* Sets the bits taken from every file this program, and the programs
   it starts, make: the mask it was. *)
proc umask*(mask: INT): INT;
begin
    return INT(C.umask(U32(mask & 1FFH)) & 1FFH);
end;

(* Makes path a symbolic link to target. *)
proc symlink*(target, path: []U8): INT;
var a, b: [4096]U8;
begin
    if not cstr(target, a) or not cstr(path, b) then return -36; end;
    if C.symlink(ADR(a[0]), ADR(b[0])) # 0 then return failed(); end;
    return 0;
end;

(* What the symbolic link at path names, good until the next call; and
   0, or minus an errno. *)
proc readLink*(path: []U8): ([]U8, INT);
var a: [4096]U8; n: INT;
begin
    if not cstr(path, a) then return "", -36; end;
    n := C.readlink(ADR(a[0]), ADR(linked[0]), UINT(LEN(linked)));
    if n < 0 then return "", failed(); end;
    if n = LEN(linked) then return "", -36; end;          (* it may be cut short *)
    return linked[0..n], 0;
end;

type Stat = [(CAbi.statLen + 7) div 8]U64;   (* a struct stat, as bytes *)

(* The type of file a struct stat says, S_IFDIR, S_IFREG or another *)
proc fileType(st: Stat): INT;
begin
    return INT(field(^U8(ADR(st)), CAbi.stModeAt, CAbi.stModeLen)) & CAbi.sIfmt;
end;

(* An Info from a struct stat, all but symlink. *)
proc fromStat(st: Stat): Info;
var i: Info; p: ^U8;
begin
    p := ^U8(ADR(st));
    i.size := field(p, CAbi.stSizeAt, CAbi.stSizeLen);
    i.dev := U64(field(p, CAbi.stDevAt, CAbi.stDevLen));
    i.ino := U64(field(p, CAbi.stInoAt, CAbi.stInoLen));
    i.links := U64(field(p, CAbi.stNlinkAt, CAbi.stNlinkLen));
    i.mtime := field(p, CAbi.stMtimeAt, CAbi.stMtimeLen) * 1000000000 + field(p, CAbi.stMtimeNsAt, CAbi.stMtimeNsLen);
    i.seconds := field(p, CAbi.stMtimeAt, CAbi.stMtimeLen);
    i.mode := INT(field(p, CAbi.stModeAt, CAbi.stModeLen)) & 1FFH;
    i.special := INT(field(p, CAbi.stModeAt, CAbi.stModeLen)) & 0E00H;
    i.dir := fileType(st) = CAbi.sIfdir;
    i.file := fileType(st) = CAbi.sIfreg;
    return i;
end;

(* The size of what path names, whether it is a directory or a regular
   file, following a symbolic link, and whether path is one; and 0, or
   minus an errno. *)
proc info*(path: []U8): (Info, INT);
var a: [4096]U8; st: Stat; i: Info; isLink: BOOL;
begin
    if not cstr(path, a) then return i, -36; end;
    if C.lstat(ADR(a[0]), ^U8(ADR(st))) # 0 then return i, failed(); end;
    isLink := fileType(st) = CAbi.sIflnk;
    if C.stat(ADR(a[0]), ^U8(ADR(st))) # 0 then return i, failed(); end;
    i := fromStat(st);
    i.symlink := isLink;
    return i, 0;
end;

(* info of path itself: if it is a symbolic link, of the link, not of
   what it names, so that symlink is true, dir and file false, and the
   size the length of what it names. *)
proc linkInfo*(path: []U8): (Info, INT);
var a: [4096]U8; st: Stat; i: Info;
begin
    if not cstr(path, a) then return i, -36; end;
    if C.lstat(ADR(a[0]), ^U8(ADR(st))) # 0 then return i, failed(); end;
    i := fromStat(st);
    i.symlink := fileType(st) = CAbi.sIflnk;
    return i, 0;
end;

(* info of the file open on fd, which is never a link. *)
proc infoOf*(fd: INT): (Info, INT);
var st: Stat; i: Info;
begin
    if C.fstat(I32(fd), ^U8(ADR(st))) # 0 then return i, failed(); end;
    return fromStat(st), 0;
end;

(* The bytes free to an ordinary user on path's file system, and the
   bytes in all. *)
proc space*(path: []U8): (I64, I64, INT);
var a: [4096]U8; st: [(CAbi.statvfsLen + 7) div 8]U64; p: ^U8; unit: I64;
begin
    if not cstr(path, a) then return 0, 0, -36; end;
    p := ^U8(ADR(st));
    if C.statvfs(ADR(a[0]), p) # 0 then return 0, 0, failed(); end;
    unit := field(p, CAbi.fFrsizeAt, CAbi.fFrsizeLen);
    return field(p, CAbi.fBavailAt, CAbi.fBavailLen) * unit, field(p, CAbi.fBlocksAt, CAbi.fBlocksLen) * unit, 0;
end;

(* The Kind of a d_type, as readdir gives it: DT_REG, DT_DIR, DT_LNK,
   DT_UNKNOWN, and the rest (pipes, devices, sockets) other things. *)
proc kindOf(t: U8): Kind;
begin
    if t = CAbi.dtReg then return isFile;
    elsif t = CAbi.dtDir then return isDir;
    elsif t = CAbi.dtLnk then return isLink;
    elsif t = CAbi.dtUnknown then return unknown;
    end;
    return isOther;
end;

(* Opens the directory at path, for nextEntry. *)
proc openDir*(var d: Dir; path: []U8): INT;
var a: [4096]U8;
begin
    d.kind := unknown;
    if not cstr(path, a) then return -36; end;
    d.d := C.opendir(ADR(a[0]));
    if d.d = nil then return failed(); end;
    return 0;
end;

(* The next name in the directory, good until the next call, but . and
   .., in no order; false at the end. *)
proc nextEntry*(var d: Dir): ([]U8, BOOL);
var e: ^U8; n: INT;
begin
    while true do
        e := C.readdir(d.d);
        if e = nil then return "", false; end;
        d.kind := kindOf(e[CAbi.dTypeAt]);
        e := e + CAbi.dNameAt;
        n := 0;
        while e[n] # 0 do INC(n); end;
        if (e[0..n] # ".") and (e[0..n] # "..") then return e[0..n], true; end;
    end;
    return "", false;
end;

(* What the name nextEntry gave last is, as the directory says, so that
   a walk needn't ask each file with linkInfo; unknown where the file
   system doesn't say. A link is isLink, whatever it names. *)
proc entryKind*(const d: Dir): Kind;
begin
    return d.kind;
end;

(* Closes the directory d that openDir opened. *)
proc closeDir*(var d: Dir);
begin
    _ := C.closedir(d.d);
end;

(* Puts the terminal on fd into raw mode, as cfmakeraw makes it: no
   echo, no lines, no signals, no flow control, no CR to NL, no NL to
   CR NL; false if fd isn't a terminal. *)
proc rawMode*(fd: INT): BOOL;
var t: [256]U8;
begin
    if C.tcgetattr(I32(fd), ADR(saved[0])) # 0 then return false; end;
    t := saved;
    C.cfmakeraw(ADR(t[0]));
    return C.tcsetattr(I32(fd), CAbi.tcsanow, ADR(t[0])) = 0;
end;

(* The terminal on fd as rawMode found it. *)
proc restoreMode*(fd: INT);
begin
    _ := C.tcsetattr(I32(fd), CAbi.tcsanow, ADR(saved[0]));
end;

(* The modes of the terminal on fd, as a shell keeps them for each job;
   and 0, or minus an errno, -25 (ENOTTY) if it isn't a terminal. *)
proc getMode*(fd: INT): (Mode, INT);
var m: Mode;
begin
    if C.tcgetattr(I32(fd), ADR(m.t[0])) # 0 then return m, failed(); end;
    return m, 0;
end;

(* Gives the terminal on fd the modes m, once what was written to it
   is sent: 0, or minus an errno. *)
proc setMode*(fd: INT; m: Mode): INT;
begin
    if C.tcsetattr(I32(fd), CAbi.tcsadrain, ADR(m.t[0])) # 0 then return failed(); end;
    return 0;
end;

(* The columns and rows of the terminal on fd; 80 by 24 if it doesn't
   say. *)
proc termSize*(fd: INT): (INT, INT);
var w: Winsize;
begin
    if (C.ioctl(I32(fd), CAbi.tiocgwinsz, ADR(w)) # 0) or (w.cols = 0) or (w.rows = 0) then
        return 80, 24;
    end;
    return INT(w.cols), INT(w.rows);
end;

(* Whether fd has something to read within ms milliseconds; ms < 0
   waits as long as it takes. *)
proc ready*(fd, ms: INT): BOOL;
var p: Pollfd; r: I32;
begin
    p := {fd: I32(fd), events: CAbi.pollin};
    _ := XCHG(ADR(broke), 0);
    repeat r := C.poll(^U8(ADR(p)), 1, I32(ms)); until (r >= 0) or not again();
    return r > 0;
end;

(* The time on clock, in nanoseconds. *)
proc time(clock: I32): I64;
var t: Timespec;
begin
    _ := C.clock_gettime(clock, ^U8(ADR(t)));
    return t.sec * 1000000000 + t.nsec;
end;

(* The clock that only goes forward, in nanoseconds: for how long
   something takes. *)
proc clock*: I64;
begin
    return time(CAbi.clockMonotonic);
end;

(* The time in nanoseconds since 1970-01-01, UTC. *)
proc now*: I64;
begin
    return time(CAbi.clockRealtime);
end;

(* Waits ms milliseconds. *)
proc sleep*(ms: INT);
var t: Timespec; at: I64;
begin
    at := clock() + I64(ms) * 1000000;
    t := {sec: at div 1000000000, nsec: at mod 1000000000};
    (* until t, again after EINTR, which it returns, the C library's *)
    repeat until C.clock_nanosleep(CAbi.clockMonotonic, CAbi.timerAbstime, ^U8(ADR(t)), nil) # CAbi.eIntr;
end;

(* Ends the program: random bytes can't be faked. *)
proc noRandom;
begin
    _ := write(stderr, "Sys.random: the kernel gave no random bytes\n");
    C._exit(2);
end;

(* Fills b with random bytes, from the kernel. Random bytes can't be
   faked, so if the kernel can't give them (no getrandom, or a filter
   refusing it) it says so on standard error and ends the program by
   exit with status 2. *)
proc random*(b: []U8);
var n, r: INT;
begin
    n := 0;
    while n < LEN(b) do                                 (* a signal may cut it short *)
        r := C.getrandom(ADR(b[n]), UINT(LEN(b) - n), 0);
        if r > 0 then INC(n, r);
        elsif (r >= 0) or (failed() # errIntr) then noRandom();   (* r = 0 can't be, and is no progress *)
        end;
    end;
end;

(* A socket of family and kind, connected to the address at a, of size
   bytes, or, if serving, bound to it and taking connections: its file
   descriptor, or minus an errno. It is closed in a program exec
   starts. *)
proc socket(family, kind: INT; a: ^U8; size: INT; serving: BOOL): INT;
var fd, r, one: I32; err: INT;
begin
    fd := C.socket(I32(family), I32(kind) | CAbi.sockCloexec, 0);
    if fd < 0 then return failed(); end;
    if serving then
        one := 1;                                       (* so that a server can start again at once *)
        _ := C.setsockopt(fd, CAbi.solSocket, CAbi.soReuseaddr, ^U8(ADR(one)), 4);
        r := C.bind(fd, a, U32(size));
        if (r = 0) and (kind = CAbi.sockStream) then    (* a stream socket takes connections; *)
            r := C.listen(fd, 4096);                    (* one of datagrams only receives *)
        end;
    else
        r := C.connect(fd, a, U32(size));
    end;
    if r # 0 then
        err := failed();                                (* before close can change errno *)
        _ := C.close(fd);
        return err;
    end;
    return INT(fd);
end;

(* Gives the address at p the family, and, on a system whose addresses
   start with their length, size *)
proc setFamily(p: ^U8; family, size: INT);
begin
    setField(p, CAbi.saFamilyAt, CAbi.saFamilyLen, family);
    if CAbi.saLenAt >= 0 then p[CAbi.saLenAt] := U8(size); end;
end;

(* The family of the address at p *)
proc familyOf(p: ^U8): INT;
begin
    return INT(field(p, CAbi.saFamilyAt, CAbi.saFamilyLen));
end;

(* path as a Unix socket's address in a, or false if it is too long. *)
proc unixAddr(path: []U8; a: ^Sockaddr): BOOL;
var p: ^U8;
begin
    if LEN(path) >= CAbi.sunPathLen then return false; end;
    p := ^U8(a);
    setFamily(p, CAbi.afUnix, CAbi.sockaddrUnLen);
    COPY(p[CAbi.sunPathAt..CAbi.sunPathAt + LEN(path)], path);
    return true;
end;

(* A stream socket connected to the Unix socket at path. *)
proc connect*(path: []U8): INT;
var a: Sockaddr;
begin
    if not unixAddr(path, ADR(a)) then return -36; end;    (* ENAMETOOLONG *)
    return socket(CAbi.afUnix, CAbi.sockStream, ^U8(ADR(a)), CAbi.sockaddrUnLen, false);
end;

(* A stream socket made at path, which must not be there yet, taking
   connections. *)
proc listen*(path: []U8): INT;
var a: Sockaddr;
begin
    if not unixAddr(path, ADR(a)) then return -36; end;
    return socket(CAbi.afUnix, CAbi.sockStream, ^U8(ADR(a)), CAbi.sockaddrUnLen, true);
end;

(* addr, an IPv4 or IPv6 address as numbers, and port, in a: the size
   of its struct sockaddr_in or sockaddr_in6, or 0 if either is
   wrong. *)
proc inetAddr(addr: []U8; port: INT; a: ^Sockaddr): INT;
var s: [64]U8; b: [16]U8; p: ^U8; at, size: INT;
begin
    if (port < 0) or (port > 65535) or not cstr(addr, s) then return 0; end;
    p := ^U8(a);
    (* into b first, since musl's inet_pton leaves what it read of an
       address it refuses, and the rest of the address is to be zero *)
    if C.inet_pton(CAbi.afInet, ADR(s[0]), ADR(b[0])) = 1 then
        size := CAbi.sockaddrInLen;
        setFamily(p, CAbi.afInet, size);
        COPY(p[CAbi.sinAddrAt..CAbi.sinAddrAt + 4], b[0..4]);
        at := CAbi.sinPortAt;
    elsif C.inet_pton(CAbi.afInet6, ADR(s[0]), ADR(b[0])) = 1 then
        size := CAbi.sockaddrIn6Len;
        setFamily(p, CAbi.afInet6, size);
        COPY(p[CAbi.sin6AddrAt..CAbi.sin6AddrAt + 16], b);
        at := CAbi.sin6PortAt;
    else
        return 0;
    end;
    p[at] := U8(port shr 8);                            (* in the network's order, the high byte first *)
    p[at + 1] := U8(port & 255);
    return size;
end;

(* The port in the IPv4 or IPv6 address at p *)
proc portOf(p: ^U8): INT;
var at: INT;
begin
    at := CAbi.sinPortAt;
    if familyOf(p) = CAbi.afInet6 then at := CAbi.sin6PortAt; end;
    return (INT(p[at]) shl 8) | INT(p[at + 1]);
end;

(* A socket of kind at addr and port, as socket makes it; -22 (EINVAL)
   if they are wrong. *)
proc inet(addr: []U8; port, kind: INT; serving: BOOL): INT;
var a: Sockaddr; size: INT;
begin
    size := inetAddr(addr, port, ADR(a));
    if size = 0 then return -22; end;
    return socket(familyOf(^U8(ADR(a))), kind, ^U8(ADR(a)), size, serving);
end;

(* A stream socket connected to port at addr, an IPv4 or IPv6 address
   as numbers. *)
proc connectTcp*(addr: []U8; port: INT): INT;
begin
    return inet(addr, port, CAbi.sockStream, false);
end;

(* A socket of datagrams to and from port at addr. *)
proc connectUdp*(addr: []U8; port: INT): INT;
begin
    return inet(addr, port, CAbi.sockDgram, false);
end;

(* A stream socket taking connections on port at addr; "0.0.0.0" or
   "::" is every address the machine has. *)
proc listenTcp*(addr: []U8; port: INT): INT;
begin
    return inet(addr, port, CAbi.sockStream, true);
end;

(* A socket of datagrams on port at addr, from anyone, for receive and
   reply. *)
proc listenUdp*(addr: []U8; port: INT): INT;
begin
    return inet(addr, port, CAbi.sockDgram, true);
end;

(* The next connection to the socket fd, waiting for one: a socket of
   its own, closed in a program exec starts; or minus an errno. *)
proc accept*(fd: INT): INT;
var r: I32;
begin
    r := C.accept4(I32(fd), nil, nil, CAbi.sockCloexec);
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* Ends this side's writing to the socket fd, so that the other end
   reads an end of input and can still answer on it. 0, or minus an
   errno. *)
proc closeWrite*(fd: INT): INT;
begin
    if C.shutdown(I32(fd), CAbi.shutWr) # 0 then return failed(); end;
    return 0;
end;

(* Who is at the other end of the connected socket fd, and 0; or minus
   an errno. *)
proc peer*(fd: INT): (Remote, INT);
var r: Remote; a: Sockaddr; size, credSize: U32; cred: [CAbi.ucUidAt + CAbi.ucUidLen]U8; p: ^U8;
begin
    r := {unix: false, ipv6: false};
    size := U32(SIZE(Sockaddr));
    p := ^U8(ADR(a));
    if C.getpeername(I32(fd), p, ADR(size)) # 0 then return r, failed(); end;
    if familyOf(p) = CAbi.afUnix then                   (* ask who made the connection *)
        credSize := U32(LEN(cred));
        if C.getsockopt(I32(fd), CAbi.solSocket, CAbi.soPeercred, ADR(cred[0]), ADR(credSize)) # 0 then
            return r, failed();
        end;
        r.unix := true;
        r.pid := INT(field(ADR(cred[0]), CAbi.ucPidAt, CAbi.ucPidLen));
        r.uid := INT(field(ADR(cred[0]), CAbi.ucUidAt, CAbi.ucUidLen));
    else
        r.port := portOf(p);
        if familyOf(p) = CAbi.afInet6 then
            r.ipv6 := true;
            COPY(r.addr[0..16], p[CAbi.sin6AddrAt..CAbi.sin6AddrAt + 16]);
        else
            COPY(r.addr[0..4], p[CAbi.sinAddrAt..CAbi.sinAddrAt + 4]);
        end;
    end;
    return r, 0;
end;

(* Two connected stream sockets, as a Unix socket and the one that
   connects to it make: their fds and 0, closed in a program exec
   starts; or -1, -1 and minus an errno. *)
proc socketPair*: (INT, INT, INT);
var fds: [2]I32;
begin
    if C.socketpair(CAbi.afUnix, CAbi.sockStream | CAbi.sockCloexec, 0, ADR(fds[0])) # 0 then
        return -1, -1, failed();
    end;
    return INT(fds[0]), INT(fds[1]), 0;
end;

(* Writes s to the socket fd, as write does, but returns -32 (EPIPE)
   where write would stop the program with SIGPIPE: when the other end
   has closed it. *)
proc send*(fd: INT; s: []U8): INT;
var r: INT;
begin
    if LEN(s) = 0 then return 0; end;
    r := C.send(I32(fd), ADR(s[0]), UINT(LEN(s)), CAbi.msgNosignal);
    if r < 0 then return failed(); end;
    return r;
end;

(* The first of reads that has something to read within ms
   milliseconds, or of writes that has room to write, or that has
   reached its end or failed, so that a read or a write won't wait; -1
   if none has. ms < 0 waits as long as it takes. At most 64 fds in
   all. *)
proc readyFor*(reads, writes: []INT; ms: INT): INT;
var p: [64]Pollfd; n, i: INT; r: I32;
begin
    n := 0;
    for i := 0 to LEN(reads) - 1 do
        if n < LEN(p) then
            p[n] := {fd: I32(reads[i]), events: CAbi.pollin};
            INC(n);
        end;
    end;
    for i := 0 to LEN(writes) - 1 do
        if n < LEN(p) then
            p[n] := {fd: I32(writes[i]), events: CAbi.pollout};
            INC(n);
        end;
    end;
    _ := XCHG(ADR(broke), 0);
    repeat r := C.poll(^U8(ADR(p)), UINT(n), I32(ms)); until (r >= 0) or not again();
    if r <= 0 then return -1; end;
    for i := 0 to n - 1 do
        if p[i].revents # 0 then return INT(p[i].fd); end;
    end;
    return -1;
end;

(* The first of fds that has something to read within ms milliseconds,
   or that has reached its end or failed, so that a read won't wait; -1
   if none has. ms < 0 waits as long as it takes. At most 64 fds. *)
proc readyOf*(fds: []INT; ms: INT): INT;
begin
    return readyFor(fds, [], ms);
end;

(* Reads and writes on fd made to wait, as they do at first; or, if not
   yes, to return -11 (EAGAIN) at once where they would wait. 0, or
   minus an errno. *)
proc setBlocking*(fd: INT; yes: BOOL): INT;
var flags: I32;
begin
    flags := C.fcntl(I32(fd), CAbi.fGetfl, 0);
    if flags < 0 then return failed(); end;
    if yes then flags := flags & ~I32(CAbi.oNonblock); else flags := flags | CAbi.oNonblock; end;
    if C.fcntl(I32(fd), CAbi.fSetfl, flags) < 0 then return failed(); end;
    return 0;
end;

(* Whether reads and writes on fd wait, as they do at first: 1 if they
   do, 0 if they return -11 (EAGAIN) at once, or minus an errno. *)
proc blocking*(fd: INT): INT;
var flags: I32;
begin
    flags := C.fcntl(I32(fd), CAbi.fGetfl, 0);
    if flags < 0 then return failed(); end;
    if flags & CAbi.oNonblock # 0 then return 0; end;
    return 1;
end;

(* A stream socket connected to port at addr, as connectTcp makes it,
   or -110 (ETIMEDOUT) if it isn't connected within ms milliseconds.
   It starts to connect without waiting, then waits for the socket to
   be writable, which it is once connected or refused, and asks which. *)
proc connectTcpWithin*(addr: []U8; port, ms: INT): INT;
var a: Sockaddr; size, r: INT; fd, err: I32; errSize: U32;
begin
    size := inetAddr(addr, port, ADR(a));
    if size = 0 then return -22; end;
    fd := C.socket(I32(familyOf(^U8(ADR(a)))), CAbi.sockStream | CAbi.sockCloexec | CAbi.sockNonblock, 0);
    if fd < 0 then return failed(); end;
    r := 0;
    if C.connect(fd, ^U8(ADR(a)), U32(size)) # 0 then r := failed(); end;
    if r = -115 then                                    (* EINPROGRESS *)
        r := -110;
        if readyFor([], [INT(fd)], ms) = INT(fd) then
            errSize := 4;
            if C.getsockopt(fd, CAbi.solSocket, CAbi.soError, ^U8(ADR(err)), ADR(errSize)) = 0 then
                r := linux(-INT(err));
            else
                r := failed();
            end;
        end;
    end;
    if r = 0 then r := setBlocking(INT(fd), true); end;
    if r < 0 then _ := C.close(fd); return r; end;
    return INT(fd);
end;

(* The port the socket fd is bound to, or minus an errno: for a socket
   made on port 0, the one the system chose. *)
proc localPort*(fd: INT): INT;
var a: Sockaddr; size: U32;
begin
    size := U32(SIZE(Sockaddr));
    if C.getsockname(I32(fd), ^U8(ADR(a)), ADR(size)) # 0 then return failed(); end;
    return portOf(^U8(ADR(a)));
end;

(* The next datagram to the socket fd, waiting for one: its first
   LEN(buf) bytes in buf, the rest lost, and who sent it. The number is
   the bytes in buf, or minus an errno. *)
proc receive*(fd: INT; buf: []U8): (INT, Peer);
var p: Peer; size: U32; n: INT;
begin
    size := U32(SIZE(Sockaddr));
    n := C.recvfrom(I32(fd), PTR(buf), UINT(LEN(buf)), 0, ^U8(ADR(p.a)), ADR(size));
    if n < 0 then n := failed(); end;
    p.size := INT(size);
    return n, p;
end;

(* Sends s, as one datagram, from the socket fd to peer, as receive
   gave it: the bytes sent, or minus an errno. *)
proc reply*(fd: INT; peer: Peer; s: []U8): INT;
var r: INT;
begin
    r := C.sendto(I32(fd), PTR(s), UINT(LEN(s)), CAbi.msgNosignal, ^U8(ADR(peer.a)), U32(peer.size));
    if r < 0 then return failed(); end;
    return r;
end;

(* Sends s, at least one byte, to the Unix socket fd, as send does, and
   with it the files fds, at most 16, which the program that receives
   them then has open too: the bytes sent, or minus an errno. *)
proc sendFds*(fd: INT; s: []U8; fds: []INT): INT;
var m: Msghdr; v: Iovec; c: Control; mp, cp: ^U8; sent: ^I32; i, r, size: INT;
begin
    if (LEN(s) = 0) or (LEN(fds) > 16) then return -22; end;
    v := {base: ADR(s[0]), size: LEN(s)};
    mp := ^U8(ADR(m));
    setField(mp, CAbi.msgIovAt, SIZE(^U8), INT(ADR(v)));
    setField(mp, CAbi.msgIovlenAt, CAbi.msgIovlenLen, 1);
    if LEN(fds) > 0 then
        (* a struct cmsghdr, its level and type ints, then the fds *)
        cp := ^U8(ADR(c));
        size := CAbi.cmsgDataAt + 4 * LEN(fds);
        setField(cp, CAbi.cmsgLenAt, CAbi.cmsgLenLen, size);
        setField(cp, CAbi.cmsgLevelAt, 4, CAbi.solSocket);
        setField(cp, CAbi.cmsgTypeAt, 4, CAbi.scmRights);
        sent := ^I32(cp + CAbi.cmsgDataAt);
        for i := 0 to LEN(fds) - 1 do sent[i] := I32(fds[i]); end;
        setField(mp, CAbi.msgControlAt, SIZE(^U8), INT(cp));
        (* CMSG_SPACE: rounded up to the C library's alignment *)
        setField(mp, CAbi.msgControllenAt, CAbi.msgControllenLen, (size + CAbi.cmsgAlign - 1) & ~(CAbi.cmsgAlign - 1));
    end;
    r := C.sendmsg(I32(fd), mp, CAbi.msgNosignal);
    if r < 0 then return failed(); end;
    return r;
end;

(* Reads into buf from the Unix socket fd, as read does, and puts the
   files sent with what it read in fds, as many as fit, closing the
   rest: the bytes read, or minus an errno, and the files put in fds.
   Each is closed in a program exec starts. *)
proc receiveFds*(fd: INT; buf: []U8; fds: []INT): (INT, INT);
var m: Msghdr; v: Iovec; c: Control; mp, cp: ^U8; got: ^I32; n, k, i, size: INT;
begin
    v := {base: PTR(buf), size: LEN(buf)};
    mp := ^U8(ADR(m));
    cp := ^U8(ADR(c));
    setField(mp, CAbi.msgIovAt, SIZE(^U8), INT(ADR(v)));
    setField(mp, CAbi.msgIovlenAt, CAbi.msgIovlenLen, 1);
    setField(mp, CAbi.msgControlAt, SIZE(^U8), INT(cp));
    setField(mp, CAbi.msgControllenAt, CAbi.msgControllenLen, SIZE(Control));
    n := C.recvmsg(I32(fd), mp, CAbi.msgCmsgCloexec);
    if n < 0 then return failed(), 0; end;
    k := 0;
    if (field(mp, CAbi.msgControllenAt, CAbi.msgControllenLen) >= CAbi.cmsgDataAt)
            and (field(cp, CAbi.cmsgLevelAt, 4) = CAbi.solSocket) and (field(cp, CAbi.cmsgTypeAt, 4) = CAbi.scmRights) then
        size := INT(field(cp, CAbi.cmsgLenAt, CAbi.cmsgLenLen));
        got := ^I32(cp + CAbi.cmsgDataAt);
        for i := 0 to (size - CAbi.cmsgDataAt) div 4 - 1 do
            if k < LEN(fds) then
                fds[k] := INT(got[i]);
                INC(k);
            else
                _ := C.close(got[i]);
            end;
        end;
    end;
    return n, k;
end;

(* What errno err, or minus it, means, as the C library's strerror
   says it. *)
proc errorText*(err: INT): []U8;
var s: ^U8; n, i: INT;
begin
    if err < 0 then err := -err; end;
    if (err < 0) or (err > 7FFFFFFFH) then return "unknown error"; end;   (* the smallest INT, or past an int *)
    for i := 0 to LEN(CAbi.errnos) - 2 by 2 do       (* Linux's errno as the C library's *)
        if INT(CAbi.errnos[i + 1]) = err then err := INT(CAbi.errnos[i]); break; end;
    end;
    s := C.strerror(I32(err));
    if s = nil then return "unknown error"; end;
    n := 0;
    while s[n] # 0 do INC(n); end;
    return s[0..n];
end;

(* The value of the environment variable name and true, or "" and
   false if it isn't set: "" and true if it is set to nothing. *)
proc findEnv*(name: []U8): ([]U8, BOOL);
var a: [4096]U8; s: ^U8; n: INT;
begin
    if not cstr(name, a) then return "", false; end;
    s := C.getenv(ADR(a[0]));
    if s = nil then return "", false; end;
    n := 0;
    while s[n] # 0 do INC(n); end;
    return s[0..n], true;
end;

(* The value of the environment variable name; "" if it isn't set. *)
proc env*(name: []U8): []U8;
var v: []U8;
begin
    v, _ := findEnv(name);
    return v;
end;

(* The environment's ith NAME=value, from 0, and true; "" and false
   past the last. *)
proc envAt*(i: INT): ([]U8, BOOL);
var e: ^^U8; s: ^U8; j, n: INT;
begin
    if i < 0 then return "", false; end;
    e := C.environ;
    for j := 0 to i do
        if e[j] = nil then return "", false; end;
    end;
    s := e[i];
    n := 0;
    while s[n] # 0 do INC(n); end;
    return s[0..n], true;
end;

(* The working directory, good until the next call; and 0, or minus an
   errno. *)
proc workDir*: ([]U8, INT);
var n: INT;
begin
    if C.getcwd(ADR(cwd[0]), LEN(cwd)) = nil then return "", failed(); end;
    n := 0;
    while cwd[n] # 0 do INC(n); end;
    return cwd[0..n], 0;
end;

(* Makes path the working directory. *)
proc setWorkDir*(path: []U8): INT;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    if C.chdir(ADR(a[0])) # 0 then return failed(); end;
    return 0;
end;

(* A pseudo-terminal: the file descriptor of its controlling side, or
   minus an errno. Its other side, the terminal its programs run on, is
   unlocked, for spawn to open. *)
proc openPty*: INT;
var fd: I32; err: INT;
begin
    fd := C.posix_openpt(CAbi.oRdwr | CAbi.oNoctty);
    if fd < 0 then return failed(); end;
    if (C.grantpt(fd) # 0) or (C.unlockpt(fd) # 0) then
        err := failed();
        _ := C.close(fd);
        return err;
    end;
    return INT(fd);
end;

(* Tells the terminal of the pseudo-terminal fd that it has cols
   columns and rows rows: 0, or minus an errno. *)
proc setTermSize*(fd, cols, rows: INT): INT;
var w: Winsize;
begin
    w := {rows: U16(rows), cols: U16(cols)};
    if C.ioctl(I32(fd), CAbi.tiocswinsz, ADR(w)) # 0 then return failed(); end;
    return 0;
end;

(* Copies s and a zero to at: the byte after them. *)
proc put(s: []U8; at: ^U8): ^U8;
begin
    COPY(at[0..LEN(s)], s);
    at[LEN(s)] := 0;
    return at + (LEN(s) + 1);
end;

(* Whether the NAME=value s, a C string, names a variable that one of
   env gives. *)
proc replaced(s: ^U8; env: [][]U8): BOOL;
var i, n: INT;
begin
    for i := 0 to LEN(env) - 1 do
        n := 0;
        while (n < LEN(env[i])) and (s[n] = env[i][n]) and (s[n] # '=') do INC(n); end;
        if (n < LEN(env[i])) and (env[i][n] = '=') and (s[n] = '=') then return true; end;
    end;
    return false;
end;

(* What execve takes, in fresh memory of the size returned: args as C
   strings and a nil, then the environment old with each NAME=value of
   env in place of its variable or added, and a nil; or nil. The
   environment follows the arguments. *)
proc argsAndEnv(args, env: [][]U8; old: ^^U8): (^^U8, INT);
var p: ^^U8; s: ^U8; size, n, i, k: INT;
begin
    n := 0;
    while old[n] # nil do INC(n); end;
    size := (LEN(args) + n + LEN(env) + 2) * SIZE(^U8);
    for i := 0 to LEN(args) - 1 do INC(size, LEN(args[i]) + 1); end;
    for i := 0 to LEN(env) - 1 do INC(size, LEN(env[i]) + 1); end;
    p := ^^U8(mmap(size));
    if p = nil then return nil, 0; end;
    s := ^U8(p + (LEN(args) + n + LEN(env) + 2));
    k := 0;
    for i := 0 to LEN(args) - 1 do p[k] := s; s := put(args[i], s); INC(k); end;
    p[k] := nil;
    INC(k);
    for i := 0 to n - 1 do
        if not replaced(old[i], env) then p[k] := old[i]; INC(k); end;
    end;
    for i := 0 to LEN(env) - 1 do p[k] := s; s := put(env[i], s); INC(k); end;
    p[k] := nil;
    return p, size;
end;

(* Sets the environment variable name to value, for env and for the
   programs this one starts; 0, or minus an errno: -22 if name is empty
   or holds an = or a 0, or value a 0, and -12 if there is no memory.
   The C library's setenv keeps the environment. It isn't safe while
   another thread reads the environment or starts a program. *)
proc setEnv*(name, value: []U8): INT;
var p: ^U8; size, i, r: INT;
begin
    if LEN(name) = 0 then return -22; end;                     (* EINVAL *)
    for i := 0 to LEN(name) - 1 do
        if (name[i] = '=') or (name[i] = 0) then return -22; end;
    end;
    for i := 0 to LEN(value) - 1 do
        if value[i] = 0 then return -22; end;
    end;
    (* both as C strings, in memory that comes zeroed *)
    size := LEN(name) + LEN(value) + 2;
    p := mmap(size);
    if p = nil then return -12; end;                           (* ENOMEM *)
    COPY(p[0..LEN(name)], name);
    COPY(p[LEN(name) + 1..size - 1], value);
    r := 0;
    if C.setenv(p, p + (LEN(name) + 1), 1) # 0 then r := failed(); end;
    munmap(p, size);
    return r;
end;

(* A pipe: the fd to read and the fd to write, both closed in a program
   exec starts; or minus an errno and -1. *)
proc pipe*: (INT, INT);
var fds: [2]I32;
begin
    if C.pipe2(ADR(fds[0]), CAbi.oCloexec) # 0 then return failed(), -1; end;
    return INT(fds[0]), INT(fds[1]);
end;

(* This program's process id. *)
proc pid*: INT;
begin
    return INT(C.getpid());
end;

(* The user this program runs as: its real id. *)
proc uid*: INT;
begin
    return INT(C.getuid());
end;

(* The user whose rights this program has, its effective id: 0 is
   root. *)
proc euid*: INT;
begin
    return INT(C.geteuid());
end;

(* The name of this machine, good until the next call; and 0, or minus
   an errno. *)
proc hostName*: ([]U8, INT);
var n: INT;
begin
    if C.gethostname(ADR(host[0]), LEN(host) - 1) # 0 then return "", failed(); end;
    host[LEN(host) - 1] := 0;                         (* POSIX doesn't promise one if it is cut *)
    n := 0;
    while host[n] # 0 do INC(n); end;
    return host[0..n], 0;
end;

(* The number of processors this program may run on, at least 1. *)
proc processors*: INT;
var mask: [1024]U8; i, b, count: INT;
begin
    for i := 0 to LEN(mask) - 1 do mask[i] := 0; end;   (* the C library fills in as many bytes as the system has processors' bits *)
    if C.sched_getaffinity(0, UINT(LEN(mask)), ADR(mask[0])) # 0 then return 1; end;
    count := 0;
    for i := 0 to LEN(mask) - 1 do
        for b := 0 to 7 do
            if (INT(mask[i]) shr b) & 1 = 1 then INC(count); end;
        end;
    end;
    if count < 1 then return 1; end;
    return count;
end;

(* The struct timeval at p, in ns *)
proc ns(p: ^U8): I64;
begin
    return field(p, CAbi.tvSecAt, CAbi.tvSecLen) * 1000000000 + field(p, CAbi.tvUsecAt, CAbi.tvUsecLen) * 1000;
end;

(* The time on the processor, in ns, that this program has used, or,
   if children, the programs it started and waited for: in the program
   itself, and in the system for it. *)
proc cpuTime*(children: BOOL): (I64, I64);
var ru: [64]U64; p: ^U8;   (* struct rusage, which cabi checks fits *)
begin
    p := ^U8(ADR(ru));
    if children then _ := C.getrusage(CAbi.rusageChildren, p);
    else _ := C.getrusage(CAbi.rusageSelf, p);
    end;
    return ns(p + CAbi.ruUtimeAt), ns(p + CAbi.ruStimeAt);
end;

(* The limit which, one of the limit constants: the soft one, which
   this program may raise up to the hard one; -1 for none; and 0, or
   minus an errno. *)
proc limit*(which: INT): (I64, I64, INT);
var r: [2]I64; i: INT;   (* struct rlimit *)
begin
    if C.getrlimit(I32(which), ^U8(ADR(r))) # 0 then return 0, 0, failed(); end;
    for i := 0 to 1 do
        if r[i] = CAbi.rlimInfinity then r[i] := -1; end;
    end;
    return r[0], r[1], 0;
end;

(* Sets the limit which to soft and hard, -1 for none: 0, or minus an
   errno. *)
proc setLimit*(which: INT; soft, hard: I64): INT;
var r: [2]I64; i: INT;
begin
    r := [soft, hard];
    for i := 0 to 1 do
        if r[i] = -1 then r[i] := CAbi.rlimInfinity; end;
    end;
    if C.setrlimit(I32(which), ^U8(ADR(r))) # 0 then return failed(); end;
    return 0;
end;

(* Moves the program pid, or this one if pid is 0, to the process group
   group, or to a new one it leads if group is 0. *)
proc setGroup*(pid, group: INT): INT;
begin
    if C.setpgid(I32(pid), I32(group)) # 0 then return failed(); end;
    return 0;
end;

(* The process group this program is in. *)
proc group*: INT;
begin
    return INT(C.getpgrp());
end;

(* Gives the keys of the terminal on fd, and its signals, to the process
   group group. *)
proc foreground*(fd, group: INT): INT;
begin
    if C.tcsetpgrp(I32(fd), I32(group)) # 0 then return failed(); end;
    return 0;
end;

(* The process group the terminal on fd gives its keys to, or minus an
   errno. *)
proc foregroundOf*(fd: INT): INT;
var g: I32;
begin
    g := C.tcgetpgrp(I32(fd));
    if g < 0 then return failed(); end;
    return INT(g);
end;

(* Where spawn looks for a program named without a /, if PATH is unset
   or empty: glibc's execvp looks in these. *)
const defaultPath = "/bin:/usr/bin";

(* The ith directory of search, a list of them with : between, as PATH
   is: dir, "." if it is empty, and where the next starts; -1 past the
   last. *)
proc pathDir(search: []U8; i: INT): ([]U8, INT);
var j: INT;
begin
    if i > LEN(search) then return "", -1; end;
    j := i;
    while (j < LEN(search)) and (search[j] # ':') do INC(j); end;
    if j = i then return ".", j + 1; end;
    return search[i..j], j + 1;
end;

(* dir, a /, and name, a C string in buf; false if it doesn't fit. *)
proc joinPath(dir, name, buf: []U8): BOOL;
var n: INT;
begin
    n := LEN(dir) + 1 + LEN(name);
    if n >= LEN(buf) then return false; end;
    COPY(buf, dir);
    buf[LEN(dir)] := '/';
    COPY(buf[LEN(dir) + 1..n], name);
    buf[n] := 0;
    return true;
end;

(* Whether name holds a /, and so is a path, not a name to look for. *)
proc isPath(name: []U8): BOOL;
var i: INT;
begin
    for i := 0 to LEN(name) - 1 do
        if name[i] = '/' then return true; end;
    end;
    return false;
end;

(* Runs the program at name, as execve does; or, for a name without a
   /, the first program of that name in the directories of search, as
   execvp does: each in turn, an empty one being the working directory.
   It returns only if none could be run. It runs in spawn's child, after
   the fork, so it takes no memory: each path is made in buf. *)
proc run(name, search, buf: []U8; argv, envp: ^^U8);
var dir: []U8; i: INT;
begin
    if isPath(name) or (LEN(name) = 0) then
        if cstr(name, buf) then _ := C.execve(ADR(buf[0]), argv, envp); end;
        return;
    end;
    dir, i := pathDir(search, 0);
    while i >= 0 do
        if joinPath(dir, name, buf) then _ := C.execve(ADR(buf[0]), argv, envp); end;
        dir, i := pathDir(search, i);
    end;
end;

(* The program exec runs for name, as a C string in buf: name itself
   if it has a /, or else the first file of that name in the
   directories of search that is no directory and that this user may
   run. 0; or -2 (ENOENT) if there is none, or -13 (EACCES) if one is
   there and can't be run. *)
proc find(name, search, buf: []U8): INT;
var dir: []U8; i, err, r: INT; f: Info;
begin
    if isPath(name) then
        if not cstr(name, buf) then return -36; end;
        return 0;
    end;
    r := -2;                                          (* ENOENT *)
    dir, i := pathDir(search, 0);
    while (LEN(name) > 0) and (i >= 0) do
        if joinPath(dir, name, buf) then
            f, err := info(buf[0..LEN(dir) + 1 + LEN(name)]);
            if (err = 0) and not f.dir then
                if C.access(ADR(buf[0]), 1) = 0 then return 0; end;   (* X_OK *)
                r := -13;                             (* EACCES *)
            end;
        end;
        dir, i := pathDir(search, i);
    end;
    return r;
end;

(* The name of the terminal of the pseudo-terminal fd, as a C string
   in name, which isn't safe to ask after a fork: 0, or minus an
   errno. *)
proc ptyName(fd: INT; name: []U8): INT;
var s: ^U8; n: INT;
begin
    s := C.ptsname(I32(fd));
    if s = nil then return failed(); end;
    n := 0;
    while s[n] # 0 do INC(n); end;
    if not cstr(s[0..n], name) then return -36; end;
    return 0;
end;

(* Closes every fd from 3 on but those of keep, which stay open in the
   program exec starts. It runs in spawn's child, after the fork, so it
   takes no memory: it closes the runs between the fds kept, the lowest
   first, each with one closeFrom. *)
proc closeAllBut(keep: []INT);
var lo, next, i: INT;
begin
    lo := 3;
    repeat
        next := -1;
        for i := 0 to LEN(keep) - 1 do
            if (keep[i] >= lo) and ((next < 0) or (keep[i] < next)) then next := keep[i]; end;
        end;
        if next < 0 then
            CAbi.closeFrom(lo, -1);                     (* the rest *)
        else
            if next > lo then CAbi.closeFrom(lo, next - 1); end;
            _ := C.fcntl(I32(next), CAbi.fSetfd, 0);    (* kept on exec *)
            lo := next + 1;
        end;
    until next < 0;
end;

(* What p asks of the program before it runs, done to this one: a
   session on the terminal name, if p.tty, or else its group, its
   terminal's foreground; then its standard input, output and error,
   each p.fds names over the terminal's; then its working directory,
   the C string dir. 0, or minus an errno. *)
proc takeOn(p: Program; name, dir: []U8): INT;
var fd: I32; i: INT;
begin
    if p.tty # 0 then
        _ := C.setsid();
        fd := C.open(ADR(name[0]), CAbi.oRdwr);
        if fd < 0 then return failed(); end;
        if C.ioctl(fd, CAbi.tiocsctty, 0) # 0 then return failed(); end;
        for i := 0 to 2 do _ := C.dup2(fd, I32(i)); end;
    else
        if p.group = -1 then _ := C.setpgid(0, 0);
        elsif p.group # 0 then _ := C.setpgid(0, I32(p.group));
        end;
        if p.foreground then _ := C.tcsetpgrp(0, C.getpgrp()); end;
    end;
    for i := 0 to 2 do
        if p.fds[i] = i then
            _ := keepOnExec(i, true);   (* dup2 of a file onto itself would leave it closed on exec *)
        elsif p.fds[i] # 0 then
            _ := C.dup2(I32(p.fds[i]), I32(i));
        end;
    end;
    if (LEN(p.dir) > 0) and (C.chdir(ADR(dir[0])) # 0) then return failed(); end;
    return 0;
end;

(* Whether the struct sigaction a says SIG_IGN. *)
proc ignoredIn(var a: Sigaction): BOOL;
var h: ^UINT;
begin
    h := ^UINT(^U8(ADR(a)) + CAbi.saHandlerAt);
    return h^ = 1;
end;

(* Whether the signal sig does nothing now, as ignore(sig, true) or the
   program that started this one left it: its handler is SIG_IGN. *)
proc ignored*(sig: INT): BOOL;
var a: Sigaction;
begin
    _ := C.sigaction(I32(sig), nil, ^U8(ADR(a)));
    return ignoredIn(a);
end;

(* Starts the program p describes, found as run says: its process id,
   or minus an errno: -2 (ENOENT) or -13 (EACCES) as exec says, before
   the fork, if there is no program to run. A program found that
   execve then refuses ends with status 127. Every signal is blocked
   from the fork until the program has its own: its group, its
   terminal's foreground, and signals as they are at first. *)
proc spawn*(p: Program): INT;
var
    a, dir, name: [4096]U8; argv: ^^U8; none: ^U8; size, err, i, g: INT; search: []U8;
    all, old, empty: Sigset; dfl: Sigaction; pid: I32;
begin
    if not cstr(p.path, a) or not cstr(p.dir, dir) then return -36; end;   (* ENAMETOOLONG *)
    if p.tty # 0 then
        err := ptyName(p.tty, name);                  (* here, since it isn't safe after fork *)
        if err # 0 then return err; end;
    end;
    none := nil;
    if p.onlyEnv then
        argv, size := argsAndEnv(p.args, p.env, ADR(none));
    else
        argv, size := argsAndEnv(p.args, p.env, C.environ);
    end;
    if argv = nil then return -12; end;               (* ENOMEM *)
    search := env("PATH");                            (* read here, before the fork *)
    if LEN(search) = 0 then search := defaultPath; end;
    err := find(p.path, search, a);
    if err < 0 then munmap(^U8(argv), size); return err; end;
    for i := 0 to LEN(all) - 1 do all[i] := 0FFFFFFFFFFFFFFFFH; end;
    _ := C.sigprocmask(CAbi.sigSetmask, ^U8(ADR(all)), ^U8(ADR(old)));
    pid := C.fork();
    if pid = 0 then
        if takeOn(p, name, dir) # 0 then C._exit(127); end;
        closeAllBut(p.more);
        for i := 1 to CAbi.sigMax do
            if not (p.keepIgnored and ignored(i)) then _ := C.sigaction(I32(i), ^U8(ADR(dfl)), nil); end;
        end;
        _ := C.sigprocmask(CAbi.sigSetmask, ^U8(ADR(empty)), nil);
        run(p.path, search, a, argv, argv + (LEN(p.args) + 1));
        C._exit(127);
    end;
    err := failed();
    if (pid > 0) and (p.tty = 0) then
        (* as the program does, for whichever of the two runs first *)
        g := p.group;
        if g = -1 then g := INT(pid); elsif g = 0 then g := INT(C.getpgrp()); end;
        if p.group # 0 then _ := C.setpgid(pid, I32(g)); end;
        if p.foreground then _ := C.tcsetpgrp(0, I32(g)); end;
    end;
    _ := C.sigprocmask(CAbi.sigSetmask, ^U8(ADR(old)), nil);
    munmap(^U8(argv), size);
    if pid < 0 then return err; end;
    return INT(pid);
end;

(* Runs the program p describes in this one's place, as spawn would
   start it, but keeping this program's other fds as they are, open
   unless closed on exec (as open and pipe give) and not kept by
   keepOnExec; the fds of p.more are kept. It returns
   only if it can't: -2 (ENOENT) or -13 (EACCES) if there is no
   program to run, before anything is done; or, once the program's
   terminal, group, fds and working directory are as p asks, which
   stay so, minus the errno that stopped it, with this program's
   signals given back as they were. *)
proc exec*(p: Program): INT;
var
    a, dir, name: [4096]U8; argv: ^^U8; none: ^U8; size, r, i: INT; search: []U8;
    all, old, empty: Sigset; dfl: Sigaction; acts: [CAbi.sigMax + 1]Sigaction;
begin
    if not cstr(p.dir, dir) then return -36; end;    (* ENAMETOOLONG *)
    if p.tty # 0 then
        r := ptyName(p.tty, name);
        if r # 0 then return r; end;
    end;
    search := env("PATH");
    if LEN(search) = 0 then search := defaultPath; end;
    r := find(p.path, search, a);
    if r < 0 then return r; end;
    none := nil;
    if p.onlyEnv then
        argv, size := argsAndEnv(p.args, p.env, ADR(none));
    else
        argv, size := argsAndEnv(p.args, p.env, C.environ);
    end;
    if argv = nil then return -12; end;               (* ENOMEM *)
    r := takeOn(p, name, dir);
    if r = 0 then
        for i := 0 to LEN(p.more) - 1 do
            if p.more[i] > 2 then _ := keepOnExec(p.more[i], true); end;
        end;
        (* every signal as it is at first and none blocked, as spawn
           gives them, each kept to give back if execve fails *)
        for i := 0 to LEN(all) - 1 do all[i] := 0FFFFFFFFFFFFFFFFH; end;
        _ := C.sigprocmask(CAbi.sigSetmask, ^U8(ADR(all)), ^U8(ADR(old)));
        for i := 1 to CAbi.sigMax do
            _ := C.sigaction(I32(i), nil, ^U8(ADR(acts[i])));   (* as it is *)
            if not (p.keepIgnored and ignoredIn(acts[i])) then
                _ := C.sigaction(I32(i), ^U8(ADR(dfl)), nil);
            end;
        end;
        _ := C.sigprocmask(CAbi.sigSetmask, ^U8(ADR(empty)), nil);
        _ := C.execve(ADR(a[0]), argv, argv + (LEN(p.args) + 1));
        r := failed();
        _ := C.sigprocmask(CAbi.sigSetmask, ^U8(ADR(all)), nil);
        for i := 1 to CAbi.sigMax do _ := C.sigaction(I32(i), ^U8(ADR(acts[i])), nil); end;
        _ := C.sigprocmask(CAbi.sigSetmask, ^U8(ADR(old)), nil);
    end;
    munmap(^U8(argv), size);
    return r;
end;

(* Runs the program at path in this one's place, with args, the first
   its name, and env, NAME=value, its whole environment, as the
   kernel's execve does and a shell wants: no search, and every fd and
   signal as it is, but that a handled signal does what it does at
   first. It returns only if it can't: minus an errno. *)
proc execve*(path: []U8; args, env: [][]U8): INT;
var a: [4096]U8; argv: ^^U8; none: ^U8; size, r: INT;
begin
    if not cstr(path, a) then return -36; end;        (* ENAMETOOLONG *)
    none := nil;
    argv, size := argsAndEnv(args, env, ADR(none));
    if argv = nil then return -12; end;               (* ENOMEM *)
    _ := C.execve(ADR(a[0]), argv, argv + (LEN(args) + 1));
    r := failed();
    munmap(^U8(argv), size);
    return r;
end;

(* waitpid with options, its status read as C's macros read it. *)
proc waitFor(pid: INT; options: I32): (INT, Status, INT);
var status, r: I32;
begin
    r := C.waitpid(I32(pid), ADR(status), options);
    if r < 0 then return failed(), running, 0; end;
    if r = 0 then return 0, running, 0; end;
    if status & 7FH = 0 then return INT(r), exited, INT(status) shr 8 & 0FFH; end;
    if status & 0FFH = 7FH then return INT(r), stopped, INT(status) shr 8 & 0FFH; end;
    return INT(r), killed, INT(status) & 7FH;
end;

(* Waits for the program pid, any of this program's if pid is -1, or
   any of the group g if pid is -g, to change, if block, and says which one changed and how: exited, with
   its exit status; killed or stopped, with the signal's number. Without
   block it doesn't wait: 0 and running if none has changed. Minus an
   errno, and running, if there is none to wait for. The status is read
   as C's macros read it, which every Unix encodes alike. *)
proc wait*(pid: INT; block: BOOL): (INT, Status, INT);
var options: I32;
begin
    options := CAbi.wNohang | CAbi.wUntraced;
    if block then options := CAbi.wUntraced; end;
    return waitFor(pid, options);
end;

(* Waits for the program pid as wait does, but only for one to end:
   a stopped program is not waited for, so the status is exited or
   killed, or running if there is none to wait for. *)
proc waitExit*(pid: INT): (INT, Status, INT);
begin
    return waitFor(pid, 0);
end;

(* Sends the program pid, or the group -pid, the signal: 0, or minus an
   errno. *)
proc kill*(pid, signal: INT): INT;
begin
    if C.kill(I32(pid), I32(signal)) # 0 then return failed(); end;
    return 0;
end;

(* The handler of caught signals: their numbers go down the pipe, which
   catch gives the end of to read. *)
proc onSignal(sig: I32);
var e: ^I32; saved: I32; b: [1]U8;
begin
    e := CAbi.errno();
    saved := e^;                                      (* as the code it stopped left it *)
    b[0] := U8(sig);
    _ := C.write(sigWrite, ADR(b[0]), 1);
    e^ := saved;
end;

(* A struct sigaction with the handler h, nil for SIG_DFL, and flags,
   and no signal blocked while it runs *)
proc action(h: Handler; flags: INT): Sigaction;
var a: Sigaction; p: ^Handler;
begin
    p := ^Handler(^U8(ADR(a)) + CAbi.saHandlerAt);
    p^ := h;
    setField(^U8(ADR(a)), CAbi.saFlagsAt, CAbi.saFlagsLen, flags);
    return a;
end;

(* Whether sig is a signal a program may take: not SIGKILL or SIGSTOP,
   which can't be, nor SIGFPE or SIGSEGV, Rt's *)
proc takable(sig: INT): BOOL;
begin
    return (sig >= 1) and (sig <= CAbi.sigMax) and (sig # sigKill) and (sig # sigStop)
        and (sig # CAbi.sigFpe) and (sig # CAbi.sigSegv);
end;

(* Catches the signals sigs: they don't do what they would, but give
   their numbers on an fd, which a later catch adds to and gives again;
   or minus an errno. *)
proc catch*(sigs: []INT): INT;
var fds: [2]I32; act: Sigaction; i: INT;
begin
    for i := 0 to LEN(sigs) - 1 do
        if not takable(sigs[i]) then return -22; end;    (* EINVAL *)
    end;
    if sigWrite = 0 then
        if C.pipe2(ADR(fds[0]), CAbi.oNonblock | CAbi.oCloexec) # 0 then return failed(); end;
        sigRead := fds[0];
        sigWrite := fds[1];
    end;
    act := action(onSignal, CAbi.saRestart);
    for i := 0 to LEN(sigs) - 1 do
        if C.sigaction(I32(sigs[i]), ^U8(ADR(act)), nil) # 0 then return failed(); end;
    end;
    return INT(sigRead);
end;

(* The next signal catch's fd has, or 0 if none is waiting. *)
proc caught*(fd: INT): INT;
var b: [1]U8;
begin
    if read(fd, b) # 1 then return 0; end;
    return INT(b[0]);
end;

(* Makes the signal sig do nothing, or, if not yes, what it does at
   first: 0, or minus an errno. *)
proc ignore*(sig: INT; yes: BOOL): INT;
var act: Sigaction;
begin
    if yes then act := action(Handler(1), 0); end;   (* SIG_IGN *)
    if C.sigaction(I32(sig), ^U8(ADR(act)), nil) # 0 then return failed(); end;
    return 0;
end;

(* Whether the file descriptor fd is a terminal. *)
proc isTerminal*(fd: INT): BOOL;
begin
    return C.isatty(I32(fd)) = 1;
end;

(* The handler of the signals handle takes: it notes that sig came, and
   does nothing else, since it runs between any two instructions of the
   program, perhaps while Out or Heap holds its lock. *)
proc onNoted(sig: I32);
begin
    _ := XCHG(ADR(noted[sig]), 1);
    _ := XCHG(ADR(broke), 1);
end;

(* Takes the signal sig away from what it would do: it is noted, for
   came to see, and a system call it comes during fails with -4 (EINTR)
   rather than going on, so that a program waiting for another, or for
   a key, sees Ctrl-C at once. 0, or minus an errno. ignore(sig, false)
   gives it back what it does at first. *)
proc handle*(sig: INT): INT;
var act: Sigaction;
begin
    if not takable(sig) then return -22; end;         (* EINVAL *)
    act := action(onNoted, 0);                        (* no SA_RESTART *)
    if C.sigaction(I32(sig), ^U8(ADR(act)), nil) # 0 then return failed(); end;
    return 0;
end;

(* Whether the signal sig, which handle took, came since the last time
   it was asked. *)
proc came*(sig: INT): BOOL;
begin
    if (sig < 1) or (sig > CAbi.sigMax) then return false; end;
    return XCHG(ADR(noted[sig]), 0) = 1;
end;

(* A copy of this program, which goes on from here: 0 in the copy, its
   process id in this one, or minus an errno. Only the thread that
   calls it is copied, so a program with threads mustn't; and what Out
   keeps is copied too, to be written twice, so the program flushes it
   first. *)
proc fork*: INT;
var r: I32;
begin
    r := C.fork();
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* A new session and process group, led by this program, with no
   controlling terminal: its process id, or minus an errno (-1, EPERM,
   if it leads a process group already, as a program just forked
   doesn't). *)
proc setsid*: INT;
var r: I32;
begin
    r := C.setsid();
    if r < 0 then return failed(); end;
    return INT(r);
end;

(* Gives the processor to another thread. *)
proc yield*;
begin
    _ := C.sched_yield();
end;

(* Ends the program, at once, with status. *)
proc exit*(status: INT);
begin
    C._exit(I32(status));
end;

(* The test of programs: one on a pseudo-terminal of 100 by 30 prints
   its arguments, a variable put in place and its size, and leads the
   terminal's foreground until it ends with status 3; one in a
   directory and an environment of its own writes to a pipe; one in a
   group of its own is stopped and killed through it; one that isn't
   there is no child, and one found that execve refuses ends with 127;
   ignored signals stay so only with keepIgnored; fds replace a
   terminal's files. Then signals: caught as a program ends and as
   one is sent; and a program starts with them neither caught nor
   ignored. *)
proc testPrograms;
var pty, child, n, m, r, w, sigs, c: INT; st: Status; buf: [64]U8;
begin
    pty := openPty();
    if (pty < 0) or (setTermSize(pty, 100, 30) # 0) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "echo $0 $1 $HOME; stty size; read x; exit 3", "a", "b"],
        env: ["HOME=/h"], tty: pty});
    if child <= 0 then exit(2); end;
    n := 0;
    while n < 16 do
        if not ready(pty, 5000) then exit(2); end;
        m := read(pty, buf[n..LEN(buf)]);
        if m <= 0 then exit(2); end;
        INC(n, m);
    end;
    if (buf[0..n] # "a b /h\r\n30 100\r\n") or (foregroundOf(pty) # child) then exit(2); end;
    if write(pty, "\n") # 1 then exit(2); end;
    repeat
        if not ready(pty, 5000) then exit(2); end;
    until read(pty, buf) <= 0;                      (* -5, EIO, once the terminal has no program *)
    close(pty);
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 3) then exit(2); end;

    r, w := pipe();
    if w < 0 then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "echo $X $HOME; pwd"], env: ["X=x"], onlyEnv: true,
        dir: "/tmp", fds: [0, w, 0]});
    close(w);
    n := 0;
    repeat
        m := read(r, buf[n..LEN(buf)]);
        if m > 0 then INC(n, m); end;
    until m <= 0;
    close(r);
    if buf[0..n] # "x\n/tmp\n" then exit(2); end;
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 0) then exit(2); end;

    (* a pipe filled without waiting, then emptied: room to write again *)
    r, w := pipe();
    if (w < 0) or (setBlocking(w, false) # 0) or (setBlocking(r, false) # 0) then exit(2); end;
    repeat n := write(w, buf); until n < 0;
    if (n # -11) or (readyFor([], [w], 0) # -1) or (readyFor([r], [w], 0) # r) then exit(2); end;
    repeat n := read(r, buf); until n < 0;
    if (n # -11) or (readyFor([r], [w], 0) # w) or (setBlocking(w, true) # 0) then exit(2); end;
    close(r);
    close(w);

    (* blocking: a fresh pipe waits, a non-blocking one doesn't, a closed fd is -9 *)
    r, w := pipe();
    if (blocking(r) # 1) or (setBlocking(r, false) # 0) or (blocking(r) # 0) then exit(2); end;
    if (setBlocking(r, true) # 0) or (blocking(r) # 1) then exit(2); end;
    close(r);
    close(w);
    if blocking(r) # -9 then exit(2); end;

    (* setsid: a forked child leads a session of its own, once; a group leader can't *)
    child := fork();
    if child = 0 then
        if (setsid() # pid()) or (setsid() # -1) then exit(2); end;
        exit(0);
    end;
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 0) then exit(2); end;
    child := fork();
    if child = 0 then
        if (setGroup(0, 0) # 0) or (setsid() # -1) then exit(2); end;
        exit(0);
    end;
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 0) then exit(2); end;

    child := spawn({path: "/bin/sleep", args: ["sleep", "10"], group: -1});
    r, st, c := wait(child, false);
    if (r # 0) or (st # running) or (kill(-child, sigStop) # 0) then exit(2); end;
    r, st, c := wait(child, true);
    if (r # child) or (st # stopped) or (c # sigStop) or (kill(-child, sigKill) # 0) then exit(2); end;
    r, st, c := wait(-1, true);
    if (r # child) or (st # killed) or (c # sigKill) then exit(2); end;
    r, st, c := wait(-1, true);
    if r # -10 then exit(2); end;                   (* ECHILD: none left *)
    child := spawn({path: "/no/such/program", args: ["x"]});
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 127) then exit(2); end;
    (* a name without a / is looked for along PATH *)
    child := spawn({path: "sh", args: ["sh", "-c", "exit 4"]});
    r, st, c := wait(child, true);
    if (r # child) or (st # exited) or (c # 4) then exit(2); end;
    (* one not on PATH is no child at all *)
    if spawn({path: "no-such-program-on-path", args: ["x"]}) # -2 then exit(2); end;
    r, st, c := wait(-1, false);
    if r # -10 then exit(2); end;                   (* ECHILD: none was made *)
    (* an ignored signal stays so only with keepIgnored *)
    if ignore(sigInt, true) # 0 then exit(2); end;
    child := spawn({path: "sh", args: ["sh", "-c", "kill -INT $$; exit 6"], keepIgnored: true});
    r, st, c := waitExit(child);
    if (r # child) or (st # exited) or (c # 6) then exit(2); end;
    child := spawn({path: "sh", args: ["sh", "-c", "kill -INT $$; exit 6"]});
    r, st, c := waitExit(child);
    if (r # child) or (st # killed) or (c # sigInt) then exit(2); end;
    if ignore(sigInt, false) # 0 then exit(2); end;
    (* fds replace the terminal's files, with tty *)
    pty := openPty();
    r, w := pipe();
    child := spawn({path: "sh", args: ["sh", "-c", "echo out; echo err >&2"], tty: pty, fds: [0, w, 0]});
    close(w);
    n := 0;
    repeat
        m := read(r, buf[n..LEN(buf)]);
        if m > 0 then INC(n, m); end;
    until m <= 0;
    close(r);
    r, st, c := waitExit(child);
    close(pty);
    if (buf[0..n] # "out\n") or (r # child) or (st # exited) or (c # 0) then exit(2); end;

    sigs := catch([sigChld, sigHup]);
    if (sigs < 0) or (catch([sigWinch]) # sigs) or (catch([CAbi.sigSegv]) # -22) or (catch([sigKill]) # -22) then exit(2); end;
    if (caught(sigs) # 0) or (ignore(sigInt, true) # 0) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "kill -INT $$; exit 0"]});
    if not ready(sigs, 5000) or (caught(sigs) # sigChld) then exit(2); end;
    r, st, c := wait(child, true);
    if (st # killed) or (c # sigInt) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "kill -HUP $$; exit 0"]});
    r, st, c := wait(child, true);
    if (st # killed) or (c # sigHup) then exit(2); end;
    while caught(sigs) # 0 do end;
    if (kill(pid(), sigHup) # 0) or not ready(sigs, 1000) or (caught(sigs) # sigHup) then exit(2); end;
    if ignore(sigInt, false) # 0 then exit(2); end;
end;

(* The test of what a shell needs: fds copied, moved and kept on
   exec; a program given an fd at its own number, and one not; access,
   the umask and the environment by number; a terminal's modes; time
   used; limits; who and where; and exec, with nothing to run, and
   with a program that can't be run, after which the signals caught
   are caught still. *)
proc testShell;
var
    r, w, fd, n, k, child, c, err, pty, sigs, mask, parent: INT; t: I64; st: Status; buf: [64]U8;
    m, raw: Mode; soft, hard, s2, h2, user, system: I64; e: []U8; ok, path: BOOL;
begin
    r, w := pipe();
    if w < 0 then exit(2); end;
    fd := dup(w);
    if (fd < 0) or (write(fd, "ab") # 2) or (read(r, buf) # 2) then exit(2); end;
    close(fd);
    if (dupTo(w, 9) # 9) or (write(9, "c") # 1) or (read(r, buf) # 1) or (buf[0] # 'c') then exit(2); end;
    if (keepOnExec(9, false) # 0) or (keepOnExec(9, true) # 0) or (keepOnExec(-1, true) # -9) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "echo more >&9"], more: [9]});
    close(9);
    close(w);
    n := 0;
    repeat
        k := read(r, buf[n..LEN(buf)]);
        if k > 0 then INC(n, k); end;
    until k <= 0;
    close(r);
    if buf[0..n] # "more\n" then exit(2); end;
    k, st, c := wait(child, true);
    if (st # exited) or (c # 0) then exit(2); end;
    r, w := pipe();
    if (w < 0) or (dupTo(w, 9) # 9) then exit(2); end;
    child := spawn({path: "/bin/sh", args: ["sh", "-c", "{ echo none >&9; } 2>/dev/null"]});   (* 9 is closed in it *)
    close(9);
    close(w);
    if read(r, buf) # 0 then exit(2); end;
    close(r);
    k, st, c := wait(child, true);
    if (st # exited) or (c = 0) then exit(2); end;

    if (access("/bin/sh", {executing}) # 0) or (access("/", {reading}) # 0)
        or (access("/no/such/file", {}) # -2) or (open("/bin/sh", {executing}) # -22) then exit(2); end;
    mask := umask(3FH);                             (* 077 *)
    if umask(mask) # 3FH then exit(2); end;
    path := false;
    n := 0;
    repeat
        e, ok := envAt(n);
        if ok and (LEN(e) > 5) and (e[0..5] = "PATH=") then path := true; end;
        INC(n);
    until not ok;
    e, ok := envAt(-1);
    if not path or ok or (LEN(e) # 0) then exit(2); end;

    (* a terminal's modes, kept and given back *)
    pty := openPty();
    m, err := getMode(pty);
    if (err # 0) or not rawMode(pty) then exit(2); end;
    raw, err := getMode(pty);
    if (err # 0) or (raw.t = m.t) or (setMode(pty, m) # 0) then exit(2); end;
    raw, err := getMode(pty);
    if (err # 0) or (raw.t # m.t) then exit(2); end;
    m, err := getMode(-1);
    if err # -9 then exit(2); end;                  (* EBADF *)
    r, w := pipe();
    m, err := getMode(r);
    if err # -25 then exit(2); end;                 (* ENOTTY *)
    close(r);
    close(w);
    close(pty);

    user, system := cpuTime(false);
    if (user < 0) or (system < 0) or (user + system = 0) then exit(2); end;
    user, system := cpuTime(true);
    if (user < 0) or (system < 0) then exit(2); end;
    soft, hard, err := limit(limitFiles);
    if (err # 0) or (soft < 16) or (setLimit(limitFiles, soft - 1, hard) # 0) then exit(2); end;
    s2, h2, err := limit(limitFiles);
    if (err # 0) or (s2 # soft - 1) or (h2 # hard) or (setLimit(limitFiles, soft, hard) # 0) then exit(2); end;
    soft, hard, err := limit(10000);
    if err # -22 then exit(2); end;                 (* EINVAL *)
    e, err := hostName();
    if (err # 0) or (LEN(e) = 0) or (uid() < 0) or (euid() < 0) then exit(2); end;

    (* a copy of an fd out of the way; this program's group; a copy of
       this program, waited for by the group; a signal noted, and a wait
       it breaks into *)
    r, w := pipe();
    fd := dupAbove(w, 10);
    if (fd < 10) or (write(fd, "d") # 1) or (read(r, buf) # 1) or (dupAbove(-1, 10) # -9) then exit(2); end;
    close(fd);
    if group() <= 0 then exit(2); end;
    child := fork();
    if child = 0 then exit(7); end;
    k, st, c := wait(-group(), true);
    if (k # child) or (st # exited) or (c # 7) then exit(2); end;
    if (handle(sigUsr2) # 0) or came(sigUsr2) or (handle(sigKill) # -22) then exit(2); end;
    if (kill(pid(), sigUsr2) # 0) or not came(sigUsr2) or came(sigUsr2) then exit(2); end;
    parent := pid();
    child := fork();
    if child = 0 then sleep(100); _ := kill(parent, sigUsr2); exit(0); end;
    t := clock();
    if ready(r, 5000) or not came(sigUsr2) or (clock() - t > 4000000000) then exit(2); end;
    k, st, c := wait(child, true);
    if (k # child) or (ignore(sigUsr2, false) # 0) then exit(2); end;
    close(r);
    close(w);

    sigs := catch([sigUsr1]);
    while caught(sigs) # 0 do end;                  (* the sigChld of the programs above *)
    if (sigs < 0) or (exec({path: "no-such-program-on-path", args: ["x"]}) # -2) then exit(2); end;
    if exec({path: "/etc/passwd", args: ["x"]}) # -13 then exit(2); end;   (* not executable *)
    if (kill(pid(), sigUsr1) # 0) or not ready(sigs, 1000) or (caught(sigs) # sigUsr1) then exit(2); end;
end;

(* The test of time, random bytes and the network: a sleep the clock
   sees; addresses read and refused; a TCP connection on the loopback;
   a datagram to a port where no one listens, refused; servers on
   ports the system chooses, of streams and of datagrams. *)
proc testNet;
var t: I64; l, c, a, u, port, n, i: INT; x, y: [16]U8; s, s6: Sockaddr; p, q: ^U8; peer: Peer;
begin
    t := clock();
    sleep(20);
    t := clock() - t;
    if (t < 20000000) or (t > 2000000000) or (now() < 1700000000 * 1000000000) then exit(2); end;
    random(x);
    random(y);
    if x[0..16] = y[0..16] then exit(2); end;
    p := ^U8(ADR(s));
    q := ^U8(ADR(s6)) + CAbi.sin6AddrAt;
    if (inetAddr("10.0.0.255", 80, ADR(s)) # CAbi.sockaddrInLen) or (portOf(p) # 80)
            or (p[CAbi.sinAddrAt] # 10) or (p[CAbi.sinAddrAt + 2] # 0) or (p[CAbi.sinAddrAt + 3] # 255) then
        exit(2);
    end;
    if (inetAddr("1:aBcd::ff", 258, ADR(s6)) # CAbi.sockaddrIn6Len) or (portOf(^U8(ADR(s6))) # 258)
            or (q[1] # 1) or (q[2] # 0ABH) or (q[3] # 0CDH) or (q[14] # 0) or (q[15] # 0FFH) then
        exit(2);
    end;
    q := ^U8(ADR(s6));
    for i := CAbi.sin6PortAt + 2 to CAbi.sin6AddrAt - 1 do    (* the flow, zero *)
        if q[i] # 0 then exit(2); end;
    end;
    if (inetAddr("::", 0, ADR(s6)) # CAbi.sockaddrIn6Len) or (inetAddr("1:2:3:4:5:6:7:8", 0, ADR(s6)) # CAbi.sockaddrIn6Len) then exit(2); end;
    if (connectTcp("1.2.3", 80) # -22) or (connectTcp("1.2.3.256", 80) # -22) or (connectTcp("1::2::3", 80) # -22)
            or (connectTcp("1:2:3:4:5:6:7:8:9", 80) # -22) or (connectTcp("1:", 80) # -22)
            or (connectTcp("12345::", 80) # -22) or (connectTcp("::1", 65536) # -22) then
        exit(2);
    end;
    l := listenTcp("127.0.0.1", 47391);
    c := connectTcp("127.0.0.1", 47391);
    if (l < 0) or (c < 0) then exit(2); end;
    a := accept(l);
    if (a < 0) or (send(c, "hi") # 2) or (read(a, x) # 2) or (x[0..2] # "hi") then exit(2); end;
    close(a);
    close(c);
    close(l);
    u := connectUdp("127.0.0.1", 47391);
    if (u < 0) or (send(u, "x") # 1) or not ready(u, 1000) or (read(u, x) # -111) then exit(2); end;   (* ECONNREFUSED *)
    close(u);
    (* a server on a port the system chooses, and a connection to it
       within a time; then none, where no one listens *)
    l := listenTcp("127.0.0.1", 0);
    port := localPort(l);
    if (l < 0) or (port <= 0) then exit(2); end;
    c := connectTcpWithin("127.0.0.1", port, 1000);
    a := accept(l);
    if (c < 0) or (a < 0) or (send(c, "hi") # 2) or (read(a, x) # 2) then exit(2); end;
    close(a);
    close(c);
    close(l);
    if connectTcpWithin("127.0.0.1", port, 1000) # -111 then exit(2); end;
    (* a datagram to a server, and its answer *)
    l := listenUdp("127.0.0.1", 0);
    port := localPort(l);
    u := connectUdp("127.0.0.1", port);
    if (l < 0) or (port <= 0) or (u < 0) or (send(u, "ping") # 4) then exit(2); end;
    n, peer := receive(l, x[0..2]);
    if (n # 2) or (x[0..2] # "pi") or (reply(l, peer, "pong") # 4) then exit(2); end;
    if (read(u, x) # 4) or (x[0..4] # "pong") then exit(2); end;
    close(u);
    close(l);
end;

(* The test of what a program asks of itself: a signal ignored or not,
   an environment variable unset or empty, and the processors. *)
proc testProcess;
var v: []U8; found: BOOL;
begin
    if (ignore(sigUsr1, true) # 0) or not ignored(sigUsr1) then exit(2); end;
    if (ignore(sigUsr1, false) # 0) or ignored(sigUsr1) then exit(2); end;
    v, found := findEnv("RAZ_NO_SUCH_VARIABLE");
    if found or (LEN(v) # 0) then exit(2); end;
    if setEnv("RAZ_SYS_TEST_EMPTY", "") # 0 then exit(2); end;
    v, found := findEnv("RAZ_SYS_TEST_EMPTY");
    if not found or (LEN(v) # 0) then exit(2); end;
    v, found := findEnv("PATH");
    if not found or (LEN(v) = 0) then exit(2); end;
    if processors() < 1 then exit(2); end;
end;

(* The test of what a server needs: a pair of sockets, one end told
   it has no more to read, who is at the other end of a Unix socket and
   of a TCP one, and a fifo opened without waiting. *)
proc testServer;
var a, b, l, c, s, port, child, r, how: INT; buf: [8]U8; w: Remote; st: Status;
begin
    a, b, r := socketPair();
    if (r # 0) or (send(a, "hi") # 2) or (read(b, buf) # 2) or (buf[0..2] # "hi") then exit(2); end;
    if (closeWrite(a) # 0) or (read(b, buf) # 0) then exit(2); end;     (* b reads an end, *)
    if (send(b, "yo") # 2) or (read(a, buf) # 2) or (buf[0..2] # "yo") then exit(2); end;   (* and can still answer *)
    w, r := peer(a);
    if (r # 0) or not w.unix or (w.pid # pid()) or (w.uid # uid()) or (w.port # 0) or (w.addr[0] # 0) then exit(2); end;
    close(a);
    close(b);
    _, r := peer(-1);
    if r # errBadFd then exit(2); end;
    l := listenTcp("127.0.0.1", 0);
    port := localPort(l);
    c := connectTcp("127.0.0.1", port);
    s := accept(l);
    if (l < 0) or (c < 0) or (s < 0) then exit(2); end;
    w, r := peer(c);
    if (r # 0) or w.unix or w.ipv6 or (w.port # port) or (w.addr[0..4] # "\x7f\x00\x00\x01") then exit(2); end;
    w, r := peer(s);
    if (r # 0) or (w.port = port) or (w.addr[3] # 1) or (w.addr[4] # 0) then exit(2); end;
    close(s);
    close(c);
    close(l);
    _ := remove("/tmp/raz-sys-fifo");
    child := spawn({path: "mkfifo", args: ["mkfifo", "/tmp/raz-sys-fifo"]});
    r, st, how := waitExit(child);
    if (st # exited) or (how # 0) then exit(2); end;
    if open("/tmp/raz-sys-fifo", {writing, nonblocking}) # -6 then exit(2); end;     (* ENXIO: no reader, and it didn't wait *)
    a := open("/tmp/raz-sys-fifo", {reading, nonblocking});
    b := open("/tmp/raz-sys-fifo", {writing, nonblocking});
    if (a < 0) or (b < 0) or (read(a, buf) # errAgain) then exit(2); end;     (* nothing to read, and it didn't wait *)
    close(a);
    close(b);
    _ := remove("/tmp/raz-sys-fifo");
end;

(* The test of memory and files mapped: a file open only to read, mapped
   to be read, and not to be written; and pages that change what may be
   done with them. *)
proc testMaps;
var fd: INT; p, q: ^U8;
begin
    fd := create("/tmp/raz-sys-map");
    if (fd < 0) or (write(fd, "hello") # 5) then exit(2); end;
    close(fd);
    fd := openRead("/tmp/raz-sys-map");
    if (fd < 0) or (mapFile(fd, 5) # nil) then exit(2); end;    (* shared and writable: not for a file open to read *)
    p := mapRead(fd, 5);
    if (p = nil) or (p[0..5] # "hello") then exit(2); end;
    munmap(p, 5);
    close(fd);
    _ := remove("/tmp/raz-sys-map");
    p := mmap(8192);
    if p = nil then exit(2); end;
    p[0] := 1;
    q := p + 4096;
    if (protect(q, 4096, true, false) # 0) or (q[0] # 0) then exit(2); end;
    if protect(q, 4096, true, true) # 0 then exit(2); end;
    q[0] := 2;
    if (protect(p, 4096, false, false) # 0) or (protect(p, 4096, true, true) # 0) or (p[0] # 1) then exit(2); end;   (* its bytes stay *)
    munmap(p, 8192);
end;

(* The module's test, as Linux's Sys has it: a file written, read back
   and closed; a directory made, listed and emptied; no terminal; a
   socket, sent to after its end; programs; time and the network. *)
proc main*;
var free, total: I64; fd, n, err, w, h, l, c, a, m, k, o: INT; got: [1]INT; buf: [16]U8; p, q: ^U8; i, j: Info; d: Dir; name: []U8; ok: BOOL;
begin
    fd := create("/tmp/raz-sys-test");
    if fd < 0 then exit(2); end;
    if write(fd, "hello") # 5 then exit(2); end;
    close(fd);
    fd := openRead("/tmp/raz-sys-test");
    if fd < 0 then exit(2); end;
    n := read(fd, buf);
    if (n # 5) or (buf[0..5] # "hello") or (read(fd, buf) # 0) then exit(2); end;
    close(fd);
    if openRead("/no/such/file") >= 0 then exit(2); end;
    if (errorText(-2) # "No such file or directory") or (errorText(13) # "Permission denied") then exit(2); end;
    if isTerminal(-1) then exit(2); end;
    p := mmap(100);
    if (p = nil) or (p[99] # 0) then exit(2); end;
    munmap(p, 100);
    (* files and directories *)
    _ := remove("/tmp/raz-sys-dir/f");
    _ := remove("/tmp/raz-sys-dir/g");
    _ := makeDir("/tmp/raz-sys-dir");
    fd := create("/tmp/raz-sys-dir/f");
    if (fd < 0) or (write(fd, "abc") # 3) then exit(2); end;
    close(fd);
    if rename("/tmp/raz-sys-dir/f", "/tmp/raz-sys-dir/g") # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/g");
    if (err # 0) or (i.size # 3) or i.dir or not i.file or i.symlink then exit(2); end;
    i, err := info("/tmp/raz-sys-dir");
    if (err # 0) or not i.dir or i.file then exit(2); end;
    i, err := info("/dev/null");
    if (err # 0) or i.dir or i.file then exit(2); end;
    free, total, err := space("/tmp");
    if (err # 0) or (total <= 0) or (free < 0) or (free > total) then exit(2); end;
    free, total, err := space("/no/such/dir");
    if err # -2 then exit(2); end;
    _ := remove("/tmp/raz-sys-link");
    if symlink("/tmp/raz-sys-dir", "/tmp/raz-sys-link") # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-link");
    if (err # 0) or not i.dir or not i.symlink then exit(2); end;
    i, err := linkInfo("/tmp/raz-sys-link");
    if (err # 0) or i.dir or i.file or not i.symlink or (i.size # 16) then exit(2); end;
    i, err := linkInfo("/tmp/raz-sys-dir");
    if (err # 0) or not i.dir or i.symlink or (i.ino = 0) then exit(2); end;
    name, err := readLink("/tmp/raz-sys-link");
    if (err # 0) or (name # "/tmp/raz-sys-dir") then exit(2); end;
    name, err := readLink("/tmp/raz-sys-dir");
    if err # -22 then exit(2); end;                    (* EINVAL: not a link *)
    _ := remove("/tmp/raz-sys-link");
    if symlink("/no/such/file", "/tmp/raz-sys-link") # 0 then exit(2); end;   (* dangling *)
    i, err := linkInfo("/tmp/raz-sys-link");
    if (err # 0) or not i.symlink or (i.size # 13) then exit(2); end;
    _ := remove("/tmp/raz-sys-link");
    (* open as asked, seek, the mode and the time *)
    _ := remove("/tmp/raz-sys-dir/h");
    fd := open("/tmp/raz-sys-dir/h", {writing, creating, exclusive});
    if (fd < 0) or (write(fd, "abc") # 3) then exit(2); end;
    close(fd);
    if open("/tmp/raz-sys-dir/h", {writing, creating, exclusive}) # -17 then exit(2); end;
    fd := open("/tmp/raz-sys-dir/h", {writing, appending});
    if (fd < 0) or (seek(fd, 0, false) # 0) or (write(fd, "de") # 2) then exit(2); end;
    close(fd);
    fd := open("/tmp/raz-sys-dir/h", {reading, writing});
    if (seek(fd, -2, true) # 3) or (read(fd, buf) # 2) or (buf[0..2] # "de") then exit(2); end;
    if (seek(fd, 1, false) # 1) or (write(fd, "B") # 1) or (seek(fd, 0, false) # 0) then exit(2); end;
    if (read(fd, buf) # 5) or (buf[0..5] # "aBcde") then exit(2); end;
    (* where it is, its size open, cut short, on the disk *)
    if (position(fd) # 5) or (seek(fd, 2, false) # 2) or (position(fd) # 2) then exit(2); end;
    if (truncate(fd, 4) # 0) or (position(fd) # 2) or (sync(fd) # 0) then exit(2); end;
    i, err := infoOf(fd);
    if (err # 0) or (i.size # 4) or not i.file or i.symlink then exit(2); end;
    m := INT(i.ino);
    i, err := info("/tmp/raz-sys-dir/h");
    if (err # 0) or (INT(i.ino) # m) or (syncAll(fd) # 0) then exit(2); end;
    if syncAll(-1) # -9 then exit(2); end;   (* EBADF *)
    (* the lock: one open file holds it, another can't take it until
       the first is closed *)
    k := openRead("/tmp/raz-sys-dir/h");
    if (lock(fd, false) # 0) or (lock(k, false) # -11) then exit(2); end;
    close(fd);
    if lock(k, true) # 0 then exit(2); end;
    close(k);
    (* the shared lock: two open files hold it at once, lock is refused
       until both have gone, and a shared one while lock holds it *)
    fd := openRead("/tmp/raz-sys-dir/h");
    k := openRead("/tmp/raz-sys-dir/h");
    if (lockShared(fd, false) # 0) or (lockShared(k, true) # 0) then exit(2); end;
    o := openRead("/tmp/raz-sys-dir/h");
    if lock(o, false) # -11 then exit(2); end;
    close(fd);
    close(k);
    if lock(o, false) # 0 then exit(2); end;
    fd := openRead("/tmp/raz-sys-dir/h");
    if lockShared(fd, false) # -11 then exit(2); end;
    close(fd);
    close(o);
    if (position(fd) # -9) or (truncate(fd, 0) # -9) or (sync(fd) # -9) then exit(2); end;   (* EBADF *)
    k := openRead("/tmp/raz-sys-dir/h");
    if (closeChecked(k) # 0) or (closeChecked(k) # -9) then exit(2); end;
    i, err := infoOf(fd);
    if err # -9 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/h");
    if (err # 0) or (i.mode & 1C0H # 180H) or (i.mtime < 1700000000 * 1000000000) then exit(2); end;
    if chmod("/tmp/raz-sys-dir/h", 1EDH) # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/h");
    if i.mode # 1EDH then exit(2); end;
    (* setTime, after 1970 and before it, to the nanosecond *)
    if setTime("/tmp/raz-sys-dir/h", 1234567890, 123456789) # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/h");
    if (i.mtime # 1234567890123456789) or (i.seconds # 1234567890) then exit(2); end;
    if setTime("/tmp/raz-sys-dir/h", -2, 500000000) # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/h");
    if (i.mtime # -1500000000) or (i.seconds # -2) then exit(2); end;
    if setTime("/tmp/raz-sys-dir/h", 10413792000, 0) # 0 then exit(2); end;   (* 2300, past mtime's reach *)
    i, err := info("/tmp/raz-sys-dir/h");
    if i.seconds # 10413792000 then exit(2); end;
    if setTime("/tmp/raz-sys-dir/h", 0, 1000000000) # -22 then exit(2); end;
    if setTime("/no/such/file", 0, 0) # -2 then exit(2); end;
    (* the special bits: set-user-id by chmod, and sticky by makeDirMode *)
    if chmod("/tmp/raz-sys-dir/h", 9EDH) # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/h");
    if (i.mode # 1EDH) or (i.special # 800H) then exit(2); end;
    if makeDirMode("/tmp/raz-sys-dir/m", 3C0H) # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/m");
    if (err # 0) or not i.dir or (i.mode # 1C0H) or (i.special # 200H) then exit(2); end;
    if removeDir("/tmp/raz-sys-dir/m") # 0 then exit(2); end;
    _ := remove("/tmp/raz-sys-dir/h");
    fd := openMode("/tmp/raz-sys-dir/h", {writing, creating}, 1C0H);   (* rwx------ *)
    close(fd);
    i, err := info("/tmp/raz-sys-dir/h");
    if (fd < 0) or (err # 0) or (i.mode # 1C0H) then exit(2); end;
    _ := remove("/tmp/raz-sys-dir/h");
    i, err := info("/no/such/file");
    if err >= 0 then exit(2); end;
    if openDir(d, "/tmp/raz-sys-dir") # 0 then exit(2); end;
    name, ok := nextEntry(d);
    if not ok or (name # "g") then exit(2); end;
    if (entryKind(d) # isFile) and (entryKind(d) # unknown) then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/g");
    j, err := info("/tmp/raz-sys-dir");
    if (err # 0) or (i.dev # j.dev) or (i.ino = j.ino) or (i.links # 1) then exit(2); end;
    name, ok := nextEntry(d);
    if ok then exit(2); end;
    closeDir(d);
    if (remove("/tmp/raz-sys-dir/g") # 0) or (remove("/tmp/raz-sys-dir/g") >= 0) then exit(2); end;
    if openDir(d, "/no/such/dir") >= 0 then exit(2); end;
    (* the terminal: none here, fd -1 *)
    if rawMode(-1) or ready(-1, 0) then exit(2); end;
    w, h := termSize(-1);
    if (w # 80) or (h # 24) then exit(2); end;
    (* the environment *)
    if (LEN(env("PATH")) = 0) or (LEN(env("RAZ_NO_SUCH_VARIABLE")) # 0) then exit(2); end;
    (* the environment set: refused, added, set again, grown past its first array *)
    if (setEnv("", "x") # -22) or (setEnv("A=B", "x") # -22) or (setEnv("A", "\x00") # -22) then exit(2); end;
    if (setEnv("RAZ_SYS_TEST", "one") # 0) or (env("RAZ_SYS_TEST") # "one") then exit(2); end;
    name := env("RAZ_SYS_TEST");
    if (setEnv("RAZ_SYS_TEST", "") # 0) or (env("RAZ_SYS_TEST") # "") or (name # "one") then exit(2); end;
    buf := "RAZ_SYS_TEST_..";
    for k := 0 to 99 do
        buf[13] := U8('0' + k div 10);
        buf[14] := U8('0' + k mod 10);
        if setEnv(buf[0..15], buf[13..15]) # 0 then exit(2); end;
    end;
    if (env("RAZ_SYS_TEST_42") # "42") or (env("RAZ_SYS_TEST") # "") or (LEN(env("PATH")) = 0) then exit(2); end;
    n := 0;
    k := 0;
    repeat
        name, ok := envAt(k);
        if (LEN(name) > 12) and (name[0..12] = "RAZ_SYS_TEST") then INC(n); end;
        INC(k);
    until not ok;
    if n # 101 then exit(2); end;
    name, err := workDir();
    if (err # 0) or (LEN(name) = 0) or (name[0] # '/') then exit(2); end;
    if (setWorkDir("/tmp/raz-sys-dir") # 0) or (removeDir("/tmp/raz-sys-dir") # 0) then exit(2); end;
    if (setWorkDir("/") # 0) or (removeDir("/tmp/raz-sys-dir") # -2) then exit(2); end;
    (* a socket: nothing at a path, then a listener that a connection
       makes ready, and a byte from it to the connection *)
    if connect("/tmp/raz-no-such-socket") # -2 then exit(2); end;    (* ENOENT *)
    _ := remove("/tmp/raz-sys-socket");
    l := listen("/tmp/raz-sys-socket");
    if (l < 0) or (listen("/tmp/raz-sys-socket") # -98) then exit(2); end;    (* EADDRINUSE: there already *)
    c := connect("/tmp/raz-sys-socket");
    if c < 0 then exit(2); end;
    if readyOf([c], 0) # -1 then exit(2); end;
    if readyOf([c, l], 1000) # l then exit(2); end;
    a := accept(l);
    if (a < 0) or (send(a, "x") # 1) or (readyOf([l, c], 1000) # c) then exit(2); end;
    if (read(c, buf) # 1) or (buf[0] # 'x') then exit(2); end;
    close(a);
    if (readyOf([c], 1000) # c) or (read(c, buf) # 0) then exit(2); end;   (* its end *)
    if send(c, "x") # -32 then exit(2); end;           (* EPIPE, and no SIGPIPE *)
    close(c);
    close(l);
    _ := remove("/tmp/raz-sys-socket");
    (* a file in memory, mapped, and passed with a byte down a socket
       twice, with room for one: what the other side maps is the same *)
    m := memFile(8192);
    p := mapFile(m, 8192);
    if (m < 0) or (p = nil) or (p[8191] # 0) then exit(2); end;
    p[100] := 42;
    l := listen("/tmp/raz-sys-socket");
    c := connect("/tmp/raz-sys-socket");
    a := accept(l);
    if (l < 0) or (c < 0) or (a < 0) or (sendFds(c, "", [m]) # -22) or (sendFds(c, "f", [m, m]) # 1) then exit(2); end;
    n, k := receiveFds(a, buf, got);
    if (n # 1) or (k # 1) or (buf[0] # 'f') then exit(2); end;
    q := mapFile(got[0], 8192);
    if (q = nil) or (q[100] # 42) then exit(2); end;
    q[200] := 7;
    if p[200] # 7 then exit(2); end;
    munmap(p, 8192);
    munmap(q, 8192);
    close(got[0]);
    close(m);
    close(a);
    close(c);
    close(l);
    _ := remove("/tmp/raz-sys-socket");
    testPrograms;
    testShell;
    testNet;
    testProcess;
    testServer;
    testMaps;
end;

end Sys.
