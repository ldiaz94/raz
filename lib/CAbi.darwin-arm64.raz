    timerAbstime* = 0;
    (* sockets, their addresses, and a message with fds *)
    afUnix* = 1;
    afInet* = 2;
    afInet6* = 30;
    sockStream* = 1;
    sockDgram* = 2;
    sockCloexec* = 0;
    sockNonblock* = 0;
    solSocket* = 65535;
    soReuseaddr* = 4;
    soError* = 4103;
    soPeercred* = -1;
    shutWr* = 1;
    msgNosignal* = 524288;
    msgDontwait* = 128;
    msgCmsgCloexec* = 0;
