    stMtimeLen* = 8;
    stMtimeNsAt* = 56;
    stMtimeNsLen* = 8;
    sIfmt* = 61440;
    sIfdir* = 16384;
    sIfreg* = 32768;
    sIflnk* = 40960;
    statvfsLen* = 64;
    fFrsizeAt* = 8;
    fFrsizeLen* = 8;
    fBlocksAt* = 16;
    fBlocksLen* = 4;
    fBavailAt* = 24;
    fBavailLen* = 4;
    dNameAt* = 21;
    dTypeAt* = 20;
    dtUnknown* = 0;
    dtDir* = 4;
    dtReg* = 8;
    dtLnk* = 10;
    (* the terminal, poll and the clocks *)
    tcsanow* = 0;
    tcsadrain* = 1;
    tiocgwinsz* = 1074295912;
    tiocswinsz* = 2148037735;
    tiocsctty* = 536900705;
    ptyHeld* = 1;
    pollin* = 1;
    pollout* = 4;
    clockRealtime* = 0;
    clockMonotonic* = 6;
    timerAbstime* = 0;
    (* sockets, their addresses, and a message with fds *)
    afUnix* = 1;
    afInet* = 2;
    afInet6* = 30;
    sockStream* = 1;
    sockDgram* = 2;
    sockCloexec* = 0;
    sockNonblock* = 0;
    solSocket* = 65535;
    soReuseaddr* = 4;
    soError* = 4103;
    soPeercred* = -1;
    shutWr* = 1;
    msgNosignal* = 524288;
    msgDontwait* = 128;
    msgCmsgCloexec* = 0;
    scmRights* = 1;
    sockaddrLen* = 128;
    saFamilyAt* = 1;
    saFamilyLen* = 1;
    saLenAt* = 0;
