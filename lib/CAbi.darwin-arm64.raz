(* CAbi: what the C library fixes for Sys over C on darwin-arm64: the
   numbers of its flags, requests, signals and limits, where the
   fields of its structs lie, an At the offset and a Len the width,
   its errnos beside Linux's, and the procedures that differ.

   Written by tools/cabi.c, from the system's own headers; not to be
   edited, but written again. *)
module CAbi;
import SYSTEM;

const
    (* open's flags, fcntl's requests, seek, flock, mmap, access *)
    oRdonly* = 0;
    oWronly* = 1;
    oRdwr* = 2;
    oCreat* = 512;
    oExcl* = 2048;
    oTrunc* = 1024;
    oAppend* = 8;
    oNonblock* = 4;
    oCloexec* = 16777216;
    oNoctty* = 131072;
    fGetfd* = 1;
    fSetfd* = 2;
    fGetfl* = 3;
    fSetfl* = 4;
    fDupfdCloexec* = 67;
    fdCloexec* = 1;
    seekSet* = 0;
    seekCur* = 1;
    seekEnd* = 2;
    lockEx* = 2;
    lockSh* = 1;
    lockNb* = 4;
    protRead* = 1;
    protWrite* = 2;
    mapShared* = 1;
    mapPrivate* = 2;
    mapAnonymous* = 4096;
    mfdCloexec* = 0;
    atFdcwd* = -2;
    fOk* = 0;
    rOk* = 4;
    wOk* = 2;
    xOk* = 1;
    (* struct stat, statvfs and dirent *)
    statLen* = 144;
    stDevAt* = 0;
    stDevLen* = 4;
    stInoAt* = 8;
