    stMtimeLen* = 8;
    stMtimeNsAt* = 56;
    stMtimeNsLen* = 8;
    sIfmt* = 61440;
    sIfdir* = 16384;
    sIfreg* = 32768;
    sIflnk* = 40960;
    statvfsLen* = 64;
    fFrsizeAt* = 8;
    fFrsizeLen* = 8;
    fBlocksAt* = 16;
    fBlocksLen* = 4;
    fBavailAt* = 24;
    fBavailLen* = 4;
