(* CAbi: what the C library fixes for Sys over C on linux-x86_64: the
   numbers of its flags, requests, signals and limits, where the
   fields of its structs lie, an At the offset and a Len the width,
   its errnos beside Linux's, and the procedures that differ.

   Written by tools/cabi.c, from the system's own headers; not to be
   edited, but written again. *)
module CAbi;
import SYSTEM;

const
    (* open's flags, fcntl's requests, seek, flock, mmap, access *)
    oRdonly* = 0;
    oWronly* = 1;
    oRdwr* = 2;
    oCreat* = 64;
    oExcl* = 128;
    oTrunc* = 512;
    oAppend* = 1024;
    oNonblock* = 2048;
    oCloexec* = 524288;
    oNoctty* = 256;
    fGetfd* = 1;
    fSetfd* = 2;
    fGetfl* = 3;
    fSetfl* = 4;
    fDupfdCloexec* = 1030;
    fdCloexec* = 1;
    seekSet* = 0;
    seekCur* = 1;
    seekEnd* = 2;
    lockEx* = 2;
    lockSh* = 1;
    lockNb* = 4;
    protRead* = 1;
    protWrite* = 2;
    mapShared* = 1;
    mapPrivate* = 2;
    mapAnonymous* = 32;
    mfdCloexec* = 1;
    atFdcwd* = -100;
    fOk* = 0;
    rOk* = 4;
    wOk* = 2;
    xOk* = 1;
    (* struct stat, statvfs and dirent *)
    statLen* = 144;
    stDevAt* = 0;
    stDevLen* = 8;
    stInoAt* = 8;
    stInoLen* = 8;
    stNlinkAt* = 16;
    stNlinkLen* = 8;
    stModeAt* = 24;
    stModeLen* = 4;
    stSizeAt* = 48;
    stSizeLen* = 8;
    stUidAt* = 28;
    stUidLen* = 4;
    stGidAt* = 32;
    stGidLen* = 4;
    stMtimeAt* = 88;
    stMtimeLen* = 8;
    stMtimeNsAt* = 96;
    stMtimeNsLen* = 8;
    sIfmt* = 61440;
    sIfdir* = 16384;
    sIfreg* = 32768;
    sIflnk* = 40960;
    statvfsLen* = 112;
    fFrsizeAt* = 8;
    fFrsizeLen* = 8;
    fBlocksAt* = 16;
    fBlocksLen* = 8;
    fBavailAt* = 32;
    fBavailLen* = 8;
    dNameAt* = 19;
    dTypeAt* = 18;
    dtUnknown* = 0;
    dtDir* = 4;
    dtReg* = 8;
    dtLnk* = 10;
    (* the terminal, poll and the clocks *)
    tcsanow* = 0;
    tcsadrain* = 1;
    tiocgwinsz* = 21523;
    tiocswinsz* = 21524;
    tiocsctty* = 21518;
    ptyHeld* = 0;
    pollin* = 1;
    pollout* = 4;
    clockRealtime* = 0;
    clockMonotonic* = 1;
    timerAbstime* = 1;
    (* sockets, their addresses, and a message with fds *)
    afUnix* = 1;
    afInet* = 2;
    afInet6* = 10;
    sockStream* = 1;
    sockDgram* = 2;
    sockCloexec* = 524288;
    sockNonblock* = 2048;
    solSocket* = 1;
    soReuseaddr* = 2;
    soError* = 4;
    soPeercred* = 17;
    shutWr* = 1;
    msgNosignal* = 16384;
    msgDontwait* = 64;
    msgCmsgCloexec* = 1073741824;
    scmRights* = 1;
    sockaddrLen* = 128;
    saFamilyAt* = 0;
    saFamilyLen* = 2;
    saLenAt* = -1;
    sockaddrUnLen* = 110;
    sunPathAt* = 2;
    sunPathLen* = 108;
    unixAbstract* = 1;
    sockaddrInLen* = 16;
    sinPortAt* = 2;
    sinAddrAt* = 4;
    sockaddrIn6Len* = 28;
    sin6PortAt* = 2;
    sin6AddrAt* = 8;
    ucPidAt* = 0;
    ucPidLen* = 4;
    ucUidAt* = 4;
    ucUidLen* = 4;
    msghdrLen* = 56;
    msgIovAt* = 16;
    msgIovlenAt* = 24;
    msgIovlenLen* = 8;
    msgControlAt* = 32;
    msgControllenAt* = 40;
    msgControllenLen* = 8;
    cmsgLenAt* = 0;
    cmsgLenLen* = 8;
    cmsgLevelAt* = 8;
    cmsgTypeAt* = 12;
    cmsgDataAt* = 16;
    cmsgAlign* = 8;
    (* signals, sigaction and sigprocmask *)
    sigHup* = 1;
    sigInt* = 2;
    sigQuit* = 3;
    sigFpe* = 8;
    sigKill* = 9;
    sigUsr1* = 10;
    sigSegv* = 11;
    sigUsr2* = 12;
    sigPipe* = 13;
    sigAlrm* = 14;
