    stMtimeLen* = 8;
    stMtimeNsAt* = 96;
    stMtimeNsLen* = 8;
    sIfmt* = 61440;
    sIfdir* = 16384;
    sIfreg* = 32768;
    sIflnk* = 40960;
    statvfsLen* = 112;
    fFrsizeAt* = 8;
    fFrsizeLen* = 8;
    fBlocksAt* = 16;
    fBlocksLen* = 8;
    fBavailAt* = 32;
