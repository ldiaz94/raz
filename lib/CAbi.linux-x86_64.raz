    afInet* = 2;
    afInet6* = 10;
    sockStream* = 1;
    sockDgram* = 2;
    sockCloexec* = 524288;
    sockNonblock* = 2048;
    solSocket* = 1;
    soReuseaddr* = 2;
    soError* = 4;
    soPeercred* = 17;
    shutWr* = 1;
    msgNosignal* = 16384;
    msgDontwait* = 64;
