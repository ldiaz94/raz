(* A hash map from K to V, by open addressing; it hashes and compares
   keys with the procedures it is given:
       import Count := Map([]U8, I64, Str.hash, Str.eq); *)
module Map(K, V; hash: proc(k: K): U64; eq: proc(a, b: K): BOOL);
import Mem;

type
    Entry = record
        key: K;
        val: V;
        used: BOOL;
    end;
    Map* = record
        a: ^Mem.Allocator;
        slots: ^Entry;
        cap: I64;     (* a power of two, or 0 *)
        len*: I64;
    end;

proc init*(m: ^Map; a: ^Mem.Allocator);
begin
    m^ := {a: a};
end;

(* The slot of k, or of the empty slot where it would go. *)
proc slot(m: ^Map; k: K): I64;
var i: I64;
begin
    i := I64(hash(k) and U64(m^.cap - 1));
    while m^.slots[i].used and not eq(m^.slots[i].key, k) do
        i := (i + 1) and (m^.cap - 1);
    end;
    return i;
end;

proc grow(m: ^Map): BOOL;
var old: ^Entry; n, i, j: I64;
begin
    old := m^.slots;
    n := m^.cap;
    if n = 0 then m^.cap := 16; else m^.cap := n * 2; end;
    m^.slots := ^Entry(Mem.alloc(m^.a, m^.cap * SIZE(Entry), 8));
    if m^.slots = nil then m^.slots := old; m^.cap := n; return false; end;
    for i := 0 to m^.cap - 1 do m^.slots[i].used := false; end;
    for i := 0 to n - 1 do
        if old[i].used then
            j := slot(m, old[i].key);
            m^.slots[j] := old[i];
        end;
    end;
    if old # nil then Mem.free(m^.a, ^U8(old)); end;
    return true;
end;

(* k now maps to v; false if there was no room. *)
proc put*(m: ^Map; k: K; v: V): BOOL;
var i: I64;
begin
    if (m^.len + 1) * 4 > m^.cap * 3 then
        if not grow(m) then return false; end;
    end;
    i := slot(m, k);
    if not m^.slots[i].used then
        m^.slots[i] := {key: k, used: true};
        INC(m^.len);
    end;
    m^.slots[i].val := v;
    return true;
end;

(* What k maps to, and whether it maps to anything. *)
proc get*(m: ^Map; k: K): (V, BOOL);
var i: I64; none: V;
begin
    if m^.cap = 0 then return none, false; end;
    i := slot(m, k);
    if not m^.slots[i].used then return none, false; end;
    return m^.slots[i].val, true;
end;

end Map.
