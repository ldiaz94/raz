(* Whether c is in one of the ranges of t, by halving. *)
proc within(t: []I32; c: I32): BOOL;
var lo, hi, m: INT;
begin
    lo := 0;
    hi := LEN(t) div 2 - 1;
    while lo <= hi do
        m := (lo + hi) div 2;
        if c < t[2 * m] then hi := m - 1;
        elsif c > t[2 * m + 1] then lo := m + 1;
        else return true;
        end;
    end;
    return false;
end;

(* The columns the character c takes: 0, 1 or 2. *)
proc width*(c: I32): INT;
begin
    if (c >= 32) and (c < 7FH) then return 1; end;   (* ASCII, at once *)
    if within(Zero, c) then return 0; end;
    if within(Wide, c) then return 2; end;
    return 1;
end;

(* The columns the UTF-8 text s takes, as Str.decode reads it. *)
proc columns*(s: []U8): INT;
var c: I32; i, n, w: INT;
begin
    i := 0;
    w := 0;
    while i < LEN(s) do
        c, n := Str.decode(s[i..LEN(s)]);
        w := w + width(c);
        i := i + n;
    end;
    return w;
end;

(* Checks that every character in cs has the width w. *)
proc allWidth(what: []U8; cs: []I32; w: INT);
var i: INT;
begin
    for i := 0 to LEN(cs) - 1 do Check.int(what, width(cs[i]), w); end;
end;

(* The module's test. *)
proc main*;
begin
    allWidth("Width.width: ASCII 1", [I32('a'), I32(' ')], 1);
    allWidth("Width.width: ASCII 0", [I32(0), 9, 7FH], 0);
    allWidth("Width.width: none", [I32(0301H), 200BH, 1160H], 0);
    Check.int("Width.width: soft hyphen", width(0ADH), 1);
    allWidth("Width.width: wide", [I32(4E2DH), 3042H, 0FF21H, 01F600H, 3000H], 2);
    allWidth("Width.width: one", [I32(0E9H), 03B1H, 0FFFDH, 10FFFFH], 1);
    Check.int("Width.columns empty", columns(""), 0);
    Check.int("Width.columns abc", columns("abc"), 3);
    Check.int("Width.columns combining", columns("e\u{301}"), 1);
    Check.int("Width.columns wide", columns("\u{4E2D}\u{6587}"), 4);
    Check.int("Width.columns mixed", columns("a\u{1F600}b"), 4);
end;

end Width.
