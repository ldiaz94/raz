(* Formatted output. Each {} in the format takes the next argument:
       Fmt.print("{} of {}\n", [Fmt.int(n), Fmt.real(x, 2)]);
   {{ and }} stand for { and }. A {} with no argument left prints
   nothing, and arguments left over are not printed. *)
module Fmt;
import Out, Buf, Arena, Rt, Sys;

type
    (* An argument, and how it is printed. A real has places digits
       after the point, at most 9, rounded to the nearest, half away
       from zero; from 1E15 on, it has the exponent that makes it less
       than 10, as 1.50e17; nan and inf are spelled so. *)
    Arg* = variant
        int(i: I64);       (* in decimal *)
        uint(u: U64);      (* in decimal *)
        hex(h: U64);       (* in hexadecimal, capitals, no 0x *)
        str(s: []U8);
        char(c: U8);       (* the one byte *)
        bool(b: BOOL);     (* true or false *)
        real(r: F64; places: INT);
    end;

(* The digits of u in base, at the end of the array: it and where they start. *)
proc digits(u: U64; base: U64): ([24]U8, INT);
var d: [24]U8; i: INT; v: U8;
begin
    i := 24;
    repeat
        DEC(i);
        v := U8(u mod base);
        if v < 10 then d[i] := v + '0'; else d[i] := v - 10 + 'A'; end;
        u := u div base;
    until u = 0;
    return d, i;
end;

(* Where the pieces go: to b, or to standard output if b is nil. *)
proc put(b: ^Buf.Buf; s: []U8);
begin
    if b = nil then Out.str(s); else Buf.str(b, s); end;
end;

(* x as Arg's real says. The whole part and the fraction are taken
   apart, so that each fits an I64: hence the exponent from 1E15. *)
proc putReal(b: ^Buf.Buf; x: F64; places: INT);
const zeros = "00000000";
var d: [24]U8; at, i, e: INT; scale, whole, frac: I64;
begin
    if x # x then put(b, "nan"); return; end;
    if x < 0.0 then put(b, "-"); x := -x; end;
    if x > 1.7976931348623157E308 then put(b, "inf"); return; end;
    if places < 0 then places := 0; elsif places > 9 then places := 9; end;
    scale := 1;
    for i := 1 to places do scale := scale * 10; end;
    if x >= 1.0E15 then
        while x >= 10.0 do x := x / 10.0; INC(e); end;
    end;
    whole := I64(x);
    frac := I64((x - F64(whole)) * F64(scale) + 0.5);
    if frac = scale then INC(whole); frac := 0; end;
    if (e > 0) and (whole = 10) then whole := 1; INC(e); end;
    d, at := digits(U64(whole), 10);
    put(b, d[at..24]);
    if places > 0 then
        put(b, ".");
        d, at := digits(U64(frac), 10);
        put(b, zeros[0..places - (24 - at)]);
        put(b, d[at..24]);
    end;
    if e > 0 then
        d, at := digits(U64(e), 10);
        put(b, "e");
        put(b, d[at..24]);
    end;
end;

proc arg(b: ^Buf.Buf; a: Arg);
var d: [24]U8; at: INT; one: [1]U8;
begin
    match a of
    | int(i):
        if i < 0 then
            put(b, "-");
            d, at := digits(0 - U64(i), 10);
        else
            d, at := digits(U64(i), 10);
        end;
        put(b, d[at..24]);
    | uint(u): d, at := digits(u, 10); put(b, d[at..24]);
    | hex(h):  d, at := digits(h, 16); put(b, d[at..24]);
    | str(s):  put(b, s);
    | char(c): one[0] := c; put(b, one);
    | bool(t): if t then put(b, "true"); else put(b, "false"); end;
    | real(r, places): putReal(b, r, places);
    end;
end;

proc format(b: ^Buf.Buf; f: []U8; args: []Arg);
var i, start, n: INT;
begin
    i := 0; start := 0; n := 0;
    while i < LEN(f) do
        if (f[i] = '{') or (f[i] = '}') then
            put(b, f[start..i]);
            if (i + 1 < LEN(f)) and (f[i + 1] = f[i]) then
                put(b, f[i..i + 1]);
                INC(i);
            elsif (f[i] = '{') and (i + 1 < LEN(f)) and (f[i + 1] = '}') then
                if n < LEN(args) then arg(b, args[n]); end;
                INC(n);
                INC(i);
            end;
            start := i + 1;
        end;
        INC(i);
    end;
    put(b, f[start..LEN(f)]);
end;

(* Writes f to standard output, each {} replaced by the next of args. *)
proc print*(f: []U8; args: []Arg);
begin
    format(nil, f, args);
end;

(* Writes f to standard error as print writes it, after flushing Out,
   so that what was printed before comes first. The text is made whole
   in a buffer and written at once, to stay together when threads
   write at once. The buffer is an arena's, not the heap's, so that a
   program that doesn't call eprint carries no heap for it; its pages
   are mapped as they are written, and a text of more than a megabyte
   stops the program, as a Buf does when it can't grow. *)
proc eprint*(f: []U8; args: []Arg);
var ar: Arena.Arena; b: Buf.Buf; s: []U8; n: INT;
begin
    Out.flush;
    if not Arena.init(ADR(ar), 1 shl 20) then Rt.stop("Fmt.eprint: no arena"); end;
    Buf.init(ADR(b), ADR(ar.base));
    format(ADR(b), f, args);
    s := Buf.bytes(ADR(b));
    while LEN(s) > 0 do
        n := Sys.write(Sys.stderr, s);
        if n > 0 then s := s[n..LEN(s)];
        elsif n # -4 then break;   (* -EINTR: try again *)
        end;
    end;
    Arena.done(ADR(ar));
end;

(* Appends f to b, each {} replaced by the next of args. *)
proc write*(b: ^Buf.Buf; f: []U8; args: []Arg);
begin
    format(b, f, args);
end;

(* The module's test: formats into a buffer over an arena. *)
proc main*;
var ar: Arena.Arena; b: Buf.Buf; zero: F64;
begin
    if not Arena.init(ADR(ar), 1 shl 16) then Rt.stop("Fmt: no arena"); end;
    Buf.init(ADR(b), ADR(ar.base));
    write(ADR(b), "{} {} {} {}|{}{}{} {{}}", [int(-42), uint(0FFFFFFFFFFFFFFFFH), hex(48879),
        str("s"), char('c'), bool(true), int(0)]);
    if Buf.bytes(ADR(b)) # "-42 18446744073709551615 BEEF s|ctrue0 {}" then Rt.stop("Fmt.write"); end;
    Buf.reset(ADR(b));
    write(ADR(b), "{} and {}", [int(1)]);
    if Buf.bytes(ADR(b)) # "1 and " then Rt.stop("Fmt: too few arguments"); end;
    Buf.reset(ADR(b));
    write(ADR(b), "{} {} {} {} {} {} {} {}", [real(3.14159, 2), real(-2.5, 0), real(0.999, 2), real(0.05, 1),
        real(1.0, 12), real(-0.001, 2), real(123.0, 0), real(999999999999999.9, 0)]);
    if Buf.bytes(ADR(b)) # "3.14 -3 1.00 0.1 1.000000000 -0.00 123 1000000000000000" then Rt.stop("Fmt.real"); end;
    Buf.reset(ADR(b));
    write(ADR(b), "{} {} {} {} {} {}", [real(1.5E17, 2), real(-9.999E20, 2), real(1.0E15, 0), real(1.7976931348623157E308, 3),
        real(1.0 / zero, 2), real(zero / zero, 2)]);
    if Buf.bytes(ADR(b)) # "1.50e17 -1.00e21 1e15 1.798e308 inf nan" then Rt.stop("Fmt.real: an exponent"); end;
    Arena.done(ADR(ar));
end;

end Fmt.
