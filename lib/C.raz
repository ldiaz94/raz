(* The C library: what raz's own library calls in it, and what most
   programs reach for. A program that imports C uses C, and so is
   linked dynamically and starts through the C library. *)
module C;

extern proc write*(fd: I32; buf: ^U8; n: U64): I64;
extern proc read*(fd: I32; buf: ^U8; n: U64): I64;
extern proc open*(path: ^U8; flags: I32; ...): I32;
extern proc creat*(path: ^U8; mode: U32): I32;
extern proc close*(fd: I32): I32;
extern proc mmap*(addr: ^U8; n: U64; prot, flags, fd: I32; off: I64): ^U8;
extern proc munmap*(addr: ^U8; n: U64): I32;
extern proc isatty*(fd: I32): I32;
extern proc exit*(status: I32);
extern proc _exit*(status: I32);
extern proc __errno_location*: ^I32;   (* errno is this thread's: through here *)
extern proc sched_yield*: I32;
extern proc pthread_create*(t: ^U64; attr: ^U8; start: proc(arg: ^U8): ^U8; arg: ^U8): I32;
extern proc pthread_join*(t: U64; result: ^^U8): I32;
extern proc rename*(old, new: ^U8): I32;
extern proc unlink*(path: ^U8): I32;
extern proc mkdir*(path: ^U8; mode: U32): I32;
extern proc lseek*(fd: I32; off: I64; whence: I32): I64;
extern proc opendir*(path: ^U8): ^U8;        (* DIR * *)
extern proc readdir*(d: ^U8): ^U8;           (* struct dirent * *)
extern proc closedir*(d: ^U8): I32;
extern proc tcgetattr*(fd: I32; t: ^U8): I32;
extern proc tcsetattr*(fd: I32; when: I32; t: ^U8): I32;
extern proc cfmakeraw*(t: ^U8);
extern proc ioctl*(fd: I32; request: U64; ...): I32;
extern proc poll*(fds: ^U8; n: U64; ms: I32): I32;
extern proc getenv*(name: ^U8): ^U8;
extern proc getcwd*(buf: ^U8; n: U64): ^U8;
extern proc printf*(format: ^U8; ...): I32;
extern proc fflush*(f: ^U8): I32;
extern var stdout*: ^U8;               (* FILE * *)
extern var stderr*: ^U8;

end C.
