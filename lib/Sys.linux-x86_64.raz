(* System calls on Linux for x86-64. Other targets supply their own
   Sys, with the same exports. *)
module Sys;

const
    stdin* = 0;
    stdout* = 1;
    stderr* = 2;

type
    (* What info says of a file. *)
    Info* = record
        size*: I64;     (* in bytes *)
        dir*: BOOL;     (* a directory *)
        file*: BOOL;    (* a regular file: not a directory, device, pipe or socket *)
        symlink*: BOOL; (* the path itself is a symbolic link *)
    end;

    (* An open directory: getdents64's records, read a block at a time. *)
    Dir* = record
        fd, pos, len: I64;
        buf: [8192]U8;
    end;

    (* struct termios as the kernel's TCGETS fills it: 36 bytes *)
    Termios = record
        iflag, oflag, cflag, lflag: U32;
        line: U8;
        cc: [19]U8;
    end;
    Winsize = record rows, cols, xpixel, ypixel: U16; end;
    Pollfd = record fd: I32; events, revents: I16; end;

    (* struct sockaddr_un: AF_UNIX, then the path and its zero *)
    SockaddrUn = record
        family: U16;
        path: [108]U8;
    end;

var
    cwd: [4096]U8;    (* what workDir gives *)
    saved: Termios;   (* the terminal as rawMode found it *)

(* Writes s to the file descriptor fd; the number of bytes written, or
   minus an errno. *)
proc write*(fd: I64; s: []U8): I64;
begin
    if LEN(s) = 0 then return 0; end;
    return SYSCALL(1, fd, ADR(s[0]), LEN(s));
end;

(* Reads into buf from fd; the number of bytes read, 0 at the end, or
   minus an errno. *)
proc read*(fd: I64; buf: []U8): I64;
begin
    if LEN(buf) = 0 then return 0; end;
    return SYSCALL(0, fd, ADR(buf[0]), LEN(buf));
end;

(* path, a C string in buf, or false if it doesn't fit. *)
proc cstr(path, buf: []U8): BOOL;
var i: I64;
begin
    if LEN(path) >= LEN(buf) then return false; end;
    for i := 0 to LEN(path) - 1 do buf[i] := path[i]; end;
    buf[LEN(path)] := 0;
    return true;
end;

(* The file at path, opened for reading: its file descriptor, or minus
   an errno. *)
proc openRead*(path: []U8): I64;
var buf: [4096]U8;
begin
    if not cstr(path, buf) then return -36; end;   (* ENAMETOOLONG *)
    return SYSCALL(2, ADR(buf), 0);                 (* open, O_RDONLY *)
end;

(* The file at path, made empty or new, opened for writing, readable by
   all: its file descriptor, or minus an errno. *)
proc create*(path: []U8): I64;
var buf: [4096]U8;
begin
    if not cstr(path, buf) then return -36; end;
    return SYSCALL(85, ADR(buf), 420);              (* creat, mode 644 *)
end;

proc close*(fd: I64);
begin
    SYSCALL(3, fd);
end;

(* size bytes of fresh, zeroed memory from the system, a multiple of
   pages, or nil. *)
proc mmap*(size: I64): ^U8;
var p: I64;
begin
    p := SYSCALL(9, 0, size, 3, 22H, -1, 0);   (* read, write; private, anonymous *)
    if p < 0 then return nil; end;
    return ^U8(p);
end;

proc munmap*(p: ^U8; size: I64);
begin
    SYSCALL(11, p, size);
end;

(* Whether the file descriptor fd is a terminal: whether it has a
   terminal's settings to read (ioctl TCGETS). *)
proc isTerminal*(fd: I64): BOOL;
var t: [8]I64;   (* struct termios: 60 bytes *)
begin
    return SYSCALL(16, fd, 5401H, ADR(t)) = 0;
end;

(* Renames old to new, replacing what new names: 0, or minus an errno. *)
proc rename*(old, new: []U8): I64;
var a, b: [4096]U8;
begin
    if not cstr(old, a) or not cstr(new, b) then return -36; end;
    return SYSCALL(82, ADR(a), ADR(b));
end;

(* Removes the file at path; not a directory. *)
proc remove*(path: []U8): I64;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    return SYSCALL(87, ADR(a));                     (* unlink *)
end;

(* Makes a directory at path, readable by all, writable by its owner. *)
proc makeDir*(path: []U8): I64;
var a: [4096]U8;
begin
    if not cstr(path, a) then return -36; end;
    return SYSCALL(83, ADR(a), 1EDH);               (* mkdir, mode 755 *)
end;

(* The size of what path names, whether it is a directory or a regular
   file, following a symbolic link, and whether path is one; and 0, or
   minus an errno. *)
proc info*(path: []U8): (Info, I64);
var a: [4096]U8; st: [18]I64; i: Info; r: I64;    (* struct stat: 144 bytes *)
begin
    if not cstr(path, a) then return i, -36; end;
    r := SYSCALL(6, ADR(a), ADR(st));               (* lstat *)
    if r # 0 then return i, r; end;
    i.symlink := st[3] & 0F000H = 0A000H;            (* st_mode is S_IFLNK *)
    r := SYSCALL(4, ADR(a), ADR(st));               (* stat *)
    if r # 0 then return i, r; end;
    i.size := st[6];                                (* st_size *)
    i.dir := st[3] & 0F000H = 4000H;              (* S_IFDIR *)
    i.file := st[3] & 0F000H = 8000H;             (* S_IFREG *)
    return i, 0;
end;

(* Opens the directory at path, for nextEntry. *)
proc openDir*(d: ^Dir; path: []U8): I64;
var a: [4096]U8;
begin
    d^.pos := 0;
    d^.len := 0;
    if not cstr(path, a) then return -36; end;
    d^.fd := SYSCALL(2, ADR(a), 10000H);            (* open, O_RDONLY, O_DIRECTORY *)
    if d^.fd < 0 then return d^.fd; end;
    return 0;
end;

(* The next name in the directory, good until the next call, but . and
   .., in no order; false at the end. *)
proc nextEntry*(d: ^Dir): ([]U8, BOOL);
var n, at: I64;
begin
    while true do
        if d^.pos >= d^.len then
            d^.len := SYSCALL(217, d^.fd, ADR(d^.buf), LEN(d^.buf));   (* getdents64 *)
            d^.pos := 0;
            if d^.len <= 0 then return "", false; end;
        end;
        (* a record: d_ino and d_off, 8 bytes each; d_reclen, 2; d_type,
           1; then d_name, ending in a zero *)
        at := d^.pos + 19;
        n := 0;
        while d^.buf[at + n] # 0 do INC(n); end;
        INC(d^.pos, I64(d^.buf[d^.pos + 16]) + I64(d^.buf[d^.pos + 17]) * 256);
        if (d^.buf[at..at + n] # ".") and (d^.buf[at..at + n] # "..") then
            return d^.buf[at..at + n], true;
        end;
    end;
    return "", false;
end;

proc closeDir*(d: ^Dir);
begin
    SYSCALL(3, d^.fd);
end;

(* Puts the terminal on fd into raw mode: no echo, no lines, no signals,
   no flow control, no CR to NL, no NL to CR NL; false if fd isn't a
   terminal. *)
proc rawMode*(fd: I64): BOOL;
var t: Termios;
begin
    if SYSCALL(16, fd, 5401H, ADR(saved)) # 0 then return false; end;   (* TCGETS *)
    t := saved;
    t.iflag := t.iflag & ~U32(5EBH);   (* IGNBRK BRKINT PARMRK ISTRIP INLCR IGNCR ICRNL IXON *)
    t.oflag := t.oflag & ~U32(1);      (* OPOST *)
    t.cflag := t.cflag & ~U32(130H) | 30H;   (* CS8, no PARENB *)
    t.lflag := t.lflag & ~U32(804BH);  (* ISIG ICANON ECHO ECHONL IEXTEN *)
    t.cc[5] := 0;                           (* VTIME: no time limit *)
    t.cc[6] := 1;                           (* VMIN: a byte at least *)
    return SYSCALL(16, fd, 5402H, ADR(t)) = 0;                             (* TCSETS *)
end;

(* The terminal on fd as rawMode found it. *)
proc restoreMode*(fd: I64);
begin
    SYSCALL(16, fd, 5402H, ADR(saved));
end;

(* The columns and rows of the terminal on fd; 80 by 24 if it doesn't
   say. *)
proc termSize*(fd: I64): (I64, I64);
var w: Winsize;
begin
    if (SYSCALL(16, fd, 5413H, ADR(w)) # 0) or (w.cols = 0) or (w.rows = 0) then   (* TIOCGWINSZ *)
        return 80, 24;
    end;
    return I64(w.cols), I64(w.rows);
end;

(* Whether fd has something to read within ms milliseconds; ms < 0
   waits as long as it takes. *)
proc ready*(fd, ms: I64): BOOL;
var p: Pollfd;
begin
    p := {fd: I32(fd), events: 1};                  (* POLLIN *)
    return SYSCALL(7, ADR(p), 1, ms) > 0;           (* poll *)
end;

(* A stream socket connected to the Unix socket at path: its file
   descriptor, or minus an errno. It is closed in a program exec
   starts. *)
proc connect*(path: []U8): I64;
var a: SockaddrUn; fd, r, i: I64;
begin
    if LEN(path) >= LEN(a.path) then return -36; end;   (* ENAMETOOLONG *)
    a.family := 1;                                      (* AF_UNIX *)
    for i := 0 to LEN(path) - 1 do a.path[i] := path[i]; end;
    fd := SYSCALL(41, 1, 80001H, 0);                    (* socket: AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC *)
    if fd < 0 then return fd; end;
    r := SYSCALL(42, fd, ADR(a), SIZE(SockaddrUn));     (* connect *)
    if r < 0 then close(fd); return r; end;
    return fd;
end;

(* Writes s to the socket fd, as write does, but returns -32 (EPIPE)
   where write would stop the program with SIGPIPE: when the other end
   has closed it. *)
proc send*(fd: I64; s: []U8): I64;
begin
    if LEN(s) = 0 then return 0; end;
    return SYSCALL(44, fd, ADR(s[0]), LEN(s), 4000H, 0, 0);   (* sendto, MSG_NOSIGNAL, no address *)
end;

(* The first of fds that has something to read within ms milliseconds,
   or that has reached its end or failed, so that a read won't wait; -1
   if none has. ms < 0 waits as long as it takes. At most 64 fds. *)
proc readyOf*(fds: []I64; ms: I64): I64;
var p: [64]Pollfd; n, i: I64;
begin
    n := LEN(fds);
    if n > LEN(p) then n := LEN(p); end;
    for i := 0 to n - 1 do p[i] := {fd: I32(fds[i]), events: 1}; end;   (* POLLIN *)
    if SYSCALL(7, ADR(p), n, ms) <= 0 then return -1; end;               (* poll *)
    for i := 0 to n - 1 do
        if p[i].revents # 0 then return fds[i]; end;
    end;
    return -1;
end;

(* The value of the environment variable name; "" if it isn't set. The
   environment follows the arguments and their nil. *)
proc env*(name: []U8): []U8;
var e: ^^U8; s: ^U8; i, n, m: I64;
begin
    e := ARGV() + (ARGC() + 1);
    i := 0;
    while e[i] # nil do
        s := e[i];
        n := 0;
        while (n < LEN(name)) and (s[n] = name[n]) do INC(n); end;
        if (n = LEN(name)) and (s[n] = '=') then
            m := n + 1;
            while s[m] # 0 do INC(m); end;
            return s[n + 1..m];
        end;
        INC(i);
    end;
    return "";
end;

(* The working directory, good until the next call; and 0, or minus an
   errno. *)
proc workDir*: ([]U8, I64);
var r: I64;
begin
    r := SYSCALL(79, ADR(cwd), LEN(cwd));           (* getcwd: its length with its zero *)
    if r < 0 then return "", r; end;
    return cwd[0..r - 1], 0;
end;

(* A pseudo-terminal: the file descriptor of its controlling side, or
   minus an errno. Its other side, the terminal its programs run on, is
   unlocked, for spawn to open. *)
proc openPty*: I64;
var a: [4096]U8; fd, unlock: I64;
begin
    cstr("/dev/ptmx", a);
    fd := SYSCALL(2, ADR(a), 80102H);                   (* open: O_RDWR, O_NOCTTY, O_CLOEXEC *)
    if fd < 0 then return fd; end;
    unlock := 0;
    if SYSCALL(16, fd, 40045431H, ADR(unlock)) # 0 then  (* TIOCSPTLCK *)
        close(fd);
        return -5;                                      (* EIO *)
    end;
    return fd;
end;

(* Tells the terminal of the pseudo-terminal fd that it has cols
   columns and rows rows: 0, or minus an errno. *)
proc setTermSize*(fd, cols, rows: I64): I64;
var w: Winsize;
begin
    w := {rows: U16(rows), cols: U16(cols)};
    return SYSCALL(16, fd, 5414H, ADR(w));              (* TIOCSWINSZ *)
end;

(* Copies s and a zero to at: the byte after them. *)
proc put(s: []U8; at: ^U8): ^U8;
var i: I64;
begin
    for i := 0 to LEN(s) - 1 do at[i] := s[i]; end;
    at[LEN(s)] := 0;
    return at + (LEN(s) + 1);
end;

(* Whether the NAME=value s, a C string, names a variable that one of
   env gives. *)
proc replaced(s: ^U8; env: [][]U8): BOOL;
var i, n: I64;
begin
    for i := 0 to LEN(env) - 1 do
        n := 0;
        while (n < LEN(env[i])) and (s[n] = env[i][n]) and (s[n] # '=') do INC(n); end;
        if (n < LEN(env[i])) and (env[i][n] = '=') and (s[n] = '=') then return true; end;
    end;
    return false;
end;

(* What execve takes, in fresh memory of the size returned: args as C
   strings and a nil, then the environment old with each NAME=value of
   env in place of its variable or added, and a nil; or nil. The
   environment follows the arguments. *)
proc argsAndEnv(args, env: [][]U8; old: ^^U8): (^^U8, I64);
var p: ^^U8; s: ^U8; size, n, i, k: I64;
begin
    n := 0;
    while old[n] # nil do INC(n); end;
    size := (LEN(args) + n + LEN(env) + 2) * SIZE(^U8);
    for i := 0 to LEN(args) - 1 do INC(size, LEN(args[i]) + 1); end;
    for i := 0 to LEN(env) - 1 do INC(size, LEN(env[i]) + 1); end;
    p := ^^U8(mmap(size));
    if p = nil then return nil, 0; end;
    s := ^U8(p + (LEN(args) + n + LEN(env) + 2));
    k := 0;
    for i := 0 to LEN(args) - 1 do p[k] := s; s := put(args[i], s); INC(k); end;
    p[k] := nil;
    INC(k);
    for i := 0 to n - 1 do
        if not replaced(old[i], env) then p[k] := old[i]; INC(k); end;
    end;
    for i := 0 to LEN(env) - 1 do p[k] := s; s := put(env[i], s); INC(k); end;
    p[k] := nil;
    return p, size;
end;

(* Starts the program at path with args, the first its name, and this
   program's environment changed by env: its process id, or minus an
   errno. If tty is a pseudo-terminal's fd, the program runs on that
   terminal, as its controlling terminal and its standard input, output
   and error. It gets no other open file. A program that can't be
   started ends with status 127. *)
proc spawn*(path: []U8; args, env: [][]U8; tty: I64): I64;
var a: [4096]U8; name: [32]U8; p: ^^U8; size, pid, n, i, fd: I64;
begin
    if not cstr(path, a) then return -36; end;
    if tty >= 0 then
        (* its terminal: /dev/pts/ and the number TIOCGPTN gives *)
        n := 0;
        if SYSCALL(16, tty, 80045430H, ADR(n)) # 0 then return -25; end;   (* ENOTTY *)
        i := put("/dev/pts/", ADR(name[0])) - ADR(name[0]) - 1;   (* at its zero *)
        size := n;
        repeat INC(i); size := size div 10; until size = 0;
        name[i] := 0;
        repeat DEC(i); name[i] := U8(48 + n mod 10); n := n div 10; until n = 0;
    end;
    p, size := argsAndEnv(args, env, ARGV() + (ARGC() + 1));
    if p = nil then return -12; end;                    (* ENOMEM *)
    pid := SYSCALL(57);                                 (* fork *)
    if pid = 0 then
        if tty >= 0 then
            SYSCALL(112);                               (* setsid *)
            fd := SYSCALL(2, ADR(name), 2);             (* open, O_RDWR *)
            if (fd < 0) or (SYSCALL(16, fd, 540EH, 0) # 0) then SYSCALL(231, 127); end;   (* TIOCSCTTY; exit *)
            for i := 0 to 2 do SYSCALL(33, fd, i); end; (* dup2 *)
        end;
        SYSCALL(436, 3, 0FFFFFFFFH, 0);                 (* close_range: every fd from 3 *)
        SYSCALL(59, ADR(a), p, p + (LEN(args) + 1));    (* execve *)
        SYSCALL(231, 127);                              (* exit *)
    end;
    munmap(^U8(p), size);
    return pid;
end;

(* Whether the program pid has ended, waiting for it to if block: its
   exit status, or 128 and the number of the signal that stopped it,
   and 1; or 0 and 0 if it goes on; or minus an errno and 1, if there
   is no such program to wait for. *)
proc wait*(pid: I64; block: BOOL): (I64, I64);
var status: I32; r, options: I64;
begin
    options := 1;                                       (* WNOHANG *)
    if block then options := 0; end;
    r := SYSCALL(61, pid, ADR(status), options, 0);     (* wait4 *)
    if r < 0 then return r, 1; end;
    if r = 0 then return 0, 0; end;
    if status & 7FH = 0 then return I64(status) shr 8 & 0FFH, 1; end;
    return 128 + I64(status) & 7FH, 1;
end;

(* Sends the program pid the signal: 0, or minus an errno. *)
proc kill*(pid, signal: I64): I64;
begin
    return SYSCALL(62, pid, signal);
end;

(* Gives the processor to another thread. *)
proc yield*;
begin
    SYSCALL(24);
end;

(* Ends the program, at once, with status. *)
proc exit*(status: I64);
begin
    SYSCALL(231, status);
end;

(* A socket listening at path, for the test: its fd. *)
proc listen(path: []U8): I64;
var a: SockaddrUn; fd, i: I64;
begin
    remove(path);
    a.family := 1;
    for i := 0 to LEN(path) - 1 do a.path[i] := path[i]; end;
    fd := SYSCALL(41, 1, 1, 0);                         (* socket *)
    if (fd < 0) or (SYSCALL(49, fd, ADR(a), SIZE(SockaddrUn)) # 0)    (* bind *)
            or (SYSCALL(50, fd, 1) # 0) then                          (* listen *)
        exit(2);
    end;
    return fd;
end;

(* The test of programs: one spawned on a pseudo-terminal of 100 by 30
   prints its size, its arguments and a variable put in place, and ends
   with status 3; one with no terminal is stopped by kill; one that
   isn't there ends with 127. *)
proc testPrograms;
var pty, pid, n, m, status, ended: I64; buf: [64]U8;
begin
    pty := openPty();
    if (pty < 0) or (setTermSize(pty, 100, 30) # 0) then exit(2); end;
    pid := spawn("/bin/sh", ["sh", "-c", "stty size; echo $0 $1 $HOME; exit 3", "a", "b"], ["HOME=/h"], pty);
    if pid <= 0 then exit(2); end;
    n := 0;
    repeat
        if not ready(pty, 5000) then exit(2); end;
        m := read(pty, buf[n..LEN(buf)]);
        if m > 0 then INC(n, m); end;
    until m <= 0;                                   (* -5, EIO, once the terminal has no program *)
    close(pty);
    if buf[0..n] # "30 100\r\na b /h\r\n" then exit(2); end;
    status, ended := wait(pid, true);
    if (status # 3) or (ended # 1) then exit(2); end;
    pid := spawn("/bin/sleep", ["sleep", "10"], [], -1);
    status, ended := wait(pid, false);
    if ended # 0 then exit(2); end;
    if kill(pid, 15) # 0 then exit(2); end;
    status, ended := wait(pid, true);
    if (status # 128 + 15) or (ended # 1) then exit(2); end;
    status, ended := wait(pid, true);
    if (status # -10) or (ended # 1) then exit(2); end;   (* ECHILD: waited for already *)
    pid := spawn("/no/such/program", ["x"], [], -1);
    status, ended := wait(pid, true);
    if (status # 127) or (ended # 1) then exit(2); end;
end;

(* The module's test: a file written, read back and closed; a
   directory made, listed and emptied; no terminal; a socket, sent to
   after its end. *)
proc main*;
var fd, n, err, w, h, l, c, a: I64; buf: [16]U8; p: ^U8; i: Info; d: Dir; name: []U8; ok: BOOL;
    dir, name2: [4096]U8;
begin
    fd := create("/tmp/raz-sys-test");
    if fd < 0 then exit(2); end;
    if write(fd, "hello") # 5 then exit(2); end;
    close(fd);
    fd := openRead("/tmp/raz-sys-test");
    if fd < 0 then exit(2); end;
    n := read(fd, buf);
    if (n # 5) or (buf[0..5] # "hello") or (read(fd, buf) # 0) then exit(2); end;
    close(fd);
    if openRead("/no/such/file") >= 0 then exit(2); end;
    if isTerminal(-1) then exit(2); end;
    p := mmap(100);
    if (p = nil) or (p[99] # 0) then exit(2); end;
    munmap(p, 100);
    (* files and directories *)
    remove("/tmp/raz-sys-dir/f");
    remove("/tmp/raz-sys-dir/g");
    makeDir("/tmp/raz-sys-dir");
    fd := create("/tmp/raz-sys-dir/f");
    if (fd < 0) or (write(fd, "abc") # 3) then exit(2); end;
    close(fd);
    if rename("/tmp/raz-sys-dir/f", "/tmp/raz-sys-dir/g") # 0 then exit(2); end;
    i, err := info("/tmp/raz-sys-dir/g");
    if (err # 0) or (i.size # 3) or i.dir or not i.file or i.symlink then exit(2); end;
    i, err := info("/tmp/raz-sys-dir");
    if (err # 0) or not i.dir or i.file then exit(2); end;
    i, err := info("/dev/null");
    if (err # 0) or i.dir or i.file then exit(2); end;
    remove("/tmp/raz-sys-link");
    cstr("/tmp/raz-sys-dir", dir);
    cstr("/tmp/raz-sys-link", name2);
    if SYSCALL(88, ADR(dir), ADR(name2)) # 0 then exit(2); end;   (* symlink *)
    i, err := info("/tmp/raz-sys-link");
    if (err # 0) or not i.dir or not i.symlink then exit(2); end;
    remove("/tmp/raz-sys-link");
    i, err := info("/no/such/file");
    if err >= 0 then exit(2); end;
    if openDir(ADR(d), "/tmp/raz-sys-dir") # 0 then exit(2); end;
    name, ok := nextEntry(ADR(d));
    if not ok or (name # "g") then exit(2); end;
    name, ok := nextEntry(ADR(d));
    if ok then exit(2); end;
    closeDir(ADR(d));
    if (remove("/tmp/raz-sys-dir/g") # 0) or (remove("/tmp/raz-sys-dir/g") >= 0) then exit(2); end;
    if openDir(ADR(d), "/no/such/dir") >= 0 then exit(2); end;
    (* the terminal: none here, fd -1 *)
    if rawMode(-1) or ready(-1, 0) then exit(2); end;
    w, h := termSize(-1);
    if (w # 80) or (h # 24) then exit(2); end;
    (* the environment *)
    if (LEN(env("PATH")) = 0) or (LEN(env("RAZ_NO_SUCH_VARIABLE")) # 0) then exit(2); end;
    name, err := workDir();
    if (err # 0) or (LEN(name) = 0) or (name[0] # '/') then exit(2); end;
    (* a socket: nothing at a path, then a listener that a connection
       makes ready, and a byte from it to the connection *)
    if connect("/tmp/raz-no-such-socket") # -2 then exit(2); end;    (* ENOENT *)
    l := listen("/tmp/raz-sys-socket");
    c := connect("/tmp/raz-sys-socket");
    if c < 0 then exit(2); end;
    if readyOf([c], 0) # -1 then exit(2); end;
    if readyOf([c, l], 1000) # l then exit(2); end;
    a := SYSCALL(43, l, 0, 0);                         (* accept *)
    if (a < 0) or (send(a, "x") # 1) or (readyOf([l, c], 1000) # c) then exit(2); end;
    if (read(c, buf) # 1) or (buf[0] # 'x') then exit(2); end;
    close(a);
    if (readyOf([c], 1000) # c) or (read(c, buf) # 0) then exit(2); end;   (* its end *)
    if send(c, "x") # -32 then exit(2); end;           (* EPIPE, and no SIGPIPE *)
    close(c);
    close(l);
    remove("/tmp/raz-sys-socket");
    testPrograms;
end;

end Sys.
