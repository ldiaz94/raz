(* System calls on Linux for x86-64. Other targets supply their own
   Sys, with the same exports. *)
module Sys;

const
    stdin* = 0;
    stdout* = 1;
    stderr* = 2;

(* Writes s to the file descriptor fd; the number of bytes written, or
   minus an errno. *)
proc write*(fd: I64; s: []U8): I64;
begin
    if LEN(s) = 0 then return 0; end;
    return SYSCALL(1, fd, ADR(s[0]), LEN(s));
end;

(* Reads into buf from fd; the number of bytes read, 0 at the end, or
   minus an errno. *)
proc read*(fd: I64; buf: []U8): I64;
begin
    if LEN(buf) = 0 then return 0; end;
    return SYSCALL(0, fd, ADR(buf[0]), LEN(buf));
end;

(* path, a C string in buf, or false if it doesn't fit. *)
proc cstr(path: []U8; var buf: [4096]U8): BOOL;
var i: I64;
begin
    if LEN(path) >= LEN(buf) then return false; end;
    for i := 0 to LEN(path) - 1 do buf[i] := path[i]; end;
    buf[LEN(path)] := 0;
    return true;
end;

(* The file at path, opened for reading: its file descriptor, or minus
   an errno. *)
proc openRead*(path: []U8): I64;
var buf: [4096]U8;
begin
    if not cstr(path, buf) then return -36; end;   (* ENAMETOOLONG *)
    return SYSCALL(2, ADR(buf), 0);                 (* open, O_RDONLY *)
end;

(* The file at path, made empty or new, opened for writing, readable by
   all: its file descriptor, or minus an errno. *)
proc create*(path: []U8): I64;
var buf: [4096]U8;
begin
    if not cstr(path, buf) then return -36; end;
    return SYSCALL(85, ADR(buf), 420);              (* creat, mode 644 *)
end;

proc close*(fd: I64);
begin
    SYSCALL(3, fd);
end;

(* size bytes of fresh, zeroed memory from the system, a multiple of
   pages, or nil. *)
proc mmap*(size: I64): ^U8;
var p: I64;
begin
    p := SYSCALL(9, 0, size, 3, 22H, -1, 0);   (* read, write; private, anonymous *)
    if p < 0 then return nil; end;
    return ^U8(p);
end;

proc munmap*(p: ^U8; size: I64);
begin
    SYSCALL(11, p, size);
end;

(* Whether the file descriptor fd is a terminal: whether it has a
   terminal's settings to read (ioctl TCGETS). *)
proc isTerminal*(fd: I64): BOOL;
var t: [8]I64;   (* struct termios: 60 bytes *)
begin
    return SYSCALL(16, fd, 5401H, ADR(t)) = 0;
end;

(* Gives the processor to another thread. *)
proc yield*;
begin
    SYSCALL(24);
end;

(* Ends the program, at once, with status. *)
proc exit*(status: I64);
begin
    SYSCALL(231, status);
end;

(* The module's test: a file written, read back and closed. *)
proc main*;
var fd, n: I64; buf: [16]U8; p: ^U8;
begin
    fd := create("/tmp/raz-sys-test");
    if fd < 0 then exit(2); end;
    if write(fd, "hello") # 5 then exit(2); end;
    close(fd);
    fd := openRead("/tmp/raz-sys-test");
    if fd < 0 then exit(2); end;
    n := read(fd, buf);
    if (n # 5) or (buf[0..5] # "hello") or (read(fd, buf) # 0) then exit(2); end;
    close(fd);
    if openRead("/no/such/file") >= 0 then exit(2); end;
    if isTerminal(-1) then exit(2); end;
    p := mmap(100);
    if (p = nil) or (p[99] # 0) then exit(2); end;
    munmap(p, 100);
end;

end Sys.
