(* The C library: what jed's own library calls in it, and what most
   programs reach for. A program that imports C uses C, and so is
   linked dynamically and starts through the C library. *)
module C;

extern proc write*(fd: I32; buf: ^U8; n: U64): I64;
extern proc mmap*(addr: ^U8; n: U64; prot, flags, fd: I32; off: I64): ^U8;
extern proc munmap*(addr: ^U8; n: U64): I32;
extern proc isatty*(fd: I32): I32;
extern proc exit*(status: I32);
extern proc _exit*(status: I32);
extern proc __errno_location*: ^I32;   (* errno is this thread's: through here *)
extern proc printf*(format: ^U8; ...): I32;
extern proc fflush*(f: ^U8): I32;
extern var stdout*: ^U8;               (* FILE * *)
extern var stderr*: ^U8;

end C.
