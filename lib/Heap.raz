(* A general allocator: Heap.heap. Small blocks come in nine sizes,
   16 to 4096 bytes with their header, each with a list of the free
   ones; a block bigger than that gets pages of its own. Every block
   has a 16-byte header before it: its size class, or minus the size
   of its pages for a big one, which start less than a page before it;
   then a marker, which says the block is out, so that freeing it
   twice, or freeing what the heap never gave out, stops the program.
   One lock keeps it whole across threads. *)
module Heap;
import Mem, Lock, Rt;

const
    Classes = 9;
    Header = 16;
    Refill = 65536;
    Largest = 1 shl 46;           (* bigger sizes are refused *)
    Out = 5A6564426C6F636BH;      (* the marker, xor the header's address *)

type
    Block = record next: ^Block; end;
    Head = record size, mark: INT; end;

var
    lists: [Classes]^Block;
    cur: ^U8;            (* where the next new small block comes from *)
    left: INT;
    lock: Lock.Lock;
    std: Mem.Allocator;
    (* The heap, for NEW(p, Heap.heap) and Mem's procedures. *)
    heap*: ^Mem.Allocator;

(* The block p, with size for its header, given out. *)
proc give(p: ^U8; size: INT): ^U8;
var h: ^Head;
begin
    h := ^Head(p);
    h^.size := size;
    h^.mark := Out xor INT(h);
    return p + Header;
end;

(* size bytes aligned to align, or nil: also for a size below zero or
   too big, and an alignment that isn't a power of two up to a page. *)
proc alloc(_a: ^Mem.Allocator; size, align: INT): ^U8;
var c, n: INT; b: ^Block; p: ^U8;
begin
    if (size < 0) or (size > Largest) or (align < 1) or (align > Mem.Page)
        or (align & (align - 1) # 0) then
        return nil;
    end;
    n := size + Header;
    c := 0;
    while (c < Classes) and (16 shl c < n) do INC(c); end;
    if (c = Classes) or (align > Header) then
        (* pages of its own, the block at align from their start *)
        if align < Header then align := Header; end;
        n := (size + align + Mem.Page - 1) div Mem.Page * Mem.Page;
        p := Mem.pages(n);
        if p = nil then return nil; end;
        return give(p + align - Header, -n);
    end;
    Lock.take(lock);
    defer Lock.give(lock);
    b := lists[c];
    if b # nil then
        lists[c] := b^.next;
        p := ^U8(b);
    else
        if left < 16 shl c then
            cur := Mem.pages(Refill);
            if cur = nil then left := 0; return nil; end;
            left := Refill;
        end;
        p := cur;
        cur := cur + (16 shl c);
        left := left - (16 shl c);
    end;
    return give(p, c);
end;

proc free(_a: ^Mem.Allocator; p: ^U8);
var h: ^Head; b: ^Block; c: INT;
begin
    if p = nil then return; end;
    h := ^Head(p - Header);
    Lock.take(lock);
    if h^.mark # Out xor INT(h) then
        Rt.stop("Heap: a block freed twice, or never given out");
    end;
    h^.mark := 0;
    if h^.size < 0 then
        Lock.give(lock);
        Mem.unmap(^U8(INT(h) - INT(h) mod Mem.Page), -h^.size);
    else
        c := h^.size;          (* before next, which takes its place, is set *)
        b := ^Block(h);
        b^.next := lists[c];
        lists[c] := b;
        Lock.give(lock);
    end;
end;

(* The module's test: blocks of every class and big ones, written,
   freed and taken again. *)
proc main*;
var p: [40]^U8; i, j, n: INT; again: ^U8;
begin
    for i := 0 to 39 do
        n := (i * i * 37) mod 9000 + 1;
        p[i] := Mem.alloc(heap, n, 8);
        if (p[i] = nil) or (INT(p[i]) mod 8 # 0) then Rt.stop("Heap: alloc"); end;
        for j := 0 to n - 1 do p[i][j] := U8(i); end;
    end;
    for i := 0 to 39 do
        n := (i * i * 37) mod 9000 + 1;
        if (p[i][0] # U8(i)) or (p[i][n - 1] # U8(i)) then Rt.stop("Heap: overlap"); end;
    end;
    Mem.free(heap, p[5]);
    again := Mem.alloc(heap, (25 * 37) mod 9000 + 1, 8);
    if again # p[5] then Rt.stop("Heap: a freed block isn't taken again"); end;
    for i := 0 to 39 do Mem.free(heap, p[i]); end;
    if Mem.alloc(heap, -1, 8) # nil then Rt.stop("Heap: negative size"); end;
    if Mem.alloc(heap, 7FFFFFFFFFFFFFFFH - 4, 8) # nil then Rt.stop("Heap: huge size"); end;
end;

begin
    std := {alloc: alloc, free: free};
    heap := ADR(std);
end Heap.
