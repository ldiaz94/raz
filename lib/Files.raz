(* What most programs need of the command line and of files: an
   argument as a string, and a whole file read or written. *)
module Files;
import Sys, Buf, Heap, Rt;

(* Argument i, a C string, as a slice. *)
proc arg*(i: INT): []U8;
var s: ^U8; n: INT;
begin
    s := ARGV()[i];
    n := 0;
    while s[n] # 0 do INC(n); end;
    return s[0..n];
end;

(* Adds the file at path to b: 0, or minus the errno of the open or
   the read that failed, as Sys gives them: -2 (ENOENT) for no such
   file, -13 (EACCES) for one not allowed, -21 (EISDIR) for a
   directory. What was read before a read failed stays in b. *)
proc load*(path: []U8; b: ^Buf.Buf): INT;
var fd, n: INT;
begin
    fd := Sys.openRead(path);
    if fd < 0 then return fd; end;
    repeat
        n := Sys.read(fd, Buf.spare(b, 65536));   (* straight into b *)
        if n > 0 then INC(b^.len, n); end;
    until n <= 0;
    Sys.close(fd);
    return n;
end;

(* Adds the file at path to b; false if it can't be read. *)
proc read*(path: []U8; b: ^Buf.Buf): BOOL;
begin
    return load(path, b) = 0;
end;

(* Makes the file at path hold data; false if it can't be written. *)
proc write*(path, data: []U8): BOOL;
var fd, n, at: INT;
begin
    fd := Sys.create(path);
    if fd < 0 then return false; end;
    at := 0;
    while at < LEN(data) do
        n := Sys.write(fd, data[at..LEN(data)]);
        if n <= 0 then Sys.close(fd); return false; end;
        at := at + n;
    end;
    Sys.close(fd);
    return true;
end;

(* The module's test. *)
proc main*;
var b: Buf.Buf;
begin
    Buf.init(ADR(b), Heap.heap);
    if not write("/tmp/raz-files-test", "abc") then Rt.stop("Files.write"); end;
    if (load("/tmp/raz-files-test", ADR(b)) # 0) or (Buf.bytes(ADR(b)) # "abc") then Rt.stop("Files.load"); end;
    if not read("/tmp/raz-files-test", ADR(b)) or (Buf.bytes(ADR(b)) # "abcabc") then Rt.stop("Files.read"); end;
    _ := Sys.remove("/tmp/raz-files-test");
    if load("/tmp/raz-files-test", ADR(b)) # -2 then Rt.stop("Files.load: no such file"); end;
    if load("/", ADR(b)) # -21 then Rt.stop("Files.load: a directory"); end;
    if read("/", ADR(b)) or (b.len # 6) then Rt.stop("Files.read: a directory"); end;
    Buf.done(ADR(b));
end;

end Files.
