(* Writing text and numbers to standard output, through a buffer of
   4 KB. The buffer is written out when it is full, at each line feed
   when standard output is a terminal, by flush, and when the program
   ends by Rt.exit. C's stdio keeps a buffer of its own: a program that
   writes with both flushes one before writing with the other. A lock
   keeps what each call writes together when threads write at once. *)
module Out;
import Rt, Sys, Lock;

var
    buf: [Sys.outSize]U8;
    n: INT;          (* bytes in buf *)
    tty: BOOL;       (* standard output is a terminal *)
    lock: Lock.Lock;

(* Writes out the buffer, with the lock held. What can't be written is
   dropped. *)
proc out;
var i, k: INT;
begin
    i := 0;
    while i < n do
        k := Sys.write(Sys.stdout, buf[i..n]);
        if k > 0 then i := i + k;
        elsif k # -4 then break;   (* -EINTR: try again *)
        end;
    end;
    n := 0;
end;

proc flush*;
begin
    Lock.take(ADR(lock));
    out;
    Lock.give(ADR(lock));
end;

proc str*(s: []U8);
var i: INT;
begin
    Lock.take(ADR(lock));
    for i := 0 to LEN(s) - 1 do
        if n = LEN(buf) then out; end;
        buf[n] := s[i];
        INC(n);
        if (s[i] = '\n') and tty then out; end;
    end;
    Lock.give(ADR(lock));
end;

proc char*(c: U8);
var b: [1]U8;
begin
    b[0] := c;
    str(b);
end;

proc ln*;
begin
    char('\n');
end;

(* n in decimal *)
proc int*(n: I64);
var buf: [20]U8; i: INT; u: U64;
begin
    u := U64(n);
    if n < 0 then u := 0 - u; end;
    i := 20;
    repeat
        i := i - 1;
        buf[i] := U8(u mod 10) + '0';
        u := u div 10;
    until u = 0;
    if n < 0 then
        i := i - 1;
        buf[i] := '-';
    end;
    str(buf[i..20]);
end;

(* n in hexadecimal, digits digits at least *)
proc hex*(n: U64; digits: INT);
var buf: [16]U8; i: INT; d: U8;
begin
    i := 16;
    repeat
        i := i - 1;
        d := U8(n & 15);
        if d < 10 then buf[i] := d + '0'; else buf[i] := d - 10 + 'A'; end;
        n := n shr 4;
        digits := digits - 1;
    until (n = 0) and (digits <= 0) or (i = 0);
    str(buf[i..16]);
end;

begin
    tty := Sys.isTerminal(Sys.stdout);
    Rt.atExit(flush);
end Out.
