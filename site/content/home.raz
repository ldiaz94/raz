(* Several results, slices, and checks that say what failed. *)
module Taste;
import Out;

proc divmod(a, b: INT): (INT, INT);
begin
    return a div b, a mod b;
end;

proc sum(s: []INT): INT;
var i, t: INT;
begin
    for i := 0 to LEN(s) - 1 do t := t + s[i]; end;
    return t;
end;

proc main*;
var q, r: INT; a: [5]INT; i: INT;
begin
    for i := 0 to 4 do a[i] := i * i; end;
    q, r := divmod(sum(a), 7);
    Out.int(q); Out.str(" remainder "); Out.int(r); Out.ln;
    Out.int(sum(a[1..3])); Out.ln;
end;

end Taste.
