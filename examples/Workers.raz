(* Native threads, for a program without C: workers that take jobs
   from a shared counter and add up their results under a Mutex. *)
module Workers;
import Out, Thread;

const
    Workers = 4;
    Jobs = 100;

var
    next: I64;           (* the next job, taken with XADD *)
    m: Thread.Mutex;
    total: I64;

(* job n: the sum of the squares up to n *)
proc job(n: I64): I64;
var i, s: I64;
begin
    s := 0;
    for i := 1 to n do s := s + i * i; end;
    return s;
end;

proc work(arg: ^U8);
var n, r: I64;
begin
    n := XADD(ADR(next), 1);
    while n < Jobs do
        r := job(n * 1000);
        Thread.lock(ADR(m));
        total := total + r;
        Thread.unlock(ADR(m));
        n := XADD(ADR(next), 1);
    end;
end;

proc main*;
var t: [Workers]^Thread.Thread; i: I64; err: ERROR;
begin
    for i := 0 to Workers - 1 do
        t[i], err := Thread.spawn(work, nil);
        if err # nil then Out.str(MSG(err)); Out.ln; return; end;
    end;
    for i := 0 to Workers - 1 do Thread.join(t[i]); end;
    Out.str("total "); Out.int(total); Out.ln;
end;

end Workers.
