(* Prints its arguments, one per line, and exits with how many. *)
module Args;
import Out;
import SYSTEM;

(* The length of a C string. *)
proc len(s: ^U8): INT;
var n: INT;
begin
    n := 0;
    while s[n] # 0 do n := n + 1; end;
    return n;
end;

proc main*: INT;
var i: INT; s: ^U8;
begin
    for i := 1 to ARGC() - 1 do
        s := SYSTEM.ARGV()[i];
        Out.str(s[0..len(s)]);
        Out.ln;
    end;
    return ARGC() - 1;
end;

end Args.
