{
  "name": "raz-image-registry",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test test.mjs",
    "test:docker": "npm run build && node docker-smoke.mjs",
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist/deploy"
  },
  "dependencies": {
    "r2-registry": "https://github.com/cloudflare/serverless-registry/archive/a73605d6d5587286eb9cfcb910148f7d1423f218.tar.gz"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "wrangler": "4.151.2"
  }
}
