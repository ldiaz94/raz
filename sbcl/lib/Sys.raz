(* System calls, for Linux on any machine SBCL runs on: through the C
   library's syscall(), which the run time's SYSCALL calls. The numbers
   are x86-64's. A result that can fail is a number, minus an errno, as
   on Linux. *)
module Sys;

const
    stdin* = 0; stdout* = 1; stderr* = 2;
    outSize* = 4096;    (* the bytes Out keeps *)
    sigHup* = 1; sigInt* = 2; sigQuit* = 3; sigKill* = 9; sigPipe* = 13;
    sigTerm* = 15; sigChld* = 17; sigCont* = 18; sigStop* = 19;
    sigTstp* = 20; sigTtin* = 21; sigTtou* = 22; sigWinch* = 28;

    (* system call numbers *)
    sysRead = 0; sysWrite = 1; sysClose = 3; sysStat = 4; sysLstat = 6;
    sysLseek = 8; sysMmap = 9; sysMunmap = 11; sysIoctl = 16;
    sysYield = 24; sysNanosleep = 35; sysGetpid = 39; sysKill = 62;
    sysGetcwd = 79; sysChdir = 80; sysRename = 82; sysMkdir = 83;
    sysRmdir = 84; sysUnlink = 87; sysSymlink = 88; sysReadlink = 89;
    sysChmod = 90; sysClockGettime = 228; sysExitGroup = 231;
    sysOpenat = 257; sysGetrandom = 318; sysPoll = 7; sysDup2 = 33;
    sysSocket = 41; sysConnect = 42; sysAccept4 = 288; sysSendto = 44;
    sysBind = 49; sysListen = 50; sysSetsockopt = 54; sysFork = 57;
    sysExecve = 59; sysExit = 60; sysWait4 = 61; sysFcntl = 72;
    sysSetpgid = 109; sysSetsid = 112; sysStatfs = 137;
    sysGetdents64 = 217; sysPipe2 = 293; sysCloseRange = 436;
    sysRtSigaction = 13; sysRtSigprocmask = 14;

    (* ioctls of terminals *)
    tcgets = 5401H; tcsets = 5402H; tiocgwinsz = 5413H; tiocswinsz = 5414H;
    tiocspgrp = 5410H; tiocgpgrp = 540FH; tiocsctty = 540EH;
    tiocsptlck = 40045431H; tiocgptn = 80045430H;

    cloexec = 80000H; nonblock = 800H;

    atFdCwd = -100;
    pathMax = 4096;

type
    Access* = (reading, writing, creating, exclusive, truncating, appending);
    Accesses* = set of Access;
    Info* = record
        size*: I64;      (* in bytes *)
        mtime*: I64;     (* when its contents last changed, in nanoseconds since 1970 *)
        mode*: INT;      (* its permission bits *)
        dir*: BOOL;      (* a directory *)
        file*: BOOL;     (* a regular file *)
        symlink*: BOOL;  (* the path itself is a symbolic link *)
    end;
    Path = [pathMax]U8;  (* a path with a zero after it, as Linux takes it *)
    Dir* = record        (* an open directory *)
        fd: INT;
        buf: [4096]U8;   (* entries as getdents64 gives them *)
        pos, len: INT;
    end;
    Program* = record
        path*: []U8;
        args*: [][]U8;      (* the first is its name *)
        env*: [][]U8;       (* NAME=value, each added to this program's environment *)
        onlyEnv*: BOOL;     (* env is its whole environment *)
        dir*: []U8;         (* its working directory; "" for this program's *)
        fds*: [3]INT;       (* its standard input, output and error; 0 for this program's own *)
        group*: INT;        (* the process group it joins: 0 for this program's, -1 a new one it leads *)
        foreground*: BOOL;  (* its group takes the terminal on standard input *)
        tty*: INT;          (* a pseudo-terminal's fd, to start a session on; 0 for none *)
    end;
    Status* = (running, exited, killed, stopped);
    Termios = [64]U8;    (* the kernel's struct termios, with room *)

var
    saved: Termios;      (* the terminal's mode before rawMode *)
    savedFd: INT;
    haveSaved: BOOL;
    linkBuf: [pathMax]U8;
    dirBuf: [pathMax]U8;
    envp: ^^U8;

(* p, ended by a zero, in c; false if it is too long *)
proc cPath(p: []U8; var c: Path): BOOL;
begin
    if LEN(p) >= LEN(c) then return false; end;
    COPY(c, p);
    c[LEN(p)] := 0;
    return true;
end;

proc write*(fd: INT; s: []U8): INT;
begin
    if LEN(s) = 0 then return 0; end;
    return SYSCALL(sysWrite, fd, ADR(s[0]) , LEN(s));
end;

proc read*(fd: INT; buf: []U8): INT;
begin
    if LEN(buf) = 0 then return 0; end;
    return SYSCALL(sysRead, fd, ADR(buf[0]), LEN(buf));
end;

proc open*(path: []U8; how: Accesses): INT;
var c: Path; flags: INT;
begin
    if not cPath(path, c) then return -36; end;
    if (reading in how) and (writing in how) then flags := 2;
    elsif writing in how then flags := 1;
    end;
    if creating in how then flags := flags | 40H; end;
    if exclusive in how then flags := flags | 80H; end;
    if truncating in how then flags := flags | 200H; end;
    if appending in how then flags := flags | 400H; end;
    return SYSCALL(sysOpenat, atFdCwd, ADR(c), flags | 80000H, 1A4H);
end;

proc openRead*(path: []U8): INT;
begin
    return open(path, {reading});
end;

proc create*(path: []U8): INT;
begin
    return open(path, {writing, creating, truncating});
end;

proc seek*(fd: INT; pos: I64; fromEnd: BOOL): I64;
var whence: INT;
begin
    if fromEnd then whence := 2; end;
    return SYSCALL(sysLseek, fd, pos, whence);
end;

proc close*(fd: INT);
begin
    _ := SYSCALL(sysClose, fd);
end;

proc isTerminal*(fd: INT): BOOL;
var termios: [64]U8;
begin
    return SYSCALL(sysIoctl, fd, 5401H, ADR(termios)) = 0;
end;

(* size bytes of zeroed memory, in whole pages; or nil *)
proc mmap*(size: INT): ^U8;
var r: INT;
begin
    r := SYSCALL(sysMmap, 0, size, 3, 22H, -1, 0);
    if r < 0 then return nil; end;
    return ^U8(r);
end;

proc munmap*(p: ^U8; size: INT);
begin
    _ := SYSCALL(sysMunmap, p, size);
end;

proc yield*;
begin
    _ := SYSCALL(sysYield);
end;

(* the program ended at once, without Rt's atExit *)
proc exit*(status: INT);
begin
    _ := SYSCALL(sysExitGroup, status);
end;

proc rename*(old, new: []U8): INT;
var a, b: Path;
begin
    if not cPath(old, a) or not cPath(new, b) then return -36; end;
    return SYSCALL(sysRename, ADR(a), ADR(b));
end;

proc remove*(path: []U8): INT;
var c: Path;
begin
    if not cPath(path, c) then return -36; end;
    return SYSCALL(sysUnlink, ADR(c));
end;

proc removeDir*(path: []U8): INT;
var c: Path;
begin
    if not cPath(path, c) then return -36; end;
    return SYSCALL(sysRmdir, ADR(c));
end;

proc makeDir*(path: []U8): INT;
var c: Path;
begin
    if not cPath(path, c) then return -36; end;
    return SYSCALL(sysMkdir, ADR(c), 1EDH);
end;

proc chmod*(path: []U8; mode: INT): INT;
var c: Path;
begin
    if not cPath(path, c) then return -36; end;
    return SYSCALL(sysChmod, ADR(c), mode);
end;

proc symlink*(target, path: []U8): INT;
var a, b: Path;
begin
    if not cPath(target, a) or not cPath(path, b) then return -36; end;
    return SYSCALL(sysSymlink, ADR(a), ADR(b));
end;

(* what the link names, good until the next call *)
proc readLink*(path: []U8): ([]U8, INT);
var c: Path; n: INT;
begin
    if not cPath(path, c) then return "", -36; end;
    n := SYSCALL(sysReadlink, ADR(c), ADR(linkBuf), LEN(linkBuf));
    if n < 0 then return "", n; end;
    return linkBuf[0..n], 0;
end;

(* following a symbolic link *)
proc info*(path: []U8): (Info, INT);
var c: Path; st: [144]U8; r: INT; i: Info; mode: U32;
begin
    if not cPath(path, c) then return i, -36; end;
    r := SYSCALL(sysLstat, ADR(c), ADR(st));
    if r < 0 then return i, r; end;
    i.symlink := ^U32(ADR(st[24]))^ & 0F000H = 0A000H;
    if i.symlink then
        r := SYSCALL(sysStat, ADR(c), ADR(st));
        if r < 0 then return i, r; end;
    end;
    mode := ^U32(ADR(st[24]))^;
    i.size := ^I64(ADR(st[48]))^;
    i.mtime := ^I64(ADR(st[88]))^ * 1000000000 + ^I64(ADR(st[96]))^;
    i.mode := INT(mode & 1FFH);
    i.dir := mode & 0F000H = 4000H;
    i.file := mode & 0F000H = 8000H;
    return i, 0;
end;

(* C's environ, which the run time's C library keeps *)
proc environ: ^^U8;
code
    (ld :u64 (sb-sys:find-foreign-symbol-address "environ"));
end;

(* the environment variable's value; "" if unset *)
proc env*(name: []U8): []U8;
var e: ^U8; i, n: INT;
begin
    if envp = nil then envp := environ(); end;
    i := 0;
    while envp[i] # nil do
        e := envp[i];
        n := 0;
        while e[n] # 0 do INC(n); end;
        if n > LEN(name) and e[LEN(name)] = '=' and e[0..LEN(name)] = name then
            return e[LEN(name) + 1..n];
        end;
        INC(i);
    end;
    return "";
end;

(* the working directory, good until the next call *)
proc workDir*: ([]U8, INT);
var r: INT;
begin
    r := SYSCALL(sysGetcwd, ADR(dirBuf), LEN(dirBuf));
    if r < 0 then return "", r; end;
    r := 0;
    while dirBuf[r] # 0 do INC(r); end;
    return dirBuf[0..r], 0;
end;

proc setWorkDir*(path: []U8): INT;
var c: Path;
begin
    if not cPath(path, c) then return -36; end;
    return SYSCALL(sysChdir, ADR(c));
end;

proc pid*: INT;
begin
    return SYSCALL(sysGetpid);
end;

proc kill*(pid, signal: INT): INT;
begin
    return SYSCALL(sysKill, pid, signal);
end;

proc clockOf(which: INT): I64;
var t: [2]I64;
begin
    _ := SYSCALL(sysClockGettime, which, ADR(t));
    return t[0] * 1000000000 + t[1];
end;

(* nanoseconds, on a clock that only goes forward *)
proc clock*: I64;
begin
    return clockOf(1);
end;

(* nanoseconds since 1970-01-01, UTC *)
proc now*: I64;
begin
    return clockOf(0);
end;

proc sleep*(ms: INT);
var t: [2]I64;
begin
    t[0] := ms div 1000;
    t[1] := (ms mod 1000) * 1000000;
    while SYSCALL(sysNanosleep, ADR(t), ADR(t)) = -4 do end;
end;

(* b filled with random bytes *)
proc random*(b: []U8);
var done, n: INT;
begin
    while done < LEN(b) do
        n := SYSCALL(sysGetrandom, ADR(b[done]), LEN(b) - done, 0);
        if n > 0 then done := done + n; end;
    end;
end;

(* the bytes free and in all on path's file system *)
proc space*(path: []U8): (I64, I64, INT);
var c: Path; st: [16]I64; r: INT;
begin
    if not cPath(path, c) then return 0, 0, -36; end;
    r := SYSCALL(sysStatfs, ADR(c), ADR(st));
    if r < 0 then return 0, 0, r; end;
    return st[4] * st[1], st[2] * st[1], 0;
end;

(* Directories: getdents64's entries, read a buffer at a time. *)

proc openDir*(d: ^Dir; path: []U8): INT;
var fd: INT;
begin
    fd := open(path, {reading});
    if fd < 0 then return fd; end;
    d^.fd := fd;
    d^.pos := 0;
    d^.len := 0;
    return 0;
end;

(* a name, good until the next call; false at the end *)
proc nextEntry*(d: ^Dir): ([]U8, BOOL);
var n, reclen, i: INT; name: []U8;
begin
    while true do
        if d^.pos >= d^.len then
            n := SYSCALL(sysGetdents64, d^.fd, ADR(d^.buf), LEN(d^.buf));
            if n <= 0 then return "", false; end;
            d^.pos := 0;
            d^.len := n;
        end;
        reclen := INT(^U16(ADR(d^.buf[d^.pos + 16]))^);
        i := d^.pos + 19;
        while d^.buf[i] # 0 do INC(i); end;
        name := d^.buf[d^.pos + 19..i];
        d^.pos := d^.pos + reclen;
        if name # "." and name # ".." then return name, true; end;
    end;
    return "", false;
end;

proc closeDir*(d: ^Dir);
begin
    close(d^.fd);
end;

(* The terminal. *)

(* the terminal on fd: no echo, no lines, no signals *)
proc rawMode*(fd: INT): BOOL;
var t: Termios; iflag, oflag, cflag, lflag: ^U32;
begin
    if SYSCALL(sysIoctl, fd, tcgets, ADR(t)) # 0 then return false; end;
    if not haveSaved then saved := t; savedFd := fd; haveSaved := true; end;
    iflag := ^U32(ADR(t[0])); oflag := ^U32(ADR(t[4]));
    cflag := ^U32(ADR(t[8])); lflag := ^U32(ADR(t[12]));
    iflag^ := iflag^ & ~U32(1H | 2H | 8H | 20H | 40H | 80H | 100H | 400H);
    oflag^ := oflag^ & ~U32(1H);
    lflag^ := lflag^ & ~U32(8H | 40H | 2H | 1H | 8000H);
    cflag^ := (cflag^ & ~U32(30H | 100H)) | 30H;
    t[17 + 6] := 1;     (* VMIN *)
    t[17 + 5] := 0;     (* VTIME *)
    return SYSCALL(sysIoctl, fd, tcsets, ADR(t)) = 0;
end;

(* as rawMode found it *)
proc restoreMode*(fd: INT);
begin
    if haveSaved then _ := SYSCALL(sysIoctl, fd, tcsets, ADR(saved)); end;
end;

(* columns and rows; 80 and 24 if unknown *)
proc termSize*(fd: INT): (INT, INT);
var w: [4]U16;
begin
    if SYSCALL(sysIoctl, fd, tiocgwinsz, ADR(w)) # 0 or w[1] = 0 then return 80, 24; end;
    return INT(w[1]), INT(w[0]);
end;

(* the size its programs are told of *)
proc setTermSize*(fd, cols, rows: INT): INT;
var w: [4]U16;
begin
    w[0] := U16(rows);
    w[1] := U16(cols);
    return SYSCALL(sysIoctl, fd, tiocswinsz, ADR(w));
end;

(* Waiting: poll on up to 64 descriptors. *)

type PollFd = record fd: I32; events, revents: I16; end;

(* poll on n of fds, again if a signal interrupts it *)
proc poll(fds: ^PollFd; n, ms: INT): INT;
var r: INT;
begin
    repeat
        r := SYSCALL(sysPoll, fds, n, ms);
    until r # -4;
    return r;
end;

(* something to read within ms, or ever if ms < 0 *)
proc ready*(fd, ms: INT): BOOL;
var p: PollFd;
begin
    p.fd := I32(fd);
    p.events := 1;
    return poll(ADR(p), 1, ms) > 0;
end;

(* readyOf, and the first of writes with room to write *)
proc readyFor*(reads, writes: []INT; ms: INT): INT;
var p: [64]PollFd; n, i, j: INT; found: BOOL;
begin
    for i := 0 to LEN(reads) - 1 do
        if n < LEN(p) then p[n].fd := I32(reads[i]); p[n].events := 1; INC(n); end;
    end;
    for i := 0 to LEN(writes) - 1 do
        if n < LEN(p) then
            found := false;
            for j := 0 to n - 1 do
                if p[j].fd = I32(writes[i]) then p[j].events := p[j].events | 4; found := true; end;
            end;
            if not found then p[n].fd := I32(writes[i]); p[n].events := 4; INC(n); end;
        end;
    end;
    if poll(ADR(p[0]), n, ms) <= 0 then return -1; end;
    for i := 0 to n - 1 do
        if p[i].revents # 0 then return INT(p[i].fd); end;
    end;
    return -1;
end;

(* the first of fds with something to read within ms, or -1 *)
proc readyOf*(fds: []INT; ms: INT): INT;
var none: [1]INT;
begin
    return readyFor(fds, none[0..0], ms);
end;

(* if not yes, a read or write that would wait is -11 at once *)
proc setBlocking*(fd: INT; yes: BOOL): INT;
var flags: INT;
begin
    flags := SYSCALL(sysFcntl, fd, 3);
    if flags < 0 then return flags; end;
    if yes then flags := flags & ~nonblock; else flags := flags | nonblock; end;
    return SYSCALL(sysFcntl, fd, 4, flags);
end;

(* Programs. *)

(* the fd to read and the fd to write; or minus an errno and -1 *)
proc pipe*: (INT, INT);
var fds: [2]I32; r: INT;
begin
    r := SYSCALL(sysPipe2, ADR(fds), cloexec);
    if r < 0 then return r, -1; end;
    return INT(fds[0]), INT(fds[1]);
end;

(* a pseudo-terminal: the fd of its controlling side *)
proc openPty*: INT;
var fd: INT; zero: I32;
begin
    fd := open("/dev/ptmx", {reading, writing});
    if fd < 0 then return fd; end;
    _ := SYSCALL(sysIoctl, fd, tiocsptlck, ADR(zero));
    return fd;
end;

(* s with a zero after it, in memory of its own, for the new program *)
proc cString(s: []U8): ^U8;
var p: ^U8;
begin
    p := mmap(LEN(s) + 1);
    if p # nil and LEN(s) > 0 then COPY(p[0..LEN(s)], s); end;
    return p;
end;

(* The new program's environment: this one's with p.env put in, or p.env alone. *)
proc environment(p: Program): ^^U8;
var e: ^^U8; n, i, j, k, eq: INT; s: ^U8; replaced: BOOL;
begin
    if envp = nil then envp := environ(); end;
    while envp[n] # nil do INC(n); end;
    e := ^^U8(mmap((n + LEN(p.env) + 1) * 8));
    k := 0;
    if not p.onlyEnv then
        for i := 0 to n - 1 do
            s := envp[i];
            replaced := false;
            for j := 0 to LEN(p.env) - 1 do
                eq := 0;
                while eq < LEN(p.env[j]) and p.env[j][eq] # '=' do INC(eq); end;
                if s[0..eq + 1] = p.env[j][0..eq + 1] then replaced := true; end;
            end;
            if not replaced then e[k] := s; INC(k); end;
        end;
    end;
    for j := 0 to LEN(p.env) - 1 do e[k] := cString(p.env[j]); INC(k); end;
    e[k] := nil;
    return e;
end;

(* In the child, after fork: what spawn says, then the program. *)
proc child(p: Program; path: ^U8; argv, env: ^^U8);
var i, n, slave: INT; zero: [2]U64; act: [4]U64; pts: Path; pgrp: I32;
begin
    if p.tty # 0 then
        (* a session on the pseudo-terminal: its controlling terminal and
           standard input, output and error *)
        _ := SYSCALL(sysSetsid);
        _ := SYSCALL(sysIoctl, p.tty, tiocgptn, ADR(n));
        pts := "/dev/pts/";
        i := 9;
        if n = 0 then pts[i] := '0'; INC(i); end;
        slave := n;
        while slave > 0 do INC(i); slave := slave div 10; end;
        slave := i;
        while n > 0 do DEC(i); pts[i] := U8(n mod 10) + '0'; n := n div 10; end;
        pts[slave] := 0;
        slave := SYSCALL(sysOpenat, atFdCwd, ADR(pts), 2);
        _ := SYSCALL(sysIoctl, slave, tiocsctty, 0);
        for i := 0 to 2 do _ := SYSCALL(sysDup2, slave, i); end;
    else
        if p.group = -1 then _ := SYSCALL(sysSetpgid, 0, 0);
        elsif p.group > 0 then _ := SYSCALL(sysSetpgid, 0, p.group);
        end;
        if p.foreground then
            pgrp := I32(SYSCALL(sysGetpid));
            if p.group > 0 then pgrp := I32(p.group); end;
            _ := SYSCALL(sysIoctl, 0, tiocspgrp, ADR(pgrp));
        end;
        for i := 0 to 2 do
            if p.fds[i] # 0 then _ := SYSCALL(sysDup2, p.fds[i], i); end;
        end;
    end;
    (* every signal as it is at first, and none blocked *)
    for i := 1 to 31 do
        if i # 9 and i # 19 then _ := SYSCALL(sysRtSigaction, i, ADR(act), 0, 8); end;
    end;
    _ := SYSCALL(sysRtSigprocmask, 2, ADR(zero), 0, 8);
    _ := SYSCALL(sysCloseRange, 3, 0FFFFFFFFH, 0);
    if LEN(p.dir) > 0 and setWorkDir(p.dir) < 0 then _ := SYSCALL(sysExit, 127); end;
    _ := SYSCALL(sysExecve, path, argv, env);
    _ := SYSCALL(sysExit, 127);
end;

(* a program started: its process id *)
proc spawn*(p: Program): INT;
var path: ^U8; argv, env: ^^U8; i, pid: INT;
begin
    path := cString(p.path);
    argv := ^^U8(mmap((LEN(p.args) + 1) * 8));
    if path = nil or argv = nil then return -12; end;
    for i := 0 to LEN(p.args) - 1 do argv[i] := cString(p.args[i]); end;
    env := environment(p);
    pid := SYSCALL(sysFork);
    if pid = 0 then child(p, path, argv, env); end;
    (* the parent's copies given back *)
    for i := 0 to LEN(p.args) - 1 do munmap(argv[i], LEN(p.args[i]) + 1); end;
    munmap(^U8(argv), (LEN(p.args) + 1) * 8);
    munmap(path, LEN(p.path) + 1);
    return pid;
end;

(* which program, how, and its code *)
proc wait*(pid: INT; block: BOOL): (INT, Status, INT);
var st: I32; r, options: INT;
begin
    options := 2;   (* WUNTRACED *)
    if not block then options := options | 1; end;
    repeat
        r := SYSCALL(sysWait4, pid, ADR(st), options, 0);
    until r # -4;
    if r <= 0 then return r, running, 0; end;
    if st & 7FH = 0 then return r, exited, INT((st shr 8) & 0FFH); end;
    if st & 0FFH = 7FH then return r, stopped, INT((st shr 8) & 0FFH); end;
    return r, killed, INT(st & 7FH);
end;

(* pid 0 is this program; group 0 a new one pid leads *)
proc setGroup*(pid, group: INT): INT;
begin
    return SYSCALL(sysSetpgid, pid, group);
end;

(* the terminal on fd gives its keys to group *)
proc foreground*(fd, group: INT): INT;
var g: I32;
begin
    g := I32(group);
    return SYSCALL(sysIoctl, fd, tiocspgrp, ADR(g));
end;

(* the group the terminal on fd gives its keys to *)
proc foregroundOf*(fd: INT): INT;
var g: I32; r: INT;
begin
    r := SYSCALL(sysIoctl, fd, tiocgpgrp, ADR(g));
    if r < 0 then return r; end;
    return INT(g);
end;

(* Signals: SBCL's run time catches them and writes each to a pipe,
   whose end to read is the fd catch gives. *)

proc catchSignal(sig: INT): INT;
code
    (catch-signal sig);
end;

proc ignoreSignal(sig: INT; yes: BOOL);
code
    (ignore-signal sig yes);
end;

(* sigs caught: an fd to wait on *)
proc catch*(sigs: []INT): INT;
var i, fd: INT;
begin
    for i := 0 to LEN(sigs) - 1 do
        if sigs[i] = sigKill or sigs[i] = sigStop or sigs[i] = 11 or sigs[i] = 8
           or sigs[i] < 1 or sigs[i] > 64 then
            return -22;
        end;
    end;
    fd := -22;
    for i := 0 to LEN(sigs) - 1 do fd := catchSignal(sigs[i]); end;
    return fd;
end;

(* the next signal caught, or 0 if none is waiting *)
proc caught*(fd: INT): INT;
var b: [1]U8;
begin
    if SYSCALL(sysRead, fd, ADR(b), 1) = 1 then return INT(b[0]); end;
    return 0;
end;

(* sig ignored; or, if not yes, back to what it does at first *)
proc ignore*(sig: INT; yes: BOOL): INT;
begin
    if sig = sigKill or sig = sigStop or sig = 11 or sig = 8 or sig < 1 or sig > 64 then return -22; end;
    ignoreSignal(sig, yes);
    return 0;
end;

(* Sockets. An address is a sockaddr, made in a [128]U8. *)

type Address = [128]U8;

(* path as a Unix socket's address, and its length; -36 if too long *)
proc unixAddress(path: []U8; var a: Address): INT;
begin
    if LEN(path) > 107 then return -36; end;
    a[0] := 1;      (* AF_UNIX *)
    COPY(a[2..2 + LEN(path)], path);
    a[2 + LEN(path)] := 0;
    return 2 + LEN(path) + 1;
end;

(* the number at s[i..], hexadecimal or decimal, and where it ends *)
proc number(s: []U8; i: INT; hex: BOOL): (INT, INT, BOOL);
var v, d, start: INT;
begin
    start := i;
    while i < LEN(s) do
        if s[i] >= '0' and s[i] <= '9' then d := INT(s[i] - '0');
        elsif hex and s[i] >= 'a' and s[i] <= 'f' then d := INT(s[i] - 'a') + 10;
        elsif hex and s[i] >= 'A' and s[i] <= 'F' then d := INT(s[i] - 'A') + 10;
        else return v, i, i > start;
        end;
        if hex then v := v * 16 + d; else v := v * 10 + d; end;
        if v > 0FFFFH then return 0, i, false; end;
        INC(i);
    end;
    return v, i, i > start;
end;

(* addr, IPv4 or IPv6 numbers, and port as an address, and its length; -22 if addr isn't one *)
proc inetAddress(addr: []U8; port: INT; var a: Address): INT;
var i, k, v, gap, n: INT; ok: BOOL; groups: [8]INT;
begin
    a[2] := U8(port shr 8);
    a[3] := U8(port & 0FFH);
    while i < LEN(addr) and addr[i] # ':' do INC(i); end;
    if i = LEN(addr) then
        i := 0;
        a[0] := 2;      (* AF_INET *)
        for k := 0 to 3 do
            v, i, ok := number(addr, i, false);
            if not ok or v > 255 then return -22; end;
            a[4 + k] := U8(v);
            if k < 3 then
                if i >= LEN(addr) or addr[i] # '.' then return -22; end;
                INC(i);
            end;
        end;
        if i # LEN(addr) then return -22; end;
        return 16;
    end;
    a[0] := 10;         (* AF_INET6 *)
    gap := -1;
    i := 0;
    if LEN(addr) >= 2 and addr[0..2] = "::" then gap := 0; i := 2; end;
    while i < LEN(addr) do
        if n = 8 then return -22; end;
        v, i, ok := number(addr, i, true);
        if not ok then return -22; end;
        groups[n] := v;
        INC(n);
        if i < LEN(addr) then
            if addr[i] # ':' then return -22; end;
            INC(i);
            if i < LEN(addr) and addr[i] = ':' then
                if gap >= 0 then return -22; end;
                gap := n;
                INC(i);
            end;
        end;
    end;
    if gap < 0 and n # 8 then return -22; end;
    (* the groups after the gap move to the end *)
    for k := 0 to 7 do
        if gap < 0 or k < gap then v := groups[k];
        elsif k >= 8 - (n - gap) then v := groups[k - (8 - n)];
        else v := 0;
        end;
        a[8 + 2 * k] := U8(v shr 8);
        a[9 + 2 * k] := U8(v & 0FFH);
    end;
    return 28;
end;

(* a socket of type kind for address a, connected or bound and listening *)
proc socket(a: Address; n, kind: INT; serve: BOOL): INT;
var fd, r: INT; one: I32;
begin
    if n < 0 then return n; end;
    fd := SYSCALL(sysSocket, INT(a[0]), kind | cloexec, 0);
    if fd < 0 then return fd; end;
    if serve then
        one := 1;
        _ := SYSCALL(sysSetsockopt, fd, 1, 2, ADR(one), 4);
        r := SYSCALL(sysBind, fd, ADR(a), n);
        if r = 0 then r := SYSCALL(sysListen, fd, 128); end;
    else
        r := SYSCALL(sysConnect, fd, ADR(a), n);
    end;
    if r < 0 then close(fd); return r; end;
    return fd;
end;

(* a stream socket, connected to the Unix socket at path: its fd *)
proc connect*(path: []U8): INT;
var a: Address;
begin
    return socket(a, unixAddress(path, a), 1, false);
end;

(* addr an IPv4 or IPv6 address, as numbers *)
proc connectTcp*(addr: []U8; port: INT): INT;
var a: Address;
begin
    return socket(a, inetAddress(addr, port, a), 1, false);
end;

proc connectUdp*(addr: []U8; port: INT): INT;
var a: Address;
begin
    return socket(a, inetAddress(addr, port, a), 2, false);
end;

(* a Unix socket made at path, taking connections *)
proc listen*(path: []U8): INT;
var a: Address;
begin
    return socket(a, unixAddress(path, a), 1, true);
end;

proc listenTcp*(addr: []U8; port: INT): INT;
var a: Address;
begin
    return socket(a, inetAddress(addr, port, a), 1, true);
end;

(* the next connection, waiting for one *)
proc accept*(fd: INT): INT;
var r: INT;
begin
    repeat r := SYSCALL(sysAccept4, fd, 0, 0, cloexec); until r # -4;
    return r;
end;

(* write, to a socket: -32 (EPIPE), not a signal, if it is closed *)
proc send*(fd: INT; s: []U8): INT;
begin
    if LEN(s) = 0 then return 0; end;
    return SYSCALL(sysSendto, fd, ADR(s[0]), LEN(s), 4000H, 0, 0);
end;

end Sys.
