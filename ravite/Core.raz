(* Core: what the parts of ravite share. The buffers, the one the
   window shows and the one commands act on, which is the minibuffer
   while it is open; the echo area; the count a command is given; the
   settings; and procedures through which a part reads keys, runs them
   and opens directories, set by the main module, so that a part needs
   no import of the parts that do these.

   Positions are those of Text, in the buffer commands act on. insert
   and delete keep the mark where it was in the text.

   Depends on: Text, and Tty for files.
   Leaves out: the commands themselves, in Edit, Mini, Search, Dired
   and Commands. *)
module Core;
import Sys, Rt, Buf, Fmt, Heap, Files, Text, Tty;

const
    File* = 0;        (* a buffer of text: a file's, or no file's, as *scratch* *)
    Directory* = 1;   (* a directory, by Dired *)
    List* = 2;        (* the list of buffers *)
    Mini* = 3;        (* the minibuffer *)
    Help* = 4;        (* what C-h b lists *)

type
    Buffer* = record
        name*, path*: Buf.Buf;    (* path: absolute, or empty for no file *)
        t*: Text.Text;
        point*, mark*: I64;
        hasMark*: BOOL;           (* a mark is set *)
        active*: BOOL;            (* and the region is shown *)
        top*, left*: I64;         (* where the window starts *)
        kind*: I64;
        readOnly*: BOOL;
        coloured*: BOOL;          (* raz, in colour *)
        known*, knownDepth*: I64; (* the depth of comment at known, for Colour *)
        next*: ^Buffer;
    end;

    Command* = proc(n: I64);

var
    buffers*: ^Buffer;     (* all but the minibuffer, the last shown first *)
    b*: ^Buffer;           (* the one commands act on *)
    shown*: ^Buffer;       (* the one the window shows *)
    mini*: ^Buffer;
    prompt*: Buf.Buf;      (* before the minibuffer, while it is open *)
    miniOpen*: BOOL;
    after*: Buf.Buf;       (* shown after the minibuffer: ido's choices *)
    echo*: Buf.Buf;        (* a message in the echo area *)
    lit*, litEnd*: I64;    (* what a search found, shown, if litEnd > lit *)
    tmp*: Buf.Buf;         (* for anyone, between two calls of nothing else *)

    arg*: I64;             (* the count the command was given, 1 if none *)
    argGiven*: BOOL;
    last*: Command;        (* the command before the one running *)
    changed*: BOOL;        (* the command changed a buffer *)
    want*: I64;            (* the column C-n and C-p keep to *)
    cols*, rows*: I64;     (* the screen *)
    quitting*: BOOL;       (* C-x C-c said yes *)

    (* settings *)
    indent*: I64;          (* the columns TAB goes on by *)
    tabWidth*: I64;        (* a tab character's columns *)
    colour*: BOOL;
    ido*: BOOL;

    home*, cwd*: Buf.Buf;  (* $HOME, and the directory ravite started in *)

    nextKey*: proc: I64;
    runKey*: proc(k: I64);                   (* the command bound to keys starting with k *)
    openDir*: proc(path: []U8): ^Buffer;     (* a directory's buffer *)

proc size*: I64;
begin
    return Text.len(ADR(b^.t));
end;

proc at*(p: I64): U8;
begin
    return Text.at(ADR(b^.t), p);
end;

proc slice*(lo, hi: I64): []U8;
begin
    return Text.slice(ADR(b^.t), lo, hi);
end;

proc lineStart*(p: I64): I64;
begin
    return Text.lineStart(ADR(b^.t), p);
end;

proc lineEnd*(p: I64): I64;
begin
    return Text.lineEnd(ADR(b^.t), p);
end;

(* The start of the character after the one at p. *)
proc next*(p: I64): I64;
begin
    if p >= size() then return p; end;
    INC(p);
    while (p < size()) and (at(p) and 0C0H = 80H) do INC(p); end;
    return p;
end;

(* The start of the character before p. *)
proc prev*(p: I64): I64;
begin
    if p <= 0 then return 0; end;
    DEC(p);
    while (p > 0) and (at(p) and 0C0H = 80H) do DEC(p); end;
    return p;
end;

proc isBlank*(c: U8): BOOL;
begin
    return (c = ' ') or (c = '\t');
end;

(* The column p is at in its line. *)
proc column*(p: I64): I64;
var q, c: I64; ch: U8;
begin
    q := lineStart(p);
    c := 0;
    while q < p do
        ch := at(q);
        if ch = '\t' then c := (c div tabWidth + 1) * tabWidth;
        elsif (ch < 32) or (ch = 127) then INC(c, 2);
        elsif ch and 0C0H # 80H then INC(c);
        end;
        INC(q);
    end;
    return c;
end;

(* The character of p's line at column c, or the line's end. *)
proc atColumn*(p, c: I64): I64;
var e: I64;
begin
    p := lineStart(p);
    e := lineEnd(p);
    while (p < e) and (column(next(p)) <= c) do p := next(p); end;
    return p;
end;

(* The start of the line n lines below p's, or above if n < 0, as far as
   the text goes; and how many lines that is. *)
proc lines*(p, n: I64): (I64, I64);
var i: I64;
begin
    p := lineStart(p);
    i := 0;
    while (i < n) and (lineEnd(p) < size()) do
        p := lineEnd(p) + 1;
        INC(i);
    end;
    while (i > n) and (p > 0) do
        p := lineStart(p - 1);
        DEC(i);
    end;
    return p, i;
end;

(* Says s in the echo area. *)
proc message*(s: []U8);
begin
    Buf.reset(ADR(echo));
    Buf.str(ADR(echo), s);
end;

(* Whether the buffer can be changed; says so if not. *)
proc writable*: BOOL;
begin
    if b^.readOnly then
        Fmt.write(ADR(echo), "Buffer is read-only: {}", [Fmt.str(Buf.bytes(ADR(b^.name)))]);
        return false;
    end;
    return true;
end;

(* Inserts s at p; the point at p or after it moves on, and the mark
   after p, as emacs's markers do. *)
proc insert*(p: I64; s: []U8);
begin
    if not Text.insert(ADR(b^.t), p, s) then message("Memory exhausted"); return; end;
    if b^.mark > p then INC(b^.mark, LEN(s)); end;
    if b^.point >= p then INC(b^.point, LEN(s)); end;
    changed := true;
end;

(* Deletes the n bytes from p; the point and the mark move with them. *)
proc delete*(p, n: I64);
begin
    if n <= 0 then return; end;
    if not Text.delete(ADR(b^.t), p, n) then message("Memory exhausted"); return; end;
    if b^.mark >= p + n then DEC(b^.mark, n); elsif b^.mark > p then b^.mark := p; end;
    if b^.point >= p + n then DEC(b^.point, n); elsif b^.point > p then b^.point := p; end;
    changed := true;
end;

(* Buffers *)

(* The buffer named name, or nil. *)
proc find*(name: []U8): ^Buffer;
var x: ^Buffer;
begin
    x := buffers;
    while (x # nil) and (Buf.bytes(ADR(x^.name)) # name) do x := x^.next; end;
    return x;
end;

(* A new, empty buffer, named name, or name<2> and on if that is taken,
   last in the list. *)
proc newBuffer*(name: []U8; kind: I64): ^Buffer;
var x, y: ^Buffer; i: I64;
begin
    NEW(x, Heap.heap);
    if x = nil then Rt.stop("ravite: out of memory"); end;
    Text.init(ADR(x^.t), Heap.heap);
    Buf.init(ADR(x^.name), Heap.heap);
    Buf.init(ADR(x^.path), Heap.heap);
    x^.kind := kind;
    Buf.str(ADR(x^.name), name);
    i := 2;
    while find(Buf.bytes(ADR(x^.name))) # nil do
        Buf.reset(ADR(x^.name));
        Fmt.write(ADR(x^.name), "{}<{}>", [Fmt.str(name), Fmt.int(i)]);
        INC(i);
    end;
    if kind = Mini then return x; end;
    if buffers = nil then
        buffers := x;
    else
        y := buffers;
        while y^.next # nil do y := y^.next; end;
        y^.next := x;
    end;
    return x;
end;

(* Shows x in the window, first in the list, the one commands act on. *)
proc show*(x: ^Buffer);
var y: ^Buffer;
begin
    if buffers # x then
        y := buffers;
        while (y # nil) and (y^.next # x) do y := y^.next; end;
        if y # nil then y^.next := x^.next; end;
        x^.next := buffers;
        buffers := x;
    end;
    shown := x;
    b := x;
end;

(* The buffer shown last that isn't x; *scratch*, made again, if none. *)
proc other*(x: ^Buffer): ^Buffer;
var y: ^Buffer;
begin
    y := buffers;
    while (y # nil) and (y = x) do y := y^.next; end;
    if y = nil then y := newBuffer("*scratch*", File); end;
    return y;
end;

(* Takes x out of the list, and the window to another. *)
proc kill*(x: ^Buffer);
var y: ^Buffer;
begin
    if shown = x then show(other(x)); end;
    y := buffers;
    if y = x then
        buffers := x^.next;
    else
        while (y # nil) and (y^.next # x) do y := y^.next; end;
        if y # nil then y^.next := x^.next; end;
    end;
    Text.done(ADR(x^.t));
    Buf.done(ADR(x^.name));
    Buf.done(ADR(x^.path));
    Heap.heap^.free(Heap.heap, ^U8(x));
end;

(* Files *)

(* path made absolute and plain into out: ~ is the home directory, a
   relative path is from the directory ravite started in, // or /~
   start again as emacs does, and . and .. are taken out. *)
proc absolute*(path: []U8; out: ^Buf.Buf);
var i, n: I64; s: []U8;
begin
    i := LEN(path) - 1;
    while i >= 1 do
        if (path[i - 1] = '/') and ((path[i] = '/') or (path[i] = '~')) then
            path := path[i..LEN(path)];
            break;
        end;
        DEC(i);
    end;
    Buf.reset(ADR(tmp));
    if (LEN(path) > 0) and (path[0] = '~') then
        Buf.str(ADR(tmp), Buf.bytes(ADR(home)));
        path := path[1..LEN(path)];
    elsif (LEN(path) = 0) or (path[0] # '/') then
        Buf.str(ADR(tmp), Buf.bytes(ADR(cwd)));
        Buf.add(ADR(tmp), '/');
    end;
    Buf.str(ADR(tmp), path);
    s := Buf.bytes(ADR(tmp));
    Buf.reset(out);
    i := 0;
    while i < LEN(s) do
        while (i < LEN(s)) and (s[i] = '/') do INC(i); end;
        n := i;
        while (n < LEN(s)) and (s[n] # '/') do INC(n); end;
        if s[i..n] = ".." then
            while (out^.len > 0) and (Buf.bytes(out)[out^.len - 1] # '/') do DEC(out^.len); end;
            if out^.len > 0 then DEC(out^.len); end;
        elsif (n > i) and (s[i..n] # ".") then
            Buf.add(out, '/');
            Buf.str(out, s[i..n]);
        end;
        i := n;
    end;
    if out^.len = 0 then Buf.add(out, '/'); end;
end;

(* path with the home directory written ~, into out. *)
proc abbreviate*(path: []U8; out: ^Buf.Buf);
var h: []U8;
begin
    h := Buf.bytes(ADR(home));
    if (LEN(h) > 1) and (LEN(path) >= LEN(h)) and (path[0..LEN(h)] = h)
        and ((LEN(path) = LEN(h)) or (path[LEN(h)] = '/')) then
        Buf.add(out, '~');
        Buf.str(out, path[LEN(h)..LEN(path)]);
    else
        Buf.str(out, path);
    end;
end;

(* The directory of the buffer x, or the one ravite started in, with a
   / at its end, abbreviated, into out. *)
proc directory*(x: ^Buffer; out: ^Buf.Buf);
var p: []U8; i: I64;
begin
    p := Buf.bytes(ADR(x^.path));
    if LEN(p) = 0 then
        abbreviate(Buf.bytes(ADR(cwd)), out);
    elsif x^.kind = Directory then
        abbreviate(p, out);
    else
        i := LEN(p);
        while (i > 0) and (p[i - 1] # '/') do DEC(i); end;
        abbreviate(p[0..i], out);
    end;
    if (out^.len = 0) or (Buf.bytes(out)[out^.len - 1] # '/') then Buf.add(out, '/'); end;
end;

(* The buffer visiting path, or nil. *)
proc visiting*(path: []U8): ^Buffer;
var x: ^Buffer;
begin
    x := buffers;
    while (x # nil) and (Buf.bytes(ADR(x^.path)) # path) do x := x^.next; end;
    return x;
end;

(* The buffer for the file or directory path, absolute: the one that
   has it already, or a new one with what the file holds, or empty for
   a new file; nil if it can't be read. *)
proc visit*(path: []U8): ^Buffer;
var x: ^Buffer; i, fd, err: I64; info: Tty.Info;
begin
    x := visiting(path);
    if x # nil then return x; end;
    info, err := Tty.info(path);
    if (err = 0) and info.dir then return openDir(path); end;
    i := LEN(path);
    while (i > 0) and (path[i - 1] # '/') do DEC(i); end;
    x := newBuffer(path[i..LEN(path)], File);
    Buf.str(ADR(x^.path), path);
    x^.coloured := colour and (LEN(path) > 4) and (path[LEN(path) - 4..LEN(path)] = ".raz");
    if err = -2 then
        message("(New file)");
        return x;
    end;
    fd := Sys.openRead(path);
    if fd >= 0 then Sys.close(fd); end;
    Buf.reset(ADR(tmp));
    if (fd < 0) or not Files.read(path, ADR(tmp)) or not Text.load(ADR(x^.t), Buf.bytes(ADR(tmp))) then
        b := x;
        kill(x);
        b := shown;
        Fmt.write(ADR(echo), "Can't read {}", [Fmt.str(path)]);
        return nil;
    end;
    return x;
end;

(* Writes all of s to fd; false if it can't. *)
proc writeAll*(fd: I64; s: []U8): BOOL;
var n: I64;
begin
    while LEN(s) > 0 do
        n := Sys.write(fd, s);
        if n > 0 then
            s := s[n..LEN(s)];
        elsif n # -4 then   (* -EINTR: again *)
            return false;
        end;
    end;
    return true;
end;

(* Writes x to its file: to a new file beside it, renamed over it once
   written, so that a failed write loses nothing. *)
proc save*(x: ^Buffer): BOOL;
var fd: I64; ok: BOOL; path: []U8;
begin
    path := Buf.bytes(ADR(x^.path));
    Buf.reset(ADR(tmp));
    Buf.str(ADR(tmp), path);
    Buf.str(ADR(tmp), ".ravite~");
    fd := Sys.create(Buf.bytes(ADR(tmp)));
    if fd < 0 then
        Fmt.write(ADR(echo), "Opening output file: {}", [Fmt.str(path)]);
        return false;
    end;
    ok := writeAll(fd, Text.slice(ADR(x^.t), 0, Text.len(ADR(x^.t))));
    Sys.close(fd);
    if not ok or (Tty.rename(Buf.bytes(ADR(tmp)), path) # 0) then
        Fmt.write(ADR(echo), "Write error: {}", [Fmt.str(path)]);
        return false;
    end;
    Text.written(ADR(x^.t));
    Buf.reset(ADR(echo));
    Buf.str(ADR(echo), "Wrote ");
    abbreviate(path, ADR(echo));
    return true;
end;

begin
    Buf.init(ADR(prompt), Heap.heap);
    Buf.init(ADR(after), Heap.heap);
    Buf.init(ADR(echo), Heap.heap);
    Buf.init(ADR(tmp), Heap.heap);
    Buf.init(ADR(home), Heap.heap);
    Buf.init(ADR(cwd), Heap.heap);
    indent := 4;
    tabWidth := 8;
    colour := true;
    ido := true;
    arg := 1;
    rows := 24;
    cols := 80;
end Core.
