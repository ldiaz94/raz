(* Search: incremental search and query-replace, as emacs does them.

   C-s and C-r search as the text is typed, forward or back, the match
   shown and the point at its far end. Typed again they go to the next
   match; at the end, the search fails, and once more it wraps round.
   DEL takes back the last step, C-w adds the word after the match, RET
   stops, C-g goes back to where the search started, and any other key
   stops and does what it does. A search with no capital letters
   matches either case.

   M-% asks, at each match after the point, whether to replace it: y
   or SPC does, n or DEL doesn't, ! does it to all the rest, . to this
   one and stops, q or RET stops. A replacement follows the case of
   what it replaces when that is all capitals or capitalized.

   Depends on: Core, Mini, Keys, Text.
   Leaves out: patterns, and searching in the minibuffer's history. *)
module Search;
import Buf, Fmt, Heap, Text, Keys, Core, Mini, Edit;

const Max = 256;   (* steps DEL can take back *)

type
    Step = record
        len: I64;        (* of the search string *)
        point, lo: I64;  (* where it stood, and the match's start *)
        found, wrapped: BOOL;
    end;

var
    last: Buf.Buf;       (* the last search, which C-s C-s searches again *)
    s: Buf.Buf;
    steps: [Max]Step;
    numSteps: I64;
    with, prompt: Buf.Buf;

proc lower(c: U8): U8;
begin
    if (c >= 'A') and (c <= 'Z') then return c + 32; end;
    return c;
end;

(* Whether the search ignores case: it has no capitals. *)
proc fold(pat: []U8): BOOL;
var i: I64;
begin
    for i := 0 to LEN(pat) - 1 do
        if (pat[i] >= 'A') and (pat[i] <= 'Z') then return false; end;
    end;
    return true;
end;

(* Whether pat is at p in t. *)
proc matchAt(t: []U8; p: I64; pat: []U8; f: BOOL): BOOL;
var i: I64;
begin
    if p + LEN(pat) > LEN(t) then return false; end;
    for i := 0 to LEN(pat) - 1 do
        if (t[p + i] # pat[i]) and not f or f and (lower(t[p + i]) # lower(pat[i])) then return false; end;
    end;
    return true;
end;

(* Where pat starts: the first place from p on, or if back the last
   that ends at p or before; -1 if none. *)
proc find*(pat: []U8; p: I64; back: BOOL): I64;
var t: []U8; f: BOOL;
begin
    t := Core.slice(0, Core.size());
    f := fold(pat);
    if back then
        p := p - LEN(pat);
        while p >= 0 do
            if matchAt(t, p, pat, f) then return p; end;
            DEC(p);
        end;
    else
        while p + LEN(pat) <= LEN(t) do
            if matchAt(t, p, pat, f) then return p; end;
            INC(p);
        end;
    end;
    return -1;
end;

(* The search from the step before, with what is typed now: from the
   same match, which may grow, or past it if again; round the end if
   wrap. *)
proc look(back, again, wrap: BOOL);
var st: Step; p, from: I64;
begin
    st := steps[numSteps - 1];
    from := st.lo;
    if back and (st.len > 0) then from := st.lo + s.len; end;   (* the match may grow *)
    if again and st.found then
        if back then from := st.lo; else from := st.lo + st.len; end;
    end;
    if wrap then
        if back then from := Core.size(); else from := 0; end;
    end;
    p := -1;
    if s.len > 0 then p := find(Buf.bytes(ADR(s)), from, back); end;
    if numSteps < Max then INC(numSteps); end;
    steps[numSteps - 1] := {len: s.len, point: st.point, lo: st.lo, found: false, wrapped: st.wrapped or wrap};
    if (s.len = 0) or (p >= 0) then
        if p >= 0 then
            steps[numSteps - 1].lo := p;
            steps[numSteps - 1].point := p;
            if not back then steps[numSteps - 1].point := p + s.len; end;
        end;
        steps[numSteps - 1].found := true;
    end;
end;

(* The echo area and the match shown as the last step left them. *)
proc showStep(back: BOOL);
var st: Step;
begin
    st := steps[numSteps - 1];
    Core.b^.point := st.point;
    Core.lit := st.lo;
    Core.litEnd := st.lo + s.len;
    if not st.found then Core.litEnd := Core.lit; end;
    Buf.reset(ADR(Core.echo));
    if not st.found then Buf.str(ADR(Core.echo), "Failing ");
    elsif st.wrapped then Buf.str(ADR(Core.echo), "Wrapped ");
    end;
    Buf.str(ADR(Core.echo), "I-search");
    if back then Buf.str(ADR(Core.echo), " backward"); end;
    Buf.str(ADR(Core.echo), ": ");
    Buf.str(ADR(Core.echo), Buf.bytes(ADR(s)));
end;

proc isearch(back: BOOL);
var k, start, e, n: I64; b: [4]U8;
begin
    start := Core.b^.point;
    Buf.reset(ADR(s));
    numSteps := 1;
    steps[0] := {point: start, lo: start, found: true};
    while true do
        showStep(back);
        k := Core.nextKey();
        if (k = Keys.ctrl('s')) or (k = Keys.ctrl('r')) then
            if (k = Keys.ctrl('r')) # back then
                (* turned round: the same match, the point at its other end *)
                back := k = Keys.ctrl('r');
                look(back, false, false);
            elsif (s.len = 0) and (last.len > 0) then
                Buf.str(ADR(s), Buf.bytes(ADR(last)));
                look(back, true, false);
            else
                look(back, true, not steps[numSteps - 1].found);
            end;
        elsif (k = Keys.Backspace) or (k = 8) then
            if numSteps > 1 then DEC(numSteps); end;
            s.len := steps[numSteps - 1].len;
        elsif k = Keys.ctrl('w') then
            (* the word after the match, or the character *)
            e := steps[numSteps - 1].lo + s.len;
            n := Core.next(e);
            if (e < Core.size()) and Edit.isWord(Core.at(e)) then
                while (n < Core.size()) and Edit.isWord(Core.at(n)) do INC(n); end;
            end;
            Buf.str(ADR(s), Core.slice(e, n));
            look(back, false, false);
        elsif (k >= 32) and (k # 127) and (k < Keys.Up) then
            n := Edit.utf8(k, b);
            Buf.str(ADR(s), b[0..n]);
            look(back, false, false);
        elsif k = Keys.ctrl('g') then
            if steps[numSteps - 1].found then
                Core.b^.point := start;
                Core.lit := 0;
                Core.litEnd := 0;
                Core.message("Quit");
                return;
            end;
            (* a failing search goes back to what it found *)
            while (numSteps > 1) and not steps[numSteps - 1].found do DEC(numSteps); end;
            s.len := steps[numSteps - 1].len;
        else
            break;
        end;
    end;
    Core.lit := 0;
    Core.litEnd := 0;
    if s.len > 0 then
        Buf.reset(ADR(last));
        Buf.str(ADR(last), Buf.bytes(ADR(s)));
    end;
    Buf.reset(ADR(Core.echo));
    if Core.b^.point # start then
        Core.b^.mark := start;
        Core.b^.hasMark := true;
        Core.message("Mark saved where search started");
    end;
    if (k # Keys.Enter) and (k # 10) then Core.runKey(k); end;
end;

proc isearchForward*(n: I64);
begin
    isearch(false);
end;

proc isearchBackward*(n: I64);
begin
    isearch(true);
end;

(* with, as it should replace m: in capitals if m is all
   capitals, capitalized if it is, else as it is; into out. *)
proc cased(m: []U8; out: ^Buf.Buf);
var i, caps, smalls: I64; first: BOOL; c: U8; r: []U8;
begin
    r := Buf.bytes(ADR(with));
    caps := 0;
    smalls := 0;
    for i := 0 to LEN(m) - 1 do
        if (m[i] >= 'A') and (m[i] <= 'Z') then INC(caps); end;
        if (m[i] >= 'a') and (m[i] <= 'z') then INC(smalls); end;
    end;
    Buf.reset(out);
    first := (LEN(m) > 0) and (m[0] >= 'A') and (m[0] <= 'Z') and (caps = 1);
    for i := 0 to LEN(r) - 1 do
        c := r[i];
        if (caps > 1) and (smalls = 0) or (caps = 1) and (smalls = 0) and (LEN(m) = 1) then
            if (c >= 'a') and (c <= 'z') then c := c - 32; end;
        elsif first and (i = 0) then
            if (c >= 'a') and (c <= 'z') then c := c - 32; end;
        end;
        Buf.add(out, c);
    end;
end;

(* M-%: replaces matches after the point, asking about each. *)
proc queryReplace*(n: I64);
var p, k, count: I64; all: BOOL; pat: []U8; rep: Buf.Buf;
begin
    if not Core.writable() then return; end;
    if not Mini.read("Query replace: ", "", ADR(s)) or (s.len = 0) then return; end;
    Buf.reset(ADR(prompt));
    Fmt.write(ADR(prompt), "Query replace {} with: ", [Fmt.str(Buf.bytes(ADR(s)))]);
    if not Mini.read(Buf.bytes(ADR(prompt)), "", ADR(with)) then return; end;
    Buf.init(ADR(rep), Heap.heap);
    defer Buf.done(ADR(rep));
    Buf.reset(ADR(prompt));
    Fmt.write(ADR(prompt), "Query replacing {} with {}: (y, n, !, ., q) ",
        [Fmt.str(Buf.bytes(ADR(s))), Fmt.str(Buf.bytes(ADR(with)))]);
    Core.b^.mark := Core.b^.point;
    Core.b^.hasMark := true;
    pat := Buf.bytes(ADR(s));
    count := 0;
    all := false;
    p := find(pat, Core.b^.point, false);
    while p >= 0 do
        Core.b^.point := p + LEN(pat);
        k := 'y';
        if not all then
            Core.lit := p;
            Core.litEnd := p + LEN(pat);
            k := Mini.key(Buf.bytes(ADR(prompt)), "yn!.q \x7f\r");
            Core.lit := 0;
            Core.litEnd := 0;
        end;
        if k = '!' then all := true; k := 'y'; end;
        if (k = 'y') or (k = ' ') or (k = '.') then
            cased(Core.slice(p, p + LEN(pat)), ADR(rep));
            Core.delete(p, LEN(pat));
            Core.insert(p, Buf.bytes(ADR(rep)));
            Core.b^.point := p + rep.len;
            INC(count);
        end;
        if (k = 'q') or (k = '.') or (k = Keys.Enter) or (k = Keys.ctrl('g')) then break; end;
        p := find(pat, Core.b^.point, false);
    end;
    Buf.reset(ADR(Core.echo));
    Fmt.write(ADR(Core.echo), "Replaced {} occurrence", [Fmt.int(count)]);
    if count # 1 then Buf.add(ADR(Core.echo), 's'); end;
end;

begin
    Buf.init(ADR(last), Heap.heap);
    Buf.init(ADR(s), Heap.heap);
    Buf.init(ADR(with), Heap.heap);
    Buf.init(ADR(prompt), Heap.heap);
end Search.
