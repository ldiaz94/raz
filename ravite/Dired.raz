(* Dired: buffers that list things, each line one of them, with keys of
   their own.

   A directory, as emacs's dired lists it, but with less: whether each
   entry is a directory, its size, and its name, sorted by name.

        ~/raz/ravite:
          d          -  ..
          -       5120  Core.raz

   RET or f opens the entry on the line, a file or a directory; ^ goes
   up; n and p move; g lists it again; + makes a directory, R renames
   the entry, D deletes it, a file, after a yes; q leaves.

   The list of buffers, as emacs's C-x C-b makes it:

        CRM Buffer                Size  Mode         File
        .   notes.raz              120  Raz          ~/notes.raz

   C is . for the buffer shown before, R % for one that can't be
   changed, M * for one with unsaved changes. RET or f shows the
   buffer on the line, d marks it to be killed and u unmarks it, x
   kills those marked, g lists them again, q leaves.

   Depends on: Core, Mini, Text.
   Leaves out: dired's marks and its commands on many files, deleting
   directories, and sorting the buffers. *)
module Dired;
import Sys, Buf, Fmt, Heap, Str, Text, Core, Mini;

const
    Max = 256;
    MaxEntries = 4096;
    Name = 16;   (* the column a directory's entry starts at *)

var
    listed: [Max]^Core.Buffer;   (* the buffer on each line, from the second *)
    numListed: I64;
    line, names, path, given: Buf.Buf;   (* given: a path, before Core.absolute *)
    starts: [MaxEntries]I64;     (* each name in names, sorted *)
    numNames: I64;
    dir: Sys.Dir;

(* Pads line with spaces to n bytes. *)
proc pad(n: I64);
begin
    while line.len < n do Buf.add(ADR(line), ' '); end;
end;

(* The list of buffers, made again in the buffer x; before is the one
   shown before it. *)
proc fill(x, before: ^Core.Buffer);
var y, saved: ^Core.Buffer; m: []U8;
begin
    saved := Core.b;
    Core.b := x;
    Core.delete(0, Core.size());
    Core.insert(0, " CRM Buffer                Size  Mode         File\n");
    numListed := 0;
    y := Core.buffers;
    while (y # nil) and (numListed < Max) do
        listed[numListed] := y;
        INC(numListed);
        Buf.reset(ADR(line));
        Buf.add(ADR(line), ' ');
        if y = before then Buf.add(ADR(line), '.'); else Buf.add(ADR(line), ' '); end;
        if y^.readOnly then Buf.add(ADR(line), '%'); else Buf.add(ADR(line), ' '); end;
        if (y^.kind = Core.File) and (y^.path.len > 0) and Text.changed(ADR(y^.t)) then
            Buf.add(ADR(line), '*');
        else
            Buf.add(ADR(line), ' ');
        end;
        Buf.add(ADR(line), ' ');
        Buf.str(ADR(line), Buf.bytes(ADR(y^.name)));
        Buf.reset(ADR(Core.tmp));
        Fmt.write(ADR(Core.tmp), "{}", [Fmt.int(Text.len(ADR(y^.t)))]);
        pad(27 - Core.tmp.len);
        Buf.add(ADR(line), ' ');
        Buf.str(ADR(line), Buf.bytes(ADR(Core.tmp)));
        pad(31);
        m := "Fundamental";
        if y^.kind = Core.Directory then m := "Dired";
        elsif y^.kind = Core.List then m := "Buffer Menu";
        elsif y^.coloured then m := "Raz";
        end;
        Buf.str(ADR(line), m);
        pad(44);
        Core.abbreviate(Buf.bytes(ADR(y^.path)), ADR(line));
        while (line.len > 0) and (Buf.bytes(ADR(line))[line.len - 1] = ' ') do DEC(line.len); end;
        Buf.add(ADR(line), '\n');
        Core.insert(Core.size(), Buf.bytes(ADR(line)));
        y := y^.next;
    end;
    Core.delete(Core.size() - 1, 1);
    Text.written(ADR(x^.t));
    Core.b := saved;
end;

(* The point on line l of the list, on the name. *)
proc toLine(l: I64);
var moved: I64;
begin
    Core.b^.point, moved := Core.lines(0, l);
    if Core.lineEnd(Core.b^.point) - Core.b^.point >= 5 then INC(Core.b^.point, 5); end;
end;

(* C-x C-b: the list of buffers, shown, the point on its first. *)
proc listBuffers*(n: I64);
var x, before: ^Core.Buffer;
begin
    before := Core.shown;
    x := Core.find("*Buffer List*");
    if x = nil then x := Core.newBuffer("*Buffer List*", Core.List); end;
    x^.readOnly := true;
    Core.show(x);
    fill(x, before);
    toLine(1);
end;

(* The buffer on the point's line, or nil. *)
proc here: ^Core.Buffer;
var i: I64;
begin
    i := Text.lineOf(ADR(Core.b^.t), Core.b^.point) - 1;
    if (i < 0) or (i >= numListed) then return nil; end;
    return listed[i];
end;

(* The mark of the point's line set to c, and the point to the next. *)
proc mark(c: []U8);
var s: I64;
begin
    if here() = nil then return; end;
    s := Core.lineStart(Core.b^.point);
    Core.delete(s, 1);
    Core.insert(s, c);
    if Core.lineEnd(s) < Core.size() then Core.b^.point := Core.lineEnd(s) + 6; end;
    Text.written(ADR(Core.b^.t));
end;

proc bufferMenuThisWindow*(n: I64);
var x: ^Core.Buffer;
begin
    x := here();
    if x # nil then Core.show(x); end;
end;

proc bufferMenuDelete*(n: I64);
begin
    mark("D");
end;

proc bufferMenuUnmark*(n: I64);
begin
    mark(" ");
end;

(* Kills x, asking first if it has unsaved changes; false if not. *)
proc killBuffer*(x: ^Core.Buffer): BOOL;
var saved: ^Core.Buffer;
begin
    if (x^.kind = Core.File) and (x^.path.len > 0) and Text.changed(ADR(x^.t)) then
        Buf.reset(ADR(line));
        Fmt.write(ADR(line), "Buffer {} modified; kill anyway? (yes or no) ", [Fmt.str(Buf.bytes(ADR(x^.name)))]);
        if not Mini.yesOrNo(Buf.bytes(ADR(line))) then return false; end;
    end;
    saved := Core.b;
    Core.kill(x);
    if saved # x then Core.b := saved; end;
    return true;
end;

(* x: kills the buffers marked D, and lists them again. *)
proc bufferMenuExecute*(n: I64);
var i: I64; me: ^Core.Buffer; l: I64;
begin
    me := Core.b;
    l := Text.lineOf(ADR(me^.t), me^.point);
    for i := 0 to numListed - 1 do
        if (listed[i] # me) and (Text.at(ADR(me^.t), Text.lineAt(ADR(me^.t), i + 1)) = 'D') then
            killBuffer(listed[i]);
        end;
    end;
    Core.show(me);
    fill(me, nil);
    toLine(l);
end;

(* g: lists again what the buffer lists. *)
proc revertDir; forward;

proc revertBuffer*(n: I64);
var l: I64;
begin
    if Core.b^.kind = Core.Directory then revertDir; return; end;
    l := Text.lineOf(ADR(Core.b^.t), Core.b^.point);
    if Core.b^.kind = Core.List then fill(Core.b, nil); end;
    toLine(l);
end;

(* q: the buffer shown before this one. *)
proc quitWindow*(n: I64);
begin
    Core.show(Core.other(Core.b));
end;

(* Directories *)

proc nameAt(i: I64): []U8;
var e: I64; s: []U8;
begin
    s := Buf.bytes(ADR(names));
    e := starts[i];
    while s[e] # 0 do INC(e); end;
    return s[starts[i]..e];
end;

(* The directory x lists, read again into it, with the point on line l. *)
proc fillDir(x: ^Core.Buffer; l: I64);
var saved: ^Core.Buffer; name: []U8; ok: BOOL; i, j, k, err, moved: I64; info: Sys.Info;
begin
    saved := Core.b;
    Core.b := x;
    Core.delete(0, Core.size());
    Buf.reset(ADR(line));
    Buf.str(ADR(line), "  ");
    Core.abbreviate(Buf.bytes(ADR(x^.path)), ADR(line));
    Buf.str(ADR(line), ":\n");
    Core.insert(0, Buf.bytes(ADR(line)));
    Buf.reset(ADR(names));
    numNames := 0;
    if Sys.openDir(ADR(dir), Buf.bytes(ADR(x^.path))) = 0 then
        name, ok := Sys.nextEntry(ADR(dir));
        while ok and (numNames < MaxEntries) do
            k := names.len;
            Buf.str(ADR(names), name);
            Buf.add(ADR(names), 0);
            i := numNames;
            starts[i] := k;
            while (i > 0) and (Str.cmp(nameAt(i - 1), name) > 0) do
                starts[i] := starts[i - 1];
                DEC(i);
            end;
            starts[i] := k;
            INC(numNames);
            name, ok := Sys.nextEntry(ADR(dir));
        end;
        Sys.closeDir(ADR(dir));
    end;
    Core.insert(Core.size(), "  d          -  ..");
    for j := 0 to numNames - 1 do
        Buf.reset(ADR(path));
        Buf.str(ADR(path), Buf.bytes(ADR(x^.path)));
        if path.len > 1 then Buf.add(ADR(path), '/'); end;
        Buf.str(ADR(path), nameAt(j));
        info, err := Sys.info(Buf.bytes(ADR(path)));
        Buf.reset(ADR(Core.tmp));
        if info.dir then
            Buf.add(ADR(Core.tmp), '-');
        else
            Fmt.write(ADR(Core.tmp), "{}", [Fmt.int(info.size)]);
        end;
        Buf.reset(ADR(line));
        if info.dir then Buf.str(ADR(line), "  d"); else Buf.str(ADR(line), "  -"); end;
        pad(Name - 2 - Core.tmp.len);
        Buf.str(ADR(line), Buf.bytes(ADR(Core.tmp)));
        pad(Name);
        Buf.str(ADR(line), nameAt(j));
        Core.insert(Core.size(), "\n");
        Core.insert(Core.size(), Buf.bytes(ADR(line)));
    end;
    Text.written(ADR(x^.t));
    x^.point, moved := Core.lines(0, l);
    if Core.lineEnd(x^.point) - x^.point >= Name then INC(x^.point, Name); end;
    Core.b := saved;
end;

(* A buffer listing the directory at path, absolute: the one there is,
   or a new one. *)
proc open*(path: []U8): ^Core.Buffer;
var x: ^Core.Buffer; i: I64;
begin
    x := Core.visiting(path);
    if x # nil then return x; end;
    i := LEN(path);
    while (i > 1) and (path[i - 1] # '/') do DEC(i); end;
    if LEN(path) = 1 then i := 0; end;
    x := Core.newBuffer(path[i..LEN(path)], Core.Directory);
    Buf.str(ADR(x^.path), path);
    x^.readOnly := true;
    fillDir(x, 2);
    return x;
end;

(* The path of the entry on the point's line, into path; false if the
   line has none. *)
proc entry: BOOL;
var s: I64;
begin
    s := Core.lineStart(Core.b^.point);
    if (s = 0) or (Core.lineEnd(s) - s <= Name) then return false; end;
    Buf.reset(ADR(given));
    Buf.str(ADR(given), Buf.bytes(ADR(Core.b^.path)));
    Buf.add(ADR(given), '/');
    Buf.str(ADR(given), Core.slice(s + Name, Core.lineEnd(s)));
    Core.absolute(Buf.bytes(ADR(given)), ADR(path));
    return true;
end;

proc diredFindFile*(n: I64);
var x: ^Core.Buffer;
begin
    if not entry() then return; end;
    x := Core.visit(Buf.bytes(ADR(path)));
    if x # nil then Core.show(x); end;
end;

proc diredUpDirectory*(n: I64);
var x: ^Core.Buffer;
begin
    Buf.reset(ADR(given));
    Buf.str(ADR(given), Buf.bytes(ADR(Core.b^.path)));
    Buf.str(ADR(given), "/..");
    Core.absolute(Buf.bytes(ADR(given)), ADR(path));
    x := open(Buf.bytes(ADR(path)));
    Core.show(x);
end;

(* n and p: the next line, or the last, on its name. *)
proc diredNextLine*(n: I64);
var moved: I64;
begin
    Core.b^.point, moved := Core.lines(Core.b^.point, n);
    if Core.lineEnd(Core.b^.point) - Core.b^.point >= Name then INC(Core.b^.point, Name); end;
end;

proc diredPreviousLine*(n: I64);
begin
    diredNextLine(-n);
end;

(* g in a directory: read again, the point on the same line. *)
proc revertDir;
begin
    fillDir(Core.b, Text.lineOf(ADR(Core.b^.t), Core.b^.point));
end;

(* Reads a path into path, after prompt, starting with the directory. *)
proc ask(prompt: []U8): BOOL;
begin
    Buf.reset(ADR(line));
    Core.directory(Core.b, ADR(line));
    if not Mini.read(prompt, Buf.bytes(ADR(line)), ADR(given)) then return false; end;
    Core.absolute(Buf.bytes(ADR(given)), ADR(path));
    return true;
end;

proc diredCreateDirectory*(n: I64);
begin
    if not ask("Create directory: ") then return; end;
    if Sys.makeDir(Buf.bytes(ADR(path))) # 0 then
        Fmt.write(ADR(Core.echo), "Can't make {}", [Fmt.str(Buf.bytes(ADR(path)))]);
    end;
    revertDir;
end;

proc diredDoRename*(n: I64);
var old: Buf.Buf; s: I64;
begin
    if not entry() then return; end;
    Buf.init(ADR(old), Heap.heap);
    defer Buf.done(ADR(old));
    Buf.str(ADR(old), Buf.bytes(ADR(path)));
    s := Core.lineStart(Core.b^.point);
    Buf.reset(ADR(line));
    Fmt.write(ADR(line), "Rename {} to: ", [Fmt.str(Core.slice(s + Name, Core.lineEnd(s)))]);
    if not ask(Buf.bytes(ADR(line))) then return; end;
    if Sys.rename(Buf.bytes(ADR(old)), Buf.bytes(ADR(path))) # 0 then
        Fmt.write(ADR(Core.echo), "Can't rename to {}", [Fmt.str(Buf.bytes(ADR(path)))]);
    end;
    revertDir;
end;

proc diredDoDelete*(n: I64);
var s: I64;
begin
    if not entry() then return; end;
    s := Core.lineStart(Core.b^.point);
    if Core.at(s + 2) = 'd' then Core.message("Only files can be deleted here"); return; end;
    Buf.reset(ADR(line));
    Fmt.write(ADR(line), "Delete {}? (yes or no) ", [Fmt.str(Core.slice(s + Name, Core.lineEnd(s)))]);
    if not Mini.yesOrNo(Buf.bytes(ADR(line))) then return; end;
    if Sys.remove(Buf.bytes(ADR(path))) # 0 then Core.message("Can't delete it"); end;
    revertDir;
end;

(* C-x d: a directory, named in the minibuffer, listed. *)
proc dired*(n: I64);
var x: ^Core.Buffer; info: Sys.Info; err: I64;
begin
    if not ask("Dired (directory): ") then return; end;
    info, err := Sys.info(Buf.bytes(ADR(path)));
    if (err # 0) or not info.dir then
        Fmt.write(ADR(Core.echo), "No such directory: {}", [Fmt.str(Buf.bytes(ADR(path)))]);
        return;
    end;
    x := open(Buf.bytes(ADR(path)));
    Core.show(x);
end;

begin
    Buf.init(ADR(line), Heap.heap);
    Buf.init(ADR(names), Heap.heap);
    Buf.init(ADR(path), Heap.heap);
    Buf.init(ADR(given), Heap.heap);
end Dired.
