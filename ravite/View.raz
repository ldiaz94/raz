(* View: the screen, drawn into one buffer, to be written at once: a
   row for each line from the top, the mode line, and the echo area.
   Or the same as plain text, for the tests.

   A line is shown from column left on; a tab reaches to the next
   multiple of the tab width, a control character shows as ^ and a
   letter, and every other code point takes one column. Long lines
   don't wrap.

   Depends on: Text, Buf, Fmt.
   Leaves out: wide characters, and drawing only what changed: the
   whole screen is written each time, which a terminal takes in well
   under a millisecond. *)
module View;
import Buf, Fmt, Text;

type
    Frame* = record
        t*: ^Text.Text;
        cols*, rows*: I64;     (* the screen's size *)
        top*: I64;             (* where the text starts: a line's start *)
        left*: I64;            (* the first column shown *)
        cursor*: I64;          (* in the text *)
        cursorColumn*: I64;    (* its column in its line *)
        tabWidth*: I64;
        selLo*, selHi*: I64;   (* the region, shown, from selLo up to selHi *)
        colours*: []U8;        (* a colour for each byte from top on, or none *)
        colour*: BOOL;         (* colour at all *)
        modeLine*: []U8;
        echo*: []U8;           (* the last line *)
        echoCursor*: I64;      (* the cursor's column on the last line, or -1 *)
    end;

(* The escape sequence of each colour: plain, reserved words, basic
   types, built-ins, constants, numbers, strings, comments. *)
proc sgr(c: I64): []U8;
begin
    if c = 1 then return "\x1b[0;33m";
    elsif c = 2 then return "\x1b[0;32m";
    elsif c = 3 then return "\x1b[0;36m";
    elsif (c = 4) or (c = 5) then return "\x1b[0;35m";
    elsif c = 6 then return "\x1b[0;31m";
    elsif c = 7 then return "\x1b[0;34m";
    end;
    return "\x1b[0m";
end;

(* How many bytes the character starting with byte c takes. *)
proc bytes(c: U8): I64;
begin
    if c >= 0F0H then return 4;
    elsif c >= 0E0H then return 3;
    elsif c >= 0C0H then return 2;
    end;
    return 1;
end;

(* One line, from pos, as a row of the screen. *)
proc row(f: ^Frame; out: ^Buf.Buf; pos: I64; plain: BOOL);
var e, col, w, n, i, attr, a: I64; c: U8; caret: [2]U8;
begin
    e := Text.lineEnd(f^.t, pos);
    col := 0;
    attr := 0;
    while (pos < e) and (col < f^.left + f^.cols) do
        c := Text.at(f^.t, pos);
        n := bytes(c);
        if pos + n > e then n := e - pos; end;
        w := 1;
        if c = '\t' then w := f^.tabWidth - col mod f^.tabWidth;
        elsif (c < 32) or (c = 127) then w := 2;
        end;
        if not plain then
            a := 0;
            if pos - f^.top < LEN(f^.colours) then a := I64(f^.colours[pos - f^.top]); end;
            if (pos >= f^.selLo) and (pos < f^.selHi) then a := a + 16; end;
            if (a # attr) and (col >= f^.left) then
                Buf.str(out, sgr(a and 15));
                if a >= 16 then Buf.str(out, "\x1b[7m"); end;
                attr := a;
            end;
        end;
        if (col >= f^.left) and (col + w <= f^.left + f^.cols) then
            if c = '\t' then
                for i := 1 to w do Buf.add(out, ' '); end;
            elsif w = 2 then
                caret[0] := '^';
                caret[1] := c xor 40H;
                Buf.str(out, caret);
            else
                Buf.str(out, Text.slice(f^.t, pos, pos + n));
            end;
        end;
        INC(col, w);
        INC(pos, n);
    end;
    if attr # 0 then Buf.str(out, "\x1b[0m"); end;
end;

(* s, cut to the screen's width. *)
proc fit(f: ^Frame; s: []U8): []U8;
begin
    if LEN(s) > f^.cols then return s[0..f^.cols]; end;
    return s;
end;

(* The frame drawn into out: with escape sequences, ready for the
   terminal; or plain, as lines of text with nothing past their ends. *)
proc draw*(f: ^Frame; out: ^Buf.Buf; plain: BOOL);
var r, pos, n, cr, cc, i: I64; s: []U8;
begin
    if not plain then Buf.str(out, "\x1b[?25l\x1b[H"); end;
    pos := f^.top;
    n := Text.len(f^.t);
    cr := 0;
    for r := 0 to f^.rows - 3 do
        if pos <= n then
            if (f^.cursor >= pos) and (f^.cursor <= Text.lineEnd(f^.t, pos)) then cr := r; end;
            row(f, out, pos, plain);
            pos := Text.lineEnd(f^.t, pos) + 1;
        end;
        if plain then Buf.add(out, '\n'); else Buf.str(out, "\x1b[K\r\n"); end;
    end;
    s := fit(f, f^.modeLine);
    if plain then
        Buf.str(out, s);
        Buf.add(out, '\n');
        Buf.str(out, fit(f, f^.echo));
        Buf.add(out, '\n');
        return;
    end;
    Buf.str(out, "\x1b[7m");
    Buf.str(out, s);
    for i := LEN(s) + 1 to f^.cols do Buf.add(out, ' '); end;
    Buf.str(out, "\x1b[0m\r\n");
    Buf.str(out, fit(f, f^.echo));
    Buf.str(out, "\x1b[K");
    if f^.echoCursor >= 0 then
        cr := f^.rows - 1;
        cc := f^.echoCursor;
        if cc >= f^.cols then cc := f^.cols - 1; end;
    else
        cc := f^.cursorColumn - f^.left;
    end;
    Fmt.write(out, "\x1b[{};{}H\x1b[?25h", [Fmt.int(cr + 1), Fmt.int(cc + 1)]);
end;

end View.
