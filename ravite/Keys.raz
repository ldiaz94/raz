(* Keys: the keys ravite reads. A key is a code point, a control
   character among them (C-a is 1), or one of the special keys below,
   which lie past the last code point; Meta adds 1000000H to any of
   them. decode takes the bytes a terminal sends for a key, ESC and a
   key being that key with Meta. notation reads keys written as emacs
   writes them, C-x C-s and M-%, for the tests and the settings; name
   writes one so.

   Depends on: Buf, to write names; Rt, for its test.
   Leaves out: modifiers on special keys (C-<up> is <up>), function
   keys, and the mouse. *)
module Keys;
import Buf, Heap, Rt;

const
    Tab* = 9;
    Enter* = 13;
    Esc* = 27;
    Backspace* = 127;
    Up* = 110001H;
    Down* = 110002H;
    Right* = 110003H;
    Left* = 110004H;
    Home* = 110005H;
    End* = 110006H;
    PageUp* = 110007H;
    PageDown* = 110008H;
    Delete* = 110009H;
    Insert* = 11000AH;
    Unknown* = 11000BH;   (* a sequence decode doesn't know *)
    Meta* = 1000000H;

(* Control and c: ctrl('x') is C-x, 24; ctrl(' ') is C-SPC, 0. *)
proc ctrl*(c: I64): I64;
begin
    if (c >= 'a') and (c <= 'z') then c := c - 32; end;
    if c = '/' then return 31; end;
    if c = '?' then return 127; end;
    return c and 1FH;
end;

proc meta*(k: I64): I64;
begin
    return k or Meta;
end;

(* An escape sequence at the start of b, ESC [ ... or ESC O x. *)
proc decode*(b: []U8): (I64, I64); forward;

proc escape(b: []U8): (I64, I64);
var i, n, k: I64; c: U8;
begin
    if LEN(b) = 1 then return 0, 0; end;
    if b[1] = 'O' then
        if LEN(b) = 2 then return 0, 0; end;
        c := b[2];
        if c = 'A' then return Up, 3;
        elsif c = 'B' then return Down, 3;
        elsif c = 'C' then return Right, 3;
        elsif c = 'D' then return Left, 3;
        elsif c = 'H' then return Home, 3;
        elsif c = 'F' then return End, 3;
        end;
        return Meta + 'O', 2;
    end;
    if b[1] = Esc then return Esc, 1; end;
    if b[1] # '[' then
        (* ESC and a key: the key with Meta *)
        k, n := decode(b[1..LEN(b)]);
        if n = 0 then return 0, 0; end;
        return Meta + k, n + 1;
    end;
    (* parameters, digits and ;, then a final byte; only the first
       number matters *)
    i := 2;
    n := 0;
    while (i < LEN(b)) and (b[i] >= '0') and (b[i] <= '9') do
        n := n * 10 + I64(b[i] - '0');
        INC(i);
    end;
    while (i < LEN(b)) and ((b[i] >= '0') and (b[i] <= '9') or (b[i] = ';')) do INC(i); end;
    if i = LEN(b) then return 0, 0; end;
    c := b[i];
    INC(i);
    if c = 'A' then return Up, i;
    elsif c = 'B' then return Down, i;
    elsif c = 'C' then return Right, i;
    elsif c = 'D' then return Left, i;
    elsif c = 'H' then return Home, i;
    elsif c = 'F' then return End, i;
    elsif c = '~' then
        if (n = 1) or (n = 7) then return Home, i;
        elsif (n = 4) or (n = 8) then return End, i;
        elsif n = 2 then return Insert, i;
        elsif n = 3 then return Delete, i;
        elsif n = 5 then return PageUp, i;
        elsif n = 6 then return PageDown, i;
        end;
    end;
    return Unknown, i;
end;

(* The key at the start of b, and the number of bytes it takes; 0
   bytes if b holds only the start of one, and more may come. A byte
   that starts nothing valid is a key of its own, its value. *)
proc decode*(b: []U8): (I64, I64);
var c, n, k, i: I64;
begin
    if LEN(b) = 0 then return 0, 0; end;
    c := I64(b[0]);
    if c = Esc then
        k, n := escape(b);
        return k, n;
    end;
    if c < 80H then return c, 1;
    elsif c >= 0F8H then return c, 1;
    elsif c >= 0F0H then n := 4; k := c and 7;
    elsif c >= 0E0H then n := 3; k := c and 0FH;
    elsif c >= 0C0H then n := 2; k := c and 1FH;
    else return c, 1;
    end;
    if LEN(b) < n then return 0, 0; end;
    for i := 1 to n - 1 do
        if b[i] and 0C0H # 80H then return c, 1; end;
        k := k shl 6 or I64(b[i] and 3FH);
    end;
    return k, n;
end;

(* The names of keys that aren't characters, as emacs writes them, and
   what they stand for. *)
proc named(s: []U8): I64;
begin
    if s = "RET" then return Enter;
    elsif s = "SPC" then return ' ';
    elsif s = "TAB" then return Tab;
    elsif s = "DEL" then return Backspace;
    elsif s = "ESC" then return Esc;
    elsif s = "LFD" then return 10;
    elsif s = "<up>" then return Up;
    elsif s = "<down>" then return Down;
    elsif s = "<left>" then return Left;
    elsif s = "<right>" then return Right;
    elsif s = "<home>" then return Home;
    elsif s = "<end>" then return End;
    elsif s = "<prior>" then return PageUp;
    elsif s = "<next>" then return PageDown;
    elsif s = "<delete>" then return Delete;
    elsif s = "<insert>" then return Insert;
    end;
    return Unknown;
end;

(* The key one word of emacs's notation stands for: C-, M- and C-M-
   then a key, a key's name, or a single character; Unknown if the
   word is none of these. *)
proc word*(w: []U8): I64;
var mods, k, n: I64;
begin
    mods := 0;
    while (LEN(w) > 2) and (w[1] = '-') and ((w[0] = 'C') or (w[0] = 'M')) do
        if w[0] = 'C' then mods := mods or 1; else mods := mods or 2; end;
        w := w[2..LEN(w)];
    end;
    k := named(w);
    if k = Unknown then
        k, n := decode(w);
        if (n # LEN(w)) or (k >= Meta) then return Unknown; end;
    end;
    if mods and 1 # 0 then k := ctrl(k); end;
    if mods and 2 # 0 then k := k + Meta; end;
    return k;
end;

(* Gives add each key of s, written as emacs writes keys: words
   separated by blanks or line breaks, each a key as word reads it, or
   else a run of characters, each a key. *)
proc notation*(s: []U8; add: proc(k: I64));
var i, j, k, n: I64; w: []U8;
begin
    i := 0;
    while i < LEN(s) do
        if (s[i] = ' ') or (s[i] = '\n') or (s[i] = '\t') then
            INC(i);
        else
            j := i;
            while (j < LEN(s)) and (s[j] # ' ') and (s[j] # '\n') and (s[j] # '\t') do INC(j); end;
            w := s[i..j];
            k := word(w);
            if k # Unknown then
                add(k);
            else
                while LEN(w) > 0 do
                    k, n := decode(w);
                    if n = 0 then k := I64(w[0]); n := 1; end;
                    add(k);
                    w := w[n..LEN(w)];
                end;
            end;
            i := j;
        end;
    end;
end;

(* Adds k to b as emacs writes it. *)
proc name*(b: ^Buf.Buf; k: I64);
var c: [4]U8; m: BOOL;
begin
    m := k >= Meta;
    if m then k := k - Meta; end;
    if m and (k > 0) and (k < 32) and (k # Enter) and (k # Tab) and (k # Esc) then
        Buf.str(b, "C-M-");
        if k <= 26 then Buf.add(b, U8(k + 96)); else Buf.add(b, U8(k + 64)); end;
        return;
    end;
    if m then Buf.str(b, "M-"); end;
    if k = Enter then Buf.str(b, "RET");
    elsif k = ' ' then Buf.str(b, "SPC");
    elsif k = Tab then Buf.str(b, "TAB");
    elsif k = Backspace then Buf.str(b, "DEL");
    elsif k = Esc then Buf.str(b, "ESC");
    elsif k = 0 then Buf.str(b, "C-SPC");
    elsif k < 32 then
        Buf.str(b, "C-");
        if k <= 26 then Buf.add(b, U8(k + 96)); else Buf.add(b, U8(k + 64)); end;
    elsif k = Up then Buf.str(b, "<up>");
    elsif k = Down then Buf.str(b, "<down>");
    elsif k = Left then Buf.str(b, "<left>");
    elsif k = Right then Buf.str(b, "<right>");
    elsif k = Home then Buf.str(b, "<home>");
    elsif k = End then Buf.str(b, "<end>");
    elsif k = PageUp then Buf.str(b, "<prior>");
    elsif k = PageDown then Buf.str(b, "<next>");
    elsif k = Delete then Buf.str(b, "<delete>");
    elsif k = Insert then Buf.str(b, "<insert>");
    elsif k < 80H then
        Buf.add(b, U8(k));
    else
        (* a code point, as UTF-8 *)
        if k < 800H then
            c[0] := U8(0C0H or k shr 6); c[1] := U8(80H or k and 3FH);
            Buf.str(b, c[0..2]);
        elsif k < 10000H then
            c[0] := U8(0E0H or k shr 12); c[1] := U8(80H or k shr 6 and 3FH);
            c[2] := U8(80H or k and 3FH);
            Buf.str(b, c[0..3]);
        else
            c[0] := U8(0F0H or k shr 18); c[1] := U8(80H or k shr 12 and 3FH);
            c[2] := U8(80H or k shr 6 and 3FH); c[3] := U8(80H or k and 3FH);
            Buf.str(b, c);
        end;
    end;
end;

var
    got: [16]I64;   (* the keys notation gave, for the test *)
    numGot: I64;

proc keep(k: I64);
begin
    got[numGot] := k;
    INC(numGot);
end;

(* One key decoded from b: key, using n bytes. *)
proc expect(b: []U8; key, n: I64);
var k, m: I64;
begin
    k, m := decode(b);
    if (k # key) or (m # n) then Rt.stop("Keys.decode"); end;
end;

(* The module's test. *)
proc main*;
var b: Buf.Buf; i: I64;
begin
    expect("a", 'a', 1);
    expect("\x12", 18, 1);
    expect("é!", 'é', 2);
    expect("\xe2\x82", 0, 0);
    expect("\xe2\x82\xac", 20ACH, 3);
    expect("\xf0\x9f\x98\x80", 1F600H, 4);
    expect("\x80", 80H, 1);
    expect("\xc3(", 0C3H, 1);
    expect("\x1b", 0, 0);
    expect("\x1b[", 0, 0);
    expect("\x1b[A", Up, 3);
    expect("\x1bOD", Left, 3);
    expect("\x1b[5~x", PageUp, 4);
    expect("\x1b[1;5C", Right, 6);
    expect("\x1b[3~", Delete, 4);
    expect("\x1b[99~", Unknown, 5);
    expect("\x1bx", Meta + 'x', 2);
    expect("\x1b\x7f", Meta + Backspace, 2);
    expect("\x1bé", Meta + 'é', 3);
    expect("\x1b\x1b", Esc, 1);
    expect("\x1bO", 0, 0);
    if (word("C-x") # 24) or (word("M-%") # Meta + '%') or (word("C-M-a") # Meta + 1)
        or (word("C-SPC") # 0) or (word("M-DEL") # Meta + 127) or (word("C-/") # 31)
        or (word("<up>") # Up) or (word("xy") # Unknown) or (word("é") # 'é') then
        Rt.stop("Keys.word");
    end;
    notation("C-x C-f a.txt RET\nM-x SPC", keep);
    if (numGot # 10) or (got[0] # 24) or (got[1] # 6) or (got[2] # 'a') or (got[6] # 't')
        or (got[7] # Enter) or (got[8] # Meta + 'x') or (got[9] # ' ') then
        Rt.stop("Keys.notation");
    end;
    Buf.init(ADR(b), Heap.heap);
    for i := 0 to numGot - 1 do
        name(ADR(b), got[i]);
        Buf.add(ADR(b), ' ');
    end;
    name(ADR(b), Meta + 31);
    if Buf.bytes(ADR(b)) # "C-x C-f a . t x t RET M-x SPC C-M-_" then Rt.stop("Keys.name"); end;
end;

end Keys.
