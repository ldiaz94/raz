(* ravite, raz visual text editor: an editor with emacs's keys.

       ravite [file...]
   visits each file, and shows the first, or *scratch* if none.

       ravite -script W H [file...] < keys
   types the keys, written as emacs writes them (C-x C-s, M-%, RET), on
   a screen W columns by H rows; at their end, or at C-x C-c, prints
   the screen as plain text, then the buffer it shows. For the tests.

   This module reads keys, from the terminal or the script, and runs
   them; draws the screen whenever no key is waiting; and keeps the
   point on it, putting its line in the middle when it leaves, as
   emacs does.

   Depends on: Core and the modules of commands; View and Colour to
   draw; Tty for the terminal.
   Leaves out: see doc/ravite.md. *)
module Ravite;
import Sys, Rt, Buf, Fmt, Heap, Files, Text, Tty, Keys, View, Colour, Core, Commands, Dired;

var
    script: BOOL;
    keys: ^I64;           (* the script's keys *)
    numKeys, capKeys, atKey: I64;
    pending: [256]U8;     (* bytes read from the terminal, not yet keys *)
    have: I64;
    screen, mode, echo: Buf.Buf;
    paint: [65536]U8;     (* the colours of the screen's bytes, as far as they go *)

(* The screen *)

proc textRows: I64;
begin
    return Core.rows - 2;
end;

(* The window's top moved so that the point is in it: its line halfway
   down if it had left. *)
proc scroll(x: ^Core.Buffer);
var n, moved, c: I64; saved: ^Core.Buffer;
begin
    saved := Core.b;
    Core.b := x;
    if x^.top > Core.size() then x^.top := Core.lineStart(Core.size()); end;
    x^.top := Core.lineStart(x^.top);
    n := Text.count(ADR(x^.t), x^.top, x^.point);
    if (x^.point < x^.top) or (n >= textRows()) then
        x^.top, moved := Core.lines(x^.point, -(textRows() div 2));
    end;
    c := Core.column(x^.point);
    if c < x^.left then x^.left := c; end;
    if c >= x^.left + Core.cols - 1 then x^.left := c - Core.cols + 2; end;
    if c < Core.cols - 1 then x^.left := 0; end;
    Core.b := saved;
end;

(* The colours of the bytes on the screen, as far as paint goes. The
   depth of comment at the top is counted from where it was last known
   if no change came before that, else from the start. *)
proc colours(x: ^Core.Buffer): []U8;
var e, d, moved: I64;
begin
    if not x^.coloured or not Core.colour then return ""; end;
    if (x^.t.low < x^.known) or (x^.known > x^.top) then
        x^.known := 0;
        x^.knownDepth := 0;
    end;
    x^.t.low := 1 shl 40;
    d := Colour.depth(Text.slice(ADR(x^.t), x^.known, x^.top), x^.knownDepth);
    x^.known := x^.top;
    x^.knownDepth := d;
    e := x^.top;
    for moved := 1 to textRows() do
        if e < Text.len(ADR(x^.t)) then e := Text.lineEnd(ADR(x^.t), e) + 1; end;
    end;
    if e > Text.len(ADR(x^.t)) then e := Text.len(ADR(x^.t)); end;
    if e - x^.top > LEN(paint) then e := x^.top + LEN(paint); end;
    Colour.paint(Text.slice(ADR(x^.t), x^.top, e), d, paint[0..e - x^.top]);
    return paint[0..e - x^.top];
end;

(* The mode line of x, as emacs's: -UU-:**-  name   Top L12   (Raz) *)
proc modeLine(x: ^Core.Buffer);
var n, i: I64; m: []U8;
begin
    Buf.reset(ADR(mode));
    Buf.str(ADR(mode), "-UU-:");
    if x^.readOnly then Buf.str(ADR(mode), "%%");
    elsif Text.changed(ADR(x^.t)) and (x^.kind = Core.File) then Buf.str(ADR(mode), "**");
    else Buf.str(ADR(mode), "--");
    end;
    Buf.str(ADR(mode), "-  ");
    Buf.str(ADR(mode), Buf.bytes(ADR(x^.name)));
    for i := mode.len to 22 do Buf.add(ADR(mode), ' '); end;
    Buf.str(ADR(mode), "   ");
    n := Text.len(ADR(x^.t));
    if (x^.top = 0) and (Text.count(ADR(x^.t), 0, n) < textRows()) then Buf.str(ADR(mode), "All");
    elsif x^.top = 0 then Buf.str(ADR(mode), "Top");
    elsif Text.count(ADR(x^.t), x^.top, n) < textRows() then Buf.str(ADR(mode), "Bot");
    else Fmt.write(ADR(mode), "{}%", [Fmt.int(x^.top * 100 div n)]);
    end;
    Fmt.write(ADR(mode), " L{}   ", [Fmt.int(Text.lineOf(ADR(x^.t), x^.point) + 1)]);
    m := "(Fundamental)";
    if x^.kind = Core.Directory then m := "(Dired)";
    elsif x^.kind = Core.List then m := "(Buffer Menu)";
    elsif x^.coloured then m := "(Raz)";
    end;
    Buf.str(ADR(mode), m);
    Buf.add(ADR(mode), ' ');
    for i := mode.len to Core.cols - 1 do Buf.add(ADR(mode), '-'); end;
end;

(* The columns s takes: its characters. *)
proc width(s: []U8): I64;
var i, n: I64;
begin
    n := 0;
    for i := 0 to LEN(s) - 1 do
        if s[i] and 0C0H # 80H then INC(n); end;
    end;
    return n;
end;

(* The screen as it stands, drawn into screen. *)
proc frame(plain: BOOL);
var f: View.Frame; x: ^Core.Buffer; saved: ^Core.Buffer; c: I64;
begin
    x := Core.shown;
    scroll(x);
    modeLine(x);
    saved := Core.b;
    Core.b := x;
    f := {t: ADR(x^.t), cols: Core.cols, rows: Core.rows, top: x^.top, left: x^.left,
        cursor: x^.point, cursorColumn: Core.column(x^.point), tabWidth: Core.tabWidth,
        colour: Core.colour, modeLine: Buf.bytes(ADR(mode)), echoCursor: -1};
    Core.b := saved;
    if Core.litEnd > Core.lit then
        f.selLo := Core.lit;
        f.selHi := Core.litEnd;
    elsif x^.active and x^.hasMark then
        f.selLo := x^.mark;
        f.selHi := x^.point;
        if x^.point < x^.mark then f.selLo := x^.point; f.selHi := x^.mark; end;
    end;
    if not plain then f.colours := colours(x); end;
    Buf.reset(ADR(echo));
    if Core.miniOpen then
        Buf.str(ADR(echo), Buf.bytes(ADR(Core.prompt)));
        c := width(Buf.bytes(ADR(echo)));
        Core.b := Core.mini;
        Buf.str(ADR(echo), Text.slice(ADR(Core.mini^.t), 0, Text.len(ADR(Core.mini^.t))));
        f.echoCursor := c + Core.column(Core.mini^.point);
        Core.b := saved;
        Buf.str(ADR(echo), Buf.bytes(ADR(Core.after)));
        if Core.echo.len > 0 then
            Buf.str(ADR(echo), " [");
            Buf.str(ADR(echo), Buf.bytes(ADR(Core.echo)));
            Buf.str(ADR(echo), "]");
        end;
    else
        Buf.str(ADR(echo), Buf.bytes(ADR(Core.echo)));
    end;
    f.echo := Buf.bytes(ADR(echo));
    Buf.reset(ADR(screen));
    View.draw(ADR(f), ADR(screen), plain);
end;

proc redraw;
begin
    Core.cols, Core.rows := Tty.termSize(Sys.stdout);
    if Core.cols < 20 then Core.cols := 20; end;
    if Core.rows < 4 then Core.rows := 4; end;
    frame(false);
    Core.writeAll(Sys.stdout, Buf.bytes(ADR(screen)));
end;

(* The end of a script: the screen and the buffer shown, printed. *)
proc finish;
begin
    frame(true);
    Core.writeAll(Sys.stdout, Buf.bytes(ADR(screen)));
    Core.writeAll(Sys.stdout, Text.slice(ADR(Core.shown^.t), 0, Text.len(ADR(Core.shown^.t))));
    Rt.exit(0);
end;

(* Keys *)

(* A key of the script, kept. *)
proc addKey(k: I64);
var p: ^I64; i: I64;
begin
    if numKeys = capKeys then
        capKeys := capKeys * 2 + 256;
        p := ^I64(Heap.heap^.alloc(Heap.heap, capKeys * 8, 8));
        if p = nil then Rt.stop("ravite: out of memory"); end;
        for i := 0 to numKeys - 1 do p[i] := keys[i]; end;
        keys := p;
    end;
    keys[numKeys] := k;
    INC(numKeys);
end;

(* Reads what the terminal has sent within ms milliseconds, forever if
   ms < 0; false if nothing came. *)
proc fill(ms: I64): BOOL;
var n: I64;
begin
    if (have = LEN(pending)) or not Tty.ready(Sys.stdin, ms) then return false; end;
    n := Sys.read(Sys.stdin, pending[have..LEN(pending)]);
    if n = -4 then return false; end;   (* -EINTR *)
    if n <= 0 then Rt.exit(1); end;     (* the terminal is gone *)
    INC(have, n);
    return true;
end;

(* The next key: of the script, or from the terminal, drawing the
   screen first when nothing is waiting, and again when its size
   changes. An escape that nothing follows within 30 ms is ESC. *)
proc nextKey: I64;
var k, n, i, c, r: I64;
begin
    if script then
        if atKey = numKeys then finish; end;
        INC(atKey);
        return keys[atKey - 1];
    end;
    if have = 0 then
        redraw;
        while not fill(250) do
            c, r := Tty.termSize(Sys.stdout);
            if (c # Core.cols) or (r # Core.rows) then redraw; end;
        end;
    end;
    k, n := Keys.decode(pending[0..have]);
    while n = 0 do
        if fill(30) then
            k, n := Keys.decode(pending[0..have]);
        else
            k := I64(pending[0]);
            n := 1;
        end;
    end;
    for i := n to have - 1 do pending[i - n] := pending[i]; end;
    DEC(have, n);
    return k;
end;

proc restore;
begin
    Sys.write(Sys.stdout, "\x1b[?25h\x1b[?1049l");
    Tty.restoreMode(Sys.stdin);
end;

(* Reads the arguments: -script and its size, then the files. *)
proc arguments: I64;
var i, n: I64; s: []U8;
begin
    i := 1;
    if (ARGC() >= 4) and (Files.arg(1) = "-script") then
        script := true;
        Core.cols := 0;
        Core.rows := 0;
        s := Files.arg(2);
        for n := 0 to LEN(s) - 1 do Core.cols := Core.cols * 10 + I64(s[n] - '0'); end;
        s := Files.arg(3);
        for n := 0 to LEN(s) - 1 do Core.rows := Core.rows * 10 + I64(s[n] - '0'); end;
        i := 4;
    end;
    return i;
end;

proc main*: I64;
var i, n: I64; b: Buf.Buf; chunk: [4096]U8; dir: [4096]U8; x, first: ^Core.Buffer;
begin
    Buf.init(ADR(screen), Heap.heap);
    Buf.init(ADR(mode), Heap.heap);
    Buf.init(ADR(echo), Heap.heap);
    Buf.init(ADR(b), Heap.heap);
    Buf.str(ADR(Core.home), Tty.env("HOME"));
    n := Tty.workDir(dir);
    if n > 0 then Buf.str(ADR(Core.cwd), dir[0..n]); else Buf.add(ADR(Core.cwd), '/'); end;
    Core.colour := LEN(Tty.env("NO_COLOR")) = 0;
    Core.nextKey := nextKey;
    Core.runKey := Commands.runKey;
    Core.openDir := Dired.open;
    Core.mini := Core.newBuffer(" *Minibuf*", Core.Mini);
    Core.show(Core.newBuffer("*scratch*", Core.File));
    i := arguments();
    first := nil;
    while i < ARGC() do
        Core.absolute(Files.arg(i), ADR(b));
        x := Core.visit(Buf.bytes(ADR(b)));
        if (x # nil) and (first = nil) then first := x; end;
        INC(i);
    end;
    if first # nil then Core.show(first); end;
    if script then
        Buf.reset(ADR(b));
        repeat
            n := Sys.read(Sys.stdin, chunk);
            if n > 0 then Buf.str(ADR(b), chunk[0..n]); end;
        until n <= 0;
        Keys.notation(Buf.bytes(ADR(b)), addKey);
    else
        if not Tty.rawMode(Sys.stdin) then
            Sys.write(Sys.stderr, "ravite: not a terminal\n");
            return 1;
        end;
        Rt.atExit(restore);
        Sys.write(Sys.stdout, "\x1b[?1049h");
    end;
    while not Core.quitting do
        Core.b := Core.shown;
        n := nextKey();
        Buf.reset(ADR(Core.echo));
        Commands.runKey(n);
        scroll(Core.shown);   (* as drawing would, between keys of a script too *)
    end;
    if script then finish; end;
    return 0;
end;

end Ravite.
