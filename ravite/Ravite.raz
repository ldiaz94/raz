(* ravite, raz visual text editor: a small editor with vim's keys.

       ravite file
   edits file.

       ravite -script W H file < keys
   runs the keys, written in vim's notation (<esc>, <c-r>), on a screen
   W columns by H rows, as if typed; at their end, or at :q, prints the
   screen as plain text, then the text. For the tests.

   Normal mode takes a count, then a command. An operator, d c y > or
   <, then takes a motion, or itself for whole lines. Insert mode types
   until Escape. The command line runs :w, :q and the like. Every
   delete and yank fills the one register. A command, with all it
   types in insert mode, is one step of undo, and what . repeats: its
   keys are kept, and . plays them again.

   Depends on: Tty, Keys, Text and View; Files for the arguments; Scan
   for what a word is.
   Leaves out: see doc/ravite.md. *)
module Ravite;
import Sys, Rt, Buf, Fmt, Heap, Files, Scan, Tty, Keys, Text, View, Colour;

const
    Normal = 0;
    Insert = 1;
    Visual = 2;
    VisualLine = 3;
    MaxKeys = 4096;      (* the keys of a change . can repeat *)
    Far = 1 shl 40;      (* a column past every line's end, for $ *)

type
    Motion = record
        pos: I64;          (* where it goes *)
        lines: BOOL;       (* it covers whole lines *)
        inclusive: BOOL;   (* the character at pos is in what it covers *)
        ok: BOOL;          (* it could go *)
    end;

var
    t: Text.Text;
    path: []U8;
    eol: BOOL;            (* the file ends with a line break *)
    cur: I64;             (* the cursor *)
    want: I64;            (* the column up and down keep to *)
    top, left: I64;       (* where the screen starts, and its first column *)
    cols, rows: I64;
    mode: I64;
    msg, cmd, reg, tmp, screen, status, ruler: Buf.Buf;
    regLines: BOOL;       (* the register holds whole lines *)
    prompting: BOOL;      (* the command line is open *)
    lead: U8;             (* its first character, : / or ? *)
    didChange: BOOL;      (* the command under way changed the text *)

    (* the keys of the command under way, of the last change, and of
       the change . is playing *)
    rec, last, replay: [MaxKeys]I64;
    numRec, numLast, numReplay, atReplay: I64;
    again: [MaxKeys]I64;   (* what insert mode typed, to type again for a count *)
    numAgain, atAgain: I64;
    recording, recFull: BOOL;

    script: BOOL;
    keys: ^I64;           (* the script's keys *)
    numKeys, capKeys, atKey: I64;
    pending: [256]U8;     (* bytes read from the terminal, not yet keys *)
    have: I64;

    colour: BOOL;         (* colour isn't turned off *)
    coloured: BOOL;       (* the file is raz, and in colour *)
    paint: [65536]U8;     (* the colours of the screen's bytes, as far as they go *)
    known, knownDepth: I64;   (* the depth of comment at position known *)

proc size: I64;
begin
    return Text.len(ADR(t));
end;

proc at(p: I64): U8;
begin
    return Text.at(ADR(t), p);
end;

proc lineStart(p: I64): I64;
begin
    return Text.lineStart(ADR(t), p);
end;

proc lineEnd(p: I64): I64;
begin
    return Text.lineEnd(ADR(t), p);
end;

(* The start of the character after the one at p. *)
proc next(p: I64): I64;
begin
    if p >= size() then return p; end;
    INC(p);
    while (p < size()) and (at(p) and 0C0H = 80H) do INC(p); end;
    return p;
end;

(* The start of the character before p. *)
proc prev(p: I64): I64;
begin
    if p <= 0 then return 0; end;
    DEC(p);
    while (p > 0) and (at(p) and 0C0H = 80H) do DEC(p); end;
    return p;
end;

proc isBlank(c: U8): BOOL;
begin
    return (c = ' ') or (c = '\t');
end;

(* The first character of the line from start that isn't blank. *)
proc firstNonBlank(start: I64): I64;
var e: I64;
begin
    e := lineEnd(start);
    while (start < e) and isBlank(at(start)) do INC(start); end;
    return start;
end;

(* p, kept off a line's end, as normal mode keeps the cursor. *)
proc onChar(p: I64): I64;
begin
    if p > size() then p := size(); end;
    if (p = lineEnd(p)) and (p > lineStart(p)) then return prev(p); end;
    return p;
end;

(* Changing the text, so that the command counts as a change. *)
proc ins(p: I64; s: []U8);
begin
    if not Text.insert(ADR(t), p, s) then Buf.str(ADR(msg), "E342: Out of memory"); end;
    didChange := true;
end;

proc del(p, n: I64);
begin
    if not Text.delete(ADR(t), p, n) then Buf.str(ADR(msg), "E342: Out of memory"); end;
    didChange := true;
end;

(* The UTF-8 of code point k, in b: the number of bytes. *)
proc utf8(k: I64; var b: [4]U8): I64;
begin
    if k < 80H then
        b[0] := U8(k);
        return 1;
    elsif k < 800H then
        b[0] := U8(0C0H or k shr 6);
        b[1] := U8(80H or k and 3FH);
        return 2;
    elsif k < 10000H then
        b[0] := U8(0E0H or k shr 12);
        b[1] := U8(80H or k shr 6 and 3FH);
        b[2] := U8(80H or k and 3FH);
        return 3;
    end;
    b[0] := U8(0F0H or k shr 18);
    b[1] := U8(80H or k shr 12 and 3FH);
    b[2] := U8(80H or k shr 6 and 3FH);
    b[3] := U8(80H or k and 3FH);
    return 4;
end;

(* Whether k is a key that types a character. *)
proc typed(k: I64): BOOL;
begin
    return (k >= 32) and (k # 127) and (k < Keys.Up);
end;

(* The screen *)

(* top and left moved so that the cursor is on the screen. *)
proc scroll;
var n, c: I64;
begin
    if top > size() then top := lineStart(size()); end;
    if cur < top then
        top := lineStart(cur);
    else
        n := Text.count(ADR(t), top, cur) - (rows - 2);
        while n > 0 do
            top := lineEnd(top) + 1;
            DEC(n);
        end;
    end;
    c := View.column(ADR(t), cur);
    if c < left then left := c; end;
    if c >= left + cols then left := c - cols + 1; end;
end;

(* The colours of the bytes on the screen, as far as paint goes. The
   depth of comment at the top is counted from where it was last
   known, if no change came before that; else from the start. *)
proc colours: []U8;
var e, i, d: I64;
begin
    if not coloured then return ""; end;
    if (t.low < known) or (known > top) then
        known := 0;
        knownDepth := 0;
    end;
    t.low := Far;
    d := Colour.depth(Text.slice(ADR(t), known, top), knownDepth);
    known := top;
    knownDepth := d;
    e := top;
    i := 1;
    while (i < rows) and (e < size()) do
        e := lineEnd(e) + 1;
        INC(i);
    end;
    if e > size() then e := size(); end;
    if e - top > LEN(paint) then e := top + LEN(paint); end;
    Colour.paint(Text.slice(ADR(t), top, e), d, paint[0..e - top]);
    return paint[0..e - top];
end;

(* The screen as it stands, drawn into the buffer screen. *)
proc frame(plain: BOOL);
var f: View.Frame;
begin
    scroll;
    Buf.reset(ADR(status));
    if prompting then
        Buf.add(ADR(status), lead);
        Buf.str(ADR(status), Buf.bytes(ADR(cmd)));
    elsif msg.len > 0 then
        Buf.str(ADR(status), Buf.bytes(ADR(msg)));
    elsif mode = Insert then
        Buf.str(ADR(status), "-- INSERT --");
    elsif mode = Visual then
        Buf.str(ADR(status), "-- VISUAL --");
    elsif mode = VisualLine then
        Buf.str(ADR(status), "-- VISUAL LINE --");
    end;
    Buf.reset(ADR(ruler));
    Buf.str(ADR(ruler), path);
    if Text.changed(ADR(t)) then Buf.str(ADR(ruler), " [+]"); end;
    Fmt.write(ADR(ruler), "  {},{}", [Fmt.int(Text.lineOf(ADR(t), cur) + 1),
        Fmt.int(View.column(ADR(t), cur) + 1)]);
    f := {t: ADR(t), cols: cols, rows: rows, top: top, left: left, cursor: cur,
        status: Buf.bytes(ADR(status)), ruler: Buf.bytes(ADR(ruler)),
        prompt: prompting, bar: mode = Insert, colour: colour};
    if not plain then f.colours := colours(); end;
    Buf.reset(ADR(screen));
    View.draw(ADR(f), ADR(screen), plain);
end;

(* Writes all of s to fd; false if it can't. *)
proc writeAll(fd: I64; s: []U8): BOOL;
var n: I64;
begin
    while LEN(s) > 0 do
        n := Sys.write(fd, s);
        if n > 0 then
            s := s[n..LEN(s)];
        elsif n # -4 then   (* -EINTR: again *)
            return false;
        end;
    end;
    return true;
end;

proc redraw;
begin
    cols, rows := Tty.size();
    if cols < 20 then cols := 20; end;
    if rows < 2 then rows := 2; end;
    frame(false);
    writeAll(Sys.stdout, Buf.bytes(ADR(screen)));
end;

(* The end of a script: the screen and the text, printed. *)
proc finish;
begin
    frame(true);
    writeAll(Sys.stdout, Buf.bytes(ADR(screen)));
    writeAll(Sys.stdout, Text.slice(ADR(t), 0, size()));
    writeAll(Sys.stdout, "\n");
    Rt.exit(0);
end;

proc quit;
begin
    if script then finish; end;
    Rt.exit(0);
end;

(* Keys *)

(* A key of the script, kept. *)
proc addKey(k: I64);
var p: ^I64; i: I64;
begin
    if numKeys = capKeys then
        capKeys := capKeys * 2 + 256;
        p := ^I64(Heap.heap^.alloc(Heap.heap, capKeys * 8, 8));
        if p = nil then Rt.stop("ravite: out of memory"); end;
        for i := 0 to numKeys - 1 do p[i] := keys[i]; end;
        keys := p;
    end;
    keys[numKeys] := k;
    INC(numKeys);
end;

(* Reads what the terminal has sent within ms milliseconds, forever
   if ms < 0; false if nothing came. *)
proc fill(ms: I64): BOOL;
var n: I64;
begin
    if (have = LEN(pending)) or not Tty.wait(ms) then return false; end;
    n := Sys.read(Sys.stdin, pending[have..LEN(pending)]);
    if n = -4 then return false; end;   (* -EINTR *)
    if n <= 0 then Rt.exit(1); end;     (* the terminal is gone *)
    INC(have, n);
    return true;
end;

(* The next key from the terminal. The screen is drawn first when
   nothing is waiting, and again when its size changes. An escape that
   nothing follows within 30 ms is the Escape key. *)
proc readKey: I64;
var k, n, i, c, r: I64;
begin
    if have = 0 then
        redraw;
        while not fill(250) do
            c, r := Tty.size();
            if (c # cols) or (r # rows) then redraw; end;
        end;
    end;
    k, n := Keys.decode(pending[0..have]);
    while n = 0 do
        if fill(30) then
            k, n := Keys.decode(pending[0..have]);
        else
            k := I64(pending[0]);
            n := 1;
        end;
    end;
    for i := n to have - 1 do pending[i - n] := pending[i]; end;
    DEC(have, n);
    return k;
end;

(* The next key: of the change . is playing, of the script, or from
   the terminal; kept, while a command is under way, for . to play. *)
proc nextKey: I64;
var k: I64;
begin
    if atAgain < numAgain then
        k := again[atAgain];
        INC(atAgain);
        return k;
    elsif atReplay < numReplay then
        k := replay[atReplay];
        INC(atReplay);
    elsif script then
        if atKey = numKeys then finish; end;
        k := keys[atKey];
        INC(atKey);
    else
        k := readKey();
    end;
    if recording then
        if numRec < MaxKeys then
            rec[numRec] := k;
            INC(numRec);
        else
            recFull := true;
        end;
    end;
    return k;
end;

(* Motions *)

(* A character's class, for words: blank, part of a name, or other. *)
proc class(c: U8): I64;
begin
    if isBlank(c) or (c = '\n') then return 0; end;
    if Scan.isWord(c) or (c >= 80H) then return 1; end;
    return 2;
end;

(* Whether p starts an empty line. *)
proc emptyLine(p: I64): BOOL;
begin
    return (lineEnd(p) = p) and (lineStart(p) = p);
end;

(* w: the start of the next word; an empty line counts as one. *)
proc wordForward(p: I64): I64;
var c: I64;
begin
    if p >= size() then return p; end;
    c := class(at(p));
    if c # 0 then
        while (p < size()) and (class(at(p)) = c) do INC(p); end;
    end;
    while (p < size()) and (class(at(p)) = 0) do
        INC(p);
        if (at(p - 1) = '\n') and emptyLine(p) then return p; end;
    end;
    return p;
end;

(* e: the last character of this word, or of the next. *)
proc wordEnd(p: I64): I64;
var c: I64;
begin
    if p + 1 >= size() then return p; end;
    INC(p);
    while (p < size() - 1) and (class(at(p)) = 0) do INC(p); end;
    c := class(at(p));
    while (p + 1 < size()) and (class(at(p + 1)) = c) do INC(p); end;
    while (p > 0) and (at(p) and 0C0H = 80H) do DEC(p); end;
    return p;
end;

(* b: the start of this word, or of the one before. *)
proc wordBack(p: I64): I64;
var c: I64;
begin
    if p = 0 then return 0; end;
    DEC(p);
    while (p > 0) and (class(at(p)) = 0) do
        if emptyLine(p) then return p; end;
        DEC(p);
    end;
    c := class(at(p));
    while (p > 0) and (class(at(p - 1)) = c) do DEC(p); end;
    return p;
end;

(* }: the next empty line past the lines with text, or the end. *)
proc paraNext(p: I64): I64;
var s, e: I64;
begin
    s := lineEnd(p) + 1;
    if s > size() then return size(); end;
    while (s < size()) and emptyLine(s) do INC(s); end;
    while true do
        e := lineEnd(s);
        if e = s then return s; end;
        if e >= size() then return e; end;
        s := e + 1;
    end;
    return s;
end;

(* {: the empty line before the lines with text above, or the start. *)
proc paraPrev(p: I64): I64;
var s: I64;
begin
    s := lineStart(p);
    if s = 0 then return 0; end;
    s := lineStart(s - 1);
    while (s > 0) and emptyLine(s) do s := lineStart(s - 1); end;
    while s > 0 do
        if emptyLine(s) then return s; end;
        s := lineStart(s - 1);
    end;
    return 0;
end;

(* The start of line n from 0, kept within the text. *)
proc line(n: I64): I64;
begin
    if n < 0 then n := 0; end;
    return Text.lineAt(ADR(t), n);
end;

(* The start of the line n lines below p's, or above it if n < 0, as
   far as the text goes; and how many lines that is, n or fewer. *)
proc lines(p, n: I64): (I64, I64);
var i, e: I64;
begin
    p := lineStart(p);
    i := 0;
    while (i < n) and (lineEnd(p) < size()) do
        p := lineEnd(p) + 1;
        INC(i);
    end;
    while (i > n) and (p > 0) do
        p := lineStart(p - 1);
        DEC(i);
    end;
    return p, i;
end;

(* Whether k moves up or down, keeping the column. *)
proc vertical(k: I64): BOOL;
begin
    return (k = 'j') or (k = 'k') or (k = Keys.Down) or (k = Keys.Up)
        or (k = Keys.ctrl('n')) or (k = Keys.ctrl('p'));
end;

(* Where motion k goes from the cursor, count times; count 0 is none
   given. *)
proc motion(k, count: I64): Motion;
var m: Motion; n, i, l: I64;
begin
    m := {pos: cur, ok: true};
    n := count;
    if n = 0 then n := 1; end;
    if (k = 'h') or (k = Keys.Left) or (k = Keys.Backspace) or (k = 8) then
        for i := 1 to n do
            if m.pos > lineStart(m.pos) then m.pos := prev(m.pos); end;
        end;
        m.ok := m.pos # cur;
    elsif (k = 'l') or (k = Keys.Right) or (k = ' ') then
        for i := 1 to n do
            if m.pos < lineEnd(m.pos) then m.pos := next(m.pos); end;
        end;
        m.ok := m.pos # cur;
    elsif vertical(k) then
        if (k = 'k') or (k = Keys.Up) or (k = Keys.ctrl('p')) then n := -n; end;
        l, i := lines(cur, n);
        m.ok := i # 0;
        m.pos := View.atColumn(ADR(t), l, want);
        m.lines := true;
    elsif (k = '0') or (k = Keys.Home) then
        m.pos := lineStart(cur);
    elsif k = '^' then
        m.pos := firstNonBlank(lineStart(cur));
    elsif (k = '$') or (k = Keys.End) then
        for i := 2 to n do
            if lineEnd(m.pos) < size() then m.pos := lineEnd(m.pos) + 1; end;
        end;
        m.pos := lineEnd(m.pos);
    elsif (k = Keys.Enter) or (k = '+') or (k = '-') then
        if k = '-' then n := -n; end;
        l, i := lines(cur, n);
        m.ok := i = n;
        m.pos := firstNonBlank(l);
        m.lines := true;
    elsif k = 'w' then
        for i := 1 to n do m.pos := wordForward(m.pos); end;
    elsif k = 'b' then
        for i := 1 to n do m.pos := wordBack(m.pos); end;
    elsif k = 'e' then
        for i := 1 to n do m.pos := wordEnd(m.pos); end;
        m.inclusive := true;
    elsif k = 'G' then
        if count = 0 then count := Text.lines(ADR(t)); end;
        m.pos := firstNonBlank(line(count - 1));
        m.lines := true;
    elsif k = 'g' then
        if nextKey() # 'g' then m.ok := false; return m; end;
        m.pos := firstNonBlank(line(n - 1));
        m.lines := true;
    elsif k = '}' then
        for i := 1 to n do m.pos := paraNext(m.pos); end;
    elsif k = '{' then
        for i := 1 to n do m.pos := paraPrev(m.pos); end;
    else
        m.ok := false;
    end;
    return m;
end;

(* The column up and down keep to, after the cursor moved by k. *)
proc keepColumn(k: I64);
begin
    if (k = '$') or (k = Keys.End) then
        want := Far;
    elsif not vertical(k) then
        want := View.column(ADR(t), cur);
    end;
end;

(* Insert mode *)

(* The blanks that start the line p is in, before p, into tmp. *)
proc indent(p: I64);
var s, e: I64;
begin
    s := lineStart(p);
    e := firstNonBlank(s);
    if e > p then e := p; end;
    Buf.str(ADR(tmp), Text.slice(ADR(t), s, e));
end;

(* Types what comes until Escape, at the cursor. *)
proc typeKeys;
var k, p, n, i: I64; b: [4]U8; m: Motion;
begin
    while true do
        k := nextKey();
        if (k = Keys.Esc) or (k = Keys.ctrl('c')) then
            break;
        elsif (k = Keys.Enter) or (k = 10) then
            Buf.reset(ADR(tmp));
            Buf.add(ADR(tmp), '\n');
            indent(cur);
            ins(cur, Buf.bytes(ADR(tmp)));
            INC(cur, tmp.len);
        elsif (k = Keys.Backspace) or (k = 8) then
            if cur > 0 then
                p := prev(cur);
                del(p, cur - p);
                cur := p;
            end;
        elsif k = Keys.ctrl('w') then
            p := wordBack(cur);
            if p < lineStart(cur) then p := lineStart(cur); end;
            if (p = cur) and (cur > 0) then p := prev(cur); end;
            del(p, cur - p);
            cur := p;
        elsif k = Keys.Delete then
            if cur < size() then del(cur, next(cur) - cur); end;
        elsif k = Keys.Tab then
            n := 4 - View.column(ADR(t), cur) mod 4;
            for i := 1 to n do ins(cur, " "); INC(cur); end;
        elsif typed(k) then
            n := utf8(k, b);
            ins(cur, b[0..n]);
            INC(cur, n);
        else
            m := motion(k, 0);
            if m.ok and (k # 'g') then
                cur := m.pos;
                keepColumn(k);
            end;
        end;
    end;
end;

proc openBelow; forward;

(* Insert mode: types what comes until Escape; then, count times in
   all, the same again, each time on a new line below if lines. *)
proc insertMode(count: I64; lines: BOOL);
var from, i: I64;
begin
    mode := Insert;
    didChange := true;
    from := numRec;
    typeKeys;
    if not recFull and (numRec - from <= MaxKeys) then
        for i := from to numRec - 1 do again[i - from] := rec[i]; end;
        for i := 2 to count do
            if lines then openBelow; end;
            numAgain := numRec - from;
            atAgain := 0;
            typeKeys;
        end;
    end;
    numAgain := 0;
    mode := Normal;
    if cur > lineStart(cur) then cur := prev(cur); end;
end;

(* Opens a line below the cursor's, with its indent, the cursor on it. *)
proc openBelow;
var p: I64;
begin
    Buf.reset(ADR(tmp));
    p := lineEnd(cur);
    Buf.add(ADR(tmp), '\n');
    indent(p);
    ins(p, Buf.bytes(ADR(tmp)));
    cur := p + tmp.len;
end;

(* o and O: count lines below the cursor's, or above it, typed in
   insert mode. *)
proc openLine(below: BOOL; count: I64);
var p: I64;
begin
    if below then
        openBelow;
    else
        p := lineStart(cur);
        Buf.reset(ADR(tmp));
        indent(lineEnd(cur));
        Buf.add(ADR(tmp), '\n');
        ins(p, Buf.bytes(ADR(tmp)));
        cur := p + tmp.len - 1;
    end;
    insertMode(count, true);
end;

(* Operators *)

(* The register holds the text from lo up to hi; whole lines if lines. *)
proc yank(lo, hi: I64; lines: BOOL);
begin
    Buf.reset(ADR(reg));
    Buf.str(ADR(reg), Text.slice(ADR(t), lo, hi));
    if lines then Buf.add(ADR(reg), '\n'); end;
    regLines := lines;
end;

(* Deletes the lines from the one starting at lo to the one ending at
   hi, with a line break: the one after, or before the last line. *)
proc deleteLines(lo, hi: I64);
begin
    if hi < size() then
        del(lo, hi + 1 - lo);
    elsif lo > 0 then
        del(lo - 1, hi + 1 - lo);
        lo := lineStart(lo - 1);
    else
        del(lo, hi - lo);
    end;
    cur := firstNonBlank(lo);
end;

(* Shifts the lines from the one starting at lo to the one ending at
   hi by 4 spaces, right or left. Empty lines stay empty. *)
proc shift(lo, hi: I64; right: BOOL);
var p, e, n, lines, i: I64;
begin
    lines := Text.count(ADR(t), lo, hi) + 1;
    p := lo;
    for i := 1 to lines do
        e := lineEnd(p);
        if right then
            if e > p then ins(p, "    "); INC(e, 4); end;
        else
            n := 0;
            while (n < 4) and (p + n < e) and (at(p + n) = ' ') do INC(n); end;
            if (n = 0) and (p < e) and (at(p) = '\t') then n := 1; end;
            del(p, n);
            DEC(e, n);
        end;
        p := e + 1;
    end;
    cur := firstNonBlank(lo);
end;

(* Operator op on the text from lo up to hi; on the whole lines from
   lo's to hi's if lines. *)
proc operate(op, lo, hi: I64; lines: BOOL);
begin
    if lines then
        lo := lineStart(lo);
        hi := lineEnd(hi);
    end;
    if op = 'y' then
        yank(lo, hi, lines);
        if not lines then cur := lo; end;
    elsif op = 'd' then
        yank(lo, hi, lines);
        if lines then
            deleteLines(lo, hi);
        else
            del(lo, hi - lo);
            cur := lo;
        end;
    elsif op = 'c' then
        yank(lo, hi, lines);
        if lines then lo := firstNonBlank(lo); end;
        del(lo, hi - lo);
        cur := lo;
        insertMode(1, false);
    elsif (op = '>') or (op = '<') then
        shift(lo, hi, op = '>');
    end;
end;

(* count whole lines from the cursor's, for dd, cc, yy, >> and <<. *)
proc operateLines(op, count: I64);
var l: I64;
begin
    if count = 0 then count := 1; end;
    l := Text.lineOf(ADR(t), cur) + count - 1;
    operate(op, cur, line(l), true);
end;

(* An operator, op, and the motion it takes. *)
proc operator(op, count: I64);
var k, n, c, p: I64; m: Motion;
begin
    k := nextKey();
    n := 0;
    while (k >= '1') and (k <= '9') or (n > 0) and (k = '0') do
        n := n * 10 + k - '0';
        k := nextKey();
    end;
    if (count = 0) and (n = 0) then
        c := 0;
    else
        if count = 0 then count := 1; end;
        if n = 0 then n := 1; end;
        c := count * n;
    end;
    if k = op then operateLines(op, c); return; end;
    if (op = 'c') and (k = 'w') and (class(at(cur)) # 0) then
        (* cw changes to the end of the word, as ce *)
        p := cur;
        while (p + 1 < size()) and (class(at(p + 1)) = class(at(cur))) do INC(p); end;
        for n := 2 to c do p := wordEnd(p); end;
        operate(op, cur, next(p), false);
        return;
    end;
    m := motion(k, c);
    if not m.ok then return; end;
    if (k = 'w') and (Text.lineOf(ADR(t), m.pos) > Text.lineOf(ADR(t), cur))
        and (lineEnd(cur) > cur) then
        (* dw stops at the end of the line *)
        m.pos := lineEnd(cur);
    end;
    if m.pos < cur then
        p := cur;
        if m.inclusive then p := next(p); end;
        operate(op, m.pos, p, m.lines);
    else
        p := m.pos;
        if m.inclusive then p := next(p); end;
        operate(op, cur, p, m.lines);
    end;
end;

(* Commands *)

(* p: the register after the cursor, or before it, count times. *)
proc paste(after: BOOL; count: I64);
var p, i: I64; body: []U8;
begin
    if reg.len = 0 then return; end;
    if count = 0 then count := 1; end;
    Buf.reset(ADR(tmp));
    body := Buf.bytes(ADR(reg));
    if regLines and after then
        for i := 1 to count do
            Buf.add(ADR(tmp), '\n');
            Buf.str(ADR(tmp), body[0..LEN(body) - 1]);
        end;
        p := lineEnd(cur);
        ins(p, Buf.bytes(ADR(tmp)));
        cur := firstNonBlank(p + 1);
    elsif regLines then
        for i := 1 to count do Buf.str(ADR(tmp), body); end;
        p := lineStart(cur);
        ins(p, Buf.bytes(ADR(tmp)));
        cur := firstNonBlank(p);
    else
        for i := 1 to count do Buf.str(ADR(tmp), body); end;
        p := cur;
        if after and (cur < lineEnd(cur)) then p := next(cur); end;
        ins(p, Buf.bytes(ADR(tmp)));
        cur := prev(p + tmp.len);
    end;
end;

(* J: joins count lines, at least two, with a space between. *)
proc join(count: I64);
var i, e, p: I64;
begin
    if count < 2 then count := 2; end;
    for i := 2 to count do
        e := lineEnd(cur);
        if e >= size() then break; end;
        p := e + 1;
        while (p < size()) and isBlank(at(p)) do INC(p); end;
        del(e, p - e);
        if (e < size()) and (at(e) # '\n') and (at(e) # ')') and (e > lineStart(e))
            and not isBlank(at(e - 1)) then
            ins(e, " ");
        end;
        cur := e;
    end;
end;

(* r: replaces count characters with the next key's. *)
proc replace(count: I64);
var k, i, p, n: I64; b: [4]U8;
begin
    k := nextKey();
    if not typed(k) then return; end;
    if count = 0 then count := 1; end;
    p := cur;
    for i := 1 to count do
        if p >= lineEnd(cur) then return; end;
        p := next(p);
    end;
    del(cur, p - cur);
    n := utf8(k, b);
    for i := 1 to count do
        ins(cur, b[0..n]);
        INC(cur, n);
    end;
    cur := prev(cur);
end;

(* Writes the text to a new file beside path, then renames it over
   path, so that a failed write loses nothing. *)
proc write: BOOL;
var fd: I64; ok: BOOL;
begin
    Buf.reset(ADR(tmp));
    Buf.str(ADR(tmp), path);
    Buf.str(ADR(tmp), ".ravite~");
    fd := Sys.create(Buf.bytes(ADR(tmp)));
    if fd < 0 then
        Fmt.write(ADR(msg), "E212: Can't open file for writing: {}", [Fmt.str(path)]);
        return false;
    end;
    ok := writeAll(fd, Text.slice(ADR(t), 0, size()));
    if ok and eol and (size() > 0) then ok := writeAll(fd, "\n"); end;
    Sys.close(fd);
    if not ok or (Tty.rename(Buf.bytes(ADR(tmp)), path) # 0) then
        Fmt.write(ADR(msg), "E514: Write error: {}", [Fmt.str(path)]);
        return false;
    end;
    Text.written(ADR(t));
    Fmt.write(ADR(msg), "\"{}\" {}L, {}B written", [Fmt.str(path),
        Fmt.int(Text.lines(ADR(t))), Fmt.int(size() + 1)]);
    return true;
end;

(* The command line, after lead: false if it was left with Escape. *)
proc prompt(c: U8): BOOL;
var k, n: I64; b: [4]U8;
begin
    Buf.reset(ADR(cmd));
    prompting := true;
    lead := c;
    while true do
        k := nextKey();
        if (k = Keys.Enter) or (k = 10) then
            prompting := false;
            return true;
        elsif (k = Keys.Esc) or (k = Keys.ctrl('c')) then
            break;
        elsif (k = Keys.Backspace) or (k = 8) then
            if cmd.len = 0 then break; end;
            DEC(cmd.len);
            while (cmd.len > 0) and (Buf.bytes(ADR(cmd))[cmd.len] and 0C0H = 80H) do DEC(cmd.len); end;
        elsif typed(k) then
            n := utf8(k, b);
            Buf.str(ADR(cmd), b[0..n]);
        end;
    end;
    prompting := false;
    return false;
end;

(* Whether s is a number, and its value. *)
proc number(s: []U8): (I64, BOOL);
var i, n: I64;
begin
    if LEN(s) = 0 then return 0, false; end;
    n := 0;
    for i := 0 to LEN(s) - 1 do
        if (s[i] < '0') or (s[i] > '9') then return 0, false; end;
        n := n * 10 + I64(s[i] - '0');
    end;
    return n, true;
end;

(* : and the command line. *)
proc ex;
var s: []U8; n: I64; ok: BOOL;
begin
    if not prompt(':') then return; end;
    s := Buf.bytes(ADR(cmd));
    while (LEN(s) > 0) and (s[0] = ' ') do s := s[1..LEN(s)]; end;
    while (LEN(s) > 0) and (s[LEN(s) - 1] = ' ') do s := s[0..LEN(s) - 1]; end;
    n, ok := number(s);
    if ok then
        cur := firstNonBlank(line(n - 1));
    elsif s = "$" then
        cur := firstNonBlank(line(Text.lines(ADR(t)) - 1));
    elsif s = "w" then
        write();
    elsif s = "q" then
        if Text.changed(ADR(t)) then
            Buf.str(ADR(msg), "E37: No write since last change (add ! to override)");
        else
            quit;
        end;
    elsif s = "q!" then
        quit;
    elsif (s = "wq") or (s = "x") and Text.changed(ADR(t)) then
        if write() then quit; end;
    elsif s = "x" then
        quit;
    elsif LEN(s) > 0 then
        Fmt.write(ADR(msg), "E492: Not an editor command: {}", [Fmt.str(s)]);
    end;
end;

(* Moves the screen and the cursor by n lines, down or up. *)
proc scrollBy(n: I64);
var i: I64;
begin
    top, i := lines(top, n);
    cur, i := lines(cur, n);
    cur := firstNonBlank(cur);
end;

(* Command k, after count; count 0 is none given. *)
proc command(k, count: I64);
var p, i, n: I64; m: Motion; ok: BOOL;
begin
    n := count;
    if n = 0 then n := 1; end;
    if k = 'i' then
        insertMode(n, false);
    elsif k = 'a' then
        if cur < lineEnd(cur) then cur := next(cur); end;
        insertMode(n, false);
    elsif k = 'I' then
        cur := firstNonBlank(lineStart(cur));
        insertMode(n, false);
    elsif k = 'A' then
        cur := lineEnd(cur);
        insertMode(n, false);
    elsif k = 'o' then
        openLine(true, n);
    elsif k = 'O' then
        openLine(false, n);
    elsif (k = 'x') or (k = Keys.Delete) or (k = 's') then
        p := cur;
        for i := 1 to n do
            if p < lineEnd(cur) then p := next(p); end;
        end;
        if p > cur then
            yank(cur, p, false);
            del(cur, p - cur);
        end;
        if k = 's' then insertMode(1, false); end;
    elsif k = 'X' then
        p := cur;
        for i := 1 to n do
            if p > lineStart(cur) then p := prev(p); end;
        end;
        if p < cur then
            yank(p, cur, false);
            del(p, cur - p);
            cur := p;
        end;
    elsif (k = 'D') or (k = 'C') then
        p := lineEnd(cur);
        yank(cur, p, false);
        del(cur, p - cur);
        if k = 'C' then insertMode(1, false); end;
    elsif k = 'S' then
        operateLines('c', count);
    elsif k = 'Y' then
        operateLines('y', count);
    elsif (k = 'd') or (k = 'c') or (k = 'y') or (k = '>') or (k = '<') then
        operator(k, count);
    elsif k = 'r' then
        replace(count);
    elsif k = 'J' then
        join(count);
    elsif k = 'p' then
        paste(true, count);
    elsif k = 'P' then
        paste(false, count);
    elsif k = 'u' then
        for i := 1 to n do
            p, ok := Text.undo(ADR(t));
            if not ok then Buf.str(ADR(msg), "Already at oldest change"); break; end;
            cur := p;
        end;
    elsif k = Keys.ctrl('r') then
        for i := 1 to n do
            p, ok := Text.redo(ADR(t));
            if not ok then Buf.str(ADR(msg), "Already at newest change"); break; end;
            cur := p;
        end;
    elsif k = '.' then
        for i := 0 to numLast - 1 do replay[i] := last[i]; end;
        numReplay := numLast;
        atReplay := 0;
    elsif k = ':' then
        ex;
    elsif k = 'Z' then
        if nextKey() = 'Z' then
            if Text.changed(ADR(t)) and not write() then return; end;
            quit;
        end;
    elsif k = Keys.ctrl('d') then
        scrollBy((rows - 1) div 2);
    elsif k = Keys.ctrl('u') then
        scrollBy(-((rows - 1) div 2));
    elsif (k = Keys.ctrl('f')) or (k = Keys.PageDown) then
        scrollBy(rows - 3);
    elsif (k = Keys.ctrl('b')) or (k = Keys.PageUp) then
        scrollBy(-(rows - 3));
    else
        m := motion(k, count);
        if m.ok then
            cur := m.pos;
            keepColumn(k);
            return;
        end;
    end;
    want := View.column(ADR(t), onChar(cur));
end;

(* One command of normal mode, with its count; a step of undo, and,
   if it changed the text, what . repeats. *)
proc normal;
var k, count: I64;
begin
    Text.step(ADR(t));
    numRec := 0;
    recording := true;
    recFull := false;
    didChange := false;
    k := nextKey();
    Buf.reset(ADR(msg));
    count := 0;
    while (k >= '1') and (k <= '9') or (count > 0) and (k = '0') do
        count := count * 10 + k - '0';
        k := nextKey();
    end;
    command(k, count);
    recording := false;
    if didChange and not recFull then
        for k := 0 to numRec - 1 do last[k] := rec[k]; end;
        numLast := numRec;
    end;
    cur := onChar(cur);
end;

(* Whether the environment variable name is set, and not empty. *)
proc env(name: []U8): BOOL;
var e: ^^U8; s: ^U8; i, n: I64;
begin
    e := ARGV() + (ARGC() + 1);   (* the environment follows the arguments *)
    i := 0;
    while e[i] # nil do
        s := e[i];
        n := 0;
        while (n < LEN(name)) and (s[n] = name[n]) do INC(n); end;
        if (n = LEN(name)) and (s[n] = '=') and (s[n + 1] # 0) then return true; end;
        INC(i);
    end;
    return false;
end;

(* Reads the file at path into the text; false if it is there and
   can't be read. *)
proc load: BOOL;
var b: Buf.Buf; fd: I64; s: []U8;
begin
    eol := true;
    fd := Sys.openRead(path);
    if fd = -2 then   (* ENOENT *)
        Fmt.write(ADR(msg), "\"{}\" [New]", [Fmt.str(path)]);
        return true;
    end;
    if fd < 0 then return false; end;
    Sys.close(fd);
    Buf.init(ADR(b), Heap.heap);
    if not Files.read(path, ADR(b)) then return false; end;
    s := Buf.bytes(ADR(b));
    if (LEN(s) > 0) and (s[LEN(s) - 1] = '\n') then
        s := s[0..LEN(s) - 1];
    elsif LEN(s) > 0 then
        eol := false;
    end;
    if not Text.load(ADR(t), s) then return false; end;
    Fmt.write(ADR(msg), "\"{}\" {}L, {}B", [Fmt.str(path), Fmt.int(Text.lines(ADR(t))),
        Fmt.int(LEN(Buf.bytes(ADR(b))))]);
    Buf.done(ADR(b));
    return true;
end;

proc main*: I64;
var b: Buf.Buf; chunk: [4096]U8; n: I64; ok: BOOL;
begin
    Text.init(ADR(t), Heap.heap);
    Buf.init(ADR(msg), Heap.heap);
    Buf.init(ADR(cmd), Heap.heap);
    Buf.init(ADR(reg), Heap.heap);
    Buf.init(ADR(tmp), Heap.heap);
    Buf.init(ADR(screen), Heap.heap);
    Buf.init(ADR(status), Heap.heap);
    Buf.init(ADR(ruler), Heap.heap);
    if (ARGC() = 5) and (Files.arg(1) = "-script") then
        script := true;
        cols, ok := number(Files.arg(2));
        rows, ok := number(Files.arg(3));
        path := Files.arg(4);
        Buf.init(ADR(b), Heap.heap);
        repeat
            n := Sys.read(Sys.stdin, chunk);
            if n > 0 then Buf.str(ADR(b), chunk[0..n]); end;
        until n <= 0;
        Keys.notation(Buf.bytes(ADR(b)), addKey);
    elsif (ARGC() = 2) and (Files.arg(1)[0] # '-') then
        path := Files.arg(1);
    else
        Sys.write(Sys.stderr, "usage: ravite file\n");
        return 2;
    end;
    if not load() then
        Sys.write(Sys.stderr, "ravite: can't read ");
        Sys.write(Sys.stderr, path);
        Sys.write(Sys.stderr, "\n");
        return 1;
    end;
    colour := not env("NO_COLOR");
    coloured := colour and (LEN(path) > 4) and (path[LEN(path) - 4..LEN(path)] = ".raz");
    if not script and not Tty.raw() then
        Sys.write(Sys.stderr, "ravite: not a terminal\n");
        return 1;
    end;
    while true do normal; end;
    return 0;
end;

end Ravite.
